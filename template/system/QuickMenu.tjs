	function drawPin(b, over)
	{
		var c = over ? 0xff5025ff : 0xffffffff, cx = b.x + (b.w >> 1), cy = b.y + (b.h >> 1), k = drawScale;
		var p1 = (int)(k + 0.5), p3 = (int)(3 * k), p4 = (int)(4 * k), p7 = (int)(7 * k), p9 = (int)(9 * k), p11 = (int)(11 * k), p12 = (int)(12 * k);
		layer.fillRect(b.x + 2, b.y + 4, b.w - 4, b.h - 8, over ? 0xc0ffffff : 0x805025ff);
		if (pinned) {
			layer.fillRect(cx - p7, cy - p12, p7 * 2, p9, c);
			layer.fillRect(cx - p3, cy - p3, p3 * 2, p4, c);
			layer.fillRect(cx - p1, cy + p1, p1 * 2, p11, c);
		} else {
			layer.fillRect(cx - p12, cy - p7, p9, p7 * 2, c);
			layer.fillRect(cx - p3, cy - p3, p4, p3 * 2, c);
			layer.fillRect(cx + p1, cy - p1, p11, p1 * 2, c);
		}
	}

