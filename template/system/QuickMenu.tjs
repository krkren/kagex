		if (key != stateKey) { stateKey = key; build(); }
		var at = place !== void ? KAGBindToGlobal(place)(layer.width, layer.height) : [ (window.primaryLayer.width - layer.width) >> 1, window.primaryLayer.height - layer.height - 12 ];
		// near: the pointer within reveal px of the strip, where a mouse put it (a finger leaves
		// it resting where it was, and that would keep the strip for good)
