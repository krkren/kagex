			if (!KAGActionAvailable(it.action) || hidden(it.action)) continue;
			var b = %[ action:it.action, on:KAGBindToGlobal(it.on) ];
			b.normal = picture(it.image + "_normal") if it.image !== void;
			if (b.normal !== void) {
				b.over = picture(it.image + "_over");
				b.lit = picture(it.image + "_on");
				b.w = (int)(b.normal.width * k), b.h = (int)(b.normal.height * k);
			} else {
				b.label = it.label !== void ? tr(it.label) : KAGActionLabel(it.action);
				if (typeof global.setYesNoFont == "undefined") KAGLoadScript("YesNoDialog.tjs");
				b.w = (int)(150 * k), b.h = (int)(48 * k);
			}
			b.x = it.x !== void ? (int)(+it.x * k) : x;
			b.y = 0;
			x = b.x + b.w + gap;
			h = b.h if b.h > h;
			shown.add(b);
		}
		// the pin
		h = (int)(42 * k) if h == 0;
		shown.add(%[ action:"", pin:true, x:x, y:0, w:(int)(36 * k), h:h ]);
		stripHeight = h;
		return x + (int)(36 * k);
	}

	function build()
	{
		// at the player's size, made smaller when that's wider than the screen
		var k = scale, fit = window.primaryLayer.width - 8, w = layout(k);
		for (var n = 0; n < 4 && w > fit; n++) { k *= fit / w; w = layout(k); }
		if (layer === void) {
