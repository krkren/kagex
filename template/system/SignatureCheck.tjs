// SignatureCheck.tjs - verify the game's archives and engine before the game starts (signed builds)
//
// A build made by kagex-release with signing on carries a public key (SignatureKey.tjs, written
// into data.xp3) and RSA-PSS/SHA-256 signatures (.sig files, or embedded in the executable) made
// with the matching private key. This script, loaded first by Initialize.tjs, checks them with
// the engine's sigcheck plugin (Window.checkSignature) and lets the game start only when they all
// verify; otherwise it shows a message naming the file and quits.
//
// What it protects, and what it can't:
//   - It catches a damaged or edited archive, an engine or plugin swapped out, and patch/DLC or
//     extra archive files that weren't signed with the developer's key.
//   - It cannot protect the code that runs the check: whoever can rebuild data.xp3 (or the engine)
//     can take the check out. Compiled scripts and an encrypted archive (kagex-release) raise that bar;
//     this does not. So the archive's own check is "refuse to start if tampered", not a root of
//     trust, and the real value is gating patches and extra archives (loaded from the already
//     active, verify-or-refuse data.xp3).
//
// Because the check runs on a background thread and reports through onCheckSignatureDone (it can't
// be waited on inline on the SDL engine), verification is driven as a queue and the game is started
// from the completion. Only the web, Android and iOS builds lack the plugin; there the build is
// signed by the platform (or served from the developer's site) and this check is skipped.
//
// State lives in globals (TJS has no closures, so helpers can't capture Initialize's locals):
//   KAGSigned                 whether this is a signed build (a public key is present)
//   KAGSignaturePublicKey     the PEM public key text
//   KAGSignatureCheckEngine   also verify the engine files listed beside the executable
//   KAGSignedArchive          the archive the running code was loaded from (data.xp3 or the exe)
//   KAGSignedParts            external archives to verify and mount (each %[ storage, paths ])
//   KAGSignedPatchXp3         .xp3 patches to verify and add to the path (each %[ storage, path ])
//   KAGSignedPatchZip         .zip patches to verify and mount
//   KAGSignedMountOK          set true only while the verified patches/archives are being mounted
//
// With hidden file names (kagex-release's archive.hideNames) the files in data.xp3 and in the
// archives split out beside it are stored under hashed names and read through the xp3crypt
// plugin's xpcrypt:// medium; only data.xp3's startup.tjs (hashed-bootstrap.tjs) keeps its name.
// The key and the self-test are in data.xp3 under hashed names (read as kagexHashedArchive +
// name), and a verified split archive is mounted through the plugin (KAGSignedUseHashedArchive).

var KAGSignatureKeyFile = "SignatureKey.tjs";
// The injection options a signed build refuses: a REPL opens a script console in the running game,
// and the startup/eval options change what code runs. debugwin must stay off (its Shift+F12 is a
// console too). The engine's release build has the REPL compiled in, so this matters.
var KAGSignatureBannedArgs = [ "-repl", "-replfile", "-replsocket", "-replweb", "-replwebpad",
	"-startup", "-nostartup", "-evalcontext" ];


// Reads the public key and sets KAGSigned. In a signed build, refuses the injection options at
// once (before anything else runs). Called from the top of Initialize.tjs, before the auto paths.
function KAGSignatureInit()
{
	global.KAGSigned = false;
	global.KAGSignaturePublicKey = "";
	global.KAGSignatureCheckEngine = false;
	global.KAGSignedArchive = "";
	global.KAGSignedParts = [];
	global.KAGSignedPatchXp3 = [];
	global.KAGSignedPatchZip = [];
	global.KAGSignedMountOK = false;
	global.KAGSignatureAborted = false;

	var keyFile = KAGSignatureHashedArchive() + KAGSignatureKeyFile;
	if (!Storages.isExistentStorage(keyFile)) return;  // an unsigned build: nothing to do
	try {
		Scripts.execStorage(keyFile);
	} catch (e) {
		KAGSignatureQuit("The signature key could not be read (" + e.message + ").");
		return;
	}
	if (typeof global.KAGSignaturePublicKey != "String" || global.KAGSignaturePublicKey == "") {
		KAGSignatureQuit("The signature key is missing or malformed.");
		return;
	}
	global.KAGSigned = true;

	// Only the desktop engines have the sigcheck plugin. The web, Android and iOS builds carry the
	// same data.xp3 (and so the key), but are signed by the app store or served from the developer's
	// site, so the check is skipped there and the build runs as an unsigned one.
	var tag = (typeof System.platformTag != "undefined") ? System.platformTag : "";
	if (tag != "windows" && tag != "linux" && tag != "macos") {
		dm("Signature checking is not available on \"" + tag + "\"; relying on the platform's own integrity.");
		global.KAGSigned = false;
		return;
	}

	// Refuse a console / startup / eval option, however it was given (command line or a .cf)
	for (var i = 0; i < KAGSignatureBannedArgs.count; i++) {
		if (System.getArgument(KAGSignatureBannedArgs[i]) != "") {
			KAGSignatureQuit("This option is not allowed for a signed build: " + KAGSignatureBannedArgs[i]);
			return;
		}
	}
	// A signed release must have the debug window off (debugwin=no in its .cf). "" = the engine
	// default (debug on) or the line removed; "no" = off. Anything else re-enables the console.
	if (System.getArgument("-debugwin") != "no") {
		KAGSignatureQuit("A signed build must run with the debug window off.");
		return;
	}
	dm("Signed build: signatures will be checked before the game starts.");
}


// The hidden-names archive's folder (xpcrypt://data/), where the key and the self-test are, or ""
// for a game whose names aren't hidden. The bootstrap sets it before Initialize.tjs runs
function KAGSignatureHashedArchive()
{
	return typeof global.kagexHashedArchive == "String" ? global.kagexHashedArchive : "";
}

// useArchiveIfExists, when signed and the archive exists: record it to verify and defer its auto
// path. Returns true when it handled the archive (the caller then does nothing).
function KAGSignedUseArchive(name, arcname)
{
	for (var i = 0; i < KAGSignedParts.count; i++)
		if (KAGSignedParts[i].storage == arcname) { KAGSignedParts[i].paths.add(arcname + ">"); return true; }
	KAGSignedParts.add(%[ "storage" => arcname, "paths" => [ arcname + ">" ] ]);
	return true;
}

// useArchiveIfExists, when signed and the names are hidden: record the archive to verify, and
// mount it through the xp3crypt plugin as xpcrypt://<name>/ once it has (KAGSignatureAllPassed).
function KAGSignedUseHashedArchive(name, arcname)
{
	for (var i = 0; i < KAGSignedParts.count; i++)
		if (KAGSignedParts[i].storage == arcname) return true;
	KAGSignedParts.add(%[ "storage" => arcname, "paths" => [ "xpcrypt://" + name + "/" ], "domain" => name ]);
	return true;
}

// addArchiveWithSubFolder, when signed: defer an external archive's subfolder auto path, so it is
// added only after the archive verifies. Returns true when it recorded the path.
function KAGSignedDeferSubPath(arcname, path)
{
	for (var i = 0; i < KAGSignedParts.count; i++)
		if (KAGSignedParts[i].storage == arcname) { KAGSignedParts[i].paths.add(path); return true; }
	// The archive wasn't recorded as existing, so there is nothing to mount: drop the path
	return true;
}

// The patch.xp3 / patchN.xp3 loop, when signed: record the patch to verify and mount later.
function KAGSignedDeferPatchXp3(storage)
{
	if (!Storages.isExistentStorage(storage)) return false;
	KAGSignedPatchXp3.add(%[ "storage" => storage, "path" => storage + ">" ]);
	return true;
}

// The patch.zip loop, when signed: record the zip to verify and mount later.
function KAGSignedDeferPatchZip(storage)
{
	if (!Storages.isExistentStorage(storage)) return false;
	KAGSignedPatchZip.add(storage);
	return true;
}


//---------------------------------------------------------------------------
// Verification (a serial queue of checks, run through kag.checkSignature)
//---------------------------------------------------------------------------
// Each entry: %[ storage, label, expect ("pass" = result 1, "mismatch" = result 0), kind ]
var KAGSigQueue = [];
var KAGSigIndex = 0;

// Builds the queue and starts it. cont() runs once every check has passed (it starts the game).
function KAGSignatureVerifyAndStart(cont)
{
	global.KAGSigCont = cont;
	global.KAGSigQueue = [];
	global.KAGSigIndex = 0;

	// The archive the running scripts were loaded from (data.xp3, or the executable it is bound
	// into). The engine prefers a data.xp3 next to it over a bound copy, so checking the archive
	// actually in use catches a planted data.xp3. With hidden names that's data.xp3 too: its
	// startup.tjs, the one name it keeps, is what the engine ran.
	var hashed = KAGSignatureHashedArchive();
	var placed = Storages.getPlacedPath("startup.tjs");
	if (placed == "") placed = Storages.getPlacedPath("system/Initialize.tjs");
	var at = placed.indexOf(">");
	global.KAGSignedArchive = at >= 0 ? placed.substring(0, at) : System.exeName;

	// A decoy: a file whose .sig was made for different content, so a correct plugin reports a
	// mismatch (0). A plugin stubbed to always succeed would return 1 here and be caught; one that
	// always fails is caught on the real files below. It is always queued: a signed build always
	// ships it, so its absence means the archive was repacked and is treated as a failure.
	KAGSigQueue.add(%[ "storage" => hashed + "SignatureDecoy.bin", "label" => "the signature self-test",
		"expect" => "mismatch", "kind" => "decoy" ]);

	KAGSigQueue.add(%[ "storage" => KAGSignedArchive, "label" => "the game data (" +
		Storages.extractStorageName(KAGSignedArchive) + ")", "expect" => "pass", "kind" => "archive" ]);

	// The engine files, from the signed list beside the executable (<exe>.sigfiles). Verified as a
	// whole; the files it names are appended to the queue once it passes (so the list can't be
	// edited to drop a file). Not on macOS: there the app bundle is sealed by codesign (and would
	// rewrite these binaries after we signed them), so the engine's own code signature covers them.
	var tag = (typeof System.platformTag != "undefined") ? System.platformTag : "";
	if (KAGSignatureCheckEngine && tag != "macos") {
		var listName = KAGSignatureEngineListName();
		KAGSigQueue.add(%[ "storage" => listName, "label" => "the engine file list",
			"expect" => "pass", "kind" => "enginelist" ]);
	}

	// External archives (the split parts, and any stray <folder>.xp3 beside the engine) and patches
	for (var i = 0; i < KAGSignedParts.count; i++)
		KAGSigQueue.add(%[ "storage" => KAGSignedParts[i].storage, "label" => "an archive (" +
			Storages.extractStorageName(KAGSignedParts[i].storage) + ")", "expect" => "pass", "kind" => "part", "index" => i ]);
	for (var i = 0; i < KAGSignedPatchXp3.count; i++)
		KAGSigQueue.add(%[ "storage" => KAGSignedPatchXp3[i].storage, "label" => "a patch (" +
			Storages.extractStorageName(KAGSignedPatchXp3[i].storage) + ")", "expect" => "pass", "kind" => "patchxp3", "index" => i ]);
	for (var i = 0; i < KAGSignedPatchZip.count; i++)
		KAGSigQueue.add(%[ "storage" => KAGSignedPatchZip[i], "label" => "a patch (" +
			Storages.extractStorageName(KAGSignedPatchZip[i]) + ")", "expect" => "pass", "kind" => "patchzip", "index" => i ]);

	// The plugin reports back on kag; give it the handlers and start.
	kag.onCheckSignatureDone = KAGSignatureOnDone;
	kag.onCheckSignatureProgress = KAGSignatureOnProgress;
	KAGSignatureStartNext();
}

function KAGSignatureEngineListName()
{
	// <exe leaf>.sigfiles next to the executable (System.exeName is the full path)
	var exe = System.exeName;
	return exe + ".sigfiles";
}

function KAGSignatureStartNext()
{
	if (KAGSigIndex >= KAGSigQueue.count) { KAGSignatureAllPassed(); return; }
	var item = KAGSigQueue[KAGSigIndex];
	if (item.storage == "" || !Storages.isExistentStorage(item.storage)) {
		// A file named for checking but not present. The decoy, the game archive and the engine
		// files are always shipped, so a missing one means tampering and fails. Only a part or a
		// patch can legitimately be absent (it was a candidate that this build doesn't have).
		if (item.kind == "part" || item.kind == "patchxp3" || item.kind == "patchzip") {
			KAGSigIndex++;
			KAGSignatureStartNext();
			return;
		}
		KAGSignatureQuit("A file that must be checked is missing: " + item.label + ".");
		return;
	}
	kag.checkSignature(item.storage, KAGSignaturePublicKey, (string)KAGSigIndex);
}

function KAGSignatureOnProgress(handler, info, percent)
{
	// shown by the logo while it waits, if the game wants it; nothing to do here
}

function KAGSignatureOnDone(handler, info, result, errormsg)
{
	var idx = (int)info;
	if (idx < 0 || idx >= KAGSigQueue.count) return;
	var item = KAGSigQueue[idx];
	var ok = item.expect == "mismatch" ? (result == 0) : (result == 1);
	if (!ok) {
		if (item.kind == "decoy")
			KAGSignatureQuit("The signature self-test failed; the signature check can't be trusted on this copy.");
		else
			KAGSignatureQuit("The signature check failed for " + item.label + "." +
				(result == -2 && errormsg != "" ? "\n(" + errormsg + ")" : ""));
		return;
	}
	// The engine list verified: read it and append each file it names as its own check.
	if (item.kind == "enginelist") KAGSignatureQueueEngineFiles(item.storage);
	KAGSigIndex++;
	// run the next on a fresh tick rather than nested in this event
	global.KAGSigStep = new Timer(KAGSignatureStepTick, "");
	KAGSigStep.interval = 1;
	KAGSigStep.enabled = true;
}

function KAGSignatureStepTick()
{
	KAGSigStep.enabled = false;
	invalidate KAGSigStep;
	global.KAGSigStep = void;
	KAGSignatureStartNext();
}

// Reads the (now verified) engine list and appends an "enginefile" check per line. Paths are
// relative to the executable's folder; blank lines and ; comments are ignored.
function KAGSignatureQueueEngineFiles(listStorage)
{
	var lines = [];
	try { lines.load(listStorage); } catch (e) {
		KAGSignatureQuit("The engine file list could not be read (" + e.message + ").");
		return;
	}
	var base = System.exePath;
	for (var i = 0; i < lines.count; i++) {
		var line = lines[i];
		// trim
		while (line != "" && (line[0] == " " || line[0] == "\t")) line = line.substring(1);
		while (line != "" && (line.substring(line.length - 1) == "\r" || line.substring(line.length - 1) == " " || line.substring(line.length - 1) == "\t"))
			line = line.substring(0, line.length - 1);
		if (line == "" || line[0] == ";") continue;
		KAGSigQueue.add(%[ "storage" => base + line, "label" => "an engine file (" + line + ")",
			"expect" => "pass", "kind" => "enginefile" ]);
	}
	invalidate lines;
}

// Every check passed: add the verified archives' auto paths, mount the verified patches, start.
function KAGSignatureAllPassed()
{
	global.KAGSignedMountOK = true;
	for (var i = 0; i < KAGSignedParts.count; i++) {
		var part = KAGSignedParts[i];
		// hidden names: the archive is served through the xp3crypt plugin as xpcrypt://<domain>/
		if (part.domain !== void && (typeof global.XP3Crypt == "undefined" || !XP3Crypt.mount(part.domain, part.storage))) {
			global.KAGSignedMountOK = false;
			KAGSignatureQuit("The game data (" + Storages.extractStorageName(part.storage) + ") could not be opened.");
			return;
		}
		for (var j = 0; j < part.paths.count; j++) Storages.addAutoPath(part.paths[j]);
		dm("Signed archive mounted: " + part.storage);
	}
	for (var i = 0; i < KAGSignedPatchXp3.count; i++) {
		Storages.addAutoPath(KAGSignedPatchXp3[i].path);
		dm("Signed patch mounted: " + KAGSignedPatchXp3[i].storage);
	}
	for (var i = 0; i < KAGSignedPatchZip.count; i++) KAGMountPatchZip(KAGSignedPatchZip[i]);
	global.KAGSignedMountOK = false;
	dm("Signatures verified; starting the game.");
	var cont = global.KAGSigCont;
	global.KAGSigCont = void;
	cont();
}

// DLC the game mounts itself in a signed build: verify the zip with the game's public key, then
// mount it on success. onDone(storage, ok) is called when it finishes. In an unsigned build it
// mounts straight away (no key to check against).
function KAGMountSignedPatchZip(storage, onDone)
{
	if (!global.KAGSigned) {
		var okNow = KAGMountPatchZip(storage);
		if (onDone !== void) onDone(storage, okNow);
		return;
	}
	if (!Storages.isExistentStorage(storage)) { if (onDone !== void) onDone(storage, false); return; }
	global.KAGSignedDlcStorage = storage;
	global.KAGSignedDlcDone = onDone;
	kag.onCheckSignatureDone = KAGSignatureDlcDone;
	kag.onCheckSignatureProgress = KAGSignatureOnProgress;
	kag.checkSignature(storage, KAGSignaturePublicKey, "dlc");
}

function KAGSignatureDlcDone(handler, info, result, errormsg)
{
	if (info != "dlc") return;
	var storage = global.KAGSignedDlcStorage, onDone = global.KAGSignedDlcDone;
	var ok = false;
	if (result == 1) {
		global.KAGSignedMountOK = true;
		ok = KAGMountPatchZip(storage);
		global.KAGSignedMountOK = false;
	} else {
		dm("DLC rejected (signature check failed): " + storage);
	}
	global.KAGSignedDlcStorage = void;
	global.KAGSignedDlcDone = void;
	if (onDone !== void) onDone(storage, ok);
}


// Shows a message and quits. Used for every verification failure and for a refused option.
function KAGSignatureQuit(reason)
{
	var msg = "This copy of the game can't be started.\n\n" + reason +
		"\n\nThe game files or the program may be damaged or modified. Please reinstall from the original source.";
	dm("Signature check: " + reason);
	global.KAGSignatureAborted = true;   // Initialize.tjs returns on this; terminate() is async
	try {
		var wasDisabled = System.eventDisabled;
		System.eventDisabled = true;
		System.inform(msg);
		System.eventDisabled = wasDisabled;
	} catch (e) {}
	KAGUnlinkPluginsBeforeExit() if typeof global.KAGUnlinkPluginsBeforeExit != "undefined";
	System.terminate();
}
