// Language.tjs - the languages a game is shown in (doc/kagex.txt, "Languages")
//
// A game lists its languages in Config.tjs (global.KAGLanguageList, "en,ja"): the first is the
// one its scenarios and scripts are written in, the source language.
//
// The story is in the compiled scenarios, as in Wamsoft's multi-language games: each script in
// !scnlist.txt has a translation into each other language, data/lang/<code>/scenario/<script>
// (the script with its text in that language), and the compiler builds every language's texts,
// speakers' names, choices and titles into the script's .scn (SceneParser.addLanguages,
// doc/scn.txt "Languages"); the scene player shows the language shown. Speakers' names that
// come from envinit.tjs (nameAlias) can be a dictionary by language. Scripts KAG plays itself
// (the title screen, the system screens, a script not in !scnlist.txt) are shown as written.
//
// The interface is in each other language's folder, data/lang/<code>/, which is put on the
// search path while the game shows that language, so any file in it stands in for the file of
// the same name elsewhere (the screens' images with words on them, a CSV), and which holds
// that language's table of interface strings, lang.json:
//
//   {
//     "name": "日本語",                      the language's name, in that language
//     "strings": { "Load?": "ロードしますか？", ... }    prompts, labels and messages a
//                                            screen draws (tr()), keyed by the source text
//   }
//
// The framework's own strings (the Yes/No prompts, About, the backlog's "Choice: ") are in
// system/kagex_<code>.json, read before the game's table, which can change them. A string a
// table doesn't have is shown as written.
//
// KAGLanguage.set(code) switches the language while the game runs: the search path and the
// table change, then every object registered with addListener gets onLanguageChange(code,
// previous), which the window (MainWindow.tjs) uses to draw the message, the choices and the
// screen on show again.

class KAGLanguageManager
{
	var list = [];          // the language codes, the source language first
	var source = "en";      // the language the scenarios are written in
	var current;            // the language shown
	var chosen = false;     // whether the player chose it (saved; otherwise the system's)
	var table;              // current's tables, merged: %[ name, strings ]
	var paths = [];         // the search paths added for current
	var listeners = [];     // objects told of a change (onLanguageChange)
	var generation = 0;     // counts the changes (caches keyed on the language check it)

	// a language's name in itself, for a language without a table (the source language)
	var ownNames = %[
		"en" => "English", "ja" => "日本語", "zh-cn" => "简体中文", "zh-tw" => "繁體中文",
		"zh-hans" => "简体中文", "zh-hant" => "繁體中文", "zh" => "中文", "ko" => "한국어",
		"fr" => "Français", "de" => "Deutsch", "es" => "Español", "it" => "Italiano",
		"pt" => "Português", "pt-br" => "Português (Brasil)", "ru" => "Русский",
		"pl" => "Polski", "th" => "ไทย", "vi" => "Tiếng Việt", "id" => "Bahasa Indonesia",
		];

	function KAGLanguageManager(spec)
	{
		if (typeof spec != "String" || spec == "") spec = "en";
		var codes = spec.split(",", , true);
		for (var i = 0; i < codes.count; i++) {
			var c = normalize(codes[i]);
			if (c != "" && list.find(c) < 0) list.add(c);
		}
		if (list.count == 0) list.add("en");
		source = list[0];
		current = source;
		table = emptyTable();
	}

	function finalize() { }

	// whether there is another language to switch to
	property available { getter() { return list.count > 1; } }

	property isSource { getter() { return current == source; } }

	// "en_US" and "EN-us" as "en-us"
	function normalize(code)
	{
		if (typeof code != "String") return "";
		return code.replace(/_/g, "-").toLowerCase().trim();
	}

	function has(code) { return list.find(normalize(code)) >= 0; }

	// the listed language that fits a code: itself, or one with its language part ("en" for
	// "en-us", "zh-tw" for "zh-hant-tw" when that's all there is)
	function match(code)
	{
		code = normalize(code);
		if (code == "") return void;
		if (list.find(code) >= 0) return code;
		var main = code.split("-")[0];
		if (list.find(main) >= 0) return main;
		for (var i = 0; i < list.count; i++)
			if (list[i].split("-")[0] == main) return list[i];
		return void;
	}

	// the language the system prefers, of those listed: the engine's UI language (the system
	// locale, or -language=) and then its candidates (System.uiLanguageCandidates, in the order
	// the engine prefers them); the source language when none fits
	function preferred()
	{
		var c;
		try { if (typeof System.uiLanguage == "String" && (c = match(System.uiLanguage)) !== void) return c; } catch (e) {}
		try {
			var cands = System.uiLanguageCandidates;
			if (cands instanceof "Array")
				for (var i = 0; i < cands.count; i++)
					if ((c = match(cands[i])) !== void) return c;
		} catch (e) {}
		return source;
	}

	// Whether a language's text is broken into lines between words (the word wrap, MainWindow
	// needsToBeWrapped) or anywhere (KAG's own wrap, with its line-breaking rules): the table's
	// "wordWrap", otherwise not for Japanese and Chinese, which don't put spaces between words
	function wordWrap(lang)
	{
		lang = lang === void ? current : normalize(lang);
		var t = tableFor(lang);
		if (t.wordWrap !== void) return !!+t.wordWrap; // JSON's true and false come as 1 and 0
		var main = lang.split("-")[0];
		return main != "ja" && main != "zh";
	}

	// a language's name in itself (its table's, for the language shown)
	function nameOf(code)
	{
		code = normalize(code);
		if (code == current && typeof table.name == "String" && table.name != "") return table.name;
		return ownNames[code] !== void ? ownNames[code] : code;
	}

	// the language after the current one (the switching key)
	property next { getter() { return list[(list.find(current) + 1) % list.count]; } }

	function addListener(obj) { if (listeners.find(obj) < 0) listeners.add(obj); }
	function removeListener(obj) { listeners.remove(obj, true); }

	// Shows the game in another language: its folder goes on the search path in place of the
	// previous one's and its table is read. With notify, the listeners draw what they show
	// again. Returns whether it changed.
	function set(code, notify = true)
	{
		var c = match(code);
		if (c === void) { dm("Language not listed in KAGLanguageList: " + code); return false; }
		if (c == current && generation > 0) return false;
		var previous = current;
		current = c;
		applyPaths();
		// The image cache goes by the name a script loads, not the file found, so an image
		// the previous language's folder (or none) gave would come back for the same name
		if (generation > 0 && typeof System.clearGraphicCache != "undefined") System.clearGraphicCache();
		loadTable();
		generation++;
		dm("Language: " + current + (previous != current ? " (was " + previous + ")" : ""));
		if (notify && previous != current) {
			var ls = [];
			ls.assign(listeners);
			for (var i = 0; i < ls.count; i++) {
				if (!isvalid ls[i]) { listeners.remove(ls[i], true); continue; }
				try { ls[i].onLanguageChange(current, previous); }
				catch (e) { dm("onLanguageChange: " + e.message); }
			}
		}
		return previous != current;
	}

	// The search paths: lang/<code>/ in the game's data and in each zip patch that has one
	// (KAGLanguageRoots, Initialize.tjs), after every other path, so the language's files win
	// over the same names elsewhere, patches included
	function applyPaths()
	{
		for (var i = 0; i < paths.count; i++) Storages.removeAutoPath(paths[i]);
		paths.clear();
		var roots = global.KAGLanguageRoots;
		for (var i = 0; i < roots.count; i++) {
			var p = roots[i] + "lang/" + current + "/";
			Storages.addAutoPath(p);
			paths.add(p);
		}
	}

	function emptyTable() { return %[ name: "", strings: %[] ]; }

	// A JSON table, or void where there isn't one (or it isn't JSON). The json plugin's
	// evalJSONStorage fails on any character beyond ASCII ("can't convert to a UNICODE string",
	// a BOM or not), so the engine reads the text (UTF-8 or UTF-16 with or without a BOM, as it
	// reads scripts) and the plugin parses it.
	function readTable(storage)
	{
		if (!Storages.isExistentStorage(storage)) return void;
		if (typeof Scripts.evalJSON == "undefined") { dm("No json plugin: " + storage + " not read"); return void; }
		try {
			var lines = [];
			lines.load(storage);
			var t = Scripts.evalJSON(lines.join("\n"));
			if (typeof t == "Object" && t !== null && t instanceof "Dictionary") return t;
			dm("Language table " + storage + ": not a JSON object");
		}
		catch (e) { dm("Language table " + storage + ": " + e.message); }
		return void;
	}

	// merges a table into another: a dictionary's entries into the dictionary there
	function mergeInto(to, from)
	{
		if (typeof from != "Object" || from === null) return;
		var keys = [];
		keys.assign(from);
		for (var i = 0; i < keys.count; i += 2) {
			var k = keys[i], v = keys[i + 1];
			if (typeof v == "Object" && v !== null && !(v instanceof "Array")) {
				if (typeof to[k] != "Object" || to[k] === null) to[k] = %[];
				mergeInto(to[k], v);
			} else to[k] = v;
		}
	}

	// A language's tables, merged: the framework's (kagex_<code>.json), then the game's
	// (lang/<code>/lang.json), then each zip patch's, whose entries win
	function readTables(lang)
	{
		var t = emptyTable();
		mergeInto(t, readTable("kagex_" + lang + ".json"));
		var roots = global.KAGLanguageRoots, rel = "lang/" + lang + "/lang.json";
		for (var i = 0; i < roots.count; i++) if (KAGStorageAt(roots[i] + rel, rel)) mergeInto(t, readTable(roots[i] + rel));
		return t;
	}

	// The current language's tables
	function loadTable()
	{
		table = readTables(current);
		otherTables = %[];
	}

	// ---- looking up -----------------------------------------------------------------------
	// In the language shown, or in the one given (lang): the backlog keeps a choice's "Choice:"
	// in the language it was shown in (KAGEnvPlayer.tjs). A string a table doesn't have is shown
	// as written. A key is looked up as it is, then without spaces at its ends.

	// another language's tables (read once; the language shown has `table`)
	var otherTables = %[];
	function tableFor(lang)
	{
		if (lang === void || lang == current) return table;
		lang = normalize(lang);
		if (otherTables[lang] !== void) return otherTables[lang];
		return otherTables[lang] = readTables(lang);
	}

	function find(dic, text)
	{
		if (typeof dic != "Object" || dic === null) return void;
		var r = dic[text];
		if (typeof r == "String") return r;
		var t = text.trim();
		if (t != text && t != "" && typeof (r = dic[t]) == "String") return r;
		return void;
	}

	// An interface string (prompts, buttons, titles)
	function ui(text, lang)
	{
		if (typeof text != "String" || text == "") return text;
		if (lang === void) lang = current;
		if (lang == source) return text;
		var r = find(tableFor(lang).strings, text);
		return r !== void ? r : text;
	}
}

// Whether storage (a name with a folder: root + path) is there at that path. The engine looks a
// name with a folder up by its file name on the auto path when there's no such file there
// (lang/ja/scenario/effect.ks was found as data/scenario/effect.ks), so the file it finds has to
// be at path
function KAGStorageAt(storage, path)
{
	var placed = Storages.getPlacedPath(storage);
	if (placed == "") return false;
	placed = placed.toLowerCase();
	path = ((string)path).toLowerCase();
	var n = placed.length - path.length;
	if (n < 0 || placed.substr(n) != path) return false;
	if (n == 0) return true;
	var c = placed.charAt(n - 1);
	return c == "/" || c == ">" || c == "\\";
}

// The game's languages. Created by Initialize.tjs after Config.tjs, showing the language the
// system prefers until the window reads the player's saved choice (MainWindow.tjs)
var KAGLanguage;

// An interface string in the language shown: tr("Load?")
function tr(text) { return global.KAGLanguage !== void ? KAGLanguage.ui(text) : text; }
