// MenuBar.tjs - The menu bar, drawn with Elements in a strip above the game in windowed mode
//
// The SDL engine has no menu bar, so in windowed mode the window's menu (KAGWindow_createMenus:
// System, Display, the message commands, Help...) is drawn as one, as Kirikiri's Win32 menu bar
// was: the window is menuBarHeight taller than the game, the game is placed under that strip
// (Window.setViewport, KAGWindow.applyMenuBarLayout), and the strip holds the top menus' titles
// (KAGMenuBar, an ElementsDialog overlay anchored to the window). A menu drops down over the
// game from its title (KAGMenuDropDown, an Elements screen in a game layer, ElementsScreen.tjs).
// Full screen has neither, as Kirikiri's full screen had no menu bar.
//
// A click on a title opens its menu (a top item without a submenu does what it does at once),
// and moving the mouse to another title while a menu is open opens that one. F10 (and the
// controller's START, in a game that leaves it to the framework, and R3) opens the first menu
// from the keyboard. In a menu the arrows or the D-pad move (Right opens a submenu, or the next
// menu; Left closes a submenu, or goes to the menu before), Return or A chooses, Esc or B
// closes a submenu or the menu, and a click outside, a right-click or F10 closes it. Choosing an
// item closes the menu, then does what the item does (KAGMenuItem.click).
//
// The items show as they are (enabled, checked, the radio groups' choice). An item is left out
// while its visible is false (Menu_visible_config in Config.tjs) or its menuBarHidden is
// true, and so is Help > Contents without the help file. Captions are in English with an "(&X)"
// accelerator and a "\t" shortcut, as for a menu bar: the accelerator is taken off, the caption
// shown through tr() in the language shown and the shortcut at the right.

// Whether win can show the bar: the SDL engine's stand-in menu (Menus.tjs), Elements screens,
// and Window.setViewport to put the game under the strip
function KAGMenuBarAvailable(win)
{
	return KAGElementsScreenAvailable() && typeof win.setViewport != "undefined" &&
		typeof win.menuBarStandIn != "undefined" && win.menuBarStandIn && typeof win.menu == "Object" && win.menu !== void;
}

// The look, in screen pixels (the drop-down draws them at the game's scale)
var KAGMenuLook = %[
	barColor:0xf3f0ff, barLine:0xa690ff, textColor:0x010062, hiliteColor:0x5025ff, hiliteText:0xffffff,
	disabledText:0xa690ff, disabledHilite:0xe6deff, boxColor:0xffffff, boxBorder:0x5025ff, shadowColor:0x5025ff,
	separatorColor:0xd6ccff, shortcutColor:0x5f4fb0,
	titleSize:17, titlePad:11, titleLeft:4,
	itemSize:17, shortcutSize:15, itemH:30, separatorH:9, boxPad:4, shadow:4,
	gutterLeft:30, gutterRight:28, shortcutGap:36, minWidth:180
];

// ---------------------------------------------------------------------- the items --

// What an item shows: %[ label, shortcut ]
function KAGMenuItemText(item)
{
	var caption = item.caption !== void ? (string)item.caption : "";
	var shortcut = "";
	var tab = caption.indexOf("\t");
	if (tab >= 0) shortcut = caption.substring(tab + 1), caption = caption.substring(0, tab);
	caption = caption.replace(/\(&.\)/g, "").replace(/&(.)/g, "$1").trim();
	return %[ label:tr(caption), shortcut:shortcut ];
}

function KAGMenuIsSeparator(item)
{
	return typeof item == "Object" && item !== void && typeof item.caption == "String" && item.caption == "-";
}

// Whether the menu shows item
function KAGMenuShows(win, item)
{
	if (typeof item != "Object" || item === void || !isvalid item) return false;
	if (typeof item.visible != "undefined" && !item.visible) return false;
	if (typeof item.menuBarHidden != "undefined" && item.menuBarHidden) return false;
	return win.menuShows(item);
}

function KAGMenuHasChildren(win, item)
{
	if (typeof item.children == "undefined" || item.children === void) return false;
	var kids = item.children;
	for (var i = 0; i < kids.count; i++) if (KAGMenuShows(win, kids[i]) && !KAGMenuIsSeparator(kids[i])) return true;
	return false;
}

// Whether item is one of a radio group (group not 0) one of whose items is checked: the Debug
// menu's commands are in groups that are never checked, and show no mark
function KAGMenuInCheckedGroup(node, item)
{
	if (typeof item.group == "undefined" || item.group == 0) return false;
	var kids = node.children;
	for (var i = 0; i < kids.count; i++)
		if (typeof kids[i] == "Object" && kids[i] !== void && kids[i].group == item.group && kids[i].checked) return true;
	return false;
}

function KAGMenuEnabled(item)
{
	return typeof item.enabled == "undefined" || item.enabled;
}

// The items node shows, with "-" for a separator between two of them
function KAGMenuVisibleItems(win, node)
{
	var all = node.children, list = [];
	for (var i = 0; i < all.count; i++) {
		var it = all[i];
		if (!KAGMenuShows(win, it)) continue;
		if (KAGMenuIsSeparator(it)) {
			list.add("-") if list.count > 0 && !(typeof list[list.count - 1] == "String");
			continue;
		}
		list.add(it);
	}
	list.erase(list.count - 1) if list.count > 0 && typeof list[list.count - 1] == "String";
	return list;
}

// ------------------------------------------------------------------- drawing --

function KAGMenuFont(layer, size)
{
	if (typeof global.setYesNoFont == "undefined") KAGLoadScript("YesNoDialog.tjs");
	setYesNoFont(layer, size);
	layer.font.bold = false;
}

function KAGMenuTextWidth(layer, text, size)
{
	KAGMenuFont(layer, size);
	return measureYesNoText(layer, text);
}

function KAGMenuTextHeight(layer, size)
{
	KAGMenuFont(layer, size);
	return layer.font.getTextHeight("Ag");
}

// text with its left edge at x, centred on cy
function KAGMenuDrawText(layer, x, cy, text, size, color)
{
	var h = KAGMenuTextHeight(layer, size);
	KAGMenuFont(layer, size);
	drawYesNoString(layer, x, cy - (h >> 1), text, color, yesnoLabelBase);
}

function KAGMenuFill(layer, x, y, w, h, color)
{
	layer.fillRect(int(x), int(y), int(w), int(h), 0xff000000 | color) if w >= 1 && h >= 1;
}

// A check mark size wide, its top-left at x, y
function KAGMenuDrawCheck(layer, x, y, size, color)
{
	var t = Math.max(2, int(size / 6 + 0.5));
	var pts = [ [ 0, 0.55 ], [ 0.38, 0.92 ], [ 1.0, 0.15 ] ];
	for (var s = 0; s < 2; s++) {
		var x0 = pts[s][0] * size, y0 = pts[s][1] * size, x1 = pts[s + 1][0] * size, y1 = pts[s + 1][1] * size;
		var n = int(Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0))) + 1;
		for (var i = 0; i <= n; i++)
			KAGMenuFill(layer, x + x0 + (x1 - x0) * i / n - t / 2, y + y0 + (y1 - y0) * i / n - t / 2, t, t, color);
	}
}

// A filled circle of radius r centred on cx, cy
function KAGMenuDrawDot(layer, cx, cy, r, color)
{
	for (var dy = -r; dy <= r; dy++) {
		var w = int(Math.sqrt(r * r - dy * dy) + 0.5);
		KAGMenuFill(layer, cx - w, cy + dy, w * 2 + 1, 1, color);
	}
}

// A triangle pointing right, its left edge at x, centred on cy (h high)
function KAGMenuDrawArrow(layer, x, cy, h, color)
{
	var half = int(h / 2);
	for (var i = 0; i <= half; i++) {
		var w = int((half - i) * 2 / 3) + 1;
		KAGMenuFill(layer, x, cy - i, w, 1, color);
		KAGMenuFill(layer, x, cy + i, w, 1, color) if i > 0;
	}
}

// ---------------------------------------------------------------------- the bar --

class KAGMenuBar
{
	var window;
	var dialog;              // the ElementsDialog over the strip, while it shows
	var atlas;               // its pictures
	var atlasName = "";
	var titles = [];         // the titles shown: %[ item, x, w, menu (it has a submenu), enabled ] (screen pixels)
	var shownKey = "";       // what the bar shows (it's built again when that changes)
	var openIndex = -1;      // the title whose menu is open
	var hoverIndex = -1;     // the title under the mouse
	var deferred = [];
	var deferTrigger;

	function KAGMenuBar(win)
	{
		window = win;
		atlas = new global.Layer(win, win.primaryLayer);
		atlas.name = "Menu bar atlas";
		atlas.type = ltAlpha;
		atlas.face = dfAlpha;
		atlas.visible = false;
	}

	function finalize()
	{
		hide();
		invalidate retryTimer if retryTimer !== void;
		invalidate deferTrigger if deferTrigger !== void;
		invalidate atlas if atlas !== void && isvalid atlas;
	}

	property shown { getter { return dialog !== void && shownKey != ""; } }

	// The overlay's units: it's laid out in the game's pixels, scaled to the window as the game
	// is ("contain" of the primary layer in the window). The bar is drawn in screen pixels
	property scale
	{
		getter {
			var p = window.primaryLayer;
			return Math.min(window.innerWidth / p.width, window.innerHeight / p.height);
		}
	}

	/**
	 * Shows the bar as the window is now (in windowed mode, with the top menus' titles), or
	 * hides it; force builds it again (the language changed)
	 */
	function update(force = false)
	{
		if (!window.menuBarShown) return hide();
		var list = KAGMenuVisibleItems(window, window.menu), key = [];
		key.add(window.innerWidth), key.add(window.innerHeight), key.add(window.menuBarHeight);
		key.add(KAGLanguage.current) if typeof global.KAGLanguage == "Object" && KAGLanguage !== void;
		for (var i = 0; i < list.count; i++)
			if (typeof list[i] == "Object") key.add(KAGMenuItemText(list[i]).label + (KAGMenuEnabled(list[i]) ? "+" : "-"));
		key = key.join("|");
		if (!force && dialog !== void && key == shownKey) return;
		shownKey = key;
		build(list);
	}

	function hide()
	{
		if (dialog !== void) {
			try { dialog.close(); } catch {}
			invalidate dialog;
			dialog = void;
		}
		dropAtlas();
		titles.clear();
		shownKey = "";
		openIndex = hoverIndex = -1;
	}

	function dropAtlas()
	{
		if (atlasName != "") try { ElementsDialog.unregisterImage(atlasName); } catch {}
		atlasName = "";
	}

	function build(list)
	{
		var look = KAGMenuLook;
		var h = window.menuBarHeight, w = window.innerWidth, s = scale;
		if (s <= 0) return;
		// the titles and their pieces: normal, over and disabled, side by side in the atlas
		titles.clear();
		var x = look.titleLeft;
		for (var i = 0; i < list.count; i++) {
			var it = list[i];
			if (typeof it != "Object") continue;
			var text = KAGMenuItemText(it);
			var tw = KAGMenuTextWidth(atlas, text.label, look.titleSize) + look.titlePad * 2;
			titles.add(%[ item:it, label:text.label, x:x, w:tw, menu:KAGMenuHasChildren(window, it), enabled:KAGMenuEnabled(it) ]);
			x += tw;
		}
		var aw = 8, ah = (h + 8) * 3 + 8;
		for (var i = 0; i < titles.count; i++) aw += titles[i].w + 8;
		atlas.setImageSize(aw, ah);
		atlas.fillRect(0, 0, aw, ah, 0);
		var ax = 8;
		for (var i = 0; i < titles.count; i++) {
			var t = titles[i];
			t.pieces = [];
			for (var k = 0; k < 3; k++) {
				var py = 8 + k * (h + 8);
				// 0 normal, 1 over, 2 disabled
				if (k == 1) KAGMenuFill(atlas, ax, py, t.w, h - 1, look.hiliteColor);
				var color = k == 1 ? look.hiliteText : k == 2 ? look.disabledText : look.textColor;
				KAGMenuDrawText(atlas, ax + look.titlePad, py + ((h - 1) >> 1), t.label, look.titleSize, color);
				t.pieces.add([ ax, py, t.w, h - 1 ]);
			}
			ax += t.w + 8;
		}
		// the line under the bar, from a corner of the atlas
		KAGMenuFill(atlas, 0, 0, 4, 4, look.barLine);
		dropAtlas();
		atlasName = "kagex_menubar_" + (++global.KAGElementsScreenSerial);
		ElementsDialog.registerLayerImage(atlasName, atlas);

		var children = [ %[ "type" => "atlas_image", "atlas" => "bar", "rect" => [ 0, 0, 4, 4 ],
			"at" => [ 0, (h - 1) / s, w / s, 1 / s ], "a11y" => %[ "hidden" => 1 ] ] ];
		var vars = %[ "hover" => "" ];
		for (var i = 0; i < titles.count; i++) {
			var t = titles[i], at = [ t.x / s, 0, t.w / s, (h - 1) / s ];
			var frames = %[ "normal" => t.pieces[0], "hilite" => t.pieces[1], "pressed" => t.pieces[1] ];
			var b = %[ "type" => "atlas_button", "atlas" => "bar", "id" => "t" + i, "at" => at, "frames" => frames,
				"focus_hilite" => 1, "vars_on_hover" => %[ "hover" => "" + i ],
				"a11y" => %[ "label" => t.label, "role" => "menu_item" ] ];
			if (!t.enabled) {
				frames["disabled"] = t.pieces[2];
				vars["e_" + i] = "0";
				b["enabled_var"] = "e_" + i;
			}
			children.add(b);
			// the title of the menu that's open stays lit
			vars["open_" + i] = i == openIndex ? "1" : "0";
			children.add(%[ "type" => "atlas_image", "atlas" => "bar", "rect" => t.pieces[1], "at" => at,
				"visible_var" => "open_" + i, "a11y" => %[ "hidden" => 1 ] ]);
		}
		var c = look.barColor;
		var layout = %[
			"size" => [ w / s, h / s ],
			"align" => "top",
			"base" => "window",
			"background" => [ (c >> 16) & 0xff, (c >> 8) & 0xff, c & 0xff, 255 ],
			"atlases" => %[ "bar" => "mem://" + atlasName ],
			"vars" => vars,
			"a11y" => %[ "title" => tr("Menu") ],
			"content" => %[ "type" => "canvas", "width" => w / s, "height" => h / s, "children" => children ]
		];
		if (dialog === void) {
			dialog = new ElementsDialog();
			dialog.onAction = onBarAction;
			dialog.onVar = onBarVar;
		} else {
			// showDict doesn't replace a screen on show: it fails, and the old one stays
			try { dialog.close(); } catch {}
		}
		// a resident bar: the keys stay the game's. Until the window is up the engine has no
		// draw device for it ("no DrawDevice registered"): it tries again in a moment
		if (dialog.showDict(layout, false)) {
			retries = 0;
			retryTimer.enabled = false if retryTimer !== void;
		} else {
			shownKey = "";
			if (++retries > 50) { dm("The menu bar could not be shown"); return; }
			if (retryTimer === void) {
				retryTimer = new Timer(onRetry, "");
				retryTimer.interval = 100;
			}
			retryTimer.enabled = true;
		}
	}
	var retries = 0, retryTimer;

	function onRetry()
	{
		retryTimer.enabled = false;
		update();
	}

	// The menu of title index is open (-1: none)
	function setOpen(index)
	{
		if (index == openIndex) return;
		if (dialog !== void) {
			dialog.setVar("open_" + openIndex, "0") if openIndex >= 0;
			dialog.setVar("open_" + index, "1") if index >= 0;
		}
		openIndex = index;
	}

	// A title clicked: its menu opens (or closes, when it's open), or a top item without a
	// submenu does what it does
	function onBarAction(id, payload)
	{
		if (typeof id != "String" || id.charAt(0) != "t") return;
		defer(window.onMenuBarTitle, [ +id.substring(1) ]);
	}

	// The mouse moved to another title while a menu is open: that one opens
	function onBarVar(name, value)
	{
		if (name != "hover") return;
		hoverIndex = value != "" ? +value : -1;
		if (hoverIndex >= 0 && openIndex >= 0 && hoverIndex != openIndex && hoverIndex < titles.count && titles[hoverIndex].menu)
			defer(window.openMenuDropDown, [ hoverIndex, false ]);
	}

	// The next title (step +1 or -1) from index that has a menu
	function nextMenu(index, step)
	{
		for (var n = 1; n <= titles.count; n++) {
			var i = (index + step * n + titles.count * n) % titles.count;
			if (titles[i].menu && titles[i].enabled) return i;
		}
		return index;
	}

	function firstMenu() { return titles.count > 0 ? nextMenu(titles.count - 1, 1) : -1; }

	// Runs func(args) after the overlay's event (Elements can't take a new screen from inside one)
	function defer(func, args)
	{
		deferred.add([ func, args ]);
		if (deferTrigger === void) {
			deferTrigger = new AsyncTrigger(runDeferred, "");
			deferTrigger.cached = true;
		}
		deferTrigger.trigger();
	}

	function runDeferred()
	{
		while (deferred.count > 0) {
			var d = deferred[0];
			deferred.erase(0);
			d[0](d[1]*);
			if (!(this isvalid)) return;
		}
	}
}

// ------------------------------------------------------------------ the drop-down --

class KAGMenuDropDown extends KAGElementsScreen
{
	var bar;                // the window's KAGMenuBar
	var topIndex;           // the title whose menu this is
	var boxes = [];         // the menus open, outermost first: %[ node, entries, x, y, w, h, focus ]
	var k = 1.0;            // game pixels a screen pixel
	var hoverTimer;
	var hoverTarget;        // [ box, entry ] the mouse rests on

	function KAGMenuDropDown(win, index, byKey)
	{
		super.KAGElementsScreen(win, "Menu");
		bar = win.menuBarView;
		topIndex = index;
		this.byKey = byKey;
		panel.onVar = onPanelVar;
	}
	var byKey;              // opened from the keyboard: its first item is chosen

	function finalize()
	{
		invalidate hoverTimer if hoverTimer !== void;
		if (isvalid window) {
			window.menuDropDown = void if window.menuDropDown === this;
			bar.setOpen(-1) if bar !== void && isvalid bar;
			window.runMenuChoiceLater();
		}
		super.finalize(...);
	}

	function onOpen()
	{
		super.onOpen(...);
		window.menuDropDown = this;
		switchTo(topIndex, byKey);
	}

	// ------------------------------------------------------------- the menus --

	/**
	 * Shows title index's menu (by the keyboard: with its first item chosen)
	 */
	function switchTo(index, keyboard)
	{
		var t = bar.titles[index];
		if (t === void || !t.menu) return close();
		topIndex = index;
		bar.setOpen(index);
		var z = window.zoomNumer / window.zoomDenom;
		k = z > 0 ? 1 / z : 1;
		boxes.clear();
		addBox(t.item, t.x * k, 0, keyboard);
		rebuild();
	}

	// Adds the box of node's items at x, y (game pixels), its first item chosen when keyboard
	function addBox(node, x, y, keyboard)
	{
		var look = KAGMenuLook;
		var list = KAGMenuVisibleItems(window, node), entries = [];
		var textW = 0, shortW = 0, cy = look.boxPad;
		for (var i = 0; i < list.count; i++) {
			var it = list[i];
			if (typeof it == "String") {
				entries.add(%[ separator:true, y:cy, h:look.separatorH ]);
				cy += look.separatorH;
				continue;
			}
			var text = KAGMenuItemText(it);
			var e = %[ item:it, label:text.label, shortcut:text.shortcut, y:cy, h:look.itemH,
				enabled:KAGMenuEnabled(it), sub:KAGMenuHasChildren(window, it) ];
			e.mark = e.sub ? "" : KAGMenuInCheckedGroup(node, it) ? (it.checked ? "radio" : "") : it.checked ? "check" : "";
			textW = Math.max(textW, KAGMenuTextWidth(atlas, e.label, look.itemSize));
			shortW = Math.max(shortW, KAGMenuTextWidth(atlas, e.shortcut, look.shortcutSize)) if e.shortcut != "";
			entries.add(e);
			cy += look.itemH;
		}
		var w = look.gutterLeft + textW + (shortW > 0 ? look.shortcutGap + shortW : 0) + look.gutterRight;
		w = look.minWidth if w < look.minWidth;
		var h = cy + look.boxPad;
		var box = %[ node:node, entries:entries, w:w * k, h:h * k, focus:-1 ];
		// on the screen: flipped to the left of its parent, or moved up, where it would run off
		var sw = width, sh = height;
		if (boxes.count > 0 && x + box.w > sw) {
			var parent = boxes[boxes.count - 1];
			x = parent.x - box.w + 2 * k;
		}
		x = sw - box.w if x + box.w > sw;
		x = 0 if x < 0;
		y = sh - box.h if y + box.h > sh;
		y = 0 if y < 0;
		box.x = x, box.y = y;
		box.focus = firstEntry(box, 0, 1) if keyboard;
		boxes.add(box);
		return box;
	}

	// The first item of box at or after from (step: 1 down, -1 up), wrapping; -1 for none
	function firstEntry(box, from, step)
	{
		var n = box.entries.count;
		for (var i = 0; i < n; i++) {
			var j = ((from + step * i) % n + n) % n;
			if (!box.entries[j].separator) return j;
		}
		return -1;
	}

	function entryId(bi, ei) { return "b" + bi + "_" + ei; }

	// Draws the boxes again (a submenu opened or closed, the focus moved by the mouse)
	function rebuild()
	{
		var look = KAGMenuLook;
		newAtlas();
		for (var bi = 0; bi < boxes.count; bi++) {
			var box = boxes[bi];
			box.piece = addPiece(int(box.w + look.shadow * k) + 1, int(box.h + look.shadow * k) + 1, %[ kind:"box", box:box ]);
			box.separator = addPiece(int(box.w), int(look.separatorH * k), %[ kind:"separator", box:box ]);
			for (var ei = 0; ei < box.entries.count; ei++) {
				var e = box.entries[ei];
				if (e.separator) continue;
				e.pieces = [];
				for (var st = 0; st < 2; st++)
					e.pieces.add(addPiece(int(box.w - 2 * k), int(look.itemH * k), %[ kind:"item", entry:e, over:st == 1 ]));
			}
		}
		var path = buildAtlas();
		var children = [], vars = %[ "hover" => "" ], focusId;
		for (var bi = 0; bi < boxes.count; bi++) {
			var box = boxes[bi];
			children.add(%[ "type" => "atlas_image", "atlas" => "ui", "rect" => rect(box.piece),
				"at" => [ box.x, box.y, box.piece.w, box.piece.h ], "a11y" => %[ "hidden" => 1 ] ]);
			for (var ei = 0; ei < box.entries.count; ei++) {
				var e = box.entries[ei];
				var ey = box.y + e.y * k;
				if (e.separator) {
					children.add(%[ "type" => "atlas_image", "atlas" => "ui", "rect" => rect(box.separator),
						"at" => [ box.x, ey, box.separator.w, box.separator.h ], "a11y" => %[ "hidden" => 1 ] ]);
					continue;
				}
				var id = entryId(bi, ei);
				var frames = %[ "normal" => rect(e.pieces[0]), "hilite" => rect(e.pieces[1]), "pressed" => rect(e.pieces[1]) ];
				var label = e.shortcut != "" ? e.label + " (" + e.shortcut + ")" : e.label;
				var d = %[ "type" => "atlas_button", "atlas" => "ui", "id" => id, "frames" => frames,
					"at" => [ box.x + k, ey, e.pieces[0].w, e.pieces[0].h ], "focus_hilite" => 1,
					"vars_on_hover" => %[ "hover" => id ], "a11y" => %[ "label" => label, "role" => "menu_item" ] ];
				var value = e.sub ? tr("Submenu") : e.mark != "" ? tr("On") : void;
				if (value !== void) {
					vars["v_" + id] = value;
					d["a11y"]["value_var"] = "v_" + id;
				}
				if (!e.enabled) {
					// a disabled item can still be chosen with the keys, but does nothing
					frames["disabled"] = rect(e.pieces[0]);
				}
				children.add(d);
				focusId = id if box.focus == ei;
			}
		}
		var layout = %[
			"size" => [ width, height ],
			"atlases" => %[ "ui" => path ],
			"vars" => vars,
			"a11y" => %[ "title" => bar.titles[topIndex].label ],
			"content" => %[ "type" => "canvas", "width" => width, "height" => height, "children" => children ]
		];
		layout["input"] = %[ "initial_focus" => focusId ] if focusId !== void;
		show(layout);
		a11yName = bar.titles[topIndex].label;
	}

	function drawPiece(p, layer, x, y)
	{
		var look = KAGMenuLook;
		switch (p.kind) {
		case "box":
			var box = p.box, sh = look.shadow * k, b = Math.max(1, int(k + 0.5));
			KAGMenuFill(layer, x + sh, y + sh, box.w, box.h, look.shadowColor);
			KAGMenuFill(layer, x, y, box.w, box.h, look.boxBorder);
			KAGMenuFill(layer, x + b, y + b, box.w - b * 2, box.h - b * 2, look.boxColor);
			break;
		case "separator":
			KAGMenuFill(layer, x + 4 * k, y + int(p.h / 2), p.w - 8 * k, Math.max(1, int(k + 0.5)), look.separatorColor);
			break;
		case "item":
			drawItem(layer, x, y, p);
			break;
		}
	}

	// An item: its mark at the left, the label, the shortcut and a submenu's arrow at the right
	function drawItem(layer, x, y, p)
	{
		var look = KAGMenuLook, e = p.entry;
		var color = e.enabled ? (p.over ? look.hiliteText : look.textColor) : look.disabledText;
		if (p.over) KAGMenuFill(layer, x, y, p.w, p.h, e.enabled ? look.hiliteColor : look.disabledHilite);
		var cy = y + int(p.h / 2);
		if (e.mark == "check") KAGMenuDrawCheck(layer, x + 9 * k, cy - 6 * k, 12 * k, color);
		else if (e.mark == "radio") KAGMenuDrawDot(layer, x + 15 * k, cy, int(4 * k + 0.5), color);
		KAGMenuDrawText(layer, x + look.gutterLeft * k, cy, e.label, int(look.itemSize * k), color);
		var right = x + p.w - look.gutterRight * k;
		if (e.sub) KAGMenuDrawArrow(layer, right + 10 * k, cy, int(12 * k), color);
		if (e.shortcut != "") {
			var size = int(look.shortcutSize * k);
			var sw = KAGMenuTextWidth(layer, e.shortcut, size);
			KAGMenuDrawText(layer, right - sw, cy, e.shortcut, size,
				e.enabled && !p.over ? look.shortcutColor : color);
		}
	}

	// ------------------------------------------------------------------ actions --

	// The entry an id names: [ box, entry ], or void
	function entryOf(id)
	{
		if (typeof id != "String" || id.charAt(0) != "b") return;
		var us = id.indexOf("_");
		var bi = +id.substring(1, us - 1), ei = +id.substring(us + 1);
		if (bi >= boxes.count || ei >= boxes[bi].entries.count) return;
		return [ bi, ei ];
	}

	function onPanelAction(id, payload)
	{
		var at = entryOf(id);
		if (at === void) return;
		defer(activate, [ at[0], at[1], false ]);
	}

	// The mouse rests on an item: the choice follows it, and its submenu opens after a moment
	// (or the submenus past its menu close)
	function onPanelVar(name, value)
	{
		if (name != "hover") return;
		var at = entryOf(value);
		if (at === void) return;
		boxes[at[0]].focus = at[1];
		hoverTarget = at;
		if (hoverTimer === void) {
			hoverTimer = new Timer(onHoverTimer, "");
			hoverTimer.interval = 350;
		}
		hoverTimer.enabled = false;
		hoverTimer.enabled = true;
	}

	function onHoverTimer()
	{
		hoverTimer.enabled = false;
		var at = hoverTarget;
		if (at === void || at[0] >= boxes.count) return;
		var e = boxes[at[0]].entries[at[1]];
		var deeper = boxes.count > at[0] + 1;
		if (deeper && boxes[at[0] + 1].node === e.item) return; // its submenu is the one open
		if (!deeper && !e.sub) return;
		boxes.count = at[0] + 1;
		if (e.sub && e.enabled) openSub(at[0], at[1], false);
		else rebuild();
	}

	// Opens the submenu of entry ei of box bi (from the keyboard: its first item chosen)
	function openSub(bi, ei, keyboard)
	{
		var box = boxes[bi], e = box.entries[ei];
		boxes.count = bi + 1;
		box.focus = ei;
		addBox(e.item, box.x + box.w - 2 * k, box.y + (e.y - KAGMenuLook.boxPad) * k, keyboard);
		rebuild();
	}

	// An item chosen: its submenu opens, or the menu closes and the item does what it does
	function activate(bi, ei, keyboard)
	{
		if (bi >= boxes.count) return;
		var e = boxes[bi].entries[ei];
		if (e === void || e.separator) return;
		if (e.sub) {
			if (!e.enabled) return;
			if (boxes.count > bi + 1 && boxes[bi + 1].node === e.item) {
				// open already: from the keyboard, into it
				if (keyboard) { boxes.count = bi + 2; boxes[bi + 1].focus = firstEntry(boxes[bi + 1], 0, 1); rebuild(); }
				return;
			}
			return openSub(bi, ei, keyboard);
		}
		if (!e.enabled) return;
		window.menuChosen = e.item;
		close();
	}

	// ------------------------------------------------------------------- input --

	// The keys: the arrows and the D-pad move, Return or A chooses, Esc or B goes back a menu
	function onKeyDown(key, shift, process)
	{
		var depth = boxes.count - 1, box = boxes[depth];
		switch (key) {
		case VK_DOWN:
		case VK_UP:
			var step = key == VK_DOWN ? 1 : -1;
			var from = box.focus >= 0 ? box.focus + step : (step > 0 ? 0 : box.entries.count - 1);
			box.focus = firstEntry(box, from, step);
			moveFocus(depth, box.focus);
			return;
		case VK_HOME:
		case VK_END:
			box.focus = firstEntry(box, key == VK_HOME ? 0 : box.entries.count - 1, key == VK_HOME ? 1 : -1);
			moveFocus(depth, box.focus);
			return;
		case VK_RIGHT:
			if (box.focus >= 0 && box.entries[box.focus].sub && box.entries[box.focus].enabled) return activate(depth, box.focus, true);
			return switchTo(bar.nextMenu(topIndex, 1), true);
		case VK_LEFT:
			if (depth > 0) { boxes.count = depth; rebuild(); return; }
			return switchTo(bar.nextMenu(topIndex, -1), true);
		case VK_RETURN:
		case VK_SPACE:
			if (shift & ssRepeat) return;
			if (box.focus >= 0) activate(depth, box.focus, true);
			return;
		case VK_ESCAPE:
			if (shift & ssRepeat) return;
			if (depth > 0) { boxes.count = depth; rebuild(); return; }
			return close();
		case VK_F10:
		case VK_MENU:
			return close();
		}
		keyOutside(key, shift);
	}

	function onKeyUp(key, shift, process) {}

	function moveFocus(bi, ei)
	{
		panel.focus(entryId(bi, ei)) if ei >= 0;
	}

	// A click outside the menus (or a right-click) closes them
	function inBoxes(x, y)
	{
		for (var i = 0; i < boxes.count; i++)
			with (boxes[i]) if (x >= .x && y >= .y && x < .x + .w && y < .y + .h) return true;
		return false;
	}

	function onMouseDown(x, y, button, shift)
	{
		if (button == mbRight || !inBoxes(x, y)) return close();
		super.onMouseDown(...);
	}

	function onMouseUp(x, y, button, shift)
	{
		if (button == mbRight || !inBoxes(x, y)) return;
		super.onMouseUp(...);
	}

	function cancel() { close(); }
	function onPanelClose(action) { defer(close); }
}
