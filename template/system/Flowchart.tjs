		var dx = 0, dy = 0, dw = width, dh = height;
		if (sx < 0) { dx = -sx * zoom; dw -= dx * 2; sw = content.imageWidth; sx = 0; }
		if (sy < 0) { dy = -sy * zoom; dh -= dy * 2; sh = content.imageHeight; sy = 0; }
