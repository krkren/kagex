	}

	// ---- the keys (a controller's D-pad sends the arrows) ----
	function pick(n)
	{
		focusId = n.id;
		if (KAGChartIsNew(n)) { KAGChartNoticed(n); drawContent(); }
		redraw();
		pushA11y();
		if (onPick !== void) KAGBindToGlobal(onPick)(n);
	}

	function moveFocus(n)
	{
		if (n === void) return;
		focusId = n.id;
		if (KAGChartIsNew(n)) { KAGChartNoticed(n); drawContent(); }
