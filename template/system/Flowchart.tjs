	}

	function onMouseUp(x, y, button, shift)
	{
		if (button != mbLeft || !pressed) { super.onMouseUp(...); return; }
		pressed = false;
		if (dragging) {
			dragging = false;
			var now = System.getTickCount(), s = samples[0], dt = now - s[0];
			if (dt > 0 && dt < 150) {
				vx = -(x - s[1]) * 1000.0 / dt / zoom, vy = -(y - s[2]) * 1000.0 / dt / zoom;
				if (Math.abs(vx) + Math.abs(vy) > 80) { lastTick = now; timer.enabled = true; }
