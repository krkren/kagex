// KAGEnvCharacterLive2D.tjs - World characters played by Live2D Cubism models
//
// A character whose envinit.tjs entry has "live2d" is a model made with Live2D's Cubism Editor:
// a .l2d file (the exported folder's contents in a zip, renamed), which the krkrlive2d plugin
// draws each frame into the character's layer (GFX_Live2D.tjs), at the size of its World level.
// Its poses are motions that go on (one of a motion group after another, or one looping), its
// motions play once and go back to the pose, and its faces are the model's expressions or
// values for its parameters. It blinks and lip-syncs to its voice as a character drawn from
// layers does (KAGEnvCharacterEyeLip.tjs): the eyes' level closes its eye parameters, the
// mouth's opens its mouth parameters, and a lip track's vowels shape its mouth form. What it
// shares with VRM characters (poses, motions, faces, commands, waits, its picture's size and
// place) is KAGEnvCharacterModel.tjs.
//
// The face is the World's, not the motions': the parameters the faces name, the eyes' and the
// mouth's take the face's values (the parameter's default where it names none), whatever the
// motion playing does with them, and the motions move the rest (the head, the body, the hair).
// The plugin applies a value added to a parameter right after the main motion, so a copy of the
// model without OpenGL (Live2DModel) plays the same motions, moving on first each frame, and
// what's added is the face's value less what the motion sets in that frame.
// doc/world.txt, "Live2D Characters".
//
//   "hiyori" => %[
//       "voiceFile" => "hiyori%s%06d",
//       "live2d" => %[
//           "model"  => "hiyori",            // hiyori.l2d
//           "canvas" => [2976, 4175],        // the model's canvas, for its shape
//           "height" => 1650,                // the canvas's height on the screen at 100%
//           "poses"  => %[ standard:"Idle" ],
//           "motions" => %[ tap:"TapBody" ],
//           "faces"  => %[ normal:%[], smile:%[ ParamEyeLSmile:1, ParamEyeRSmile:1 ] ],
//           "defaultPose" => "standard",
//           "defaultFace" => "normal",
//           ],
//       ],

// Settings, which Override.tjs can change
// The time between the frames a model is drawn (ms): 33 is 30 a second
var live2dFrameTime = 33;
// The tallest picture drawn: a character taller on the screen is drawn at this and enlarged
var live2dMaxHeight = 2048;
// How long a motion fades in and out, and a face of parameter values into the next (ms)
var live2dMotionFade = 500;
var live2dFaceFade = 300;
// How long the eyes and the mouth take to reach the level they're going to (ms), which turns
// the steps of a blink and of lip-sync into movement: longer than a frame (live2dFrameTime)
var live2dEyeSmooth = 40;
var live2dMouthSmooth = 50;
// The mouth for each vowel of a lip track: how open (of the voice's level) and the mouth form
// (added to the face's mouth form: + wider, - rounder). A model's "vowels" can give its own
var live2dVowels = %[
	a : [1.0,  0.0],
	i : [0.45, 1.0],
	u : [0.35, -0.8],
	e : [0.6,  0.6],
	o : [0.8,  -0.6],
];

/**
 * Whether a model can be drawn here: the krkrlive2d plugin, OpenGL ES and the model's file
 * @param model the model's file name, with or without .l2d
 */
function KAGLive2DCanDraw(model) {
	if (typeof global.KAGLive2DOf == "undefined" || typeof global.kag == "undefined") {
		return false;
	}
	var sys = KAGLive2DOf(kag);
	return sys.available && sys.findModel(model) != "";
}

class KAGEnvCharacterLive2D extends KAGEnvCharacterModel {

	var modelName;       // its model's file name
	var system;          // the window's KAGLive2D
	var player;          // the model playing (Live2DPlayer), made when first drawn
	var shadow;          // its copy without OpenGL (Live2DModel), moved on first with the same motions
	var paramInfo;       // its parameters: id => %[ min, max, default ... ]
	var paramIds;        // their ids by id and by display name (cdi3.json's)
	var faceParams;      // the parameters the World sets: the faces', the eyes' and the mouth's
	var faceTargets = %[]; // the values it last set them to

	var poseMotion;      // the motion of the pose playing (a name in its group)
	var expression = ""; // the model's expression shown

	var eyeValue = 1.0;  // the eyes, 1 open to 0 shut, on their way to eyeLevel
	var mouthOpen = 0.0; // the mouth, 0 shut to 1, on its way to lipLevel
	var mouthForm = 0.0; // its shape (a vowel's)

	var eyeParams;       // the eye parameters blinking closes
	var mouthParams;     // the mouth parameters the voice opens
	var mouthFormParam;  // the parameter vowels shape

	/**
	 * Constructor
	 */
	function KAGEnvCharacterLive2D(env, name, initName, init) {
		var c = init.live2d;
		super.KAGEnvCharacterModel(env, name, initName, init, typeof c == "Object" && c !== null ? c : %[ model:(string)c ]);
		kind = "Live2D";
		modelName = config.model !== void ? (string)config.model : initName;
		if (config.canvas !== void && config.canvas.count >= 2 && +config.canvas[1] > 0) {
			aspect = (real)config.canvas[0] / +config.canvas[1];
		}
		eyeParams = listOf(config.eyes, ["ParamEyeLOpen", "ParamEyeROpen"]);
		mouthParams = listOf(config.mouth, ["ParamMouthOpenY"]);
		mouthFormParam = config.mouthForm !== void ? (string)config.mouthForm : "ParamMouthForm";
		setFaceValues(true);
	}

	function frameTime() { return live2dFrameTime; }
	function faceFadeTime() { return live2dFaceFade; }
	function maxPictureHeight() { return live2dMaxHeight; }

	function modelReady() { return player !== void; }

	// Lets go of the model; it's read again on the next draw (its picture, its GL objects)
	function releaseModel() {
		if (player !== void) {
			if (system !== void && isvalid system) {
				system.releasePlayer(player);
			} else {
				try { invalidate player; } catch {}
			}
			player = void;
		}
		if (shadow !== void) {
			try { invalidate shadow; } catch {}
			shadow = void;
		}
		poseMotion = void;
	}

	// ----------------------------------------------------------------
	// Poses, motions and faces
	// ----------------------------------------------------------------

	/**
	 * A motion spec's motions, by name: "<group>", every motion of the model3.json group (one of
	 * them at random each time); "<group>:<n>" its n-th (from 0); "<group>:<name>" or ":<name>" the
	 * motion of that file name (motions/<name>.motion3.json, as the plugin keeps them)
	 */
	function motionNames(spec) {
		return live2dMotionNames(player, spec); // GFX_Live2D.tjs
	}

	// a pose's motion loops when it's one of its own; a group's play one after another
	function startMotion(spec, asPose) {
		var names = motionNames(spec);
		return playMotion(names, asPose && names.count == 1);
	}

	function motionPlaying() {
		return player.isPlaying("main");
	}

	/**
	 * Starts one of the motions (by name) as the model's main motion; true when there was one
	 */
	function playMotion(names, loop) {
		if (names.count == 0) return false;
		var motion = names[0];
		if (names.count > 1) {
			// at random, but not the one playing again (unless the group is only that one)
			for (var tries = 0; tries < 8; tries++) {
				motion = names[(int)(Math.random() * names.count)];
				if (motion != poseMotion) break;
			}
		}
		// the plugin fades over its default for 0, so no fade is a very short one
		var fade = live2dMotionFade > 0 ? live2dMotionFade / 1000.0 : 0.001;
		player.startMotion("main", motion, loop ? 1 : 0, fade, fade);
		// a motion the model doesn't have leaves the one before playing
		var current = player.getCurrentMotions();
		var started = false;
		for (var i = 0; current !== void && i < current.count; i++) {
			started = true if current[i] !== void && current[i].name == "main." + motion;
		}
		if (!started) {
			noMotion(motion);
			return false;
		}
		shadow.startMotion("main", motion, loop ? 1 : 0, fade, fade);
		poseMotion = motion;
		return true;
	}

	/**
	 * The parameter values of a face: %[ parameter:value ], its "expression" left out. The value
	 * of an eye parameter is how open the eyes are (1 the model's open eyes, 0 shut), of another
	 * the parameter's value
	 */
	function faceValuesOf(faceName) {
		var spec = faceSpec(faceName);
		var ret = %[];
		if (typeof spec == "Object" && spec !== null) {
			(Dictionary.assign incontextof ret)(spec, false);
			delete ret.expression;
		}
		return idValues(ret);
	}

	// a parameter's id, for its id or its display name (as it is until the model is read)
	function paramIdOf(param) {
		var id = paramIds !== void ? paramIds[param] : void;
		return id !== void ? id : param;
	}

	function idValues(values) {
		if (paramIds === void) return values;
		var ret = %[];
		var keys = [];
		keys.assign(values);
		for (var i = 0; i < keys.count; i += 2) ret[paramIdOf(keys[i])] = keys[i + 1];
		return ret;
	}

	function faceExpressionOf(faceName) {
		var spec = faceSpec(faceName);
		if (typeof spec == "String") return spec;
		if (typeof spec == "Object" && spec !== null && spec.expression !== void) return (string)spec.expression;
		return "";
	}

	// whether a parameter is one the eyes' blinking closes: a face's value for it is how open
	// the eyes are (1 open, 0 shut), not the parameter's value
	function isEyeParam(param) {
		return eyeParams.find(param) >= 0;
	}

	// whether a parameter is one the voice opens
	function isMouthParam(param) {
		return mouthParams.find(param) >= 0;
	}

	// a parameter's value with no face: its default, or how open the eyes are (1)
	function noFaceValue(param) {
		if (isEyeParam(param)) return 1.0;
		var info = paramInfo !== void ? paramInfo[param] : void;
		return info !== void ? +info["default"] : 0.0;
	}

	// a load shows the face's expression again
	function restoreModel() {
		expression = "";
	}

	// ----------------------------------------------------------------
	// Drawing
	// ----------------------------------------------------------------

	/**
	 * Makes the model's player: true, or false with failed saying why
	 */
	function prepareModel() {
		if (typeof global.KAGLive2DOf == "undefined") {
			failed = "GFX_Live2D.tjs isn't loaded (gfxLive2DEnabled)";
			return false;
		}
		system = KAGLive2DOf(env.window);
		if (!system.available) {
			failed = system.reason;
			return false;
		}
		var file = system.findModel(modelName);
		if (file == "") {
			failed = @"its model ${modelName}.l2d isn't there";
			return false;
		}
		player = system.newPlayer(file);
		if (player === void) {
			failed = @"its model ${file} can't be read";
			return false;
		}
		shadow = system.newShadow(file);
		if (shadow === void) {
			failed = @"its model ${file} can't be copied";
			return false;
		}
		// its parameters, and those the World sets: the faces', the eyes' and the mouth's
		paramInfo = %[];
		paramIds = %[];
		var infos = [];
		for (var i = 0; i < shadow.getParameterCount(); i++) {
			var info = shadow.getParameterInfo(i);
			if (info !== void && info.id !== void) {
				paramInfo[info.id] = info;
				paramIds[info.id] = info.id;
				infos.add(info);
			}
		}
		for (var i = 0; i < infos.count; i++) {
			var n = infos[i].name;
			paramIds[n] = infos[i].id if n !== void && n != "" && paramIds[n] === void;
		}
		// the settings and the faces by id
		for (var i = 0; i < eyeParams.count; i++) eyeParams[i] = paramIdOf(eyeParams[i]);
		for (var i = 0; i < mouthParams.count; i++) mouthParams[i] = paramIdOf(mouthParams[i]);
		mouthFormParam = paramIdOf(mouthFormParam);
		faceFrom = idValues(faceFrom);
		faceTo = idValues(faceTo);
		var names = %[];
		var add = function(list, names) {
			for (var i = 0; i < list.count; i++) names[list[i]] = true if paramInfo[list[i]] !== void;
		} incontextof this;
		add(eyeParams, names);
		add(mouthParams, names);
		add([ mouthFormParam ], names);
		var faces = [];
		faces.assign(config.faces) if config.faces !== void;
		for (var i = 1; i < faces.count; i += 2) {
			var values = [];
			values.assign(faceValuesOf(faces[i - 1]));
			for (var j = 0; j < values.count; j += 2) add([ values[j] ], names);
		}
		faceParams = [];
		faceParams.assign(names);
		for (var i = faceParams.count - 1; i >= 0; i -= 2) faceParams.erase(i);
		// the World blinks its eyes and opens its mouth, not the model by itself
		player.setBlinkingMode(0);
		player.setVoiceValue(0);
		poseMotion = void;
		expression = "";
		return true;
	}

	/**
	 * Moves the model on to tick: its motions, its face, its eyes and mouth
	 */
	function step(tick) {
		var dt = lastStep !== void ? tick - lastStep : 0;
		dt = 0 if dt < 0;
		dt = 100 if dt > 100; // after a pause, from where it was
		lastStep = tick;

		// motions: one played once, else the pose's, another of its group when one ends
		stepMotions();

		// the copy moves on first: what the motions set in this step
		shadow.progress(dt);

		// the face: the model's expression, and its parameters' values
		var exp = faceExpressionOf(face);
		if (exp != expression) {
			player.setExpression(exp);
			expression = exp;
		}
		var values = currentFaceValues(tick);
		faceStart = void if faceStart !== void && tick - faceStart >= live2dFaceFade;

		// the eyes, closed by the blink, and the mouth, as open as the voice (lipLevel) and shaped
		// like its vowel
		var eyeTarget = eyeLevel !== void ? eyeLevel / 2.0 : 1.0;
		eyeValue = approach(eyeValue, eyeTarget, dt, live2dEyeSmooth);
		var shapes = config.vowels !== void ? config.vowels : global.live2dVowels;
		var shape = lipVowel !== void ? shapes[lipVowel] : void;
		var level = lipLevel !== void ? lipLevel : 0;
		var openTarget = level / 2.0 * (shape !== void ? +shape[0] : 1.0);
		var formTarget = level > 0 && shape !== void ? +shape[1] : 0.0;
		mouthOpen = approach(mouthOpen, openTarget, dt, live2dMouthSmooth);
		mouthForm = approach(mouthForm, formTarget, dt, live2dMouthSmooth);

		// each of the World's parameters: its value less the motion's, added after the motion
		for (var i = 0; i < faceParams.count; i++) {
			var p = faceParams[i];
			var info = paramInfo[p];
			var v = values[p] !== void ? +values[p] : noFaceValue(p);
			if (isEyeParam(p)) {
				v = +info["default"] * v * eyeValue;
			} else if (isMouthParam(p)) {
				v += (+info.max - v) * mouthOpen;
			} else if (p == mouthFormParam) {
				v += mouthForm;
			}
			v = +info.min if v < +info.min;
			v = +info.max if v > +info.max;
			faceTargets[p] = v;
			player.setDiffParameterValue(p, v - shadow.getParameterValue(p));
		}

		player.progress(dt);
	}

	/**
	 * Draws the model into a picture the size of its canvas at the character's level
	 */
	function renderModel(layer) {
		system.render(layer, player);
	}

	/**
	 * Mouths by vowel: a model's mouth form takes a lip track's vowels
	 */
	function faceHasVowels() {
		return mouthFormParam != "";
	}
};
