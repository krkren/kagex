		for (var i = 0; i < scene.choices.count; i++) {
			var c = scene.choices[i];
			if (c.type != type) warn("[" + elm.tagname + "] with choices of the other kind");
			c.type = type;
			scene.nexts.add(c);
			addExit(c.storage, c.target);
		}
		scene.choices.clear();
		scene.closed = true;
		markDead();
	}

	// ------------------------------------------------------------------
	// Text, as KAG puts it together in each line mode (MainWindow.tjs)
	// ------------------------------------------------------------------

	function setLineMode(mode) {
		switch (mode) {
		case "page": lineMode = LINEMODE_PAGE; break;
		case "line": lineMode = LINEMODE_LINE; break;
		case "vn":   lineMode = LINEMODE_VN;   break;
		case "tex":  lineMode = LINEMODE_TEX;  break;
		case "free": lineMode = LINEMODE_FREE; break;
		default:     lineMode = LINEMODE_NONE; break;
		}
		if (tok !== void) tok.ignoreCR = lineMode == LINEMODE_NONE ? global.ignoreCR : false;
		afterPage = true;
		doLine = false;
		emptyLine = true;
		commandLine = false;
		prevEmptyLine = true;
		nameMode = 0;
		afterName = false;
	}

	function setCrAfterName(mode) {
		crAfterName = mode !== void && mode != "false" && mode != "0" && mode != "";
		afterName = false;
	}

	function lineCheck() {
		if (doLine) {
			parseL();
			doLine = false;
		}
	}

	function emptyCheck() {
		switch (lineMode) {
		case LINEMODE_PAGE:
			break;
		case LINEMODE_LINE:
		case LINEMODE_VN:
		case LINEMODE_FREE:
			if (afterPage) afterPage = false;
			else if (!afterName) textR();
			break;
		case LINEMODE_TEX:
			if (afterPage) afterPage = false;
			break;
		}
		if (!afterName && (lineMode <= LINEMODE_LINE || prevEmptyLine)) {
			textName();
			afterName = true;
		}
	}

	function parseCh(elm) {
		var t = elm.text;
		if (nameMode > 0) {
			// 【name/display name】
			if (t == "】") {
				nameMode = 0;
				setNextVoice(nameStr);
				var voices;
				if (nextVoiceList.count > 0) {
					voices = nextVoiceList;
					nextVoiceList = [];
				}
				textName(nameStr, nameDisp, voices);
				afterName = true;
			} else if (nameMode == 1) {
				if (t == "/") nameMode = 2;
				else nameStr += t;
			} else {
				nameDisp += t;
			}
			return;
		} else if (emptyLine) {
			lineCheck();
			if (t == "【") {
				nameMode = 1;
				nameStr = "";
				nameDisp = "";
				return;
			}
			emptyCheck();
		}
		textCh(t);
		emptyLine = false;
		afterPage = false;
		afterName = false;
	}

	function parseR(elm) {
		if (elm.eol === void) {
			if (doLine) {
				parseL();
				doLine = false;
			}
			checkName();
			textR();
			return;
		}
		if (noCrOnce) {
			noCrOnce = false;
			prevEmptyLine = emptyLine;
			emptyLine = true;
			commandLine = false;
			return;
		}
		nameMode = 0;
		if (crAfterName && afterName) {
			commandLine = false;
			return;
		}
		switch (lineMode) {
		case LINEMODE_PAGE:
			if (emptyLine) {
				if (!commandLine) prevEmptyLine = emptyLine;
			} else {
				prevEmptyLine = emptyLine;
				emptyLine = true;
				textWait(0);
			}
			break;
		case LINEMODE_LINE:
			if (emptyLine) {
				if (!commandLine) prevEmptyLine = emptyLine;
			} else {
				prevEmptyLine = emptyLine;
				emptyLine = true;
				parseL();
			}
			break;
		case LINEMODE_VN:
			if (emptyLine) {
				if (!prevEmptyLine) {
					if (!commandLine) {
						doLine = false;
						prevEmptyLine = emptyLine;
						parseP();
					}
				} else {
					prevEmptyLine = emptyLine;
				}
			} else {
				prevEmptyLine = emptyLine;
				emptyLine = true;
				doLine = true;
			}
			break;
		case LINEMODE_TEX:
		case LINEMODE_FREE:
			if (emptyLine) {
				if (!commandLine) {
					if (!prevEmptyLine) {
						prevEmptyLine = emptyLine;
						parseP();
					} else {
						prevEmptyLine = emptyLine;
					}
				}
			} else {
				prevEmptyLine = emptyLine;
				emptyLine = true;
			}
			break;
		}
		commandLine = false;
	}

	// The [l] a line mode adds at the end of a line
	function parseL() {
		textWait(SCN_TEXTFLAG_LINE);
	}

	// An [l] in the script
	function parseL2(elm) {
		textInlineWait();
	}

	function parseP(elm) {
		textWait(0);
		afterPage = true;
		emptyLine = true;
		commandLine = false;
		nameStr = "";
		nameDisp = "";
	}

	function checkName() {
		if (emptyLine) {
			lineCheck();
			emptyCheck();
		}
		emptyLine = false;
		afterPage = false;
		afterName = false;
	}

	function parseRuby(elm) {
		checkName();
		textRuby(elm.text);
	}

	// ------------------------------------------------------------------
	// Voices (MainWindow.tjs setVoice/getVoice)
	// ------------------------------------------------------------------

	function parseParse(elm) {
		(Dictionary.clear incontextof voiceMap)();
		nextVoiceList = [];
		if (elm.base !== void) setVoiceBase(elm.base);
		if (elm.voice !== void) voiceDefault = +elm.voice;
	}

	function setVoiceBase(base) {
		voiceBase = base;
		// KAG keeps the base where the World reads it when playing a voice
		emitStep([ "eval", 0, "exp", "kag.voiceBase = \"" + ((string)base).escape() + "\"" ]);
	}

	function parseVoice(elm) {
		var a = [];
		a.assign(elm);
		for (var i = 0; i < a.count; i += 2) {
			var name = a[i], value = a[i + 1];
			switch (name) {
			case "tagname": case "replace": case "once": case "entry": case "taglist":
				continue;
			case "base":
				setVoiceBase(value);
				continue;
			case "default":
				voiceDefault = value;
				continue;
			}
			if (name.charAt(0) == "_") continue;
			setVoice(name, value, elm);
		}
	}

	function parseNextVoice(elm) {
		setNextVoice(elm.name);
	}

	function setVoice(name, voice, elm) {
		var info = voiceMap[name];
		if (info === void) {
			info = %[];
			voiceMap[name] = info;
		}
		voice = (string)voice;
		if (voice.charAt(0) == "@") {
			if (info.voice !== void) info.voice += +voice.substr(1);
			else info.voice = +voice.substr(1);
		} else if (voice == "clear") {
			delete info.strVoice;
			delete info.voice;
			delete info.incVoice;
		} else if (voice == "dec") {
			info.voice-- if info.voice !== void;
		} else if (voice == "count" || voice == "inc") {
			info.voice++ if info.voice !== void;
		} else if (voice == "ignore") {
			info.strVoice = "ignore";
		} else if (/^[1-9][0-9]*$/.test(voice) || voice == "0") {
			if (elm.once || elm.replace) info.strVoice = +voice;
			else info.voice = +voice;
		} else if (voice.length > 0) {
			info.strVoice = voice;
		}
		info.incVoice = elm.incvoice || elm.replace;
		info.noplayvoice = elm.noplayvoice;
	}

	function getVoice(name) {
		if (name == "") return;
		var info = voiceMap[name];
		if (info === void && voiceDefault !== void) {
			info = %[];
			voiceMap[name] = info;
			info.voice = voiceDefault;
		}
		var voice;
		if (info !== void) {
			if (info.strVoice !== void) {
				if (info.strVoice != "ignore") voice = info.strVoice;
				info.strVoice = void;
			} else if (info.voice !== void) {
				voice = info.voice;
				info.incVoice = true;
			}
			if (info.incVoice) {
				info.voice++ if info.voice >= 0;
				info.incVoice = void;
			}
		}
		return voice;
	}

	function setNextVoice(name) {
		var voice = getVoice(name);
		if (voice !== void) {
			var info = voiceMap[name];
			var v = %[ name:name, voice:voice ];
			v.noplayvoice = info.noplayvoice if info !== void && info.noplayvoice !== void;
			nextVoiceList.add(v);
		}
	}
}
