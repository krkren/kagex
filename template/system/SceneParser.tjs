	function controlStep(name, elm, exp) {
		var step = [ name, 0 ];
		if (exp !== void) step.push("exp", exp);
		if (elm.__mp !== void && exp !== void && /\bmp\b/.test(exp)) {
			var mp = %[];
			(Dictionary.assign incontextof mp)(elm.__mp);
			step.push("*mp", mp);
		}
		return step;
	}

	function control(elm) {
		var name = elm.tagname;
		if (dead) {
			// unreachable: follow the [if] structure to where it can be reached again
			switch (name) {
			case "if": case "ignore":
