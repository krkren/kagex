				  prevEmptyLine:prevEmptyLine, nameMode:nameMode, afterName:afterName, nameStr:nameStr,
				  nameDisp:nameDisp, voiceBase:voiceBase, voiceDefault:voiceDefault, voiceMap:vm,
				  nextVoiceList:nv, pendingName:pendingName, lastName:lastName, lastDisp:lastDisp,
				  ignoreCR:tok.ignoreCR ];
