	// ------------------------------------------------------------------
	// Tags
	// ------------------------------------------------------------------

	function processTag(elm) {
		var name = elm.tagname;
		// KAGParser handles these itself, so the line modes never see them
		switch (name) {
		case "if": case "ignore": case "elsif": case "else": case "endif": case "endignore":
			control(elm);
			return;
