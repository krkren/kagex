	// The tag's attributes as the World gets them: tagname first, then in order. Entities are
	// worked out now, from the values they have while compiling
	function envElm(elm) {
		var e = %[ tagname:elm.tagname ];
		var attrs = elm.__attrs;
		for (var i = 0; i < attrs.count; i += 2) {
