						elm.tagname, name, attrs[i + 1], ex.message));
					continue;
				}
			}
			e[name] = v;
		}
		return e;
	}

	function command(elm) {
		var name = elm.tagname;
		switch (name) {
		case "seladd":
			addChoice(elm, 1);
			return;
		case "mseladd":
			addChoice(elm, 2);
			return;
		case "select": case "mselect":
			select(elm);
			return;
		case "scenestart": case "scenestarttext": case "sceneplay": case "scenecheck":
			error("[" + name + "] can't be used in a compiled scenario");
		case "linemode":
			setLineMode(elm.mode);
			break;
		case "craftername":
			setCrAfterName(elm.mode);
			break;
		}
		emitStep(makeStep(elm));
		if (elm.__cond !== void) {
			if (isWorldTag(name)) warn("[" + name + "] has cond=, so the saved state doesn't include what it does");
		} else if (name == "clearlayers") {
			// clearing the front page clears the World's layers too (KAGEnvironment.onClear)
			if (elm.page != "back") env.onClear();
		} else if (isWorldTag(name)) {
			runWorld(elm);
		}
		emitSFlags();
	}

	function isWorldTag(name) {
		return typeof kag.tagHandlers[name] == "undefined";
	}

	// Collects the tags [allchar] and the like expand into
	var expanded = [];
	function addTag(name, elm) {
		var e = %[];
		(Dictionary.assign incontextof e)(elm, false) if elm !== void;
		e.tagname = name;
		expanded.add(e);
	}

	// Runs a World tag in the headless World
	function runWorld(elm) {
		var name = elm.tagname;
		var e = envElm(elm);
		try {
			switch (name) {
			case "dellay": case "dellayer":
				env.delLayer(e);
				break;
			case "delchar":
				env.delCharacter(e);
				break;
			case "allchar": case "alllayer": case "allfore": case "allbase": case "allimage": case "allse":
				expanded.clear();
				env[name](e, this);
				var list = [];
				list.assign(expanded);
				expanded.clear();
				for (var i = 0; i < list.count; i++) {
					var t = list[i].tagname;
					if (t != "begintrans" && t != "endtrans") worldUnknown(t, list[i]);
				}
				break;
			case "begintrans": case "endtrans": case "beginenvtrans": case "msgon": case "msgoff":
			case "twait": case "showtwait": case "*": case "laytrans": case "alltrans": case "breaktrans":
			case "wchvoice":
