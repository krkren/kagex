				break;
			}
		} catch (ex) {
			warn("[" + name + "]: " + ex.message);
		}
	}

	function worldUnknown(name, e) {
		var init = env.characterInits[name];
		if (init !== void) {
			// voices are the compiler's (KAGEnvironment.unknown sets KAG's)
			if (e.voice !== void) {
				setVoice(name, e.voice, e) if init.noVoice === void;
				delete e.voice;
			}
			if (e.nextvoice !== void) {
