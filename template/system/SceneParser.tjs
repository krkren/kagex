		crAfterName = s.crAfterName;
		noCrOnce = s.noCrOnce;
		noErOnce = s.noErOnce;
		afterPage = s.afterPage;
		doLine = s.doLine;
		emptyLine = s.emptyLine;
		commandLine = s.commandLine;
		prevEmptyLine = s.prevEmptyLine;
		nameMode = s.nameMode;
		afterName = s.afterName;
		nameStr = s.nameStr;
		nameDisp = s.nameDisp;
		voiceBase = s.voiceBase;
		voiceDefault = s.voiceDefault;
		(Dictionary.clear incontextof voiceMap)();
