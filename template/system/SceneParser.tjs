			case "ch": parseCh(elm); return;
			case "r": parseR(elm); return;
			case "p": parseP(elm); return;
			case "l": parseL2(elm); return;
			case "nor": noCrOnce = true; return;
			case "noer": noErOnce = true; return;
			case "ruby": parseRuby(elm); return;
			case "nul": checkName(); return;
			}
