// SceneParser.tjs - compiles KAG scenarios into scenes for the scene player (KAGEnvPlayer.tjs)
//
// A script listed in !scnlist.txt is compiled into <script>.scn (a PSB file, written by the
// scnfile plugin's SCNFile), or <script>.scn.json without the plugin or with format=json in
// parseroption.txt, next to the script. The player reads that instead of the script: text, names and voices as a table, the tags as
// steps, and the World's state at every save point, so it can start at any line, roll back
// and skip to unread text. See doc/scn.txt for what is compiled and how, and the format.
//
// The compiler reads the script with a tokenizer of its own rather than KAGParser, which
// evaluates [if], cond= and & entities while it parses: here those stay runtime decisions.
// Macros are expanded as KAG does, from parsermacro.ks (or the game's macros without it).
// World tags are run through the player's headless World (KAGEnvForParse) to record its
// state; every other tag is kept as a step for the game to run.
//
// A script starts from the World another listed script leaves when it goes there (a [jump]
// or a choice to its start): its entry state. Each compiled file records where it goes and
// the World then (exits); a script reached that way from scripts that all leave the same
// World starts from it, otherwise from an empty World. compileAll compiles a script again
// when its entry state has changed, until they all hold (entryFor, doc/scn.txt).
//
// A game in more than one language (KAGLanguageList, Language.tjs) has its other languages
// built into each compiled file, as Wamsoft's multi-language games do: each script's
// translation into a language, lang/<code>/scenario/<script> (a copy of the script with the
// text in that language), is compiled too, and its texts, display names, choices and titles go
// into the script's, scene by scene (addLanguages, doc/scn.txt "Languages").

// Text flags (KAGEnvPlayer.TEXTFLAG_*)
var SCN_TEXTFLAG_LINE   = 0x01;
var SCN_TEXTFLAG_NOER   = 0x02;
var SCN_TEXTFLAG_NOWAIT = 0x04;
var SCN_TEXTFLAG_EVENT  = 0x08;
var SCN_TEXTFLAG_STAGE  = 0x10;
var SCN_TEXTFLAG_NOTEXT = 0x20;
var SCN_TEXTFLAG_CONT   = 0x40;

// Compiled format version, part of every compiled file's source key (2: exits and entry; 3: a
// game's other languages in its texts, choices and titles)
var SCN_FORMAT_VERSION = 3;

// FNV-1a over a string, as 8 hex digits
function scnHashString(s)
{
	var h = 0x811c9dc5;
	var l = s.length;
	for (var i = 0; i < l; i++) {
		h = ((h ^ #s.charAt(i)) * 16777619) & 0xffffffff;
	}
	return "%08x".sprintf(h);
}

/**
 * A compiled text as plain text: without its escapes (\\, \%, \[ and \k), font commands
 * (%<size>, %r) and ruby, new lines as spaces. With ruby, what is read out: each ruby in place
 * of the characters it goes with ([ruby] before one character, [ruby,n] before n + 1, as the
 * scene player draws them)
 */
function scnPlainText(t, ruby = false)
{
	var l = t.length, ret = "", i = 0, covered = 0;
	while (i < l) {
		var ch = t.charAt(i++);
		if (ch == "\\") {
			ch = i < l ? t.charAt(i++) : "";
			if (ch != "\\" && ch != "%" && ch != "[") continue;
		} else if (ch == "%") {
			if (i < l && /[0-9]/.test(t.charAt(i))) {
				while (i < l && /[0-9]/.test(t.charAt(i))) i++;
			} else {
				i++;
			}
			continue;
		} else if (ch == "[") {
			var r = "";
			while (i < l && (ch = t.charAt(i++)) != "]") r += ch;
			if (ruby) {
				var p = r.indexOf(",");
				covered = (p >= 0 ? +r.substr(p + 1) : 0) + 1;
				ret += p >= 0 ? r.substr(0, p) : r;
			}
			continue;
		} else if (ch == "\n") {
			ch = " ";
		}
		if (covered > 0) {
			covered--;
			continue;
		}
		ret += ch;
	}
	return ret;
}

// A text's entry for one language, as Wamsoft's multi-language scenes have it: [display name,
// text, length, speech text (ruby read out), search text (as it's shown)]
function scnLanguageEntry(disp, text)
{
	var search = scnPlainText(text);
	return [ disp, text, search.length, scnPlainText(text, true), search ];
}

// A choice's text in one language: %[text, speechtext, searchtext, textlength]
function scnChoiceEntry(text)
{
	var shown = text.charAt(0) == "@" ? text.substr(1) : text; // @: a choice without a frame
	var search = scnPlainText(shown);
	return %[ text:text, speechtext:scnPlainText(shown, true), searchtext:search, textlength:search.length ];
}

/**
 * Reads a KAG scenario into tags the way KAGParser does, except that [if]/[elsif]/[else]/
 * [endif]/[ignore]/[endignore], [jump]/[call]/[return] and [emb] come back as tags, cond= is
 * returned instead of evaluated, and & entities keep their expression. Macros are expanded
 * like KAGParser's ([macropop] ends each one). Labels and [iscript] blocks go to the owner
 * (onScnLabel, onScnScript) as they're passed.
 *
 * A returned tag is a dictionary: tagname, the attributes, and
 *   __attrs  the attribute names and values in order ([name, value, ...]; values as given,
 *            entities as "&expression")
 *   __ent    names of attributes that are & entities (a dictionary)
 *   __cond   the cond= expression, if any
 *   __mp     the macro's arguments, if the tag came from a macro
 *   __line   its line (0-based)
 */
class SceneTokenizer
{
	var owner;
	var storage;
	var lines = [];
	var labelAliases = [];
	var lineCount = 0;
	var curLine = 0;
	var lineStr = "";
	var pos = 0;
	var bufferUsing = false;
	var ignoreCR = true;
	var macros;
	var macroArgs = [];
	var recording = false;
	var recordName;
	var recordStr;
	var tagLine = 0;
	var pending = []; // tags to return before reading on (a macro's cond)

	function SceneTokenizer(owner, macros) {
		this.owner = owner;
		this.macros = macros;
	}

	function finalize() {
	}

	function error(msg) {
		throw new Exception("%s(%d): %s".sprintf(storage, tagLine + 1, msg));
	}

	function load(storage) {
		this.storage = storage;
		lines.load(storage);
		lineCount = lines.count;
		for (var i = 0; i < lineCount; i++) {
			var l = lines[i];
			if (i == 0 && l.charAt(0) == $0xFEFF) l = l.substr(1); // a BOM
			var t = 0;
			while (l.charAt(t) == "\t") t++;
			lines[i] = t > 0 ? l.substr(t) : l;
		}
		// label names as KAGParser makes them: a duplicate becomes name:2, name:3...
		labelAliases.clear();
		var counts = %[], prev = "";
		for (var i = 0; i < lineCount; i++) {
			var l = lines[i];
			if (l.length >= 2 && l.charAt(0) == "*") {
				var vl = l.indexOf("|");
				var label = vl >= 0 ? l.substr(0, vl) : l;
				if (label.length == 1) {
					if (prev == "") { tagLine = i; error("the first label can't omit its name"); }
					label = prev;
				}
				prev = label;
				if (counts[label] !== void) {
					counts[label]++;
					label = label + ":" + counts[label];
				} else {
					counts[label] = 1;
				}
				labelAliases[i] = label;
			}
		}
		curLine = 0;
		pos = 0;
		bufferUsing = false;
		lineStr = "";
		macroArgs.clear();
		pending.clear();
		recording = false;
	}

	property macroDepth { getter() { return macroArgs.count; } }

	// Skips comments, passes labels and [iscript] blocks; false at the end
	function skipCommentOrLabel() {
		pos = 0;
		for (; curLine < lineCount; curLine++) {
			var p = lines[curLine];
			var c = p.charAt(0);
			if (c == ";") continue;
			if (c == "*") {
				tagLine = curLine;
				if (recording) error("a label can't be inside a macro");
				var vl = p.indexOf("|");
				var label = labelAliases[curLine];
				if (label === void) label = p;
				owner.onScnLabel(label, vl >= 0 ? p.substr(vl + 1) : void, curLine);
				continue;
			}
			if (p == "[iscript]" || p == "[iscript]\\" || p == "@iscript") {
				tagLine = curLine;
				if (recording) error("[iscript] can't be inside a macro");
				var start = curLine + 1;
				var script = "";
				for (curLine++; curLine < lineCount; curLine++) {
					p = lines[curLine];
					if (p == "[endscript]" || p == "[endscript]\\" || p == "@endscript") break;
					script += p + "\n";
				}
				if (curLine >= lineCount) error("[iscript] without [endscript]");
				owner.onScnScript(script, start);
				continue;
			}
			break;
		}
		if (curLine >= lineCount) return false;
		lineStr = lines[curLine];
		bufferUsing = false;
		return true;
	}

	function nextLine() {
		curLine++;
		pos = 0;
		bufferUsing = false;
		lineStr = "";
	}

	function isWS(c) {
		return c == " " || c == "\t";
	}

	function getNextTag() {
		if (pending.count > 0) return pending.shift();
		while (true) {
			if (curLine >= lineCount) {
				if (recording) error("[macro] without [endmacro]");
				return void;
			}
			if (!bufferUsing && pos == 0) {
				if (!skipCommentOrLabel()) {
					if (recording) error("[macro] without [endmacro]");
					return void;
				}
			}
			var len = lineStr.length;
			if (!ignoreCR) {
				if ((lineStr.charAt(pos) == "\\" && pos + 1 == len) ||
					(pos >= len && pos >= 3 && lineStr.substr(pos - 3, 3) == "[p]")) {
					// a line ending with \ or [p] doesn't end with a new line
					nextLine();
					continue;
				}
				if (pos >= len) {
					tagLine = curLine;
					nextLine();
					if (recording) {
						recordStr += "[r eol=true]";
						continue;
					}
					return %[tagname:"r", eol:"true", __line:tagLine];
				}
			}
			var ldelim;
			if (!bufferUsing && pos == 0 && lineStr.charAt(0) == "@") {
				ldelim = ""; // a line command
			} else {
				var c = lineStr.charAt(pos);
				if (c != "[" || lineStr.charAt(pos + 1) == "[") {
					tagLine = curLine;
					if (pos >= len) {
						nextLine();
						continue;
					}
					if (c == "\t") {
						pos++;
						continue;
					}
					var ret;
					if (c != "\n") {
						ret = %[tagname:"ch", text:c, __line:tagLine];
						if (recording) recordStr += (c == "[" ? "[[" : c);
					} else {
						ret = %[tagname:"r", __line:tagLine];
						if (recording) recordStr += "[r]";
					}
					pos += (c == "[") ? 2 : 1;
					if (!recording) return ret;
					continue;
				}
				ldelim = "]";
			}
			var tag = readTag(ldelim);
			if (tag !== void) return tag;
		}
	}

	// Moves past the end of a tag
	function stepNext(ldelim) {
		if (ldelim == "") nextLine();
		else pos++;
	}

	// Reads a tag at pos: the tag to return, or void to read on
	function readTag(ldelim) {
		tagLine = curLine;
		var tagstartpos = pos;
		var len = lineStr.length;
		pos++;
		while (pos < len && isWS(lineStr.charAt(pos))) pos++;
		if (pos >= len) error("syntax error in a tag");
		var namestart = pos;
		while (pos < len && !isWS(lineStr.charAt(pos)) && lineStr.charAt(pos) != ldelim) pos++;
		if (pos == namestart) error("a tag without a name");
		var tagname = lineStr.substr(namestart, pos - namestart).toLowerCase();

		var elm = %[tagname:tagname];
		var attrs = [];
		var ent = %[];
		var cond;
		var top = macroArgs.count > 0 ? macroArgs[macroArgs.count - 1] : void;

		while (true) {
			while (pos < len && isWS(lineStr.charAt(pos))) pos++;
			if ((ldelim == "" && pos >= len) || (ldelim != "" && lineStr.charAt(pos) == ldelim)) break;
			if (pos >= len) error("a tag without its ]");
			if (lineStr.charAt(pos) == "*") {
				// in a macro: all of the macro's arguments
				if (!recording && top !== void) {
					var a = [];
					a.assign(top.args);
					for (var i = 0; i < a.count; i += 2) {
						var n = a[i];
						if (n == "tagname" || n == "taglist") continue;
						var v = a[i + 1];
						if (typeof v == "String" && v.charAt(0) == "&") {
							ent[n] = true;
							v = v.substr(1);
						} else {
							delete ent[n];
						}
						if (elm[n] === void) attrs.push(n, v);
						else {
							for (var j = 0; j < attrs.count; j += 2) if (attrs[j] == n) { attrs[j + 1] = v; break; }
						}
						elm[n] = v;
					}
				}
				pos++;
				continue;
			}
			var astart = pos;
			while (pos < len) {
				var c = lineStr.charAt(pos);
				if (isWS(c) || c == "=" || c == ldelim) break;
				pos++;
			}
			var attrname = lineStr.substr(astart, pos - astart).toLowerCase();
			while (pos < len && isWS(lineStr.charAt(pos))) pos++;
			var entity = false, macroarg = false, value;
			if (lineStr.charAt(pos) != "=") {
				value = "true";
			} else {
				pos++;
				while (pos < len && isWS(lineStr.charAt(pos))) pos++;
				if (pos >= len) error("syntax error in a tag's attribute");
				var c = lineStr.charAt(pos);
				if (c == "&") entity = true, pos++;
				else if (c == "%") macroarg = true, pos++;
				var vdelim = "";
				c = lineStr.charAt(pos);
				if (c == "\"" || c == "'") {
					vdelim = c;
					pos++;
				}
				var raw = "";
				while (pos < len) {
					c = lineStr.charAt(pos);
					if (vdelim != "" ? (c == vdelim) : (c == ldelim || isWS(c))) break;
					if (c == "`") {
						pos++;
						if (pos >= len) error("syntax error in a tag's attribute");
						c = lineStr.charAt(pos);
					} else if (raw == "" && !entity && !macroarg) {
						// & or % at the start of a quoted value
						if (c == "&") { entity = true; pos++; continue; }
						if (c == "%") { macroarg = true; pos++; continue; }
					}
					raw += c;
					pos++;
				}
				if (ldelim != "" && pos >= len) error("a tag without its ]");
				if (vdelim != "") pos++;
				value = raw;
			}
			if (recording) continue;
			if (macroarg) {
				// a macro argument, name|default
				var vp = value.indexOf("|");
				var n = vp >= 0 ? value.substr(0, vp) : value;
				if (top !== void) {
					var v = top.args[n];
					if (v === void && vp >= 0) v = value.substr(vp + 1);
					value = v;
				} else {
					value = n;
				}
				if (typeof value == "String" && value.charAt(0) == "&") {
					entity = true;
					value = value.substr(1);
				}
				if (value === void) continue;
			}
			if (attrname == "cond") {
				cond = entity ? ("(" + value + ")") : value;
				continue;
			}
			if (entity) ent[attrname] = true;
			else delete ent[attrname];
			if (elm[attrname] === void) attrs.push(attrname, value);
			else {
				for (var j = 0; j < attrs.count; j += 2) if (attrs[j] == attrname) { attrs[j + 1] = value; break; }
			}
			elm[attrname] = value;
		}

		// the tag has ended
		if (recording) {
			if (tagname == "endmacro") {
				recording = false;
				macros[recordName] = recordStr + "[macropop]";
				stepNext(ldelim);
				return;
			}
			if (ldelim != "") recordStr += lineStr.substr(tagstartpos, pos - tagstartpos + 1);
			else if (pos - tagstartpos > 1) recordStr += "[" + lineStr.substr(tagstartpos + 1, pos - tagstartpos - 1) + "]";
			stepNext(ldelim);
			return;
		}
		switch (tagname) {
		case "macro":
			if (elm.name == "") error("[macro] without a name");
			recordName = ((string)elm.name).toLowerCase();
			recording = true;
			recordStr = "";
			stepNext(ldelim);
			return;
		case "endmacro":
			error("[endmacro] without [macro]");
		case "erasemacro":
			if (macros[elm.name] === void) error("unknown macro: " + elm.name);
			delete macros[elm.name];
			stepNext(ldelim);
			return;
		case "macropop":
			if (macroArgs.count > 0) {
				var frame = macroArgs.pop();
				if (frame.cond) {
					stepNext(ldelim);
					return %[tagname:"endif", __line:tagLine, __macrocond:true];
				}
			}
			stepNext(ldelim);
			return;
		case "pmacro":
		case "erasepmacro":
			error("[" + tagname + "] (parameter macros) isn't supported in compiled scenarios");
		}
		var body = macros[tagname];
		if (body !== void) {
			// expand the macro where its tag was
			if (ldelim != "") pos++;
			var rest = lineStr.substr(pos);
			lineStr = lineStr.substr(0, tagstartpos) + body + rest + ((ldelim == "" && !ignoreCR) ? "\\" : "");
			pos = tagstartpos;
			bufferUsing = true;
			var args = %[];
			(Dictionary.assign incontextof args)(elm);
			// entities stay expressions: "&expression"
			var a = [];
			a.assign(ent);
			for (var i = 0; i < a.count; i += 2) args[a[i]] = "&" + args[a[i]];
			macroArgs.add(%[args:args, cond:cond !== void]);
			if (cond !== void) {
				// a macro with cond= runs its contents only when cond holds
				return %[tagname:"if", exp:cond, __line:tagLine, __macrocond:true,
						 __mp:top !== void ? top.args : void];
			}
			return;
		}
		stepNext(ldelim);
		elm.__attrs = attrs;
		elm.__ent = ent;
		elm.__cond = cond;
		elm.__mp = top !== void ? top.args : void;
		elm.__line = tagLine;
		return elm;
	}
}

/**
 * The scene compiler
 */
class SceneParser
{
	var env;          // KAGEnvForParse: the headless World
	var scenePath;    // unused: compiled files go next to their script
	var targets = []; // the scripts to compile (!scnlist.txt)
	var targetMap = %[];
	var options = %[];
	var baseMacros = %[];
	var macroKey = "";
	var keyCache = %[]; // storage -> %[hash, entry] of its compiled file
	var exitCache = %[]; // storage -> the exits its compiled file records (exitsOf)
	var warnings = [];
	var prepared = false; // prepare() has run

	function SceneParser(env, scenePath) {
		this.env = env;
		this.scenePath = scenePath;
		env.parser = this if typeof env.parser != "undefined";
	}

	function finalize() {
		if (env isvalid && typeof env.parser != "undefined" && env.parser === this) env.parser = void;
	}

	function dm(msg) {
		global.dm("scn: " + msg);
	}

	// A problem worth reporting that doesn't stop the compile
	function warn(msg) {
		var w = (cstorage != "" ? "%s(%d): ".sprintf(cstorage, cline + 1) : "") + msg;
		warnings.add(w);
		dm("warning: " + w);
	}

	function error(msg) {
		throw new Exception("%s(%d): %s".sprintf(cstorage, cline + 1, msg));
	}

	// A problem with a file as a whole (a translation)
	function warnFile(file, msg) {
		var w = file + ": " + msg;
		warnings.add(w);
		dm("warning: " + w);
	}

	// ------------------------------------------------------------------
	// Settings: macros and options
	// ------------------------------------------------------------------

	/**
	 * Loads the macros the scripts are compiled with and the options
	 * @param macroFile parsermacro.ks: its macros, and those of the files it calls or jumps
	 * to. Without it, the game's macros as they are now
	 * @param optionFile parseroption.txt: name=value lines (linemode, craftername, format)
	 */
	function prepare(macroFile = "parsermacro.ks", optionFile = "parseroption.txt") {
		(Dictionary.clear incontextof baseMacros)();
		if (macroFile != "" && Storages.isExistentStorage(macroFile)) {
			loadMacros(macroFile, 0);
		} else if (typeof kag.mainConductor == "Object" && kag.mainConductor.macros !== void) {
			(Dictionary.assign incontextof baseMacros)(kag.mainConductor.macros);
		}
		(Dictionary.clear incontextof options)();
		if (optionFile != "" && Storages.isExistentStorage(optionFile)) {
			var list = [].load(optionFile);
			for (var i = 0; i < list.count; i++) {
				var l = ((string)list[i]).trim();
				if (l == "" || l.charAt(0) == ";" || l.charAt(0) == "#") continue;
				var p = l.indexOf("=");
				if (p < 0) options[l.toLowerCase()] = "true";
				else options[l.substr(0, p).trim().toLowerCase()] = l.substr(p + 1).trim();
			}
		}
		// the key of the settings, for knowing when to compile again
		var names = [];
		names.assign(baseMacros);
		var keys = [];
		for (var i = 0; i < names.count; i += 2) keys.add(names[i]);
		keys.sort();
		var text = "";
		for (var i = 0; i < keys.count; i++) text += keys[i] + "=" + baseMacros[keys[i]] + "\n";
		names.assign(options);
		keys.clear();
		for (var i = 0; i < names.count; i += 2) keys.add(names[i]);
		keys.sort();
		for (var i = 0; i < keys.count; i++) text += "option:" + keys[i] + "=" + options[keys[i]] + "\n";
		macroKey = scnHashString(text);
		prepared = true;
	}

	// Collects the macros a file defines, following [call] and [jump]
	function loadMacros(storage, depth) {
		if (depth > 16) throw new Exception("parsermacro.ks: calls nested too deep at " + storage);
		var tok = new SceneTokenizer(%[ onScnLabel:function {}, onScnScript:function {} ], baseMacros);
		try {
			tok.load(storage);
			var elm;
			while ((elm = tok.getNextTag()) !== void) {
				switch (elm.tagname) {
				case "call":
					if (elm.storage != "") loadMacros(elm.storage, depth + 1);
					break;
				case "jump":
					if (elm.storage != "") {
						tok.load(elm.storage);
					}
					break;
				case "return":
					invalidate tok;
					return;
				}
			}
		} catch (e) {
			invalidate tok;
			throw e;
		}
		invalidate tok;
	}

	// ------------------------------------------------------------------
	// What to compile, and when
	// ------------------------------------------------------------------

	function initDepend(list) {
		targets.clear();
		(Dictionary.clear incontextof targetMap)();
		for (var i = 0; i < list.count; i++) {
			var name = list[i];
			if (targetMap[name.toLowerCase()] === void) {
				targets.add(name);
