	// ------------------------------------------------------------------
	// Jumps and choices: where a scene goes next
	// ------------------------------------------------------------------

	function jump(elm) {
		var next = %[ type:0 ];
		next.storage = elm.storage if elm.storage != "";
		next.target = elm.target if elm.target != "";
