	// The step that runs a tag: [tagname, flag attributes..., 0, name, value...]. Values that
	// are & entities are "&expression" (one that starts with & or ` as text gets a ` before
	// it); *cond is a condition and *mp the macro's arguments, both for the game to use
	function makeStep(elm, skip) {
		var step = [ elm.tagname ];
		var attrs = elm.__attrs;
		var ent = elm.__ent;
		var i = 0;
		var n = attrs !== void ? attrs.count : 0;
		// the leading attributes without a value are flags
		for (; i < n; i += 2) {
			var name = attrs[i];
			if (skip !== void && skip[name]) continue;
			if (attrs[i + 1] !== "true" || ent[name]) break;
			step.push(name);
		}
		step.push(0);
