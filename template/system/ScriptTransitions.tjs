/**
 * Transitions drawn by scripts (since 0.18.0; doc/kagex.txt, "trans").
 *
 * extNagano's book, multiripple, rgbfade, zoomfade and spin, as krkrz_dev rebuilt them from the
 * 2006 DLL, don't do what they say (UPSTREAM.md 42): book's page stops three quarters of the way
 * and the rest of the old picture vanishes at the end, multiripple's blend flips the two pictures
 * whenever its count passes 256, rgbfade's colours each take the shortest one's time, zoomfade
 * samples the nearest pixel, and spin's box doesn't turn. kagex draws these itself: when a layer
 * starts one, KAGLayer.beginTransition hands it to KAGScriptTransition instead of the engine,
 * which takes a picture of the layer as it is and as it will be (piledCopy, children and all when
 * the transition takes them), draws each frame on a layer laid over it, and ends as the engine's
 * transitions do (onTransitionCompleted, so KAG's waits, [stoptrans], a click that skips and the
 * page exchange are as before). A game removes a name from KAGScriptTransitions to have the
 * plugin's own, or adds a class of its own:
 *
 *   class MyTransition extends KAGScriptTransitionEffect {
 *       function MyTransition(owner) { super.KAGScriptTransitionEffect(owner); }
 *       function prepare(elm) { ... }        // after a and b (the two pictures) are taken
 *       function draw(t) { ... }             // t from 0 to 1: draw into canvas
 *   }
 *   KAGScriptTransitions["mine"] = MyTransition;
 *
 * The same options as the plugin's: book's dir (0: the left page turns to the right, 1: the right
 * page turns to the left, -1 or none: either), multiripple's count (1 to 20), wavecount, rwidth,
 * maxdrift (how bright the wave rings are; 0: none), roundness and delaylast, rgbfade's delayR,
 * delayG and delayB, zoomfade's zoom1 and zoom2, spin's type1 and type2. They need no plugin.
 * An effect that needs more than one canvas asks owner.newCanvas(type) for another.
 */

var KAGScriptTransitions = %[];

// The size and place of a layer itself: an affine layer's width and the like are its picture's
// (an empty one's for the World's stand-in for no picture, 32x32), while the layer showing it is
// the screen's size
function KAGLayerWidth(l) { return *(&global.Layer.width incontextof l); }
function KAGLayerHeight(l) { return *(&global.Layer.height incontextof l); }
function KAGLayerLeft(l) { return *(&global.Layer.left incontextof l); }
function KAGLayerTop(l) { return *(&global.Layer.top incontextof l); }

class KAGScriptTransitionEffect
{
	var owner, a, b, canvas, w, h;
	function KAGScriptTransitionEffect(owner) { this.owner = owner; }
	function finalize() {}
	function prepare(elm) {}
	function draw(t) {}
}

class KAGScriptTransition
{
	var layer, src, withchildren, elm, effect;
	var a, b, canvas, start, time, ticking = false;
	var extras = []; // more canvases an effect asked for (newCanvas), shown and hidden with canvas
	var savedOpacity;
	var done = false;

	// whether method is drawn by a script here (book, multiripple ...) on layer, from src (a
	// layer without a size, or a transition without a source, is left to the engine)
	function handles(method, layer, src)
	{
		return method != "" && KAGScriptTransitions[method] !== void && layer !== void && src !== void && src !== null &&
			KAGLayerWidth(layer) > 0 && KAGLayerHeight(layer) > 0 && KAGLayerWidth(src) > 0 && KAGLayerHeight(src) > 0;
	}

	function KAGScriptTransition(layer, method, withchildren, src, elm)
	{
		this.layer = layer, this.src = src, this.withchildren = withchildren, this.elm = elm;
		var win = layer.window, w = KAGLayerWidth(layer), h = KAGLayerHeight(layer);
		time = +elm.time;
		time = 2 if time < 2;
		a = picture(layer, w, h);
		b = picture(src, w, h);
		// the canvas lies over the layer, among its siblings (the message windows stay over a KAG
		// layer's), or over everything for a layer without a parent
		canvas = new global.Layer(win, layer.parent !== null ? layer.parent : win.primaryLayer);
		canvas.name = "Script transition " + method;
		canvas.setImageSize(w, h);
		canvas.setSizeToImageSize();
		canvas.setPos(layer.parent !== null ? KAGLayerLeft(layer) : 0, layer.parent !== null ? KAGLayerTop(layer) : 0);
		canvas.type = ltAlpha;
		canvas.face = dfAlpha;
		canvas.hitType = htMask;
		canvas.hitThreshold = 256; // the pointer goes through, as it would to the layer
		canvas.absolute = layer.parent !== null ? layer.absolute + 1 : 2000000000 - 2;
		dm("script transition %s on %s, %dx%d".sprintf(method, layer.name, w, h)) if kag.debugLevel >= tkdlVerbose;
		effect = new KAGScriptTransitions[method](this);
		effect.a = a, effect.b = b, effect.canvas = canvas, effect.w = w, effect.h = h;
		try { effect.prepare(elm); } catch (e) { dm("script transition: " + e.message); }
		// the layer hides under it (a layer that isn't opaque would show through where the canvas
		// is clear), and comes back as it ends
		savedOpacity = layer.opacity;
		layer.opacity = 0;
		try { effect.draw(0); } catch (e) { dm("script transition: " + e.message); }
		canvas.visible = true;
		for (var i = 0; i < extras.count; i++) extras[i].visible = true;
		start = System.getTickCount();
		// every frame, as the engine's own transitions and KAG's movers go (a Timer could be
		// starved by a busier one: a 1 ms timer stopped a 16 ms one here)
		System.addContinuousHandler(onFrame);
		ticking = true;
		layer.scriptTransition = this;
	}

	function finalize()
	{
		System.removeContinuousHandler(onFrame) if ticking;
		invalidate effect if effect !== void;
		for (var i = 0; i < extras.count; i++) invalidate extras[i];
		invalidate canvas if canvas !== void;
		invalidate a if a !== void;
		invalidate b if b !== void;
	}

	// a picture of a layer as it would show: KAGEX's affine layers draw their pictures as they're
	// painted (AffineLayer.onPaint), so they're drawn now, and a layer not shown yet (the World's
	// new picture) is shown for the copy (an affine layer's own images aren't what it shows, and
	// assignImages took the wrong picture); its children are in it either way
	function picture(l, w, h)
	{
		var p = new global.Layer(l.window, l.window.primaryLayer);
		p.visible = false;
		p.setImageSize(w, h);
		p.type = ltAlpha;
		p.face = dfAlpha;
		p.fillRect(0, 0, w, h, 0);
		paintNow(l);
		var v = l.visible;
		l.visible = true;
		var lw = KAGLayerWidth(l), lh = KAGLayerHeight(l);
		var cw = lw < w ? lw : w, ch = lh < h ? lh : h;
		try { p.piledCopy(0, 0, l, 0, 0, cw, ch); } catch (e) { l.visible = v; throw e; }
		l.visible = v;
		return p;
	}

	// another canvas over the first, of a layer type of its own (ltAdditive ...), for an effect
	// that composes with what's behind in more than one way; shown and hidden with the canvas
	function newCanvas(type)
	{
		var c = new global.Layer(canvas.window, canvas.parent);
		c.name = canvas.name + " " + (extras.count + 2);
		c.setImageSize(canvas.imageWidth, canvas.imageHeight);
		c.setSizeToImageSize();
		c.setPos(canvas.left, canvas.top);
		c.type = type;
		c.hitType = htMask;
		c.hitThreshold = 256;
		c.absolute = canvas.absolute + extras.count + 1;
		c.visible = false;
		extras.add(c);
		return c;
	}

	function paintNow(l)
	{
		if (typeof l.drawAffine != "undefined") try { l.onPaint(); } catch (e) {}
		var c = l.children;
		for (var i = 0; i < c.count; i++) paintNow(c[i]) if c[i].visible;
	}

	function onFrame(tick)
	{
		if (done) return;
		var t = (System.getTickCount() - start) / time;
		if (t >= 1) { finish(); return; }
		// a drawing that fails ends the transition rather than leaving it running for ever
		try { effect.draw(t); } catch (e) { dm("script transition: " + e.message); finish(); return; }
		canvas.update();
	}

	// the end, on time or stopped ([stoptrans], a click). The engine ends a transition by swapping
	// the two layers in the tree (an "exchange"), and KAG goes by that, so the end goes through
	// the engine too: a crossfade of its own, stopped at once, which swaps them and fires the
	// layer's onTransitionCompleted there and then (KAG's waits, the page exchange); the canvas,
	// still showing the last frame, goes after
	function finish()
	{
		if (done) return;
		dm("script transition ends at %d of %d ms".sprintf(System.getTickCount() - start, time)) if kag.debugLevel >= tkdlVerbose;
		done = true;
		if (ticking) { System.removeContinuousHandler(onFrame); ticking = false; }
		var l = layer, s = src;
		l.opacity = savedOpacity if savedOpacity !== void;
		l.scriptTransition = void;
		try {
			(global.Layer.beginTransition incontextof l)("crossfade", withchildren, s, %[ time:2 ]);
			(global.Layer.stopTransition incontextof l)();
		} catch (e) {
			// the engine wouldn't: end as it would have, without the swap
			dm("script transition: " + e.message);
			l.onTransitionCompleted(l, s) if l.inTransition;
		}
		canvas.visible = false;
		for (var i = 0; i < extras.count; i++) extras[i].visible = false;
		KAGDisposeLater(this);
	}
}

// Invalidates an object once the event being handled is over
var KAGDisposeQueue = [], KAGDisposeTrigger;
function KAGDisposeLater(obj)
{
	KAGDisposeQueue.add(obj);
	if (KAGDisposeTrigger === void) {
		KAGDisposeTrigger = new AsyncTrigger(function {
			var q = [];
			q.assign(KAGDisposeQueue);
			KAGDisposeQueue.clear();
			for (var i = 0; i < q.count; i++) invalidate q[i] if q[i] !== void && isvalid q[i];
		} incontextof global, "");
		KAGDisposeTrigger.cached = true;
	}
	KAGDisposeTrigger.trigger();
}

function KAGEaseInOut(t) { return t * t * (3 - 2 * t); }

/**
 * book: a page turns about the spine down the middle. dir 1: the right page turns to the left,
 * so the new picture's right half shows under it, and the page's back (the new left half)
 * comes down over the old left half; dir 0 the other way round. The page is drawn in strips,
 * nearer the eye (taller) as it lifts, and shaded as it turns away from the light.
 */
class KAGBookTransition extends KAGScriptTransitionEffect
{
	var dir = 1, strips = 48;
	function KAGBookTransition(owner) { super.KAGScriptTransitionEffect(owner); }
	function prepare(elm)
	{
		var d = elm.dir !== void ? +elm.dir : -1;
		dir = d == -1 ? (Math.random() < 0.5 ? 0 : 1) : d == 0 ? 0 : 1;
	}
	// darkens the colour only, so what's clear (a picture with no page, the World's stand-in)
	// stays clear rather than turning into a grey veil
	function shadeRect(x, y, rw, rh, opa)
	{
		canvas.face = dfOpaque;
		canvas.holdAlpha = true;
		canvas.colorRect(x, y, rw, rh, 0x000000, opa);
		canvas.holdAlpha = false;
		canvas.face = dfAlpha;
	}
	function draw(t)
	{
		var half = w \ 2, p = KAGEaseInOut(t), th = Math.PI * p;
		var c = Math.cos(th), s = Math.sin(th);
		// the halves: the side the page lifts from shows the new picture, the other side the old
		// one until the page comes down over it
		if (dir == 1) {
			canvas.copyRect(0, 0, a, 0, 0, half, h);
			canvas.copyRect(half, 0, b, half, 0, w - half, h);
		} else {
			canvas.copyRect(0, 0, b, 0, 0, half, h);
			canvas.copyRect(half, 0, a, half, 0, w - half, h);
		}
		// the shadow the lifted page casts on the side it uncovered, deepest at the spine
		var sh = (int)(90 * s);
		if (sh > 0) for (var k = 0; k < 6; k++) {
			var sw = (half * (k + 1)) \ 12;
			shadeRect(dir == 1 ? half : half - sw, 0, sw, h, sh \ 6);
		}
		// the page: its front (the old picture's half) while it rises, then its back (the new
		// picture's other half) as it comes down
		var front = c >= 0, sign = dir == 1 ? 1 : -1;
		var srcl = front ? a : b;
		var depth = w * 3.0;
		for (var i = 0; i < strips; i++) {
			var u0 = i / strips, u1 = (i + 1) / strips;
			var x0 = half + sign * u0 * half * c, x1 = half + sign * u1 * half * c;
			var z = (u0 + u1) / 2 * half * s;
			var sc = depth / (depth - z);
			var sh2 = (int)(h * sc), y0 = (h - sh2) \ 2;
			var dx = (int)(x0 < x1 ? x0 : x1), dw = (int)Math.abs(x1 - x0) + 1;
			if (dw <= 0) continue;
			// where the strip is on the page: from the spine outwards
			var sx;
			if (front) sx = dir == 1 ? half + (int)(u0 * half) : half - (int)(u1 * half);
			else       sx = dir == 1 ? half - (int)(u1 * half) : half + (int)(u0 * half);
			var sw = (int)(half / strips) + 1;
			sx = 0 if sx < 0;
			sw = w - sx if sx + sw > w;
			if (sw <= 0) continue;
			canvas.stretchCopy(dx, y0, dw, sh2, srcl, sx, 0, sw, h, stFastLinear);
			// shading: darker the more the page faces away, and towards its outer edge as it curls
			var shade = (int)((front ? 1 - c : 1 + c) * 70 + (front ? u0 * 30 * s : 0));
			shadeRect(dx, y0, dw, sh2, shade > 160 ? 160 : shade) if shade > 0;
		}
	}
}

/**
 * multiripple: ripples spread from count points (the last from the middle, last), and the new
 * picture shows inside them; wave rings ride on each front.
 *
 * The ripples make a mask m (0: the old picture, 1: the new one), drawn at a quarter of the size
 * and stretched (its edges are soft anyway), and the two pictures are mixed by it with their own
 * transparency kept: what's clear in either (the World's stand-in for a picture that comes or
 * goes) lets the scene behind show through. The layer operations that can lower an alpha are
 * darken (the smaller of two, byte by byte, alpha too) and lighten (the larger), so the mixes are
 * the new picture with min(its alpha, m) over the old one with min(its alpha, max(the new one's,
 * 1 - m)); exact where an alpha is 0 or 255, close in between.
 */
class KAGMultiRippleTransition extends KAGScriptTransitionEffect
{
	var ripples = [];  // %[ x, y, start, reach ] (start and reach as fractions of the time)
	var scale = 4, sw, sh;
	var mode;          // "a", "b", "ab", "ba" or "both": which pictures need which mask (prepare)
	var small, maskM, maskN, part, edge, rings;
	var band, waves = 2, wave, glow = 96, roundness = 1.0;
	var pace = 1.0; // the time the ripples cover the whole picture by, as a fraction (prepare)
	function KAGMultiRippleTransition(owner) { super.KAGScriptTransitionEffect(owner); }
	function finalize()
	{
		var ls = [ small, maskM, maskN, part, edge, rings ];
		for (var i = 0; i < ls.count; i++) invalidate ls[i] if ls[i] !== void;
	}
	function newLayer(lw, lh, fill)
	{
		var win = owner.layer.window, l = new global.Layer(win, win.primaryLayer);
		l.visible = false; l.setImageSize(lw, lh); l.type = ltAlpha; l.face = dfAlpha;
		l.fillRect(0, 0, lw, lh, fill);
		return l;
	}
	function prepare(elm)
	{
		var count = elm.count !== void ? +elm.count : 1;
		count = 1 if count < 1; count = 20 if count > 20;
		var rwidth = elm.rwidth !== void ? +elm.rwidth : 32;
		waves = elm.wavecount !== void ? +elm.wavecount : 2;
		waves = 1 if waves < 1;
		wave = rwidth < 4 ? 4 : rwidth;
		band = wave * waves;
		glow = elm.maxdrift !== void ? (int)(+elm.maxdrift * 3) : 72;
		glow = 255 if glow > 255;
		roundness = elm.roundness !== void ? +elm.roundness : 1.0;
		roundness = 1.0 if roundness <= 0;
		var delaylast = elm.delaylast !== void ? +elm.delaylast : 1.0;
		// the sources: random ones, apart from each other, then the middle; they start one after
		// another over the first part of the time, and each reaches the corner farthest from it
		// by the end
		var spread = count > 1 ? 0.45 / (count - 1) : 0;
		for (var i = 0; i < count; i++) {
			var x, y;
			if (i == count - 1) x = w \ 2, y = h \ 2;
			else for (var n = 0; n < 20; n++) {
				x = (int)(Math.random() * w), y = (int)(Math.random() * h);
				if (i == 0 || Math.abs(x - ripples[i - 1].x) + Math.abs(y - ripples[i - 1].y) > (w + h) \ 6) break;
			}
			var st = i == count - 1 ? spread * (count - 2 + delaylast) : spread * i;
			st = 0 if st < 0; st = 0.8 if st > 0.8;
			var far = 0;
			var corners = [ [0, 0], [w, 0], [0, h], [w, h] ];
			for (var k = 0; k < 4; k++) {
				var dx = corners[k][0] - x, dy = (corners[k][1] - y) / roundness;
				var d = Math.sqrt(dx * dx + dy * dy);
				far = d if d > far;
			}
			ripples.add(%[ x:x, y:y, start:st, reach:far + band ]);
		}
		// the ripples together cover the picture before each reaches its far corner: when the
		// last point of a grid over it is covered is when the transition should end
		var latest = 0;
		for (var gy = 0; gy <= 16; gy++) for (var gx = 0; gx <= 24; gx++) {
			var px = w * gx / 24, py = h * gy / 16, first = 1.0;
			for (var i = 0; i < ripples.count; i++) {
				var r = ripples[i], dx = px - r.x, dy = (py - r.y) / roundness;
				var need = Math.sqrt(dx * dx + dy * dy) / 0.875 + band * 0.5; // the disc's solid part reaches it
				var tt = r.start + need / r.reach * (1 - r.start);
				first = tt if tt < first;
			}
			latest = first if first > latest;
		}
		pace = latest > 0.2 && latest < 1 ? latest : 1.0;
		// which of the two pictures are opaque or clear decides how they're mixed
		var ak = KAGPictureCover(a, w, h), bk = KAGPictureCover(b, w, h);
		mode = ak == "clear" ? "b" : bk == "opaque" ? "ab" : bk == "clear" ? "a" : ak == "opaque" ? "ba" : "both";
		for (var k = 0; k < 3; k++) {
			KAGRippleImage("disc" + k, "disc", 16, 1.0 - 0.125 / (1 << k)) if mode != "a";
			KAGRippleImage("hole" + k, "hole", 16, 1.0 - 0.125 / (1 << k)) if mode == "a" || mode == "ba" || mode == "both";
		}
		for (var k = 0; k < waves && glow > 0; k++) KAGRippleRing(16 * (waves - k) \ waves);
		sw = (w + scale - 1) \ scale, sh = (h + scale - 1) \ scale;
		small = newLayer(sw, sh, 0);
		if (mode != "a") maskM = newLayer(w, h, 0);
		if (mode == "a" || mode == "ba" || mode == "both") maskN = newLayer(w, h, 0);
		if (mode != "a" && mode != "b") part = newLayer(w, h, 0);
		if (mode == "both") edge = newLayer(w, h, 0);
		if (glow > 0) rings = newLayer(w, h, 0);
	}
	// the mask of every ripple's disc (inside 255, its soft edge, outside 0) or, with holes, its
	// inverse, made small and stretched to full size into to
	function makeMask(to, list, holes)
	{
		small.fillRect(0, 0, sw, sh, holes ? 0xffffffff : 0x00ffffff);
		for (var i = 0; i < list.count; i++) {
			var r = list[i][0], rx = list[i][1] / scale, ry = rx * roundness;
			if (rx < 0.5) continue;
			// the soft edge an eighth of the radius, or about 64 pixels on a big ripple, where an
			// eighth would leave the new picture a ghost over a wide band
			var soft = list[i][1] < 512 ? 0 : list[i][1] < 1024 ? 1 : 2;
			var img = KAGRippleImage((holes ? "hole" : "disc") + soft, holes ? "hole" : "disc", 16, 1.0 - 0.125 / (1 << soft));
			small.operateStretch((int)(r.x / scale - rx), (int)(r.y / scale - ry), (int)(rx * 2) + 1, (int)(ry * 2) + 1,
				img, 0, 0, img.imageWidth, img.imageHeight, holes ? omDarken : omLighten, 255, stLinear);
		}
		to.stretchCopy(0, 0, sw * scale, sh * scale, small, 0, 0, sw, sh, stFastLinear);
	}
	function draw(t)
	{
		t *= pace;
		var discs = [], fronts = [];
		for (var i = 0; i < ripples.count; i++) {
			var r = ripples[i];
			if (t <= r.start) continue;
			// the front: from the source to its farthest corner (and the rings' width past it)
			var f = (t - r.start) / (1 - r.start);
			var rad = r.reach * f;
			var inner = rad - band * 0.5;
			discs.add([ r, inner ]) if inner > 0;
			fronts.add([ r, rad ]);
		}
		if (maskM !== void) makeMask(maskM, discs, false);
		if (maskN !== void) makeMask(maskN, discs, true);
		switch (mode) {
		case "b": // no old picture: the new one inside the ripples
			canvas.copyRect(0, 0, b, 0, 0, w, h);
			canvas.operateRect(0, 0, maskM, 0, 0, w, h, omDarken, 255);
			break;
		case "a": // no new picture: the old one outside them
			canvas.copyRect(0, 0, a, 0, 0, w, h);
			canvas.operateRect(0, 0, maskN, 0, 0, w, h, omDarken, 255);
			break;
		case "ab": // an opaque new picture inside the ripples, over the old one
			canvas.copyRect(0, 0, a, 0, 0, w, h);
			part.copyRect(0, 0, b, 0, 0, w, h);
			part.operateRect(0, 0, maskM, 0, 0, w, h, omDarken, 255);
			canvas.operateRect(0, 0, part, 0, 0, w, h, omAlpha, 255);
			break;
		case "ba": // an opaque old picture outside them, over the new one
			canvas.copyRect(0, 0, b, 0, 0, w, h);
			part.copyRect(0, 0, a, 0, 0, w, h);
			part.operateRect(0, 0, maskN, 0, 0, w, h, omDarken, 255);
			canvas.operateRect(0, 0, part, 0, 0, w, h, omAlpha, 255);
			break;
		default: // both partly clear
			edge.copyRect(0, 0, b, 0, 0, w, h);
			edge.operateRect(0, 0, maskN, 0, 0, w, h, omLighten, 255);
			edge.operateRect(0, 0, a, 0, 0, w, h, omDarken, 255);
			canvas.copyRect(0, 0, a, 0, 0, w, h);
			canvas.face = dfMask;
			canvas.copyRect(0, 0, edge, 0, 0, w, h);
			canvas.face = dfAlpha;
			part.copyRect(0, 0, b, 0, 0, w, h);
			part.operateRect(0, 0, maskM, 0, 0, w, h, omDarken, 255);
			canvas.operateRect(0, 0, part, 0, 0, w, h, omAlpha, 255);
			break;
		}
		if (rings === void || fronts.count == 0) return;
		// the wave rings, bright at the front and fainter behind it, lighten what shows (the
		// colour only: what's clear stays clear)
		small.fillRect(0, 0, sw, sh, 0x00ffffff);
		for (var i = 0; i < fronts.count; i++) {
			var r = fronts[i][0], rad = fronts[i][1];
			for (var k = 0; k < waves; k++) {
				var rx = (rad - wave * k) / scale, ry = rx * roundness;
				if (rx < 2) continue;
