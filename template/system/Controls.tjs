// Controls.tjs - The controls list: what every key, mouse button and controller button does
//
// KAGControlsList(win) reads the bindings themselves, so a game that changes them gets a
// correct list: the window's key bindings (KAGWindow.keyBindings: the framework's in
// createKeyBindings, a game's from bindKey in AfterInit.tjs), the controller's
// (KAGWindow.padKeyMap: initialPadKeyMap, then the game's changes), and what the framework
// does in code for Return, Space, Ctrl, the arrows and the mouse. A key handled in a
// keyDownHook function isn't listed: use bindKey for it. The controller's buttons are named
// by the controller in use (System.padStyle: ✕ ○ □ △ on a PlayStation pad, A B X Y elsewhere).
//
// KAGControlsPanel shows the list as an Elements screen (ElementsScreen.tjs). Help > Controls
// opens it (KAGWindow.showControls), and the sample's Config screen has a button for it.

/**
 * A key's name, with the modifier keys held (shift: ssShift, ssCtrl, ssAlt; void for none)
 */
function KAGKeyName(key, shift)
{
	var mods = "";
	if (shift !== void && typeof shift == "Integer") {
		mods += "Ctrl+" if shift & ssCtrl;
		mods += "Alt+" if shift & ssAlt;
		mods += "Shift+" if shift & ssShift;
	}
	var name;
	if (key >= VK_F1 && key <= VK_F1 + 23) name = "F" + (key - VK_F1 + 1);
	else if ((key >= #'A' && key <= #'Z') || (key >= #'0' && key <= #'9')) name = $key;
	else {
		var names = %[];
		names[VK_RETURN] = tr("Enter"), names[VK_SPACE] = tr("Space"), names[VK_ESCAPE] = "Esc";
		names[VK_BACK] = tr("Backspace"), names[VK_TAB] = "Tab", names[VK_CONTROL] = "Ctrl";
		names[VK_SHIFT] = "Shift", names[VK_UP] = "↑", names[VK_DOWN] = "↓", names[VK_LEFT] = "←";
		names[VK_RIGHT] = "→", names[VK_PRIOR] = "Page Up", names[VK_NEXT] = "Page Down";
		names[VK_HOME] = "Home", names[VK_END] = "End", names[VK_DELETE] = "Delete", names[VK_INSERT] = "Insert";
		names[global.VK_SNAPSHOT] = "Print Screen" if typeof global.VK_SNAPSHOT == "Integer";
		names[global.VK_XBUTTON1] = tr("Mouse Back") if typeof global.VK_XBUTTON1 == "Integer";
		names[global.VK_XBUTTON2] = tr("Mouse Forward") if typeof global.VK_XBUTTON2 == "Integer";
		name = names[key];
		name = "Key %02X".sprintf(key) if name === void;
	}
	return mods + name;
}

/**
 * The names of the controller's buttons VK_PAD1 to VK_PAD12, as shown and as read out, for
 * the controller in use
 */
function KAGPadButtonNames()
{
	var style = typeof System.padStyle != "undefined" ? System.padStyle : "";
	var byPosition = typeof System.padButtonMapping != "undefined" && System.padButtonMapping == "position";
	var shown, said;
	switch (style) {
	case "ps":
		shown = [ "×", "○", "□", "△", "L1", "R1", "L2", "R2", "Share", "Options", "L3", "R3" ];
		said  = [ tr("Cross"), tr("Circle"), tr("Square"), tr("Triangle"), "L1", "R1", "L2", "R2", "Share", "Options", "L3", "R3" ];
		break;
	case "switch":
		// with the buttons by position (System.padButtonMapping), VK_PAD1 is the bottom one: B
		shown = [ byPosition ? "B" : "A", byPosition ? "A" : "B", byPosition ? "Y" : "X", byPosition ? "X" : "Y",
			"L", "R", "ZL", "ZR", "−", "+", tr("Left stick button"), tr("Right stick button") ];
		said = [];
		said.assign(shown);
		said[8] = tr("Minus"), said[9] = tr("Plus");
		break;
	default:
		shown = [ "A", "B", "X", "Y", "LB", "RB", "LT", "RT", "View", "Menu", tr("Left stick button"), tr("Right stick button") ];
		said = [];
		said.assign(shown);
		break;
	}
	return %[ shown:shown, said:said, style:style ];
}

/**
 * The list: an array of sections %[ title, rows ], each row %[ keys, action, said ] (said: the
 * keys as a screen reader reads them, when it differs). win: the game window
 */
function KAGControlsList(win)
{
	var sections = [];

	// --- the keyboard
	var rows = [];
	rows.add(%[ keys:KAGKeyName(VK_RETURN) + " / " + KAGKeyName(VK_SPACE), action:tr("Next text, or press the button you're on (hold to skip)") ]);
	rows.add(%[ keys:"Ctrl", action:tr("Skip, while held") ]);
	rows.add(%[ keys:"↑ ↓ ← →", said:tr("Arrow keys"), action:tr("Move between buttons and choices") ]);
	var keyRows = KAGControlsKeyRows(win, false);
	for (var i = 0; i < keyRows.count; i++) rows.add(keyRows[i]);
	sections.add(%[ title:tr("Keyboard"), rows:rows ]);

	// --- the mouse
	rows = [];
	rows.add(%[ keys:tr("Left click"), action:tr("Next text, or press a button") ]);
	rows.add(%[ keys:tr("Right click"), action:tr("Hide the message window, or go back from a screen") ]);
	rows.add(%[ keys:tr("Wheel up"), action:tr("Message history") ]);
	rows.add(%[ keys:tr("Wheel down"), action:tr("Next text") ]);
	sections.add(%[ title:tr("Mouse"), rows:rows ]);

	// --- the controller
	if (typeof win.padKeyMap == "Object" && win.padKeyMap !== void && typeof global.VK_PAD1 == "Integer") {
		rows = [];
		var map = win.padKeyMap, names = KAGPadButtonNames();
		var arrows = map[VK_PADUP] == VK_UP && map[VK_PADDOWN] == VK_DOWN && map[VK_PADLEFT] == VK_LEFT && map[VK_PADRIGHT] == VK_RIGHT;
		if (arrows) rows.add(%[ keys:tr("D-pad"), action:tr("Move between buttons and choices") ]);
		if (typeof global.VK_PAD_L_UP == "Integer" && map[VK_PAD_L_UP] == VK_UP && map[VK_PAD_L_DOWN] == VK_DOWN &&
			map[VK_PAD_L_LEFT] == VK_LEFT && map[VK_PAD_L_RIGHT] == VK_RIGHT)
			rows.add(%[ keys:tr("Left stick"), action:tr("Move between buttons and choices") ]);
		for (var i = 1; i <= 12; i++) {
			if (typeof global["VK_PAD" + i] != "Integer") continue;
			var action = KAGControlsHandlerAction(win, map[global["VK_PAD" + i]]);
			if (action === void) continue;
			rows.add(%[ keys:names.shown[i - 1], said:names.said[i - 1], action:action ]);
		}
		sections.add(%[ title:tr("Controller"), rows:rows ]) if rows.count > 0;
	}

	// --- debug mode
	if (global.debugWindowEnabled) {
		rows = KAGControlsKeyRows(win, true);
		sections.add(%[ title:tr("Debug mode"), rows:rows ]) if rows.count > 0;
	}
	return sections;
}

/**
 * The key bindings in effect, a row each (keys with the same action on one row): the debug
 * mode's or the others
 */
function KAGControlsKeyRows(win, debug)
{
	var list = [];
	var bindings = win.keyBindings;
	for (var i = 0; i < bindings.count; i++) {
		var b = bindings[i];
		if (b.label === void || !!b.debug != !!debug || !win.keyBindingActive(b)) continue;
		// left out where an early binding (a game's) takes the same key first
		var shadowed = false;
		if (!b.early) {
			for (var j = 0; j < bindings.count; j++) {
				var c = bindings[j];
				if (c.early && c.key == b.key && (b.shift === void || c.shift === b.shift) && win.keyBindingActive(c)) { shadowed = true; break; }
			}
		}
		if (shadowed) continue;
		list.add(%[ key:b.key, shift:b.shift, label:tr(b.label), order:KAGControlsKeyOrder(b.key, b.shift) ]);
	}
	// by key (the function keys first), and the keys of one action together
	list.sort(function(a, b) { return a.order < b.order; }, true);
	var rows = [], byAction = %[];
	for (var i = 0; i < list.count; i++) {
		var e = list[i], name = KAGKeyName(e.key, e.shift);
		var row = byAction[e.label];
		if (row !== void) { row.keys += " / " + name; continue; }
		row = %[ keys:name, action:e.label ];
		byAction[e.label] = row;
		rows.add(row);
	}
	return rows;
}

function KAGControlsKeyOrder(key, shift)
{
	var group = (key >= VK_F1 && key <= VK_F1 + 23) ? 0 : ((key >= #'A' && key <= #'Z') || (key >= #'0' && key <= #'9')) ? 1 : 2;
	return group * 0x100000 + (shift !== void && shift != 0 ? 0x10000 : 0) + key;
}

/**
 * What a controller button does: its handler in padKeyMap is a key code (what that key does)
 * or a function (the key binding with that action)
 */
function KAGControlsHandlerAction(win, handler)
{
	if (handler === void) return;
	var actionName = typeof global.KAGActionNameOf != "undefined" ? KAGActionNameOf(handler) : void;
	if (actionName !== void) return KAGActionAvailable(actionName) ? KAGActionLabel(actionName) : void;
	if (typeof handler == "Integer") {
		switch (handler) {
		case VK_RETURN: case VK_SPACE: return tr("Next text, or press the button you're on");
		case VK_CONTROL: return tr("Skip, while held");
		case VK_UP: case VK_DOWN: case VK_LEFT: case VK_RIGHT: return tr("Move between buttons and choices");
		}
		var b = win.findKeyBinding(handler, 0, true);
		b = win.findKeyBinding(handler, 0, false) if b === void;
		return b !== void && b.label !== void ? tr(b.label) : void;
	}
	if (typeof handler == "Object") {
		var bindings = win.keyBindings;
		for (var i = bindings.count - 1; i >= 0; i--) {
			var b = bindings[i];
			if (b.label !== void && b.action === handler && win.keyBindingActive(b)) return tr(b.label);
		}
	}
}

// ------------------------------------------------------------------------------------
// The screen
// ------------------------------------------------------------------------------------

class KAGControlsPanel extends KAGElementsScreen
{
	var columnHeight = 780, columnWidth = 560, keyWidth = 190, columnGap = 32;
	var padding = 48, titleSize = 44, headSize = 30, rowSize = 25, rowGap = 6, lineGap = 4;
	var textPad = 4; // around a row's text in its piece, for its outline
	var textColor = 0xffffff, headColor = 0xffffff;

	function KAGControlsPanel(win)
	{
		super.KAGElementsScreen(win, "Controls panel");
		soundScreen = "controls"; // controls.open, controls.close.click, controls.cancel
	}

	function onOpen()
	{
		super.onOpen(...);
		build();
	}

	function build()
	{
		newAtlas();
		var sections = KAGControlsList(window);
		var title = tr("Controls");
		var titlePiece = addPiece(textWidth(title, titleSize) + 8, textHeight(titleSize) + 8, %[ kind:"title", text:title ]);
		var closeLabel = tr("Close");
		var closeNormal = addPiece(180, 64, %[ kind:"button", text:closeLabel, over:false ]);
		var closeOver = addPiece(180, 64, %[ kind:"button", text:closeLabel, over:true ]);
		// Change Controls (since 0.19.0), where the game has actions
		var changeLabel = tr("Change…"), canChange = typeof global.KAGActionOrder == "Object" && KAGActionOrder.count > 0;
		var changeNormal, changeOver;
		if (canChange) {
			changeNormal = addPiece(180, 64, %[ kind:"button", text:changeLabel, over:false ]);
			changeOver = addPiece(180, 64, %[ kind:"button", text:changeLabel, over:true ]);
		}
		// the controller test (PadTest.tjs, since 0.19.0), where the engine reads pads
		var testLabel = tr("Test Controller"), canTest = typeof System.padEnabled != "undefined";
		var testNormal, testOver;
		if (canTest) {
			testNormal = addPiece(240, 64, %[ kind:"button", text:testLabel, over:false ]);
			testOver = addPiece(240, 64, %[ kind:"button", text:testLabel, over:true ]);
		}
		var panelPiece = addPiece(yesNoImage(yesnoPanelImage).imageWidth, yesNoImage(yesnoPanelImage).imageHeight, %[ kind:"panel" ]);

		// rows as pieces, flowed into columns
		var placed = [], col = 0, y = 0, colH = [ 0 ];
		var actionWidth = columnWidth - keyWidth - 16;
		for (var s = 0; s < sections.count; s++) {
			var sec = sections[s];
			var headH = textHeight(headSize) + 8 + textPad * 2;
			if (y > 0 && y + headH + rowGap + textHeight(rowSize) > columnHeight) { colH[col] = y; col++, y = 0; }
			y += 14 if y > 0;
			var head = addPiece(columnWidth, headH, %[ kind:"head", text:sec.title ]);
			placed.add(%[ piece:head, col:col, y:y, said:sec.title, role:"heading" ]);
			y += headH + rowGap;
			for (var r = 0; r < sec.rows.count; r++) {
				var row = sec.rows[r];
				var lines = wrapLines(row.action, rowSize, actionWidth, false);
				// a key's name a size smaller, or two, before it wraps
				var keySize = fitSize(row.keys, rowSize, keyWidth, true, rowSize - 4);
				var keyLines = wrapLines(row.keys, keySize, keyWidth, true);
				var n = lines.count > keyLines.count ? lines.count : keyLines.count;
				var h = n * (textHeight(rowSize) + lineGap) - lineGap + textPad * 2;
				if (y + h > columnHeight) {
					// on in the next column, under the section's title again
					colH[col] = y; col++, y = 0;
					placed.add(%[ piece:addPiece(columnWidth, headH, %[ kind:"head", text:sec.title ]), col:col, y:y,
						said:sec.title, role:"heading" ]);
					y += headH + rowGap;
				}
				var piece = addPiece(columnWidth, h, %[ kind:"row", keys:keyLines, keySize:keySize, lines:lines ]);
				placed.add(%[ piece:piece, col:col, y:y, said:(row.said !== void ? row.said : row.keys) + ": " + row.action ]);
				y += h + rowGap;
			}
		}
		colH[col] = y;
		var columns = col + 1, listH = 0;
		for (var i = 0; i < colH.count; i++) listH = colH[i] if colH[i] > listH;
		var atlasPath = buildAtlas();

		var shadow = yesnoPanelInsets[2] - yesnoPanelInsets[0];
		var headerH = titlePiece.h + 32;
		var pw = padding * 2 + columns * columnWidth + (columns - 1) * columnGap;
		var ph = padding * 2 + headerH + listH;
		var sw = width, sh = height;
		var px = (sw - pw - shadow) >> 1, py = (sh - ph - shadow) >> 1;
		var listX = px + padding, listY = py + padding + headerH;
		var children = [];
		children.add(%[ "type" => "atlas_nine", "atlas" => "ui", "rect" => rect(panelPiece),
			"insets" => yesnoPanelInsets, "at" => [ px, py, pw + shadow, ph + shadow ], "a11y" => %[ "hidden" => 1 ] ]);
		children.add(%[ "type" => "atlas_image", "atlas" => "ui", "rect" => rect(titlePiece),
			"at" => [ px + padding, py + padding, titlePiece.w, titlePiece.h ], "a11y" => %[ "label" => title, "role" => "heading" ] ]);
		children.add(%[ "type" => "atlas_button", "atlas" => "ui", "id" => "close",
			"at" => [ px + pw - padding - 180, py + padding + ((titlePiece.h - 64) >> 1), 180, 64 ],
			"frames" => %[ "normal" => rect(closeNormal), "hilite" => rect(closeOver), "pressed" => rect(closeOver) ],
			"focus_hilite" => 1, "initial_focus" => 1, "a11y" => %[ "label" => closeLabel ] ]);
		if (canChange)
			children.add(%[ "type" => "atlas_button", "atlas" => "ui", "id" => "change",
				"at" => [ px + pw - padding - 380, py + padding + ((titlePiece.h - 64) >> 1), 180, 64 ],
				"frames" => %[ "normal" => rect(changeNormal), "hilite" => rect(changeOver), "pressed" => rect(changeOver) ],
				"focus_hilite" => 1, "a11y" => %[ "label" => changeLabel ] ]);
		if (canTest)
			children.add(%[ "type" => "atlas_button", "atlas" => "ui", "id" => "padtest",
				"at" => [ px + pw - padding - (canChange ? 640 : 440), py + padding + ((titlePiece.h - 64) >> 1), 240, 64 ],
				"frames" => %[ "normal" => rect(testNormal), "hilite" => rect(testOver), "pressed" => rect(testOver) ],
				"focus_hilite" => 1, "a11y" => %[ "label" => testLabel ] ]);
		for (var i = 0; i < placed.count; i++) {
			var p = placed[i];
			var a = %[ "label" => p.said, "role" => p.role !== void ? p.role : "label" ];
			children.add(%[ "type" => "atlas_image", "atlas" => "ui", "rect" => rect(p.piece),
				"at" => [ listX + p.col * (columnWidth + columnGap), listY + p.y, p.piece.w, p.piece.h ], "a11y" => a ]);
		}
		show(%[
			"size" => [ sw, sh ],
			"background" => [ 0, 0, 0, 128 ],
			"atlases" => %[ "ui" => atlasPath ],
			"input" => %[ "initial_focus" => "close" ],
			"a11y" => %[ "title" => title ],
			"content" => %[ "type" => "canvas", "width" => sw, "height" => sh, "children" => children ]
		]);
	}

	// text broken into lines of width at size (a word-wrap; Japanese by character)
	function wrapLines(text, size, width, bold)
	{
		setYesNoFont(atlas, size);
		atlas.font.bold = bold;
		return wrapYesNoText(atlas, text, width);
	}

	function drawPiece(p, layer, x, y)
	{
		var lh = textHeight(rowSize) + lineGap;
		switch (p.kind) {
		case "panel":
			layer.copyRect(x, y, yesNoImage(yesnoPanelImage), 0, 0, p.w, p.h);
			break;
		case "title":
			drawOutlined(layer, x + 4, y + 4, p.text, titleSize, true);
			break;
		case "button":
			drawYesNoButtonFrame(layer, x, y, p.w, p.over);
			var tw = textWidth(p.text, 30);
			drawText(layer, x + ((p.w - tw) >> 1), y + ((p.h - textHeight(30)) >> 1), p.text, 30, p.over ? 0xffffff : 0x5025ff);
			break;
		case "head":
			drawOutlined(layer, x + 4, y + textPad + 4, p.text, headSize, true);
			layer.fillRect(x + 4, y + p.h - textPad - 3, p.w - 8, 3, 0xffffffff);
			break;
		case "row":
			for (var i = 0; i < p.keys.count; i++) drawOutlined(layer, x + 4, y + textPad + i * lh, p.keys[i], p.keySize, true);
			for (var i = 0; i < p.lines.count; i++) drawOutlined(layer, x + keyWidth + 16, y + textPad + i * lh, p.lines[i], rowSize, false);
			break;
		}
	}

	// White text with a navy outline, as the dialogs' message
	function drawOutlined(layer, x, y, text, size, bold)
	{
		setYesNoFont(layer, size);
		layer.font.bold = bold;
		drawYesNoString(layer, x, y, text, textColor, yesnoTextBase);
	}

	function onPanelAction(id, payload)
	{
		if (id == "close") defer(close);
		if (id == "change") defer(changeControls);
		if (id == "padtest") defer(padTest);
	}

	function padTest()
	{
		close();
		KAGAfterDialogClosed(KAGShowPadTest);
	}

	// (the next screen opens once this one has gone: KAGAfterDialogClosed)
	function changeControls()
	{
		close();
		KAGAfterDialogClosed(function { kag.showBindings(); });
	}
}

// ------------------------------------------------------------------------------------
// Change Controls (since 0.19.0): the player's own key, controller button and gesture for
// each action (Actions.tjs). A row picked waits for a key or a controller button (Esc: leave
// it; Backspace or Delete: no key); its gesture cell goes round the directions. Reset puts
// the game's back. Kept in the system variables (KAGWindow.rebindKey and the like)
// ------------------------------------------------------------------------------------

/**
 * The bindings of action name: [ key names, controller button names, gesture directions ]
 */
function KAGActionBindings(win, name)
{
	var keys = [], pads = [], dirs = [];
	var bindings = win.keyBindings;
	for (var i = 0; i < bindings.count; i++) {
		var b = bindings[i];
		if (b.actionName == name && win.keyBindingActive(b)) keys.add(KAGKeyName(b.key, b.shift));
	}
	var names = KAGPadButtonNames();
	for (var i = 1; i <= 12; i++) {
		if (typeof global["VK_PAD" + i] != "Integer") continue;
		if (KAGActionNameOf(win.padKeyMap[global["VK_PAD" + i]]) == name) pads.add(names.shown[i - 1]);
	}
	var dirNames = %[ left:tr("Swipe left"), right:tr("Swipe right"), up:tr("Swipe up"), down:tr("Swipe down"), hold:tr("Long press") ];
	var order = [ "left", "right", "up", "down", "hold" ];
	for (var i = 0; i < order.count; i++) dirs.add(dirNames[order[i]]) if win.gestureActions[order[i]] == name;
	return [ keys, pads, dirs ];
}

class KAGBindingsPanel extends KAGElementsScreen
{
	var rowWidth = 1480, rowHeight = 44, rowSize = 24, labelWidth = 560, keysWidth = 400, padsWidth = 230;
	var fullRowHeight = 44, fullRowSize = 24; // (rows shrink to fit the screen: rowHeight, rowSize)
	var gestureWidth = 230, padding = 44, titleSize = 40;
	var quickWidth = 0;   // the quick menu's column (QuickMenu.tjs): whether it shows the action's button
	var moveWidth = 52;   // its buttons moving the action's button earlier or later in the strip
	var waiting = "";     // the action waiting for a key
	var message = "";     // the line under the title
	var strip;            // the quick menu's buttons in their order, a drag putting them in another (since 0.25.0)
	var stripH = 64;

	function KAGBindingsPanel(win)
	{
		super.KAGElementsScreen(win, "Change Controls");
		soundScreen = "bindings";
	}

	function finalize()
	{
		window.keyCapture = void if isvalid window && waiting != "";
		invalidate strip if strip !== void && isvalid strip;
		super.finalize(...);
	}

	function onOpen()
	{
		super.onOpen(...);
		message = tr("Choose an action, then press a key or a controller button for it");
		build();
	}

	function actions()
	{
		var list = [];
		for (var i = 0; i < KAGActionOrder.count; i++) list.add(KAGActionOrder[i]) if KAGActionAvailable(KAGActionOrder[i]);
		return list;
	}

	function build()
	{
		newAtlas();
		// the rows a line high, or less where they'd run off the screen (the quick menu's strip
		// takes room too)
		var hasQuick = quickMenu() !== void;
		rowHeight = fullRowHeight, rowSize = fullRowSize;
		var fixedH = padding * 2 + textHeight(titleSize) + 8 + 16 + textHeight(rowSize) + 8 + 16 +
			(hasQuick ? 16 + textHeight(rowSize) + 8 + 4 + stripH : 0) + 24 + 60 + 24;
		var fit = (height - fixedH) \ (actions().count + 1);
		if (fit < rowHeight) {
			rowHeight = fit < 30 ? 30 : fit;
			rowSize = rowHeight * fullRowSize \ fullRowHeight;
			rowSize = 17 if rowSize < 17;
		}
		var title = tr("Change Controls");
		var titlePiece = addPiece(textWidth(title, titleSize) + 8, textHeight(titleSize) + 8, %[ kind:"title", text:title ]);
		var messagePiece = addPiece(rowWidth, textHeight(rowSize) + 8, %[ kind:"message", text:message ]);
		var buttons = [];
		var buttonIds = [ "reset", "close" ], buttonLabels = [ tr("Reset"), tr("Close") ];
		for (var i = 0; i < buttonIds.count; i++)
			buttons.add([ addPiece(180, 60, %[ kind:"button", text:buttonLabels[i], over:false ]),
				addPiece(180, 60, %[ kind:"button", text:buttonLabels[i], over:true ]) ]);
		var qm = quickMenu();
		quickWidth = qm !== void ? 240 : 0;
		var heads = [ tr("Action"), tr("Keys"), tr("Controller"), tr("Gesture") ];
		heads.add(tr("Quick Menu")) if qm !== void;
