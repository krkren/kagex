			fillRect(x + 3, y + 3, size - 6, size - 6, 0xff5025ff);
			font.height = 14;
			var t = KAGActionLabel(b.action);
			t = t.substring(0, 4) if font.getTextWidth(t) > size - 6;
			drawText(x + (size - font.getTextWidth(t)) / 2, y + (size - 14) / 2, t, 0xffffff, dim);
		}
	}

	function onMouseDown(x, y, button, shift)
	{
		if (button != mbLeft) { super.onMouseDown(...); return; }
		buttons();
