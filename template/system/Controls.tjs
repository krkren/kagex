		var stripSpace = qm !== void ? 16 + dragPiece.h + 4 + stripH : 0;
		var ph = padding * 2 + headerH + rowHeight * (rows.count + 1) + stripSpace + 24 + 60;
		var sw = width, sh = height, px = (sw - pw - shadow) >> 1, py = (sh - ph - shadow) >> 1;
