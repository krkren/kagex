					"frames" => %[ "normal" => rect(r.upNormal), "hilite" => rect(r.upOver), "pressed" => rect(r.upOver) ], "focus_hilite" => 1,
					"a11y" => %[ "label" => tr("Earlier in the quick menu") ] ]);
