}

/**
 * The quick menu's buttons in their order (the player's: scflags.quickMenuOrder), as Change
 * Controls shows them under its rows (since 0.25.0): a press on one lifts it, a drag moves it
 * along (the others making room), letting go puts it there; the ones left out of the strip show
 * dimmed. onMoved(name, index) after a move.
 */
class KAGQuickOrderStrip extends Layer
{
	var window, menu, onMoved;
	var cell = 60, size = 48, names = [], lifted = -1, liftX = 0, grabDX = 0, target = -1;

	function KAGQuickOrderStrip(win, par, qm, moved)
	{
		super.Layer(win, par);
		window = win, menu = qm, onMoved = moved;
		type = ltAlpha;
		face = dfAlpha;
		hitType = htMask;
		hitThreshold = 0;
		visible = true;
		absolute = 1000;
	}

	function setSize(w, h)
	{
		super.setSize(w, h);
		setImageSize(w, h);
		redraw();
