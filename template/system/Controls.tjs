	}

	function drawButton(b, x, y, up)
	{
		var p = b.image !== void ? menu.picture(b.image + "_normal") : void;
		var dim = menu.hidden(b.action) ? 110 : 255;
		if (up) fillRect(x - 3, y - 3, size + 6, size + 6, 0xffffb020);
		if (p !== void) operateStretch(x, y, size, size, p, 0, 0, p.imageWidth, p.imageHeight, omAlpha, dim, stLinear);
		else {
			// a button without a picture: the start of its label in the dialogs' violet
