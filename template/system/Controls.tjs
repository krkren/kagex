		fillRect(0, 0, imageWidth, imageHeight, 0);
		fillRect(0, 2, l.count * cell, imageHeight - 4, 0x30ffffff);
		for (var i = 0, slot = 0; i < l.count; i++) {
			if (i == lifted) continue;
			// the others move aside for the lifted one's place
			if (lifted >= 0 && slot == target) slot++;
			drawButton(l[i], placeX(slot) + (cell - size) / 2, (imageHeight - size) / 2, false);
			slot++;
		}
		if (lifted >= 0) {
			fillRect(placeX(target) + 4, 4, cell - 8, imageHeight - 8, 0x60ffffff);
			drawButton(l[lifted], liftX - grabDX, (imageHeight - size) / 2 - 4, true);
		}
