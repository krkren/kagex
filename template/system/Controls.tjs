		children.add(%[ "type" => "atlas_image", "atlas" => "ui", "rect" => rect(titlePiece),
			"at" => [ x0, y, titlePiece.w, titlePiece.h ], "a11y" => %[ "label" => title, "role" => "heading" ] ]);
		y += titlePiece.h + 16;
		children.add(%[ "type" => "atlas_image", "atlas" => "ui", "rect" => rect(messagePiece),
			"at" => [ x0, y, messagePiece.w, messagePiece.h ], "a11y" => %[ "label" => message ] ]);
		y += messagePiece.h + 16;
		children.add(%[ "type" => "atlas_image", "atlas" => "ui", "rect" => rect(head), "at" => [ x0, y, head.w, head.h ],
