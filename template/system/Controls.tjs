		if (i < 0 || i >= names.count) return;
		lifted = target = i;
		grabDX = x - placeX(i) - (cell - size) / 2;
		liftX = x;
		redraw();
	}

	function onMouseMove(x, y, shift)
	{
		if (lifted < 0) { cursor = x < names.count * cell ? window.cursorPointed : window.cursorDefault; super.onMouseMove(...); return; }
		liftX = x;
