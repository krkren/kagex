	// A text as it's shown: without its font commands, ruby and escapes, new lines as spaces
	function plainText(t) {
		var l = t.length, ret = "", i = 0;
		while (i < l) {
			var ch = t.charAt(i++);
			if (ch == "\\") {
				ch = i < l ? t.charAt(i++) : "";
				if (ch == "\\" || ch == "%" || ch == "[") ret += ch;
			} else if (ch == "%") {
				if (i < l && /[0-9]/.test(t.charAt(i))) {
					while (i < l && /[0-9]/.test(t.charAt(i))) i++;
				} else {
					i++;
