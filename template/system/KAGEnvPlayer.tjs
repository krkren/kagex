					var shown = plainText(t.text), source = plainText(s.text);
					var name = t.disp != "" ? t.disp : t.name, sourceName = s.disp != "" ? s.disp : s.name;
					if (shown.toLowerCase().indexOf(key) < 0 && ((string)name).toLowerCase().indexOf(key) < 0 &&
						source.toLowerCase().indexOf(key) < 0 && ((string)sourceName).toLowerCase().indexOf(key) < 0) continue;
