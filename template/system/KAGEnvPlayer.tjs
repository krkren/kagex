		var depth = 0, obj;
		while ((obj = getLine(cur++)) !== void) {
			if (typeof obj != "Object" || typeof obj[0] != "String") continue;
			switch (obj[0]) {
			case "*if":
				depth++;
				break;
			case "*endif":
				if (depth-- == 0) return;
				break;
			}
		}
	}


	/**
	 * Check process
	 */
	function check(elm) {
		// End
		if (curSceneName === void) {
			return 0;
		}
		// Next line
		var obj = getLine(cur++);
		if (obj === void) {
			return 0;
		}
		switch (typeof obj) {
		case "Object":
			if (typeof obj[SAVE_POINT] == "Integer") {
				//restore(obj[SAVE_STATE]);
			} else if (isControl(obj)) {
				control(obj);
			} else {
				if (!kag.skipNoDisp || dotags[obj[0]] || (seeking && !seekPasses[obj[0]])) {
					extractTag(obj);
				}
			}
			break;
		}
		addTagSimple("scenecheck");
		return 0;
	}

	/**
	 * Reconstruct tag info
	 * Restore tags stored as arrays
	 * @param obj Tag info
	 */
	function extractTag(obj) {
		var tagname = obj[0];
		if (tagname == "") {
			return;
		}
		// in the order KAGParser makes them: the name, then the attributes as written
		var elm = %[tagname:tagname];
		var count = obj.count;
		var i=1;
		for (;i<count;i++) {
			var id = obj[i];
			if (id === 0) {
				i++;
				break;
			}
			elm[id] = "true";
		}
		var cond, mp, entities;
		for (;i<count;i+=2) {
			var name = obj[i], value = obj[i+1];
			if (name == "*cond") { cond = value; continue; }
			if (name == "*mp") { mp = value; continue; }
			if (typeof value == "String") {
				var c = value.charAt(0);
				if (c == "&") {
					// an & entity, worked out now as KAG does when it reads the tag
					entities = [] if entities === void;
					entities.add(name);
				} else if (c == "`") {
					value = value.substr(1);
				}
			}
			elm[name] = value;
		}
		if (cond !== void && !evalWithMp(cond, mp)) {
			return;
		}
		if (entities !== void) {
			for (var j=0;j<entities.count;j++) {
				var v = evalWithMp(((string)elm[entities[j]]).substr(1), mp);
				elm[entities[j]] = v !== void ? (string)v : void;
			}
		}
		if (mp !== void) {
			// a tag from a macro: mp is its arguments while it runs
			addTag(%[tagname:"scnmp", mp:mp]);
			addTag(elm);
			addTag(%[tagname:"scnmp"]);
		} else {
			addTag(elm);
		}
	}


	var currentRuby;
	var currentRubyCount;
	var currentText;
	// The message as it's drawn, for the word wrap (KAGWindow.needsToBeWrapped): every ch
	// tag of a message carries it as wrap = %[key, line]
	var currentWrap;
	var wrapSerial = 0;

	function processRuby(text) {
		if (text.length > 0) {
			var p;
			if ((p = text.indexOf(",")) >= 0) {
				// Target character count specification exists on the ruby side
				currentRuby      = text.substr(0,p);
				currentRubyCount = +text.substr(p+1);
			} else {
				currentRuby = text;
				currentRubyCount = 0;
			}
		}
	}

	function processCh(ch) {
		currentText += ch;
		if (currentRubyCount > 0) {
			currentRubyCount--;
			return;
		}
		if (currentRuby != "") {
			addTag(%[tagname:"ruby", text:currentRuby]);
		}
		addTag(%[tagname:"ch", text:currentText, wrap:currentWrap]);
		currentRuby = "";
		currentText = "";
	}

	/**
	 * Expand text into tags
	 * @param id Text ID
	 */
	function extractText(text) {

		var flag = text.flag;
		// in the language shown (doc/scn.txt, "Languages")
		text = scnTextIn(text);

		if ((flag & TEXTFLAG_NOTEXT)) {

			// XXX No standalone voice playback process, so using this as a workaround for now
			kag.textWriteEnabled = false;
			// Display name
			addTag(nameTag(text, true));

		} else {

			kag.textWriteEnabled = true;

			// after a jump (going back, a load) the message window starts empty: a text that
			// carried it on gets the window's earlier lines back first (redrawPage), or starts it
			var cont = (flag & TEXTFLAG_CONT) && !freshMessage;
			if ((flag & TEXTFLAG_CONT) && freshMessage) cont = redrawPage(getHistoryCount() - 1);
			freshMessage = false;
			// the backlog line what this click shows starts on goes back to it
			addTag(%[tagname:"scnhistmark", pos:getHistoryCount() - 1]) if unitStart;
			if (!cont) {
				// Show message window
				addTagSimple("msgon");

				// Display name
				addTag(nameTag(text, true));
			}
			emitText(text, !cont);
		}

		// Wait process entry
		if (!(flag & TEXTFLAG_NOWAIT)) {
			if ((flag & TEXTFLAG_LINE)) {
				addTag(%[tagname:"l", voicewait:true]);
				addTagSimple("afterline");
			} else {
				if ((flag & TEXTFLAG_NOER)) {
					kag.noErOnce = true;
				}
				addTag(%[tagname:"p", nosave:true]);
			}
		}
	}

	/**
	 * The dispname tag for a text (scnTextIn's, in the language shown): with more than one
	 * language, its display name in each (disps, by code), so the window can draw the name again
	 * in another one (KAGEnvironment works out each from the character's nameAlias)
	 */
	function nameTag(text, voice) {
		var tag = %[tagname:"dispname", name:text.name, disp:text.disp];
		tag.voice = text.voice if voice;
		if (text.langs !== void) {
			tag.lang = text.lang;
			tag.disps = scnTextsByLanguage(text, 0);
		}
		return tag;
	}

	/**
	 * A text drawn (scnTextIn's, in the language shown). In a game in more than one language it's
	 * a text unit (the textunit and endtextunit tags) holding the text in every language, so the
	 * window can draw it again in another one (MessageLayer.redrawTextIn)
	 */
	function emitText(t, firstCh, redraw = false) {
		var texts = scnTextsByLanguage(t);
		if (texts === void || global.KAGLanguage === void || !KAGLanguage.available) {
			emitChars(t.text, firstCh, redraw);
			return;
		}
		addTag(%[tagname:"textunit", texts:texts]);
		emitChars(t.text, firstCh, redraw);
		// a language without spaces between its words breaks lines anywhere (KAG's own wrap)
		if (!KAGLanguage.wordWrap(t.lang)) currentWrap.line = "";
		addTagSimple("endtextunit");
	}

	/**
	 * A text's characters as tags (ch, r, font, ruby, indent), with the wrap they're drawn with
	 * @param t the text
	 * @param firstCh it starts the message (auto-indent)
	 * @param redraw it's drawn again from the history (redrawPage): its click waits (\k) are left out
	 */
	function emitChars(t, firstCh, redraw = false) {
			currentRubyCount = 0;
			currentRuby = void;
			currentText = "";
			// filled in below, before KAG draws the characters
			currentWrap = %[key:"scene:" + (++wrapSerial), line:""];
			var wrapLine = "", wrapNewline = false;

			var indentCharacter = void;
			var indentLevel = 0;

			// Expand text
			var l = t.length;
			//dm("Display text:" + t);
			for (var i=0;i<l;) {
				var ch = t.charAt(i++);
				var literal = false;
				// Escape command: \\, \% and \[ are those characters, \k waits for a click
				if (ch == "\\") {
					if (i < l) {
						ch = t.charAt(i++);
					}
					switch (ch) {
					case "\\":
					case "%":
					case "[":
						literal = true;
						break;
					case "k":
						addTag(%[tagname:"l"]) if !redraw;
					default:
						continue;
					}
				}
				if (!literal && ch == "\n") {
					// Newline processing
					addTagSimple("r");
					wrapNewline = true;
				} else if (!literal && ch == "%") {
					// Font command
					if (i < l) {
						ch = t.charAt(i++);
						if (/[0-9]/.test(ch)) {
							var value = ch;
							while (i < l) {	ch = t.charAt(i); if (!/[0-9]/.test(ch)) break; value += ch; i++; }
							value = +value;
							value = value ? string(value) : "default";
							addTag(%[tagname:"font", size:value]);
						} else {
							// Tentative XXX
							switch (ch) {
								//case "b": bold = true; break;
								//case "i": italic = true; break;
								//case "n": bold = false, italic = false; break;
								//case "s": shadow = true; break;
								//case "e": edge = true; break;
							case "r": addTagSimple("resetfont"); break;
							default: break;
							}
						}
					}
				} else if (!literal && ch == "[") {
					// Ruby processing
					var text = "";
					while (i<l && (ch = t.charAt(i++)) != "]") {
						text += ch;
					}
					processRuby(text);
				} else {
					// Auto-indent processing
					var indentBeginIdx = -1, indentEndIdx = -1;
					if (kag.autoIndent) {
						indentBeginIdx = kag.autoIndentBeginCharacters.indexOf(ch);
						indentEndIdx   = kag.autoIndentEndCharacters  .indexOf(ch);
					}
					if (kag.autoIndent < 0 && firstCh && indentBeginIdx >= 0) {
						addTag(%[tagname:"preindent", text:ch ]);
					}

					// Add character
					processCh(ch);
					wrapLine += ch;

					// Auto-indent post-processing
					if (indentBeginIdx >= 0) {
						if (firstCh) {
							indentCharacter = kag.autoIndentBeginCharacters.charAt(indentBeginIdx);
							addTagSimple("indent");
						}
						indentLevel++;
					} else if (indentEndIdx >= 0) {
						if (indentLevel == 1) {
							var pair = kag.autoIndentBeginCharacters.indexOf(indentCharacter);
							addTagSimple("endindent") if (pair == indentEndIdx);
						}
						indentLevel--;
					}

					firstCh = false;
				}
			}
			// with a new line in it the character wrap does it, as for a scenario line with [r]
			currentWrap.line = wrapNewline ? "" : wrapLine;
	}

	// -----------------------------------------------------------
	// The message window after a jump: a click in the middle of a window (its text carries the
	// window on, TEXTFLAG_CONT) gets the window's earlier lines back, drawn at once from the
	// history, as the window showed them when the game was there (going back, a load)
	// -----------------------------------------------------------

	// What clears the message window between two texts: KAG's clearing tags (a [p] of its own
	// clears it unless *noer comes before it)
	var pageClears = %[cm:true, ct:true, er:true, clearlayers:true, msgoff:true];
	var maxPageTexts = 50;

	// A scene's data (its lines and texts) by its name
	function sceneOf(sceneName) {
		var storage = getStorage(sceneName);
		var sd = scnStorage;
		if (sd === void || sd.storage != storage) {
			if (storageCache === void || storageCache.storage != storage) {
				invalidate storageCache if storageCache !== void;
				storageCache = new StorageData(storage);
			}
			sd = storageCache;
		}
		return sd.findScene(getLabel(sceneName));
	}

	// Where text id is in a scene's lines (-1: nowhere)
	function textLine(scene, id) {
		var lines = scene.lines;
		for (var i = 0; i < lines.count; i++) if (lines[i] === id) return i;
		return -1;
	}

	// The steps between two texts of a scene's lines (from after index a to before index b):
	// how many [r]s they hold, or -1 when one of them clears the message window
	function stepsBetween(lines, a, b, rs) {
		var noer = false;
		for (var i = a + 1; i < b; i++) {
			var obj = lines[i];
			if (typeof obj != "Object" || typeof obj[SAVE_POINT] == "Integer") continue;
			var name = obj[0];
			if (typeof name != "String") continue;
			if (name == "*noer") { noer = true; continue; }
			if (name == "r") rs++;
			else if (pageClears[name] || (name == "p" && !noer)) return -1;
			if (name == "p") noer = false;
		}
		return rs;
	}

	// The texts the message window showed before the text at history position pos, which
	// carries it on: %[text, rs] (rs: the [r]s after it), oldest first; empty when it starts
	// the window. Back through the history while the window wasn't cleared: a text that waited
	// with [p] (unless NOER), a clearing tag between two texts, a choice, a text that opened
	// the window (no TEXTFLAG_CONT, which is taken), or another script
	function pageBefore(pos) {
		var page = [];
		var b = historyBlock(pos);
		if (b === void || b.text !== void) return page;
		var bScene = b.scene, bId = b.idx + (pos - b.startNo);
		var bData = sceneOf(bScene);
		if (bData === void) return page;
		var bLine = textLine(bData, bId);
		var pendingRs = 0; // [r]s after a text that isn't drawn (TEXTFLAG_NOTEXT)
		for (var p = pos - 1; p >= 0 && page.count < maxPageTexts; p--) {
			var a = historyBlock(p);
			if (a === void || a.text !== void) break;
			var aScene = a.scene, aId = a.idx + (p - a.startNo);
			if (getStorage(aScene).toLowerCase() != getStorage(bScene).toLowerCase()) break;
			var aData = sceneOf(aScene);
			if (aData === void || aData.texts === void) break;
			var at = convertSceneText(aData.texts[aId - 1], aData.languages);
			if (at === void) break;
			var aFlag = +at.flag;
			// its own wait: [p] clears the window (but with NOER), [l] and none carry it on
			if (!(aFlag & (TEXTFLAG_LINE | TEXTFLAG_NOWAIT)) && !(aFlag & TEXTFLAG_NOER)) break;
			var aLine = textLine(aData, aId);
			if (aLine < 0 || bLine < 0) break;
			var rs;
			if (aScene == bScene) {
				rs = stepsBetween(aData.lines, aLine, bLine, 0);
			} else {
				// the end of one scene, then the start of the next
				rs = stepsBetween(aData.lines, aLine, aData.lines.count, 0);
				rs = stepsBetween(bData.lines, -1, bLine, rs) if rs >= 0;
			}
			if (rs < 0) break;
			if (!(aFlag & TEXTFLAG_NOTEXT)) {
				page.unshift(%[text:scnTextIn(at), rs:rs + pendingRs]);
				pendingRs = 0;
			} else {
				pendingRs += rs;
			}
			if (!(aFlag & TEXTFLAG_CONT)) break; // it opened the window
			bScene = aScene;
			bData = aData;
			bLine = aLine;
		}
		return page;
	}

	/**
	 * Draws the message window's earlier lines again before the text at history position pos
	 * (pageBefore): at once, without voices, waits or the backlog (it has them already)
	 * @return whether there were any (the text then carries the window on)
	 */
	function redrawPage(pos) {
		if (kag.skipNoDisp) return false;
		var page = pageBefore(pos);
		if (page.count == 0) return false;
		var first = page[0].text;
		addTagSimple("msgon");
		addTag(nameTag(first, false));
		var history = kag.historyWriteEnabled;
		addTag(%[tagname:"history", output:0]) if history;
		addTagSimple("nowait");
		for (var i = 0; i < page.count; i++) {
			var e = page[i];
			emitText(e.text, i == 0, true);
			for (var r = 0; r < e.rs; r++) addTagSimple("r");
		}
		addTagSimple("endnowait");
		addTag(%[tagname:"history", output:1]) if history;
		return true;
	}

	// -----------------------------------------------------------

	// Current execution info
	function getCurrentInfo() {
		if (converting) {
			// Return parser info while converting
			return parser.getCurrentInfo();
		}
		return %[
		file:curStorage,
		line:curLine,
		label:curLabel,
		lineStr:curText !== void ? curText.text : "",
			];
	}

	// -------------------------------------------------------------

	var selectInfos; // the choices on show (KAGWindow's f.selectInfos)

	/**
	 * Callback when choice processing starts on KAG side
	 */
	function onSelectStart(selectInfos) {
		// the backlog gets the choice that's taken (onSelect), as rebuildBacklog writes it
		this.selectInfos = selectInfos;
	}

	/*
	 * Callback when choice processing is executed on KAG side
	 */
	function onSelect(text)  {
		if (working) {
			dm("Choice complete:" + text);
			// the choice in every language (choiceTexts), for the backlog
			var texts;
			for (var i = 0; selectInfos !== void && i < selectInfos.count; i++) {
				var e = selectInfos[i];
				if (e !== void && e.text == text) { texts = e.texts; break; }
			}
			selectInfos = void;
			addHistorySelect(text, texts);
			var hl = kag.historyLayer;
			if (kag.historyWriteEnabled && hl !== void) {
				storeBacklogText(hl, getHistoryData(getHistoryCount() - 1).text);
				endBacklogMessage(hl);
			}
		}
	}

	/*
	 * Process to intercept transition when next is executed on KAG side
	 */
	function onNext(file, label) {
		if (working) {
			//dm(@"Next scene call storage:${file} target:${label}");
			var storage = file != "" ? Storages.extractStorageName(file) : curStorage;
			if (storage.toLowerCase() != curStorage.toLowerCase()) {
				// another script: KAG loads it, so it's the conductor's script again, and the
				// player starts there if it's compiled (KAGWorldPlugin.onScenarioLoad)
				handoff = %[storage:storage.toLowerCase()];
				storeHistory(handoff);
				storeHistoryOfStore(handoff);
				return;
			}
			startScene(storage, label);
			// Call confirmed, clear queue and proceed
			clearTag();
			addTagSimple("sceneplay");
			//dm("Call processing complete");
			return true;
		}
	}

	/**
	 * Process called when hidden skip ends on KAG side
	 */
	function onSync() {
		//dm("onSync:" + curState);
		if (curState !== void) {
			restore(curState);
		}
	}

	/**
	 * Callback when transition occurs on KAG side. Clear state.
	 */
	function onProcess(usingExtraConductor) {
		if (!usingExtraConductor) {
			clearInfo();
		}
	}
};