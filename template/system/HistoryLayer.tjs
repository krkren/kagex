class LButtonLayer extends ButtonLayer

	// Button layer modified to send onClick events to the parent

{

	function LButtonLayer(window, parent)

	{

		super.ButtonLayer(window, parent);

		focusable = false;

	}



	function finalize()

	{

		super.finalize(...);

	}



	function onClick()

	{

		super.onClick(...);

	}



	function onExecute(x, y, button, shift)

	{

		if(enabled && button == mbLeft)

			parent.onButtonClick(this);

		super.onExecute(...);

	}



}



// Where the history wraps inside a Latin word (an English name in Japanese text, which wraps a
// character at a time): the word, with any opening bracket before it, goes to the next line whole
// unless it fills the line on its own (since 0.18.0). Returns [ the line kept, what moves on ].
function KAGHistoryCarryWord(line, ch, leading)
{
	if (ch.length != 1 || !/[A-Za-z0-9]/.test(ch)) return [ line, "" ];
	var i = line.length;
	while (i > 0 && /[A-Za-z0-9]/.test(line.charAt(i - 1))) i--;
	if (i == line.length) return [ line, "" ];
	while (i > 0 && leading !== void && leading.indexOf(line.charAt(i - 1)) >= 0) i--;
	if (i == 0) return [ line, "" ];
	return [ line.substring(0, i), line.substring(i) ];
}

class HistoryLayer extends Layer

{

	var prevPageButton = void;

	var nextPageButton = void;

	var closeButton = void;

	// Since 0.21.0 the text scrolls by the pixel and can be dragged and flicked (touch screens):

	// it's drawn on textPage, inside textClip (the text area), where it always was (display line n

	// at n*lineHeight + controlHeight + marginT), and textPage moves up by scrollSub px; the line

	// under the last is drawn too, for the part that shows between lines. Pulling the newest line

	// up by closePull px and letting go closes the history, as turning the wheel past it does

	var textClip = void, textPage = void;

	var scrollSub = 0;

	var dragY = void, dragPx = 0, dragging = false, pressX, pressY, dragPace = 0, dragSamples = [];

	var coastTimer = void, coastSpeed = 0.0, coastPx = 0.0, coastTick = 0, inCoast = false;

	var overPull = 0, closePull = 150, pullNote = void, pullNoteText = "";



	var antialiased = true; // Whether to perform anti-aliased text rendering
	var verticalView = false; // Whether it is vertical writing
	var everypage = false;	// Whether to display history per page
	var autoReturn = true; // Whether to line wrap automatically
	var maxLines = 2000; // Maximum number of lines to keep


	var data = []; // Line data (ring buffer)
	var lineStart = []; // Line display start position (ring buffer)
	var actionInfo = []; // History click information (ring buffer)
	var dataStart = 0; // Data start position
	var dataLines = 0; // Number of lines in data < maxLines -1
	var dataPos = 0; // Data write position


		// Page-based viewing function code provided by kiyobee.
		// I would like to take this opportunity to thank them.


	//	When using "per page", data, lineStart, and actionInfo are used in 2D.
	var maxPages = 100;	//	Maximum number of pages
	var dataPages = 0;	//	Number of valid pages in data
	var dataPage = 0;//	Current page being written


	var marginL = 40; // 1920x1080 (the 640x480 original had 12)

	var marginR = 40;

	var marginT = 24;

	var marginB = 24;

	var fontName = "Yu Gothic Medium,Yu Gothic,Noto Sans JP,Roboto"; // Config.tjs sets the one in use

	var fontBold = false;

	var fontHeight = 24;

	var lineHeight = 26;

	var relinePos_org = 0; // Line wrap position
	var limitPos_org = 0; // Screen edge position
	var relinePos = 0; // Line wrap position
	var limitPos = 0; // Screen edge position
	var indentPos = 0; // Indentation position
	var repageLine = 0;	//	Lines per page


	var historyColor = 0xffffff;	//	History text color


	var controlHeight = 48; // the page and close buttons along the top (20 at 640x480)



	var dispStart = 0;

	var dispLines = 0;

	var canScroll = false;



	var currentLine = "";



	var currentAction = void;

	var currentActionExp = void;

	var currentActionID = 1;



	var lastHighlightedActionID = 0;



	var lastWheelTick; // Tick count of the last wheel operation
	var wheelRest = 0; // wheel delta short of a notch (120), carried to the next event


	var storeState = false; // Whether to save state to bookmarks


	//	Prohibited characters (Kinsoku shori)
	var wwFollowing = "%),:;]}｡｣ﾞﾟ。，、．：；゛゜ヽヾゝ"

                "ゞ々’”）〕］｝〉》」』】°′″℃¢％‰"; // Characters prohibited at the start of a line
	var wwFollowingWeak="!.?､･ｧｨｩｪｫｬｭｮｯｰ・？！ーぁぃぅぇぉっゃゅょゎァィ"

                "ゥェォッャュョヮヵヶ"; // (Weak) Characters prohibited at the start of a line
	var wwLeading="\\$([{｢‘“（〔［｛〈《「『【￥＄£"; // Characters prohibited at the end of a line


	wwFollowing += wwFollowingWeak;



	function HistoryLayer(win, par)

	{

		super.Layer(...);

		(HistoryLayer_config incontextof this)(); // configuration

		(HistoryLayer_config_override incontextof this)()

			if typeof global.HistoryLayer_config_override != "undefined";



		name = "Message History Layer";



		setImageSize(parent.width, parent.height);

		setSizeToImageSize();

		hitType = htMask;

		hitThreshold = 1;



		font.height = fontHeight;

		font.bold = fontBold;

		if(verticalView)

		{

			font.angle = 2700;

			font.face = '@' + fontName;

		}

		else

		{

			font.angle = 0;

			font.face = fontName;

		}



		focusable = true;



		cursor = window.cursorDefault;



		clear();

	}



	function finalize()

	{

		invalidate prevPageButton if prevPageButton !== void;

		invalidate nextPageButton if nextPageButton !== void;

		invalidate closeButton if closeButton !== void;

		invalidate coastTimer if coastTimer !== void;

		invalidate pullNote if pullNote !== void;

		invalidate textPage if textPage !== void;

		invalidate textClip if textClip !== void;

		invalidate richTextApp if richTextApp !== void;

		super.finalize(...);

	}



	function clear()

	{

		// Clear content
		lineStart = [];

		actionInfo = [];

		dataStart = 0;

		dataLines = 0;

		dataPos = 0;

		dataPages = 0;

		dataPage = 0;



		if(everypage)

		{

			data[dataPage]	= [];

			lineStart[dataPage]	= [];

			actionInfo[dataPage] = [];

		}

		else

			dataLines = 1;





		currentLine = "";



		currentAction = void;

		currentActionExp = void;

		currentActionID = 1;



		lastHighlightedActionID = 0;



		calcRelinePos();

	}



	function save() {

		// Code for saving history to bookmarks provided by Yun-shi.
		// I would like to take this opportunity to thank them.
		if(!storeState) return void;

		var dic = %[];

		if(everypage)

		{

			dic.lineStart = lineStart;

			dic.actionInfo = actionInfo;

			dic.data = data;

		}

		else

		{

			(dic.lineStart = []).assignStruct(lineStart);

			(dic.actionInfo = []).assignStruct(actionInfo);

			(dic.data = []).assignStruct(data);

		}

		dic.dataStart = dataStart;

		dic.dataPos = dataPos;

		dic.dataPages = dataPages;

		dic.dataPage = dataPage;

		dic.dataLines = dataLines;

		dic.currentLine = dic.currentLine;

		dic.currentAction = currentAction;

		dic.currentActionExp = currentActionExp;

		dic.currentActionID = currentActionID;

		dic.lastHighlightedActionID = lastHighlightedActionID;

		return dic;

	}



	function load(dic) {

		if(!storeState) return;

		if(dic === void) return;

		lineStart.assignStruct(dic.lineStart);

		actionInfo.assignStruct(dic.actionInfo);

		data.assignStruct(dic.data);

		dataStart = dic.dataStart;

		dataPos = dic.dataPos;

		dataPages = dic.dataPages;

		dataPage = dic.dataPage;

		dataLines = dic.dataLines;

		currentLine = dic.currentLine;

		currentAction = dic.currentAction;

		currentActionExp = dic.currentActionExp;

		currentActionID = dic.currentActionID;

		lastHighlightedActionID = dic.lastHighlightedActionID;

		calcRelinePos();

	}



	function calcRelinePos()

	{

		if(verticalView)

		{

			relinePos = relinePos_org = height - marginT - marginB - controlHeight;

			limitPos =  limitPos_org = height - marginT - controlHeight;

			repageLine	= (width - marginL - marginR) \ lineHeight;

		}

		else

		{

			relinePos = relinePos_org = width - marginL - marginR;

			//	Calculate the number of lines serving as a page break standard
			limitPos = limitPos_org = width - marginL;

			repageLine	= (height - marginT - marginB - controlHeight) \ lineHeight;

		}

	}



	function setOptions(elm)

	{

		// Set options
		if(elm.autoreturn !== void)

			autoReturn = +elm.autoreturn;

	}



	function makeButtons()

	{

		if(prevPageButton !== void) return; // Already created

		// the text's own layers, under the buttons (placeText sizes them)

		textClip = new global.Layer(window, this);

		textClip.name = "history text area";

		textClip.hitType = htMask;

		textClip.hitThreshold = 256; // the clicks and drags are the history layer's

		textPage = new global.Layer(window, textClip);

		textPage.name = "history text";

		textPage.type = ltAlpha;

		textPage.hitType = htMask;

		textPage.hitThreshold = 256;

		textPage.visible = true;


		prevPageButton = new LButtonLayer(window, this);

		nextPageButton = new LButtonLayer(window, this);

		closeButton = new LButtonLayer(window, this);



		if(verticalView)

		{

			nextPageButton.left    = 0;

			nextPageButton.top     = 0;

			nextPageButton.width   = (width-controlHeight) \ 2;

			nextPageButton.height  = controlHeight-2;

			nextPageButton.caption = tr("≪ Next Page ");

			nextPageButton.color   = 0x808080;

			nextPageButton.visible = true;



			prevPageButton.left    = nextPageButton.width;

			prevPageButton.top     = 0;

			prevPageButton.width   = nextPageButton.width;

			prevPageButton.height  = controlHeight-2;

			prevPageButton.caption = tr(" Prev Page ≫");

			prevPageButton.color   = 0x808080;

			prevPageButton.visible = true;

		}

		else

		{

			prevPageButton.left    = 0;

			prevPageButton.top     = 0;

			prevPageButton.width   = (width-controlHeight) \ 2;

			prevPageButton.height  = controlHeight-2;

			prevPageButton.caption = tr("≪ Prev Page ");

			prevPageButton.color   = 0x808080;

			prevPageButton.visible = true;



			nextPageButton.left    = prevPageButton.width;

			nextPageButton.top     = 0;

			nextPageButton.width   = prevPageButton.width;

			nextPageButton.height  = controlHeight-2;

			nextPageButton.caption = tr(" Next Page ≫");

			nextPageButton.color   = 0x808080;

			nextPageButton.visible = true;

		}



		closeButton.left      = width-controlHeight;

		closeButton.top       = 0;

		closeButton.width     = controlHeight;

		closeButton.height    = controlHeight-2;

		closeButton.caption   = "×";

		closeButton.captionColor= 0xffffff;

		closeButton.color     = 0x707090;

		closeButton.visible   = true;

		closeButton.hint      = tr("Close message history");

		// Their captions in the history's face list and in proportion to the buttons: the button

		// default (an empty face) draws as arrows on the SDL engine

		var buttons = [ prevPageButton, nextPageButton, closeButton ];

		for (var i = 0; i < buttons.count; i++) {

			buttons[i].font.face = fontName;

			buttons[i].font.height = controlHeight * 5 \ 8;

			buttons[i].update();

		}



	}



	property lastLine

	{

		getter

		{

			if(everypage)

				return data[dataPage][dataPos];

			else

				return data[dataPos];

		}

		

		setter(line)

		{

			if(everypage)

				data[dataPage][dataPos]	= line;

			else

				data[dataPos] = line;

		}

	}



	property lastAction

	{

		getter

		{

			if(everypage)

				return actionInfo[dataPage][dataPos];

			else

				return actionInfo[dataPos];

		}

		

		setter(n)

		{

			if(everypage)

				actionInfo[dataPage][dataPos]	= n;

			else

				actionInfo[dataPos] = n;

		}

	}



	function getLine(n)

	{

		// Get the n-th line
		n += dataStart;

		if(n >= maxLines) n -= maxLines;

		return data[n];

	}



	function getPage(n)

	{

		// Get the n-th page
		n += dataStart;

		if(n >= maxPages) n -= maxPages;

		return data[n];

	}



	function getLineStart(n)

	{

		// Get the display start position of the n-th line
		n += dataStart;

		if(n >= maxLines) n -= maxLines;

		return lineStart[n];

	}



	function getLineStart2(n, m)

	{

		// Get the display start position of the m-th line on the n-th page
		n += dataStart;

		if(n >= maxPages) n -= maxPages;

		return lineStart[n][m];

	}



	function getActionInfo(n)

	{

		// Get the n-th action info
		n += dataStart;

		if(n >= maxLines) n -= maxLines;

		return actionInfo[n];

	}



	function getActionInfo2(n, m)

	{

		// Get the action info of the m-th line on the n-th page
		n += dataStart;

		if(n >= maxPages) n -= maxPages;

		return actionInfo[n][m];

	}



	function endAction()

	{

		if(currentAction !== void)

		{

			// If current action already exists
			var ca = currentAction;

			var last = ca[ca.count - 1];

			last.end = textWidth(currentLine);

		}

	}



	function setNewAction(action)

	{

		// Set a new action
		if(action == "") action = void;

		if(action === void) return;

		endAction();

		currentActionExp = action;

		if(currentAction == void) currentAction = [];

		var last = currentAction[currentAction.count] = %[];

		last.start = textWidth(currentLine);

		last.action = action;

		last.id = ++currentActionID;

	}



	function continueAction()

	{

		if(currentActionExp === void) return;

		if(currentAction == void) currentAction = [];

		var last = currentAction[currentAction.count] = %[];

		last.start = textWidth(currentLine);

		last.action = currentActionExp;

		last.id = currentActionID;

	}



	function clearAction()

	{

		endAction();

		currentActionExp = void;

	}



	function store(ch)

	{

		if(!autoReturn)

		{

			// When not performing automatic line wrapping
			currentLine += ch;

		}

		else

		{

			// When performing automatic line wrapping
			var len;

			if((len = textWidth(currentLine += ch)) >= relinePos)

			{

				var curlen = currentLine.length;

				var lastch = curlen >= 2 ? currentLine[curlen - 2] : '';



				if(((lastch=='' || wwLeading.indexOf(lastch)==-1) &&

					wwFollowing.indexOf(ch)==-1) ||

					(lastch!='' && wwFollowingWeak.indexOf(lastch)!=-1 &&

						wwFollowingWeak.indexOf(ch)!=-1) || len > limitPos)

				{

					// If the last character drawn is not a trailing prohibited character
					// And the character about to be drawn is not a leading prohibited character
					// Or if weak prohibited characters are not continuous
					// Or if the character to be drawn is not a strong prohibited character,
					// but definitely exceeds the right edge
					// (In this case, margins are not considered)
					currentLine=

						currentLine.substring(0, currentLine.length - ch.length);	//	Remove the added character

					var carried = KAGHistoryCarryWord(currentLine, ch, wwLeading);

					currentLine = carried[0];

					reline();

					currentLine = carried[1] + (ch == " " ? "" : ch); // English: drop the space a line wrapped at

				}

			}

		}

	}



	function repage()

	{

		//	New page
		if(!everypage) return;



		if(dataPos == 0 && currentLine == "") return; // Do nothing if no data is present


		endAction();

		lastLine	= currentLine;

		lastAction = currentAction;



		dataPage++;

		if(dataPage >= maxPages)	dataPage = 0;

		dataPos	= 0;

		data[dataPage]	= [];

		lineStart[dataPage]	= [];

		lineStart[dataPage][dataPos]	= indentPos;

		actionInfo[dataPage] = [];

		actionInfo[dataPage][dataPos] = currentAction;

		if(dataPage == dataStart)	dataStart++;

		if(dataStart >= maxPages)	dataStart = 0;

		if(dataPages < maxPages-1)	dataPages++;



		currentAction = void;

		currentLine	= '';

		continueAction();

	}



	function reline()

	{

		// New line


		if(everypage)

		{

			if(dataPos + 1 >= repageLine)

			{

				//	When the number of lines reaches the page break limit
				repage();

			}

			else

			{

				endAction();

				lastLine = currentLine;

				lastAction = currentAction;



				dataPos++;

				lineStart[dataPage][dataPos] = indentPos;

				limitPos = limitPos_org - indentPos;

				relinePos = relinePos_org - indentPos;



				currentAction = void;

				currentLine = '';

				continueAction();

			}

		}

		else

		{

			endAction();

			lastLine = currentLine;

			lastAction = currentAction;



			dataPos++;

			if(dataPos >= maxLines) dataPos=0;

			data[dataPos] = void;

			lineStart[dataPos] = indentPos;

			limitPos = limitPos_org - indentPos;

			relinePos = relinePos_org - indentPos;

			if(dataPos == dataStart) dataStart++;

			if(dataStart >= maxLines) dataStart = 0;

			if(dataLines < maxLines) dataLines++;



			currentAction = void;

			currentLine = '';

			continueAction();

		}



	}



	function beginIndent()

	{

		// Set indentation at the current position
		indentPos = textWidth(currentLine);

	}



	function endIndent()

	{

		// Release indentation
		indentPos = 0;

	}



	// the background (n void: the layer's own, and the text's cleared unless background is false),

	// or display line n's rows of the text (since 0.21.0 the text has layers of its own)

	function clearBack(n, background=true)

	{

		if(n === void)

		{

			if(background)

			{

				face = dfAlpha;

				fillRect(0, 0, width, height, 0xc8000000);

			}

			if(textPage !== void)

			{

				textPage.face = dfAlpha;

				textPage.fillRect(0, 0, textPage.imageWidth, textPage.imageHeight, 0);

			}

		}

		else if(textPage !== void)

		{

			textPage.face = dfAlpha;

			if(verticalView)

				textPage.fillRect(width - marginR - (n+1)*lineHeight, controlHeight, lineHeight, height - controlHeight, 0);

			else

				textPage.fillRect(0, n*lineHeight + controlHeight + marginT, textPage.imageWidth, lineHeight, 0);

		}

	}



	function dispInit()

	{

		KAGInterfaceSound("backlog.open"); // the interface sound table's (since 0.18.0)

		// Full redraw and initial settings
		makeButtons(); // Create buttons


		lastLine = currentLine;

		endAction();

		lastAction = currentAction;



		antialiased = window.chDefaultAntialiased;

		if(!everypage)

		{

			if(verticalView)

				dispLines = (width - marginR - marginL) \ lineHeight;

			else

				dispLines = (height - marginT - marginB - controlHeight) \ lineHeight;

		}

		scrollSub = 0;

		setOverPull(0);

		stopCoast();

		dragY = void, dragging = false;

		placeText();

		clearBack();



		if(everypage)

		{

			if(dataPages>0)

			{

				canScroll	= true;

				dispStart	= dataPages - 1;

			}

			else

			{

				canScroll	= false;

				dispStart	= 0;

			}

			drawPage();

		}

		else

		{

			// the newest lines; the history scrolls when they don't all fit

			canScroll = dataLines > dispLines;

			dispStart = canScroll ? dataLines - dispLines : 0;

			drawLines();

		}


		updateButtonState();

		visible = true;

//		setMode();

		focus();

		lastWheelTick = 0;



		cursor = window.cursorDefault;

	}



	function dispUninit()

	{

		// Called from window

		stopCoast();

		setOverPull(0);

		dragY = void, dragging = false;

		removeMode();

		visible = false;

	}



	// krkr_richtext drawing for the history text when the message layers use it

	// (useRichText), so it matches the message window. Void for vertical text, or when

	// the plugin or the faces are unavailable

	var richTextApp;

	var richTextBase = %[ edge:false, edgeColor:0, edgeExtent:0, edgeEmphasis:255,

		shadow:false, shadowColor:0, shadowWidth:0, shadowOffsetX:0, shadowOffsetY:0 ];

	function getRichTextApp() {

		if (verticalView || typeof global.RichText == "undefined") return;

		var msg = window.fore.messages[0];

		if (msg === void || typeof msg.useRichText == "undefined" || !msg.useRichText) return;

		if (richTextApp === void) richTextApp = new global.MessageLayer.RichTextFontApp();

		if (richTextApp.ready(font)) return richTextApp;

	}

	// Width of text in the history font, as drawHistoryText draws it

	function textWidth(text) {

		var rta = getRichTextApp();

		return rta !== void ? int(Math.round(rta.measure(text))) : font.getTextWidth(text);

	}

	// Draws a horizontal line of history text with its top-left at x, y; the glossary's words

	// (Glossary.tjs) in its colour

	function drawHistoryText(x, y, text, color) {

		var marks = typeof global.KAGGlossary == "Object" && color == historyColor ? global.KAGGlossary.marksIn(text) : [];

		var at = 0;

		for (var i = 0; i < marks.count; i++) {

			var m = marks[i];

			if (m[0] > at) drawHistoryRun(x + textWidth(text.substring(0, at)), y, text.substring(at, m[0] - at), color);

			drawHistoryRun(x + textWidth(text.substring(0, m[0])), y, text.substring(m[0], m[1] - m[0]), global.KAGGlossary.color);

			at = m[1];

		}

		if (at < text.length) drawHistoryRun(x + (at > 0 ? textWidth(text.substring(0, at)) : 0), y, at > 0 ? text.substring(at) : text, color);

	}

	function drawHistoryRun(x, y, text, color) {

		var rta = getRichTextApp();

		if (rta !== void) {

			var attach = textPage.useCache; // the plugin's drawing finds the layer's pixels again

			rta.drawText(richTextBase, textPage, x, y, text, color);

		}

		else textPage.drawText(x, y, text, color, 255, antialiased);

	}

	function drawLine(n)

	{

		// Draw display line n

		if(!everypage && (n + dispStart >= dataLines || n + dispStart < 0)) return;

		var line = everypage?getPage(dispStart)[n]:getLine(n + dispStart);

		if(everypage && line=="") return;

		var linestart = everypage?getLineStart2(dispStart, n):getLineStart(n + dispStart);

		if(verticalView)

		{

			var x = width - marginR - n*lineHeight;

			textPage.drawText(x, marginT + controlHeight + linestart, line, historyColor, 255, antialiased);

		}

		else

		{

			var y = n*lineHeight + controlHeight + marginT;

			drawHistoryText(marginL + linestart, y, line, historyColor);

