/**
 * Scrolling lists (since 0.19.0): items in a list or a grid on a layer of their own, drawn by
 * the game one at a time and only while they're in view, that scroll with the mouse wheel, by
 * dragging (the mouse, or a finger: a flick coasts on and slows down), with the scroll bar, the
 * arrow keys, Page Up and Down, Home and End (a controller's D-pad sends the arrows), and say
 * their items to screen readers. A click or a tap on an item, or Return on the focused one,
 * picks it.
 *
 *   var list = new KAGScrollList(kag, kag.fore.messages[0]);
 *   list.setPos(316, 322);
 *   list.setSize(1344, 600);         // the list's own picture is made this size too
 *   list.itemHeight = 86;            // a row's height; gap, the space between rows
 *   list.columns = 1;                // more for a grid (each row's items share the width)
 *   list.drawItem = function(layer, index, w, h, state) { ... };  // "normal", "over", "focus"
 *   list.onPick = function(index) { ... };
 *   list.itemName = function(index) { return "..."; };          // for screen readers
 *   list.count = 120;                // draws it
