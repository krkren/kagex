KAGDefineOption(%[ name:"reduceMotion", label:"Reduce Motion", kind:"toggle", save:true, initial:false,
	values:[ ["On", true], ["Off", false] ] ]);
KAGOptionHook.add(function(name, v) { if (name == "reduceMotion") KAGApplyReduceMotion(v !== void && !!v); } incontextof global);

// ---------------------------------------------------------------------------------------
// Hearing a setting while changing it (since 0.18.0): the volumes and the other settings of a
// classic first Config page as options (with no initial: a game's first start sets them), so Undo
// and Revert take them back too, and samples that play as a volume is set
// ---------------------------------------------------------------------------------------
KAGDefineOption(%[ name:"bgmVolume", label:"BGM Volume", kind:"slider", prop:"bgmvolume", min:0, max:100, step:1, ends:[ "Min", "Max" ],
	preview:function(event, v) { KAGVolumeSamples.music(event); } ]);
KAGDefineOption(%[ name:"seVolume", label:"SE Volume", kind:"slider", prop:"sevolume", min:0, max:100, step:1, ends:[ "Min", "Max" ],
	preview:function(event, v) { KAGVolumeSamples.sound(event); } ]);
KAGDefineOption(%[ name:"voiceVolume", label:"Voice Volume", kind:"slider", prop:"voicevolume", min:0, max:100, step:1, ends:[ "Min", "Max" ],
	preview:function(event, v) { KAGVolumeSamples.voice(event); } ]);
// movies' own volume, where the game keeps it apart from the music's (since 0.19.0)
KAGDefineOption(%[ name:"movieVolume", label:"Movie Volume", kind:"slider", prop:"movieAudioVolume", min:0, max:100, step:1, ends:[ "Min", "Max" ],
	initial:100, available:function { return !!kag.independentMovieAudioProperty; } ]);
KAGDefineOption(%[ name:"textSpeed", label:"Text Speed", kind:"slider", prop:"textspeed", min:0, max:10, step:1, ends:[ "Slow", "Fast" ] ]);
KAGDefineOption(%[ name:"autoModeSpeed", label:"Auto Speed", kind:"slider", prop:"autospeed", min:0, max:10, step:1, ends:[ "Slow", "Fast" ] ]);
KAGDefineOption(%[ name:"noEffect", label:"Effect Speed", kind:"toggle", prop:"noeffect", values:[ ["Normal", false], ["Skip", true] ] ]);
KAGDefineOption(%[ name:"allSkip", label:"Skip Mode", kind:"toggle", prop:"allskip", values:[ ["All", true], ["Read Only", false] ] ]);
KAGDefineOption(%[ name:"volumeSamples", label:"Hear Volumes as You Set Them", kind:"toggle", save:true, initial:true,
	values:[ ["On", true], ["Off", false] ] ]);

/**
 * The samples a volume slider plays (the options' previews): pointing at the music's slider or
 * moving it plays musicStorage (when the game plays no music, which is a sample of its own) for
 * musicTime ms after the last move, then fades it out; letting go of the sound's plays
 * soundStorage in sound buffer soundBuffer; letting go of the voices' plays a character's test
 * line (KAGVoiceTest). A game sets musicStorage and soundStorage (void: none), and the player turns
 * them off with the volumeSamples option. stop() ends the music sample (Config closing).
 */
class KAGVolumeSampleSet
{
	var musicStorage, soundStorage, soundBuffer = 0;
	var musicTime = 5000, musicFade = 1000;
	var playing = false, timer, lastMove = 0;
	var played = [];       // the last samples played, for tests: "music:<file>", "sound:<file>", "voice:<file>"

	function note(what) { played.add(what); played.erase(0) if played.count > 20; }

	function finalize() { invalidate timer if timer !== void; }

	property on { getter { var v = KAGOptionGet("volumeSamples"); return v === void || !!v; } }

	function music(event)
	{
		if (event == "leave" || !on || musicStorage === void || musicStorage == "") return;
		lastMove = System.getTickCount();
		if (playing) return;
		if (kag.bgm.currentStorage != "") return; // the game's own music is the sample
		try { kag.bgm.play(%[ storage:musicStorage ]); } catch (e) { dm("volume sample: " + e.message); return; }
		playing = true;
		note("music:" + musicStorage);
		if (timer === void) { timer = new Timer(onTimer, ""); timer.interval = 250; }
		timer.enabled = true;
	}

	function onTimer()
	{
		if (!playing) { timer.enabled = false; return; }
		if (System.getTickCount() - lastMove < musicTime) return;
		stop(musicFade);
	}

	// the music sample stops (faded over fade ms)
	function stop(fade = 0)
	{
		timer.enabled = false if timer !== void;
		if (!playing) return;
		playing = false;
		if (fade > 0) kag.bgm.fadeOut(%[ time:fade ]); else kag.bgm.stop();
	}

	function sound(event)
	{
		if (event != "change" || !on || soundStorage === void || soundStorage == "") return;
		try { kag.se[soundBuffer].play(%[ storage:soundStorage ]); } catch (e) { dm("volume sample: " + e.message); return; }
		note("sound:" + soundStorage);
	}

	function voice(event)
	{
		if (event != "change" || !on) return;
		var who = KAGVoiceTestCharacters();
		if (who.count == 0) return;
		KAGVoiceTest(who[(int)(Math.random() * who.count)]);
	}
}
var KAGVolumeSamples = new KAGVolumeSampleSet();

// The characters with a test line (envinit.tjs: "testVoices" => [ files ]), in envinit's order
function KAGVoiceTestCharacters()
{
	var r = [];
	if (typeof global.world_object != "Object" || world_object === void) return r;
	var chars = world_object.env.envinfo.characters;
	if (chars === void) return r;
	var names = [];
	names.assign(chars);
	for (var i = 0; i < names.count; i += 2)
		r.add(names[i]) if typeof names[i + 1] == "Object" && names[i + 1] !== void && names[i + 1].testVoices !== void;
	return r;
}

// Plays one of a character's test lines (at their voice's volume, on or off as the player set it)
function KAGVoiceTest(who)
{
	if (typeof global.world_object != "Object" || world_object === void) return;
	var env = world_object.env, init = env.envinfo.characters[who];
	if (init === void || init.testVoices === void) return;
	var list = init.testVoices;
	list = [ list ] if typeof list == "String";
	if (list.count == 0) return;
	var file = list[(int)(Math.random() * list.count)];
	env.stopAllVoice();
	env.playVoice(who, file);
	KAGVolumeSamples.note("voice:" + file);
}

/**
 * A voice volume option for each of the characters named ("voice:<name>"): a slider for the
 * volume of the character's voiceName (kag.getVoiceVolume), its label the character's nameAlias,
 * a Test button for its test lines, and one played as it's let go; and a toggle for whether the
 * voiceName's voices play ("voiceOn:<voiceName>", kag.getVoiceOn). Returns the volumes' names,
 * for a Config page's column. Default puts them at 100 and on.
 */
class KAGCharacterVoiceOption
{
	var who, voiceName;
	function KAGCharacterVoiceOption(who, voiceName) { this.who = who, this.voiceName = voiceName; }
	function getValue() { return kag.getVoiceVolume(voiceName, true); }
	function setValue(v) { kag.setVoiceVolume(voiceName, v); }
	function getOn() { return kag.getVoiceOn(voiceName); }
	function setOn(v) { kag.setVoiceOn(voiceName, v); }
	function test() { KAGVoiceTest(who); }
	function preview(event, v) { KAGVoiceTest(who) if event == "change" && KAGVolumeSamples.on; }
}

function KAGDefineVoiceOptions(names)
{
	var r = [];
	if (typeof global.world_object != "Object" || world_object === void) return r;
	var chars = world_object.env.envinfo.characters;
	for (var i = 0; i < names.count; i++) {
		var init = chars !== void ? chars[names[i]] : void;
		if (init === void) continue;
		var c = new KAGCharacterVoiceOption(names[i], init.voiceName !== void ? init.voiceName : names[i]);
		var alias = init.nameAlias !== void ? init.nameAlias : names[i];
		KAGDefineOption(%[ name:"voice:" + names[i], label:typeof alias == "String" ? %[ en:alias ] : alias, kind:"slider",
			min:0, max:100, step:1, getValue:c.getValue, setValue:c.setValue, test:c.test, preview:c.preview, initial:100, owner:c ]);
		KAGDefineOption(%[ name:"voiceOn:" + c.voiceName, label:typeof alias == "String" ? %[ en:alias ] : alias, kind:"toggle",
			values:[ ["On", true], ["Off", false] ], getValue:c.getOn, setValue:c.setOn, initial:true, owner:c ]);
		r.add("voice:" + names[i]);
	}
	return r;
}

// ---------------------------------------------------------------------------------------
// Rows on a screen: a column of options laid out on a message layer, a row each (KAGOptionStyle)
// with its title above and its buttons or slider under it. The titles and the buttons' labels
// are drawn at run time, so a game adds a setting without images of its own: it needs the blank
// buttons (<button.prefix><width>_normal/_over), the slider's tab and track.
// ---------------------------------------------------------------------------------------
var KAGOptionStyle = %[
	row:130, width:640,
	label:%[ x:32, y:8, size:33 ],
	divider:%[ inset:24, color:0xffffff, opacity:120 ],
	button:%[ prefix:"config_choice", widths:[ 240, 240, 180, 130 ], height:60, gap:16, x:32, y:60, size:28,
		color:0x5025ff, overColor:0xffffff ],
	slider:%[ normal:"slidebar", over:"slidebar_over", track:"config_track", x:112, y:60, width:416, height:60, endSize:26,
		testX:32, testGap:28, testWidth:130 ],
	note:%[ x:32, y:72, gap:44, size:26 ]
	];

// The options a layer shows: %[ option name => %[ kind, buttons, slider ] ] (KAGOptionRefresh)
function KAGOptionControls(layer)
{
	if (typeof layer.optionControls != "Object" || layer.optionControls === void) layer.optionControls = %[];
	return layer.optionControls;
}

/**
 * A screen of options: columns, each [ x, top, names ] (KAGOptionColumn), on layer, which forgets
 * the rows of the page it showed before. The sample's Config pages 2 to 4 are this
 */
function KAGOptionPage(layer, columns)
{
	layer.optionControls = %[];
	var f = layer.font, face = f.face, height = f.height, bold = f.bold;
	for (var i = 0; i < columns.count; i++) KAGOptionColumn(layer, columns[i][0], columns[i][1], columns[i][2]);
	f.face = face, f.height = height, f.bold = bold; // as the layer had it (setYesNoFont changed it)
}

/**
 * Lays out a column of options on layer (a message layer whose frame is the screen), from x, top:
 * names, a row each (void leaves a row empty; an option with rows:2 takes two). The layer is the
 * current message layer for the buttons ([locate], [button], [slider])
 */
function KAGOptionColumn(layer, x, top, names)
{
	if (typeof global.setYesNoFont == "undefined") KAGLoadScript("YesNoDialog.tjs");
	var st = KAGOptionStyle, y = top;
	for (var i = 0; i < names.count; i++) {
		var o = names[i] !== void ? KAGOptions[names[i]] : void;
		o = void if o !== void && o.available !== void && !o.available();
		if (i > 0) {
			var d = st.divider;
			layer.colorRect(x + d.inset, y - 1, st.width - d.inset * 2, 2, d.color, d.opacity);
		}
		if (o === void) { y += st.row; continue; }
		setYesNoFont(layer, st.label.size);
		drawYesNoString(layer, x + st.label.x, y + st.label.y, KAGOptionLabel(o), 0xffffff, yesnoTextBase);
		switch (o.kind) {
		case "toggle":
		case "choice":
		case "button":
			KAGOptionButtons(layer, o, x, y);
			break;
		case "slider":
			KAGOptionSlider(layer, o, x, y);
			break;
		case "note":
			setYesNoFont(layer, st.note.size);
			for (var j = 0; j < o.lines.count; j++)
				drawYesNoString(layer, x + st.note.x, y + st.note.y + st.note.gap * j, tr(o.lines[j]), 0xffffff, yesnoTextBase);
			break;
		}
		y += st.row * o.rows;
	}
}

function KAGOptionButtons(layer, o, x, y)
{
	var st = KAGOptionStyle.button;
	var n = o.kind == "button" ? 1 : o.values.count;
	var w = st.widths[n < st.widths.count ? n : st.widths.count - 1];
	var c = %[ kind:o.kind, buttons:[], width:w ];
	KAGOptionControls(layer)[o.name] = c;
	for (var i = 0; i < n; i++) {
		layer.locate(x + st.x + (w + st.gap) * i, y + st.y);
		layer.addButton(%[ name:"option_" + o.name + "_" + i, normal:st.prefix + w + "_normal", over:st.prefix + w + "_over",
			exp:"KAGOptionPick('" + o.name + "', " + i + ")" ]);
		c.buttons.add(layer.names["option_" + o.name + "_" + i]);
	}
	KAGOptionDrawButtons(o, c);
}

// The buttons of an option as its value is: the chosen one lit
function KAGOptionDrawButtons(o, c)
{
	var st = KAGOptionStyle.button;
	var cur = o.kind == "button" ? -1 : KAGOptionIndex(o, KAGOptionGet(o.name));
	for (var i = 0; i < c.buttons.count; i++) {
		var b = c.buttons[i];
		if (b === void || !isvalid b) continue;
		var base = st.prefix + c.width;
		var on = i == cur;
		b.loadButtons(base + (on ? "_over" : "_normal"), base + "_over", base + "_over");
		KAGOptionLabelButton(b, tr(o.kind == "button" ? o.button : o.values[i][0]), on);
		if (o.kind == "button") b.enabled = o.enabled === void || o.enabled();
	}
}

// A button's label drawn into its three states (lit: drawn as the hovered one in all three)
function KAGOptionLabelButton(b, text, on = false)
{
	var st = KAGOptionStyle.button;
	var bw = b.width, bh = b.height;
	// smaller where the label is wider than its button (a long word, or a translation)
	var size = st.size, tw;
	do { setYesNoFont(b, size); tw = measureYesNoText(b, text); } while (tw > bw - 14 && --size > 14);
	var th = b.font.getTextHeight(text);
	var holdAlpha = b.holdAlpha;
	b.holdAlpha = true;
	for (var s = 0; s < 3; s++)
		drawYesNoString(b, bw * s + ((bw - tw) >> 1), (bh - th) >> 1, text, on || s > 0 ? st.overColor : st.color, yesnoLabelBase);
	b.holdAlpha = holdAlpha;
}

function KAGOptionSlider(layer, o, x, y)
{
	var st = KAGOptionStyle.slider;
	// with a Test button the slider starts at the row's left (testX) and has no words at its ends
	var sx = x + (o.test !== void ? st.testX : st.x), cy = y + st.y + (st.height >> 1);
	var track = kag.temporaryLayer;
	try {
		track.loadImages(st.track);
		layer.operateRect(sx, cy - (track.imageHeight >> 1), track, 0, 0, track.imageWidth, track.imageHeight);
	} catch (e) {}
	if (o.test === void && o.ends !== void) {
		setYesNoFont(layer, st.endSize);
		var lo = tr(o.ends[0]), hi = tr(o.ends[1]);
		var th = layer.font.getTextHeight(lo);
		drawYesNoString(layer, sx - 12 - measureYesNoText(layer, lo), cy - (th >> 1), lo, 0xffffff, yesnoTextBase);
		drawYesNoString(layer, sx + st.width + 12, cy - (th >> 1), hi, 0xffffff, yesnoTextBase);
	}
	layer.locate(sx, y + st.y);
	var elm = %[ name:"option_" + o.name, width:st.width, height:st.height, opacity:0, normal:st.normal, over:st.over,
		min:o.min, max:o.max, step:o.step, position:KAGOptionGet(o.name),
		onchangefunc:"KAGOptionSlide", onchangefuncdata:"'" + o.name + "'", nohilight:true ];
	if (o.preview !== void) elm.previewfunc = "KAGOptionPreview", elm.previewfuncdata = "'" + o.name + "'";
	layer.addSlider(elm);
	KAGOptionControls(layer)[o.name] = %[ kind:"slider", slider:layer.names["option_" + o.name] ];
	if (o.test !== void) {
		var bs = KAGOptionStyle.button, w = st.testWidth;
		layer.locate(sx + st.width + st.testGap, y + bs.y);
		layer.addButton(%[ name:"option_" + o.name + "_test", normal:bs.prefix + w + "_normal", over:bs.prefix + w + "_over",
			exp:"KAGOptionTest('" + o.name + "')" ]);
		var b = layer.names["option_" + o.name + "_test"];
		KAGOptionLabelButton(b, tr("Test")) if b !== void;
	}
}

// a slider with a preview pointed at, moved or left (LinkSliderLayer.preview)
function KAGOptionPreview(event, position, name)
{
	var o = KAGOptions[name];
	o.preview(event, position) if o !== void && o.preview !== void;
}

// a Test button
function KAGOptionTest(name)
{
	var o = KAGOptions[name];
	o.test() if o !== void && o.test !== void;
}

// a button of an option pressed: its value, or its action
function KAGOptionPick(name, i)
{
	var o = KAGOptions[name];
	if (o === void) return;
	if (o.kind == "button") {
		o.action() if o.action !== void;
	} else KAGOptionSet(name, o.values[i][1]);
	KAGOptionRefresh(kag.current);
}

// a slider moved
function KAGOptionSlide(position, dragging, name)
{
	KAGOptionSet(name, position, !dragging);
}

// The rows on layer drawn again as the options are now (after a change, or Default)
function KAGOptionRefresh(layer)
{
	if (layer === void || !isvalid layer || typeof layer.optionControls != "Object" || layer.optionControls === void) return;
	var names = [];
	names.assign(layer.optionControls);
	for (var i = 0; i < names.count; i += 2) {
		var o = KAGOptions[names[i]], c = names[i + 1];
		if (o === void) continue;
		if (c.kind == "slider") {
			if (c.slider !== void && isvalid c.slider) {
				var v = KAGOptionGet(o.name);
				if (KAGOptionSame(c.slider.position, v)) continue;
				// no change sound or preview: Test voices played for every row after a button
				if (typeof c.slider.setPositionQuietly != "undefined") c.slider.setPositionQuietly(v);
				else c.slider.position = v;
			}
		} else KAGOptionDrawButtons(o, c);
	}
}
