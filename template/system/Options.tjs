/**
 * The player's settings, declared once (since 0.17.0). Each option has a name, an English label
 * (shown through tr()), a kind and how to read and change it; a Config screen lays its rows out
 * from the table (KAGOptionColumn), Default puts them back (KAGResetOptions), and they're kept
 * where the property they set is kept (scflags), or in scflags["option:<name>"] for an option of
 * the game's own with save:true. A game adds options with KAGDefineOption in AfterInit.tjs.
 *
 *   name      what scripts call it
 *   label     its row's title, in English (tr() shows it in the language of the game)
 *   kind      "toggle" (two buttons), "choice" (two to four buttons), "slider", "button" (one
 *             button that runs action), "note" (lines of text, rows: how many rows they take)
 *   prop      a property of kag it reads and sets, or getValue/setValue functions
 *   apply     a method of kag called after a change (applyWindowOpacity ...)
 *   values    [ [label, value], ... ] for a toggle or a choice
 *   min, max, step, ends   a slider's range and the words at its two ends
 *   initial   the value Default and the first start give it
 *   button, action, enabled   a button's label, what it does, and whether it can be pressed
 *   lines     a note's lines (English, through tr())
 *   rows      the rows it takes (1)
 *   preview   a slider's function(event, value), called as it's pointed at ("enter"), moved while
 *             held ("drag"), let go ("change") and left ("leave"): a volume's sample (0.18.0)
 *   test      a function a Test button after the slider runs (a character's line, 0.18.0)
 *   available a function: whether this platform can do it (its row is left empty when not, 0.19.0)
 *
 * A label can be a dictionary by language code (%[ "en" => "Ai", "ja" => <the Japanese name> ]), for names.
 * While a Config screen is open, KAGOptionUndo keeps what each change replaced (Undo, Revert).
 */
var KAGOptions = %[];

function KAGDefineOption(o)
{
	o.rows = 1 if o.rows === void;
	// a function written in the table has no object of its own, so called as the option's member
	// it would run with the option as this, where kag and every global are void: the global
	// object instead (as KAGWindow.keyBindingFunction does)
	var keys = [ "getValue", "setValue", "action", "enabled", "preview", "test", "available" ];
	for (var i = 0; i < keys.count; i++) {
		var f = o[keys[i]];
		if (typeof f == "Object" && f !== void && typeof Scripts.getObjectContext != "undefined" &&
			Scripts.getObjectContext(f) === null) o[keys[i]] = f incontextof global;
	}
	KAGOptions[o.name] = o;
	return o;
}

function KAGOptionGet(name)
{
	var o = KAGOptions[name];
	if (o === void) return;
	if (o.getValue !== void) return o.getValue();
	if (o.prop !== void) return kag[o.prop];
	if (o.save) return kag.scflags["option:" + name];
}

// apply: false while a slider is dragged (the option's apply runs when it's let go)
function KAGOptionSet(name, v, apply = true)
{
	var o = KAGOptions[name];
	if (o === void) return;
	var before = KAGOptionUndo.recording ? KAGOptionGet(name) : void;
	if (o.setValue !== void) o.setValue(v);
	else if (o.prop !== void) kag[o.prop] = v;
	if (o.save) kag.scflags["option:" + name] = v;
	KAGOptionUndo.note(name, before, apply) if KAGOptionUndo.recording;
	if (!apply) return;
	if (o.apply !== void) kag[o.apply]();
	for (var i = 0; i < KAGOptionHook.count; i++) KAGOptionHook[i](name, v);
}
var KAGOptionHook = []; // functions called with (name, value) after an option changes

// An option's label in the language shown (a dictionary by language code, or English for tr())
function KAGOptionLabel(o)
{
	var l = o.label;
	if (typeof l != "Object" || l === void) return tr(l);
	var code = typeof global.KAGLanguage == "Object" && KAGLanguage !== void ? KAGLanguage.current : "en";
	return l[code] !== void ? l[code] : l.en !== void ? l.en : "";
}

// Two values the same (80 and 80.0 too)
function KAGOptionSame(a, b)
{
	if (a === b) return true;
	var na = typeof a == "Integer" || typeof a == "Real", nb = typeof b == "Integer" || typeof b == "Real";
	if (na && nb) return +a == +b;
	return typeof a == typeof b && a == b;
}

/**
 * Undo and Revert for a Config screen (since 0.18.0): begin() as the screen opens notes every
 * option's value; each change after it (a slider's from where its drag began) is a step undo()
 * takes back; mark() makes the next changes one step (Default); revert() puts every option back
 * as begin() found it; end() as the screen closes. A change undo() or revert() makes isn't a step.
 */
class KAGOptionUndoStack
{
	var recording = false;
	var start;           // %[ name => value ] at begin()
	var steps = [];      // %[ name => value before ], the newest last
	var pending = %[];   // a slider's value before its drag
	var applying = false;
	var group;           // the step mark() opened, which the changes after it join

	function values()
	{
		var d = %[], names = [];
		names.assign(KAGOptions);
		for (var i = 0; i < names.count; i += 2) {
			var o = names[i + 1];
			if (o.kind == "button" || o.kind == "note") continue;
			var v = KAGOptionGet(o.name);
			d[o.name] = v if v !== void;
		}
		return d;
	}

	function begin() { start = values(); steps.clear(); (Dictionary.clear incontextof pending)(); group = void; recording = true; }
	function end() { recording = false; start = void; steps.clear(); (Dictionary.clear incontextof pending)(); group = void; }

	// before: the value the change replaced; apply false while a slider is held
	function note(name, before, apply)
	{
		if (applying) return;
		if (!apply) { pending[name] = before if pending[name] === void; return; }
		if (pending[name] !== void) { before = pending[name]; delete pending[name]; }
		if (KAGOptionSame(before, KAGOptionGet(name))) return;
		if (group !== void) { group[name] = before if group[name] === void; return; }
		steps.add(%[ name => before ]);
	}

	// the changes from here to the next step are one (Default's): groupEnd() closes it
	function mark() { group = %[]; steps.add(group); }
	function groupEnd() { if (group !== void) { var g = group; group = void; var n = []; n.assign(g); if (n.count == 0) steps.remove(g); } }

	property canUndo { getter { return recording && steps.count > 0; } }
	// whether anything differs from when the screen opened
	property changed {
		getter {
			if (!recording || start === void) return false;
			var names = [];
			names.assign(start);
			for (var i = 0; i < names.count; i += 2) if (!KAGOptionSame(names[i + 1], KAGOptionGet(names[i]))) return true;
			return false;
		}
	}

	function setAll(d)
	{
		var names = [];
		names.assign(d);
		applying = true;
		try {
			for (var i = 0; i < names.count; i += 2)
				if (!KAGOptionSame(names[i + 1], KAGOptionGet(names[i]))) KAGOptionSet(names[i], names[i + 1]);
		} catch (e) { applying = false; throw e; }
		applying = false;
	}

	function undo()
	{
		if (!canUndo) return false;
		var d = steps.pop();
		group = void;
		setAll(d);
		return true;
	}

	function revert()
	{
		if (!recording || start === void) return false;
		group = void;
		setAll(start);
		steps.clear();
		return true;
	}
}
var KAGOptionUndo = new KAGOptionUndoStack();

// Puts the options back as they were at the first start (names: the ones to reset, void: all)
function KAGResetOptions(names)
{
	if (names === void) {
		names = [];
		names.assign(KAGOptions);
		for (var i = names.count - 2; i >= 0; i -= 2) names.erase(i + 1);
	}
	for (var i = 0; i < names.count; i++) {
		var o = KAGOptions[names[i]];
		if (o !== void && o.initial !== void) KAGOptionSet(o.name, o.initial);
	}
}

// The value index of a toggle or a choice (the nearest value, for numbers)
function KAGOptionIndex(o, v)
{
	var best = 0, d;
	for (var i = 0; i < o.values.count; i++) {
		var w = o.values[i][1];
		if (w === v || (typeof w == typeof v && w == v)) return i;
		if ((typeof w == "Integer" || typeof w == "Real") && (typeof v == "Integer" || typeof v == "Real")) {
			var e = Math.abs(w - v);
			if (d === void || e < d) d = e, best = i;
		}
	}
	return best;
}

// Text speed in ms a character for a slider from 0 to 10: 0 the slowest (chSpeeds.slow), 10 at once
function KAGSpeedOfSlider(v) { return (10 - v) * (kag.chSpeeds.slow / 10); }
function KAGSliderOfSpeed(s) { return 10 - s / (kag.chSpeeds.slow / 10); }

// ---------------------------------------------------------------------------------------
// The framework's own options
// ---------------------------------------------------------------------------------------
KAGDefineOption(%[ name:"voiceCut", label:"When You Click", kind:"choice", initial:"keep",
	values:[ ["Stop", "stop"], ["Fade", "fade"], ["Keep", "keep"] ],
	getValue:function { return !kag.voicecut ? "keep" : kag.voiceFadeOn ? "fade" : "stop"; },
	setValue:function(v) { kag.voicecut = v != "keep"; kag.voiceFadeOn = v != "stop"; } ]);
KAGDefineOption(%[ name:"voiceFadeTime", label:"Fade Length", kind:"slider", prop:"voiceFadeTime", initial:300,
	min:100, max:1000, step:50, ends:[ "Short", "Long" ] ]);
KAGDefineOption(%[ name:"voicePlacement", label:"Voice Position", kind:"toggle", prop:"voicePlacement", initial:true,
	values:[ ["With Speaker", true], ["Centred", false] ] ]);
KAGDefineOption(%[ name:"voiceSpeed", label:"Voice Speed", kind:"choice", prop:"voicespeed", initial:1.0,
	values:[ ["Slower", 0.8], ["Normal", 1.0], ["Faster", 1.25], ["Fastest", 1.5] ] ]);
KAGDefineOption(%[ name:"autoVoiceWait", label:"Pause After a Voice (Auto)", kind:"slider", prop:"autoVoiceWait", initial:0,
	min:0, max:2000, step:100, ends:[ "None", "Long" ] ]);
KAGDefineOption(%[ name:"dramaticMode", label:"Hide the Window for Voices", kind:"choice", prop:"dramaticMode", initial:"never",
	values:[ ["Never", "never"], ["In Auto", "auto"], ["Always", "always"] ] ]);
KAGDefineOption(%[ name:"continueOn", label:"Carry On at Start", kind:"toggle", prop:"continueOn", initial:true,
	values:[ ["On", true], ["Off", false] ] ]);
KAGDefineOption(%[ name:"quickSaves", label:"Quick Saves", kind:"note", rows:2,
	lines:[ "Q.SAVE or Shift+S: a quick save", "Q.LOAD or Shift+L: the newest one", "The last three are kept." ] ]);
KAGDefineOption(%[ name:"askAgain", label:"Prompts You Turned Off", kind:"button", button:"Ask Again",
	action:function { sf.yesnoSkip = void; },
	enabled:function { if (typeof sf.yesnoSkip != "Object" || sf.yesnoSkip === void) return false; var a = []; a.assign(sf.yesnoSkip); return a.count > 0; } ]);
KAGDefineOption(%[ name:"hideCursorIdle", label:"Hide the Pointer When Still", kind:"toggle", prop:"hideCursorIdle", apply:"startIdleCursor", initial:false,
	values:[ ["On", true], ["Off", false] ] ]);
KAGDefineOption(%[ name:"readSpeed", label:"Read Text Speed", kind:"slider", initial:0,
	min:0, max:10, step:1, ends:[ "Same", "Fast" ],
	getValue:function { return kag.userCh2ndSpeed < 0 ? 0 : KAGSliderOfSpeed(kag.userCh2ndSpeed); },
	setValue:function(v) { kag.userCh2ndSpeed = v <= 0 ? -1 : KAGSpeedOfSlider(v); kag.setUserSpeed(); } ]);
KAGDefineOption(%[ name:"autoSpeed", label:"Text Speed in Auto Mode", kind:"slider", initial:0,
	min:0, max:10, step:1, ends:[ "Same", "Fast" ],
	getValue:function { return kag.userChAutoSpeed < 0 ? 0 : KAGSliderOfSpeed(kag.userChAutoSpeed); },
	setValue:function(v) { kag.userChAutoSpeed = v <= 0 ? -1 : KAGSpeedOfSlider(v); kag.setUserSpeed(); } ]);
KAGDefineOption(%[ name:"autoCharWait", label:"Auto Wait per Character", kind:"slider", prop:"autoModeCharWait", initial:0,
	min:0, max:100, step:5, ends:[ "None", "Long" ] ]);
KAGDefineOption(%[ name:"textFade", label:"Text Fades In", kind:"slider", prop:"textFadeTime", apply:"applyTextFade", initial:0,
	min:0, max:800, step:50, ends:[ "Off", "Slow" ] ]);
KAGDefineOption(%[ name:"readColor", label:"Colour of Read Text", kind:"choice", prop:"readTextColor", initial:-1,
	values:[ ["As Written", -1], ["Grey", 0xb4b0c8], ["Blue", 0x9cd0ff] ] ]);
KAGDefineOption(%[ name:"readMark", label:"Mark Read Text", kind:"toggle", prop:"readMark", initial:false,
	values:[ ["On", true], ["Off", false] ] ]);
KAGDefineOption(%[ name:"windowOpacity", label:"Window Opacity", kind:"slider", prop:"windowOpacity", apply:"applyWindowOpacity", initial:255,
	min:0, max:255, step:5, ends:[ "Clear", "Solid" ] ]);
KAGDefineOption(%[ name:"afterauto", label:"Auto Mode After a Choice", kind:"toggle", prop:"afterauto", initial:false,
	values:[ ["Keep", true], ["Stop", false] ] ]);
KAGDefineOption(%[ name:"afterskip", label:"Skipping After a Choice", kind:"toggle", prop:"afterskip", initial:false,
	values:[ ["Keep", true], ["Stop", false] ] ]);
KAGDefineOption(%[ name:"enterSkip", label:"Skip Read Text on Reaching It", kind:"choice", prop:"enterSkipOnReadedLabel", initial:false,
	values:[ ["Off", false], ["Ask", "ask"], ["Skip", true] ] ]);

// Reduce Motion (since 0.18.0): effects, looping movies, the static, Live2D and 3D layers stop on
// the frame they show (an effect played once ends, a looping one shows nothing), and a layer whose
// [image]/[newlay] names still=<picture> shows that instead of its animation (GraphicLayer.tjs)
function KAGReduceMotion()
{
	var on = KAGOptionGet("reduceMotion");
	return on !== void && !!on;
}

// every flip running now: still, or moving again
function KAGApplyReduceMotion(on)
{
	if (typeof global.kag != "Object" || kag === void || typeof kag.genericFlipsInstances == "undefined") return;
