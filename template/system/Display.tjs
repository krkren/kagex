/**
 * The screen, the controller and screenshots (since 0.19.0): options for a Config screen
 * (Options.tjs), kept in the system variables and applied at start (KAGApplyDisplayOptions,
 * Initialize.tjs) and when they change. An option the platform can't do isn't offered: its row
 * stays empty (available).
 *
 *   windowSize        the window's size, as a share of the game's: those that fit the screen
 *                     (desktops, in a window; full screen keeps it for when the window comes back)
 *   fullScreenFit     how full screen fills a screen of another shape: black bars at the sides
 *                     or top and bottom ("contain"), filled with the edges cut off ("cover"), or
 *                     stretched ("fill"); also a window the player resized
 *   smoothScaling     smooth or sharp scaling of the game to the screen (-smoothzoom)
 *   vsync             frames in step with the display (Window.waitVSync)
 *   padEnabled        the controller on or off (System.padEnabled)
 *   padTest           a button that opens the controller test (PadTest.tjs)
 *   screenshotWindow  screenshots with the message windows, or without (MainWindow.tjs)
 *   screenshotFormat  PNG or JPEG
 *   screenshotPlace   (since 0.28.0, desktops with the sdlsystem plugin) the save folder, or a
 *                     folder of the game's own in the player's Pictures folder; on Android and
 *                     iOS (since 0.28.1) the save folder, or the phone's photo gallery
 *                     (SDLSystem.saveToGallery: an album of the game's title on Android), which
 *                     is where they go unless the player says otherwise
 *   screenshotOpen    a button that opens the folder they're saved in
 *   screenshotCopy    each one also put on the clipboard (desktops with the sdlsystem plugin)
 *   screenTransition  (since 0.28.0) how the game's screens come and go: their [trans screen ...]
 *                     tags take the transition of KAGScreenTransitions named here ("crossfade",
 *                     as written, or "glitch" where the glitchtrans plugin is); Reduce Motion
 *                     keeps the crossfade
 *
 * [screenshot enabled=false] turns F12's screenshots off until [screenshot enabled=true], for
 * scenes with spoilers ([screenshot off] and [screenshot on] say the same); saves keep it.
 */

function KAGPlatformTag() { return typeof System.platformTag != "undefined" ? System.platformTag : "windows"; }
function KAGIsDesktop() { var t = KAGPlatformTag(); return t != "android" && t != "ios" && t != "web"; }

// the window's sizes that fit the screen it's on: percentages of the game's size
var KAGWindowSizes = [ 50, 75, 100, 150, 200 ];
function KAGWindowSizeValues()
{
	var list = [], w = kag.scWidth, h = kag.scHeight;
	var sw = typeof System.desktopWidth != "undefined" ? System.desktopWidth : System.screenWidth;
	var sh = typeof System.desktopHeight != "undefined" ? System.desktopHeight : System.screenHeight;
	for (var i = 0; i < KAGWindowSizes.count; i++) {
		var p = KAGWindowSizes[i];
		if (p != 100 && (w * p / 100 > sw || h * p / 100 + kag.menuStripHeight > sh)) continue;
		list.add([ p + "%", p ]);
	}
	list.erase(0) if list.count > 4; // a row takes up to four buttons
	return list;
}

// a window or the whole screen (since 0.26.0, for the manual's links: Config screens have their own buttons)
KAGDefineOption(%[ name:"fullScreen", label:"Screen", kind:"toggle",
	values:[ ["Window", false], ["Full Screen", true] ],
	available:function { return KAGIsDesktop() && typeof kag.changeFullScreenOrWindow != "undefined"; },
	getValue:function { return !!kag.fullScreened; },
	setValue:function(v) { kag.changeFullScreenOrWindow(!!v); } ]);

KAGDefineOption(%[ name:"windowSize", label:"Window Size", kind:"choice", initial:100,
	values:[ ["50%", 50], ["75%", 75], ["100%", 100] ], // the sizes that fit, at start (KAGApplyDisplayOptions)
	available:function { return KAGIsDesktop() && typeof kag.setZoom != "undefined"; },
	getValue:function { return kag.zoomDenom > 0 ? (int)(kag.zoomNumer * 100 / kag.zoomDenom + 0.5) : 100; },
	setValue:function(v) {
		if (kag.fullScreened) { kag.scflags.zoomNumer = v, kag.scflags.zoomDenom = 100; return; }
		kag.setZoom(v, 100);
		KAGDisplayMenuSync();
	} ]);

KAGDefineOption(%[ name:"fullScreenFit", label:"Full Screen Fit", kind:"choice", save:true, initial:"contain",
	values:[ ["Bars", "contain"], ["Fill", "cover"], ["Stretch", "fill"], ["Part Way", "between"] ],
	available:function { return typeof kag.setViewport != "undefined"; },
	setValue:function(v) { kag.viewportFit = v; kag.applyMenuBarLayout(); } ]);

// Part Way (since 0.26.0): how far from the bars (all of the picture) to filling the screen (its
// edges cut off), as a percentage
KAGDefineOption(%[ name:"fullScreenFill", label:"How Far to Fill", kind:"slider", save:true, initial:50,
	min:0, max:100, step:5, ends:[ "Bars", "Fill" ],
	available:function { return typeof kag.setViewport != "undefined"; },
	setValue:function(v) { kag.viewportFill = +v; kag.applyMenuBarLayout() if kag.viewportFit == "between"; } ]);

KAGDefineOption(%[ name:"smoothScaling", label:"Smooth Scaling", kind:"toggle", save:true, initial:true,
	values:[ ["Smooth", true], ["Sharp", false] ],
	setValue:function(v) { System.setArgument("-smoothzoom", v ? "yes" : "no"); } ]);

KAGDefineOption(%[ name:"vsync", label:"Vertical Sync", kind:"toggle", save:true, initial:true,
	values:[ ["On", true], ["Off", false] ],
	available:function { return typeof kag.waitVSync != "undefined"; },
	setValue:function(v) { try { kag.waitVSync = v; } catch (e) { dm("waitVSync: " + e.message); } } ]);

KAGDefineOption(%[ name:"padEnabled", label:"Controller", kind:"toggle", save:true, initial:true,
	values:[ ["On", true], ["Off", false] ],
	available:function { return typeof System.padEnabled != "undefined"; },
	setValue:function(v) { try { System.padEnabled = v; } catch (e) { dm("padEnabled: " + e.message); } } ]);

// the controller test (PadTest.tjs, loaded on first use: it builds on the dialogs' classes)
function KAGPadTestAvailable() { return typeof System.padEnabled != "undefined"; }
function KAGShowPadTest()
{
	if (typeof global.KAGPadTestOpen == "undefined") KAGLoadScript("PadTest.tjs");
	return KAGPadTestOpen();
}

KAGDefineOption(%[ name:"padTest", label:"Controller Test", kind:"button", button:"Test",
	available:function { return KAGPadTestAvailable(); }, action:function { KAGShowPadTest(); } ]);

KAGDefineOption(%[ name:"screenshotWindow", label:"Screenshots", kind:"toggle", save:true, initial:true,
	values:[ ["With the Window", true], ["Without", false] ] ]);

KAGDefineOption(%[ name:"screenshotFormat", label:"Screenshot Format", kind:"toggle", save:true, initial:"png",
	values:[ ["PNG", "png"], ["JPEG", "jpg"] ] ]);

// Where screenshots go (since 0.28.0): the save folder (or the game's own screenshotFolder), or
// <Pictures>/<the game's title>/, made as the option is set; the folder opened by a button
function KAGPicturesFolder()
{
	if (typeof global.SDLSystem == "undefined" || !KAGIsDesktop()) return "";
	var p = "";
	try { p = SDLSystem.userFolder("pictures"); } catch (e) {}
	return p;
}
var KAGGameScreenshotFolder; // the game's own screenshotFolder (Config.tjs), noted at start
function KAGScreenshotPlace(v)
{
	if (KAGGameScreenshotFolder === void) KAGGameScreenshotFolder = kag.screenshotFolder === void ? "" : kag.screenshotFolder;
	var pictures = KAGPicturesFolder();
	if (v == "pictures" && pictures != "") {
		var name = sf.software_title !== void && sf.software_title != "" ? sf.software_title : System.title;
		name = name.replace(/[\\\/:*?"<>|]/g, "_"); // a regex ends at the first unescaped /
		var native = pictures + name + "/";
		try { SDLSystem.makeFolder(native); } catch (e) {}
		kag.screenshotFolder = kag.localStorageName(native);
	} else {
		kag.screenshotFolder = KAGGameScreenshotFolder == "" ? void : KAGGameScreenshotFolder;
	}
}
function KAGScreenshotFolderNow() { return kag.screenshotFolder !== void ? kag.screenshotFolder : System.dataPath; }

// The phone's photo gallery (since 0.28.1): Android's MediaStore and iOS's photo library, through
// the sdlsystem plugin; iOS asks the player the first time (the app's Info.plist must say why,
// NSPhotoLibraryAddUsageDescription, which kagex-release writes)
function KAGGalleryPossible()
{
	if (typeof global.SDLSystem == "undefined" || KAGIsDesktop()) return false;
	try { return typeof SDLSystem.galleryPossible != "undefined" && SDLSystem.galleryPossible; } catch (e) { return false; }
}
function KAGScreenshotsToGallery()
{
	if (!KAGGalleryPossible()) return false;
	var v = KAGOptionGet("screenshotPlace");
	return (v === void ? KAGOptions.screenshotPlace.initial : v) == "gallery";
}
// the album on Android (Pictures/<album>): the game's title, as a folder name
function KAGGalleryAlbum()
{
	var name = sf.software_title !== void && sf.software_title != "" ? sf.software_title : System.title;
	return name.replace(/[\\\/:*?"<>|]/g, "_");
}

KAGDefineOption(%[ name:"screenshotPlace", label:"Screenshots Go To", kind:"toggle", save:true, initial:"save",
	values:[ ["Save Folder", "save"], ["Pictures", "pictures"] ],
	available:function { return KAGPicturesFolder() != "" || KAGGalleryPossible(); },
	setValue:function(v) { KAGScreenshotPlace(v); } ]);

KAGDefineOption(%[ name:"screenshotOpen", label:"Screenshot Folder", kind:"button", button:"Open",
	available:function { return typeof global.KAGCanOpenFolders != "undefined" && KAGCanOpenFolders(); },
	action:function { KAGOpen(KAGScreenshotFolderNow()); } ]);

KAGDefineOption(%[ name:"screenshotCopy", label:"Copy Screenshots", kind:"toggle", save:true, initial:false,
	values:[ ["Yes", true], ["No", false] ],
	available:function { return typeof global.SDLSystem != "undefined" && SDLSystem.available && KAGIsDesktop(); } ]);

// The screens' transitions (since 0.28.0): [trans screen method=crossfade time=300] in a screen's
// script takes the named transition's attributes over its own; a game adds its own to the table
var KAGScreenTransitions = %[
	crossfade:%[],
	glitch:%[ method:"glitch", strength:45, bands:10, blocks:6, noise:20, mosh:40, sort:0, flash:0 ] ];

function KAGScreenTransitionFor(elm)
{
	var name = typeof global.KAGOptionGet != "undefined" ? KAGOptionGet("screenTransition") : void;
	if (name === void || name == "" || KAGScreenTransitions[name] === void) return elm;
	if (typeof global.KAGReduceMotion != "undefined" && KAGReduceMotion()) return elm;
	var t = KAGScreenTransitions[name];
	if (t.method !== void && typeof global.KAGPluginTransitions != "undefined" && KAGPluginTransitions[t.method] == "missing") return elm;
	var e = %[];
	(Dictionary.assign incontextof e)(elm);
	foreach(t, function(k, v, d, e) { e[k] = v; }, e);
	return e;
}

KAGDefineOption(%[ name:"screenTransition", label:"Screens Change With", kind:"toggle", save:true, initial:"crossfade",
	values:[ ["Crossfade", "crossfade"], ["Glitch", "glitch"] ],
	available:function { return typeof global.KAGPluginTransitions != "undefined" && KAGPluginTransitions.glitch == "linked"; } ]);

// at start, once the window and its system variables are there
function KAGApplyDisplayOptions()
{
	KAGOptions.windowSize.values = KAGWindowSizeValues() if KAGIsDesktop();
	// a phone: the save folder (out of the player's reach) or Photos, Photos at first
	if (KAGGalleryPossible()) {
		KAGOptions.screenshotPlace.values = [ ["Save Folder", "save"], ["Photos", "gallery"] ];
		KAGOptions.screenshotPlace.initial = "gallery";
	}
	var names = [ "fullScreenFill", "fullScreenFit", "smoothScaling", "vsync", "padEnabled", "screenshotPlace" ];
	for (var i = 0; i < names.count; i++) {
		var o = KAGOptions[names[i]];
		if (o.available !== void && !o.available()) continue;
		var v = KAGOptionGet(names[i]);
		if (v === void) continue; // never set: the engine's own
		try { o.setValue(v); } catch (e) { dm(names[i] + ": " + e.message); }
	}
	KAGDisplayMenuSync();
}

// The Screen menu's window sizes (since 0.26.0): one radio item for each size that fits the
// screen (Menus.tjs, and a game's own menus, add them)
function KAGDisplayMenuSizes(win, menu)
{
	if (menu === void || !KAGIsDesktop() || typeof win.setZoom == "undefined") return;
	var w = win.scWidth, h = win.scHeight;
	var sw = typeof System.desktopWidth != "undefined" ? System.desktopWidth : System.screenWidth;
	var sh = typeof System.desktopHeight != "undefined" ? System.desktopHeight : System.screenHeight;
	for (var i = 0; i < KAGWindowSizes.count; i++) {
		var p = KAGWindowSizes[i];
		if (p != 100 && (w * p / 100 > sw || h * p / 100 + win.menuBarHeight > sh)) continue;
		var item = new KAGMenuItem(win, p + "%", 2, KAGWindowSizeMenuClick incontextof global, false);
		item.windowSize = p;
		menu.add(item);
	}
}

function KAGWindowSizeMenuClick(item)
{
	KAGOptionSet("windowSize", item.windowSize);
	KAGDisplayMenuSync();
}

// the size items' ticks, as the window is
function KAGDisplayMenuSync()
{
	if (typeof global.kag != "Object" || kag === void || typeof kag.displayMenu != "Object") return;
	var v = KAGOptionGet("windowSize"), c = kag.displayMenu.children;
	for (var i = 0; i < c.count; i++) if (typeof c[i].windowSize != "undefined") c[i].checked = c[i].windowSize == v;
}

// [screenshot enabled=false] / [screenshot off] ... (kept in saves: KAGWindow.screenshotsOff)
function KAGScreenshotTag(elm)
{
	var v = elm.enabled;
	if (elm.off !== void) kag.screenshotsOff = true;
	else if (elm.on !== void) kag.screenshotsOff = false;
	else if (v !== void) kag.screenshotsOff = v == "false" || v == "0" || v == "no";
	return 0;
}
