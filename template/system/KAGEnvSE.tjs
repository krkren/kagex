/**
 * Ambient SE object
 */
class KAGEnvSE extends KAGEnvBase {

    /**
     * Constructor
     */
	function KAGEnvSE(env, id) {
		super.KAGEnvBase(env, "se" + id);
		this.id = id;
		count = 0;
	}
	
	var id;
	var filename;  // Referenced file name
	var loop;      // Whether it is looping
	var volume;    // Volume specification
	var count; // Referenced count value

	// Where it sounds on the stage (positional sound, doc/world.txt "SE Object Functions"):
	// void for everywhere (not positional), or %[ xpos, level, char ] from the tag's pos=
	// (a position of envinit.tjs's), xpos= and level=, or char= (at that character, and with
	// it as it moves while the sound plays on). KAGEnvironment.se3DPosition places it
	var place;
	var followTimer; // moves the sound with its character
	
	var play;
	var stop;
	var fade;

    /**
     * Save processing
     */
    function onStore(f) {
		f.filename  = filename if filename !== void && loop;
		f.loop      = loop   if loop !== void && loop != false;
		f.volume    = volume if volume !== void && volume != 100;
		f.place     = place  if place !== void && filename !== void && loop;
		//f.count     = count  if count != 0;
	}

	function finalize() {
		invalidate followTimer if followTimer !== void;
		super.finalize(...);
	}

	function onRestore(f) {
		if (f !== void) {
			env.getSEOBJ(id).stop(); // Stop for sure (note that filename=void in onStop)
			filename = f.filename;
			loop  = f.loop !== void ? f.loop : false;
			count = f.count !== void ? f.count : 0;
			if (f.filename != "" && f.loop) {
				setPlay(f.filename, %[loop:f.loop]);
				place = f.place;
				if (f.volume !== void) {
					fade = %[] if (fade === void);
					fade.volume = volume = f.volume;
				}
			}
		}
	}

	/**
	 * Notification on stop
	 */
	function onStop() {
		filename = void;
		loop = false;
		stopFollowing();
	}

	// --------------------------------------------------------------------

	
    /**
     * Playback processing
     * @param param Playback target file
     */
	function setPlay(param, elm) {
		if (param !== void) {
			place = placeOf(elm);
			stop = void;
			if (kag.skipMode<SKIP_STOP || elm.loop) { // XXX Workaround for skipNoDisp, but a different style should probably be considered, sync check is likely more appropriate
				filename = param;
				loop = elm.loop;
				play = %[];
				(Dictionary.assign incontextof play)(elm, false);
				if (play.fade === void && play.time === void) {
					fade = %[];
					fade.volume = volume = 100;
				}
			} else {
				stop = 0 if (loop);
				play = void;
			}
			doflag = true;
		}
    }

    /**
     * Stop processing
     * @param param Fade-out time
     */
	function setStop(param, elm) {
		play = void;
		fade = void;
		filename = void;
		loop = void;
		var time;
		if (elm !== void && elm.time !== void) {
			time = +elm.time;
		} else {
			time = +param;
		}
		stop = time;
		doflag = true;
    }

    /**
     * Volume fade
     * @param param Fade time
     */
	function setFade(param, elm) {
		fade = %[];
		fade.volume = volume = +param;
		fade.time   = elm.time;
    }

    var secommands = %[
    tagname : null, 
    taglist : null, 
    pos : null,   // positional sound: placeOf reads these
    xpos : null,
    level : null,
    char : null,
    storage : setPlay incontextof this,
    play : setPlay incontextof this,
    stop : setStop incontextof this,
    fade : setFade incontextof this,
    loop : null,
    time : null,
    start : null,
    canskip : null,
    buf : null,
    filename : null,
    nosync : null,
	sync : null,
	wait : null,
	delayrun : null,
        ];

    var doflag;

    /**
     * Execute command
     * @param cmd Command
     * @param param Parameter
     * @param elm All parameters including other commands
     * @return true if execution occurred
     */
    function doCommand(cmd, param, elm) {
        var func;
        if ((func = secommands[cmd]) !== void) {
            if (func != null) {
                func(param, elm);
            }
            return true;
        }
        // Treat as play command
		setPlay(cmd, elm);
        return true;
    }

	function command(elm) {
		doflag = false;
		foreach(elm, doCommand);
		var tagname = elm.tagname;
		if (!doflag && checkTagNamePlay(tagname)) {
			setPlay(tagname, elm); 
		}
	}

	function checkSync(elm) {
		syncCommand = true if (elm.wait || elm.sync);
	}
	
	// Whether the tag name can be treated as a file name for playback
	function checkTagNamePlay(tagname) {
		switch (tagname) {
		case "se":
		case "allse":
			// Standard tag, so invalid
			return false;

		default:
			// For looping SE, do not allow re-playback with the same tag name
			if (loop && filename == tagname)
				return false;
			break;
		}
		return true;
	}

	function update(skipMode) {
		var se = env.getSEOBJ(id);
		var fading = 0;
		if (fade !== void) {
			if (fade.time === void || fade.time == 0 || play !== void) {
				se.volume = fade.volume;
			} else {
				se.fade(fade);
				fading = 1;
			}
			fade = void;
		}
		if (play !== void) {
			var origName = filename; // [XXX] Because re-playing an already playing SE calls onStop and sets filename=void
			if (skipMode<SKIP_STOP || play.loop || !env.isNoSE()) {
				var time = +play.time;
				applyPlace(se); // before it starts, so it doesn't start in the middle
				if (time > 0)  {
					if (se.volume <= 1) se.volume = 100;
					se.fadeIn(%[ storage:filename, loop:play.loop, time:time, start:play.start]);
				} else {
					se.play(%[ storage:filename, loop:play.loop, start:play.start]);
				}
				fading = 2; // Treated as waiting for stop during sync
				filename = origName;
				loop = play.loop;
			} else {
				se.stop() if loop;
			}
			play = void;
		}
		if (stop !== void) {
			if (skipMode == SKIP_NONE && stop > 0) {
				se.fadeOut(%[time:stop]);
				fading = 2;
			} else {
				se.stop();
			}
			stop = void;
		}
		return fading;
	}
	
	// ------------------------------------------------------------------
	// Positional sound
	// ------------------------------------------------------------------

	/**
	 * Where a play tag puts the sound: void (everywhere) or %[ xpos, level, char ]
	 */
	function placeOf(elm) {
		if (elm === void || (elm.pos === void && elm.xpos === void && elm.char === void)) return;
		var p = %[];
		if (elm.pos !== void) {
			var info = env.positions !== void ? env.positions[elm.pos] : void;
			if (info === void) dm("se: no position " + elm.pos + " (envinit.tjs positions)");
			else {
				p.xpos  = +info.xpos  if info.xpos  !== void;
				p.level = +info.level if info.level !== void;
			}
		}
		p.xpos  = +elm.xpos  if elm.xpos  !== void;
		p.level = +elm.level if elm.level !== void;
		p.char  = elm.char   if elm.char  !== void;
		return p;
	}

	/**
	 * Places buffer se where the sound is (or everywhere: 3D off), and has a looping sound
	 * follow its character
	 */
	function applyPlace(se) {
		var has3D = typeof se.use3D != "undefined" && typeof global.SoundListener != "undefined";
		if (place === void || !has3D) {
			try { se.use3D = false if has3D && se.use3D; } catch {}
			stopFollowing();
			return;
		}
		var xz = env.se3DPosition(place);
		try {
			se.use3D = true;
			se.minDistance = env.se3DMinDistance;
			se.maxDistance = env.se3DMaxDistance;
			if (xz !== void) se.set3DPosition(xz[0], 0, xz[1]);
		} catch (e) { dm("se: positional sound: " + e.message); return; }
		if (place.char !== void && play !== void && play.loop) startFollowing();
		else stopFollowing();
	}

	function startFollowing() {
		if (followTimer === void) {
			followTimer = new Timer(onFollow, "");
			followTimer.interval = 50;
		}
		followTimer.enabled = true;
	}

	function stopFollowing() {
		followTimer.enabled = false if followTimer !== void;
	}

	function onFollow() {
		var se = env.getSEOBJ(id);
		if (place === void || place.char === void || filename === void || se === void || !se.use3D) return stopFollowing();
		var xz = env.se3DPosition(place);
		if (xz !== void) se.set3DPosition(xz[0], 0, xz[1]);
	}

	function sync(elm, skipMode) {
		var fading = update(skipMode);
		// Check wait
		var wait = elm.wait !== void ? +elm.wait : elm.sync !== void ? 0 : void;
		if (wait == 1) {
			wait = 0;
		}
		if (wait !== void) {
			var canskip = elm.canskip !== void ? +elm.canskip : true;
			switch(fading) {
			case 1:
				env.addFastTag("wf", %[buf:id, canskip:canskip, wait:wait]);
				break;
			default:
				env.addFastTag("ws", %[buf:id, canskip:canskip, wait:wait]);
				break;
			}
		}
	}

};