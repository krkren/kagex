// Plugin for movie alpha processing

if (typeof global.Layer.copyBottomBlueToTopAlpha == "undefined") {

	try {

		Plugins.link("plugin/layerExBTOA.dll");

	} catch(e) {

	}

}

class MovieControlLayer extends GenericFlip, VideoOverlay

{

	var FLIP  = global.GenericFlip;

	var SUPER = global.VideoOverlay;



	var targetLayer; //< For movie display 

	var alpha;       //< Is alpha movie?

	var status;      //< Playback status

	var file;        //< Current file

	var frames = 0;  //< frames shown since it started ([movie]'s watchdog)

	var subtitle;    //< subtitle= (true: <name>.vtt beside it; Movies.tjs)

	var subtitles;   //< its KAGSubtitles, while it has cues



	function MovieControlLayer(window) {

		SUPER.VideoOverlay(window);

		FLIP.GenericFlip(window);

		targetLayer = new Layer(window, window.primaryLayer);



		mode = vomLayer;

		layer1 = targetLayer;

		status = "unload";

	}



	function finalize() {

		stop();

		layer1 = null;

		invalidate targetLayer;

		FLIP.finalize();

		SUPER.finalize();

	}



	property isPlayingMovie { getter() { return flipping; } }

	function flipFrame { return flipping; } // override



	/**

	 * Start movie playback

	 * @param filename Filename

	 * @param alpha Handle as alpha movie

	 * @param loop Loop specification

	 * @param ovtype Composition mode

	 */

	function start(filename, loop=false, alpha=0, subtitle=void) {

		this.alpha = alpha;

		this.subtitle = subtitle;

		frames = 0;

		// The [image] tag shows the layer before the first frame arrives; left at ltOpaque its empty

		// image flashes white (across the whole screen for affine layers), so draw it with alpha

		for (var i = flipLayers.count-1; i >= 0; i--) flipLayers[i].type = ltAlpha;

		targetLayer.name = "Movie:" + filename;

		this.loop=loop;

		file = filename;

		var fn = getExistFileNameAutoExtFill(file, "webm", "mpg", "mpv", "mpeg", "wmv");

		open(fn);

		// Set volume if audio exists

		try { audioVolume = getAudioVolume(); } catch {}

		play();

		// its subtitles (Movies.tjs)

		if (subtitles !== void) { invalidate subtitles; subtitles = void; }

		var cueFile = typeof global.KAGSubtitleFile != "undefined" ? KAGSubtitleFile(filename, subtitle) : void;

		if (cueFile !== void) try { subtitles = new KAGSubtitles(targetLayer.window, this, cueFile); } catch (e) { dm("subtitles: " + cueFile + ": " + e.message); }

	}



	// Get volume (referenced from window)

	function getAudioVolume() {

		with (targetLayer.window)

			return   (.waveenable && .movieAudioEnable) ?

				/**/ (.wavevolume *  .movieAudioVolume) * 10 : 0; // Normally *1000 but since it's vol*vol, *10 is enough

	}



	// Stop from external

	function stop() {

		SUPER.stop();

		if (subtitles !== void) { invalidate subtitles; subtitles = void; }

		flipStop();

	}

	

	// Movie update processing

	function onFrameUpdate() {

		if (!isvalid this) return;

		frames++;

		//dm("Update:" + targetLayer.name);

		switch (alpha) {

		case 0:

			targetLayer.fillAlpha();

			break;

		case 1:

			targetLayer.height = targetLayer.imageHeight / 2;

			targetLayer.copyBottomBlueToTopAlpha();

			break;

		case 2:

			targetLayer.width = targetLayer.imageWidth / 2;

			targetLayer.copyRightBlueToLeftAlpha();

			break;

		}

		// assignImages doesn't copy the layer type, so a target layer left at ltOpaque would draw

		// an alpha movie's clear parts as solid white (across the whole screen for affine layers)

		if (alpha == 1 || alpha == 2) for (var i = flipLayers.count-1; i >= 0; i--) flipLayers[i].type = ltAlpha;

		flipAssign(targetLayer);

	}



	// Status change

	function onStatusChanged(newstat) {

		//dm("State:" + targetLayer.name + ":" + status + "->" + newstat);

		flipStop() if (status == "play" && newstat == "stop");

		status = newstat;

	}



//	function flipSetOptions(elm) {}

	function flipStore(dic) {

		with (dic) {

			;.file  = file;

			;.loop  = loop;

			;.alpha = alpha;

			;.subtitle = subtitle;

		}

	}

	function flipRestore(dic) {

		start(dic.file, dic.loop, dic.alpha, dic.subtitle);

	}

	function flipStart(storage, elm) {

		start(storage, elm.loop, elm.alpha, elm.subtitle);

	}

}



// Registration

GenericFlip.Entry(

	%[

		"type"     => "movie",             // Registration tag

		"class"    => MovieControlLayer,   // Controller class

		"trigger"  => "lmstop",            // Trigger name sent on stop

		"ext"      => [ "webm", "mpeg", "mpg", "mpv", "wmv" ], // Determination process (extension string or array)

//		"checker"  => void,                // Determination process (function)

		"options"  => [ "loop", "alpha", "subtitle" ], // Option values to use (for KAGEnvLayer)

		"autoflag" => "movie",             // Auto flag tag name (for KAGEnvLayer)

		]);