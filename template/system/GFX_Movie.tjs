// Plugin for movie alpha processing

if (typeof global.Layer.copyBottomBlueToTopAlpha == "undefined") {

	try {

		Plugins.link("plugin/layerExBTOA.dll");

	} catch(e) {

	}

}

// ms before its end a movie played once (once=true, as [movie] plays) is stopped, while it plays;
// 0: at its end. On Android a player that reached its end hung the game as it was stopped
// (UPSTREAM.md 38), so there it's stopped just before
var KAGMovieStopEarly = typeof System.platformTag != "undefined" && System.platformTag == "android" ? 300 : 0;

class MovieControlLayer extends GenericFlip, VideoOverlay

{

	var FLIP  = global.GenericFlip;

	var SUPER = global.VideoOverlay;



	var targetLayer; //< For movie display 

	var alpha;       //< Is alpha movie?

	var status;      //< Playback status

	var file;        //< Current file

	var frames = 0;  //< frames shown since it started ([movie]'s watchdog)

	var subtitle;    //< subtitle= (true: <name>.vtt beside it; Movies.tjs)

	var subtitles;   //< its KAGSubtitles, while it has cues

	var fit = false; //< fit=true: each layer showing it zoomed to fill the screen ([movie]'s smaller version)

	var fitWidth = 0, fitHeight = 0; //< the frame size it was fitted to



	function MovieControlLayer(window) {

		SUPER.VideoOverlay(window);

		FLIP.GenericFlip(window);

		targetLayer = new Layer(window, window.primaryLayer);



		mode = vomLayer;

		layer1 = targetLayer;

		status = "unload";

	}



	function finalize() {

		if (onceTrigger !== void) { invalidate onceTrigger; onceTrigger = void; }

		if (onceTimer !== void) { invalidate onceTimer; onceTimer = void; }

		stop();

		layer1 = null;

		invalidate targetLayer;

		FLIP.finalize();

		SUPER.finalize();

	}



	property isPlayingMovie { getter() { return flipping; } }

	function flipFrame { return flipping; } // override



	/**

	 * Start movie playback

	 * @param filename Filename

	 * @param alpha Handle as alpha movie

	 * @param loop Loop specification

	 * @param ovtype Composition mode

	 */

	function start(filename, loop=false, alpha=0, subtitle=void, once=false, fit=false) {

		this.alpha = alpha;

		this.fit = fit;

		fitWidth = fitHeight = 0;

		this.subtitle = subtitle;

		this.once = once;

		frames = 0;

		ended = false;

		stopped = false;

		playedOut = false;

		// The [image] tag shows the layer before the first frame arrives; left at ltOpaque its empty

		// image flashes white (across the whole screen for affine layers), so draw it with alpha

		for (var i = flipLayers.count-1; i >= 0; i--) flipLayers[i].type = ltAlpha;

		targetLayer.name = "Movie:" + filename;

		// once: played to its end once, by looping it and stopping it as it starts again

		// (onPeriod): on Android a player that ran to its end and was then stopped and freed could

		// hang the game, while one stopped as it plays is freed as a looping movie always was

		this.loop = loop || once;

		// and on Android it's stopped onceEarly ms before its end, while it plays: there a player

		// that reached its end can't go back to its start either (MediaCodec: "Uninitialized

		// state") and stopping it then hung the game just the same

		onceEarly = global.KAGMovieStopEarly;

		onceStartTick = System.getTickCount();

		if (once && onceEarly > 0) {

			if (onceTimer === void) onceTimer = new Timer(onOnceTimer, "");

			onceTimer.interval = 50;

			onceTimer.enabled = true;

		}

		file = filename;

		var fn = getExistFileNameAutoExtFill(file, "webm", "mpg", "mpv", "mpeg", "wmv");

		// on the web a movie inside an archive is copied out first (KAGMovieOpenable, Utils.tjs)

		var o = typeof global.KAGMovieOpenable != "undefined" ? KAGMovieOpenable(fn) : [ fn, void ];

		try { open(o[0]); } catch (e) { KAGMovieOpened(o[1]) if o[1] !== void; throw e; }

		KAGMovieOpened(o[1]) if o[1] !== void;

		// Set volume if audio exists

		try { audioVolume = getAudioVolume(); } catch {}

		play();

		// its subtitles (Movies.tjs)

		if (subtitles !== void) { invalidate subtitles; subtitles = void; }

		var cueFile = typeof global.KAGSubtitleFile != "undefined" ? KAGSubtitleFile(filename, subtitle) : void;

		if (cueFile !== void) try { subtitles = new KAGSubtitles(targetLayer.window, this, cueFile); } catch (e) { dm("subtitles: " + cueFile + ": " + e.message); }

	}



	// Get volume (referenced from window)

	function getAudioVolume() {

		with (targetLayer.window)

			return   (.waveenable && .movieAudioEnable) ?

				/**/ (.wavevolume *  .movieAudioVolume) * 10 : 0; // Normally *1000 but since it's vol*vol, *10 is enough

	}



	// Stop from external

	// (a player is stopped once: stopping one that stopped already is left out)

	function stop() {

		if (!stopped && !playedOut) SUPER.stop();

		stopped = true;

		if (subtitles !== void) { invalidate subtitles; subtitles = void; }

		flipStop();

	}

	

	// Reduce Motion: a looping movie (a background, not [movie]'s) pauses on its frame
	function flipCanStill() { return loop && !once; }
	function flipStill(on) {
		FLIP.flipStill(on);
		try { if (on) pause(); else play(); } catch {}
	}

	// Movie update processing

	function onFrameUpdate() {

		if (!isvalid this || ended) return; // once it has ended, not its first frame again

		frames++;

		//dm("Update:" + targetLayer.name);

		switch (alpha) {

		case 0:

			targetLayer.fillAlpha();

			break;

		case 1:

			targetLayer.height = targetLayer.imageHeight / 2;

			targetLayer.copyBottomBlueToTopAlpha();

			break;

		case 2:

			targetLayer.width = targetLayer.imageWidth / 2;

			targetLayer.copyRightBlueToLeftAlpha();

			break;

		}

		// assignImages doesn't copy the layer type, so a target layer left at ltOpaque would draw

		// an alpha movie's clear parts as solid white (across the whole screen for affine layers)

		if (alpha == 1 || alpha == 2) for (var i = flipLayers.count-1; i >= 0; i--) flipLayers[i].type = ltAlpha;

		flipAssign(targetLayer);

		if (fit && (targetLayer.width != fitWidth || targetLayer.height != fitHeight)) fitScreen();

	}



	// fit: zoom the layers showing it (affine layers) so the frame fills the screen, keeping its shape

	function fitScreen() {

		fitWidth = targetLayer.width;

		fitHeight = targetLayer.height;

		if (fitWidth <= 0 || fitHeight <= 0) return;

		var prim = targetLayer.window.primaryLayer;

		var zx = prim.width * 100.0 / fitWidth, zy = prim.height * 100.0 / fitHeight;

		var z = zx < zy ? zx : zy;

		for (var i = flipLayers.count-1; i >= 0; i--) {

			var l = flipLayers[i];

			if (typeof l.zoom != "undefined") l.zoom = z;

		}

	}



	// once: the movie came round to its start again, so it has played once; stopped after the

	// event, which the engine posts from its update of the player

	var once = false, ended = false, stopped = false, playedOut = false, onceTrigger, onceTimer;
	var onceEarly = 0, onceStartTick = 0;

	function onPeriod(reason) {

		if (!once || ended || reason != perLoop) return;

		ended = true;

		if (onceTrigger === void) onceTrigger = new AsyncTrigger(onOnceEnded, "");

		onceTrigger.trigger();

	}

	function onOnceEnded() {

		if (isvalid this) stop();

	}

	function onOnceTimer() {

		if (!isvalid this || ended) { if (isvalid this) onceTimer.enabled = false; return; }

		var total = 0, pos = 0;

		try { total = totalTime, pos = position; } catch {}

		// by its position or by the time since it started, whichever comes first: on a slow

		// Android emulator the position lagged the decoder, which reached the end first, but a

		// movie can't play faster than it runs

		if (total <= 0) return;

		if (pos < total - onceEarly && System.getTickCount() - onceStartTick < total - onceEarly) return;

		ended = true;

		onceTimer.enabled = false;

		if (onceTrigger === void) onceTrigger = new AsyncTrigger(onOnceEnded, "");

		onceTrigger.trigger();

	}



	// Status change

	function onStatusChanged(newstat) {

		//dm("State:" + targetLayer.name + ":" + status + "->" + newstat);

		playedOut = true if (status == "play" && newstat == "stop" && !stopped); // it ran to its end

		flipStop() if (status == "play" && newstat == "stop");

		status = newstat;

	}



//	function flipSetOptions(elm) {}

	function flipStore(dic) {

		with (dic) {

			;.file  = file;

			;.loop  = loop;

			;.alpha = alpha;

			;.once  = once;

			;.subtitle = subtitle;

			;.fit   = fit;

		}

	}

	function flipRestore(dic) {

		start(dic.file, dic.loop, dic.alpha, dic.subtitle, dic.once, dic.fit);

	}

	function flipStart(storage, elm) {

		start(storage, elm.loop, elm.alpha, elm.subtitle, elm.once !== void && elm.once != "false" && +elm.once != 0,

			elm.fit !== void && elm.fit != "false" && +elm.fit != 0);

	}

}



// Registration

GenericFlip.Entry(

	%[

		"type"     => "movie",             // Registration tag

		"class"    => MovieControlLayer,   // Controller class

		"trigger"  => "lmstop",            // Trigger name sent on stop

		"ext"      => [ "webm", "mpeg", "mpg", "mpv", "wmv" ], // Determination process (extension string or array)

//		"checker"  => void,                // Determination process (function)

		"options"  => [ "loop", "alpha", "subtitle", "once", "fit" ], // Option values to use (for KAGEnvLayer)

		"autoflag" => "movie",             // Auto flag tag name (for KAGEnvLayer)

		]);