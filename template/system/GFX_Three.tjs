		}
	}

	// the motion that goes on: a VRM animation, or one of a glTF model's clips
	function setMotion(spec) {
		motionSpec = spec;
		if (vrm !== void) {
			var anim;
			if (spec != "") {
				var fn = system.findFile(spec, "vrma");
				anim = fn != "" ? system.animation(fn) : void;
				if (anim === void) logOnce("motion " + spec, @"no VRM animation ${spec}");
			}
			if (anim !== motionAnim) {
				fadeFrom();
				motionAnim = anim;
				motionTime = 0.0;
			}
		} else if (model !== void) {
			playClip(spec, true);
		}
	}

	// the pose playing fades out into the animation that starts
	function fadeFrom() {
		if (oncePlaying && onceAnim !== void) {
			fromAnim = onceAnim;
			fromTime = onceAnim.getDuration() - onceLeft;
		} else {
			fromAnim = motionAnim;
			fromTime = motionTime;
		}
