			if (typeof window.se != "undefined" && n >= 0 && n < window.se.count) {
				b = window.se[n];
			} else {
				logOnce("lip " + v, @"no sound buffer ${v} for 3dlip");
			}
			if (b !== void && typeof b.getSoundLevel == "undefined") {
