		drawFrame(0);
	}

	function addLights(ambient, key) {
		var amb = new Threepp.HemisphereLight(0xffffff, 0x9088c0, ambient);
		scene.add(amb);
		lights.add(amb);
		var dir = new Threepp.DirectionalLight(0xffffff, key);
		dir.setPosition(1.5, 3, 4);
		scene.add(dir);
		lights.add(dir);
	}

	function flipSetOptions(elm) {
		if (elm === void) return;
		if (elm["3donce"] !== void) {
			// it starts with the next frame (and ends there when it can't): 3donce goes after the
			// tags that follow, a [waittrig name=3donce] among them, have run
			once = elm["3donce"];
			delete elm["3donce"];
		}
		setStateOptions(elm);
	}

	function setStateOptions(elm) {
		for (var i = stateOptions.count - 1; i >= 0; i--) {
			var key = stateOptions[i];
			options[key] = elm[key] if (elm[key] !== void);
		}
		speed = options["3dspeed"] !== void ? +options["3dspeed"] : 1.0;
		speed = 0 if speed < 0;
