	}

	// a glTF model's clip by number or name: its index, -1 when it has none
	function clipIndex(spec) {
		if (model === void) return -1;
		var n = model.getAnimationCount();
		if (spec === void || (string)spec == "") return n > 0 ? 0 : -1;
		if (/^[0-9]+$/.test((string)spec)) return +spec < n ? +spec : -1;
		for (var i = 0; i < n; i++) if (model.getAnimationName(i) == (string)spec) return i;
		return -1;
	}

	// plays a glTF clip (looping, or once); true when it has it
	function playClip(spec, loop) {
		var i = clipIndex(spec);
		if (animator === void || i < 0) {
			if (spec !== void && (string)spec != "") logOnce("clip " + spec, @"no animation ${spec}");
			return false;
		}
		animator.stopAll();
		action = animator.clipAction(model, i);
		action.setLoop(loop ? Threepp.Loop_Repeat : Threepp.Loop_Once, loop ? -1 : 1);
		action.reset();
		action.play();
