		vrm.update(sec > 0.1 ? 0.1 : sec);
	}

	function drawFrame(dt) {
		try {
			step(dt);
			system.render(this, renderer, scene, camera);
		} catch (e) {
			dm(@"3D ${file} stopped: ${e.message}");
			finish();
			return false;
		}
		frames++;
		showFrame();
		return true;
	}

	// Reduce Motion: the scene stops as it shows, after a motion played once ends
	function flipCanStill() { return true; }
	function flipStillBusy() { return once !== void || oncePlaying; }

	function flipUpdate(tick) {
		if (unavailable) {
			if (once !== void) {
				once = void;
				onceEnded();
			}
			return;
		}
		if (scene === void || !isvalid scene || !system.available) {
			scene = void;
			finish();
			return;
		}
