			addLights(0.6, 1.8);
		} else if (kind == "gltf") {
			model = system.loadGLTF(fn);
			if (model === void) {
				releaseThree();
				throw new Exception(@"glTF model ${storage} can't be read");
			}
			holder.add(model.getScene());
			if (model.getAnimationCount() > 0) animator = new Threepp.ModelAnimator(model.getScene());
			addLights(1.0, 2.5);
		} else {
			camera.setPosition(0, 1.6, 6);
			camera.lookAt(0, 1, 0);
			ctx = %[ scene:scene, camera:camera, renderer:renderer, width:w, height:h, options:options, system:system, flip:this, time:0.0 ];
			try {
				threeFunction(KAGThreeScenes[storage])(ctx);
			} catch (e) {
				releaseThree();
				throw new Exception(@"3D scene ${storage} can't be built: ${e.message}");
			}
		}
		setStateOptions(elm);
		if (vrm !== void) {
			// the hair and skirt at rest in the first pose
			step(0);
			vrm.resetSpringBones();
		}
