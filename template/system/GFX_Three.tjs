			onceLeft -= sec;
			if (onceLeft <= 0) {
				onceLeft = 0;
				if (vrm !== void) {
					// it fades out into the motion that goes on
					fadeFrom();
					onceAnim = void;
				}
				oncePlaying = false;
				if (model !== void) playClip(motionSpec, true);
				onceEnded();
			}
		}

		if (vrm !== void) {
			stepVRM(dt, sec);
		} else if (animator !== void) {
			animator.update(sec);
		} else if (ctx !== void) {
			ctx.time = time;
			var f = threeFunction(ctx.update);
			f(ctx, sec) if f !== void;
		}
	}

	// starts a motion played once: true when it has one
	function startOnce(spec) {
		if (vrm !== void) {
			var fn = system.findFile(spec, "vrma");
			var anim = fn != "" ? system.animation(fn) : void;
			if (anim === void) {
				logOnce("motion " + spec, @"no VRM animation ${spec}");
				return false;
			}
			fadeFrom();
			onceAnim = anim;
			onceLeft = anim.getDuration();
			return onceLeft > 0;
		}
		if (model !== void) {
			return playClip(spec, false);
		}
		var f = ctx !== void ? threeFunction(ctx.once) : void;
		if (f !== void) {
			var t = f(ctx, spec);
			onceLeft = t !== void ? +t : 0;
