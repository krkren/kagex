			var k = 1.0 - (fadeLeft > 0 ? fadeLeft / motionFade : 0.0);
			if (anim !== void) vrm.applyAnimationBlend(anim, at, k);
			else vrm.blendToRest(k);
		} else if (anim !== void) {
			vrm.applyAnimation(anim, at);
		}

		// the expressions given, a blink, and the mouth
		var want = threeWeights(options["3dexpression"]);
		var keys = [];
		keys.assign(shown);
		for (var i = 0; i < keys.count; i += 2) {
			if (want[keys[i]] === void) setExpression(keys[i], 0);
		}
		(Dictionary.assign incontextof shown)(want);
		keys.assign(want);
		for (var i = 0; i < keys.count; i += 2) setExpression(keys[i], keys[i + 1]);

		var now = time * 1000;
		if (options["3dblink"] === void || +options["3dblink"]) {
			blinkNext = now + 1500 + Math.random() * 3500 if blinkNext === void;
			if (blinkAt === void && now >= blinkNext) blinkAt = now;
