	}

	// the camera: where 3dcamera says, looking at 3dtarget; else framing the model (3dframe:
	// "<bottom>,<top>" in metres, a VRM's from its feet to above its head by default), from in
	// front, with a field of view of 3dfov degrees (30)
	function placeCamera() {
		var fov = options["3dfov"] !== void ? +options["3dfov"] : 30;
		var pos = threeNumbers(options["3dcamera"], 3);
		var target = threeNumbers(options["3dtarget"], 3);
		if (kind == "scene" && pos === void && target === void && options["3dfov"] === void) return;
		camera.fov = fov;
		camera.aspect = (real)canvasWidth / canvasHeight;
		if (pos === void) {
			var frame = threeNumbers(options["3dframe"], 2);
			if (frame === void) frame = defaultFrame();
			var mid = (frame[0] + frame[1]) / 2;
			var half = (frame[1] - frame[0]) / 2;
			half = 0.05 if half < 0.05;
			var dist = half / Math.tan(fov * Math.PI / 360);
