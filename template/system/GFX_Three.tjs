		if (elm["3dangle"] !== void || frames == 0) {
			angle = options["3dangle"] !== void ? +options["3dangle"] : 0.0;
		}
		turn = options["3dturn"] !== void ? +options["3dturn"] : 0.0;
		if (scene === void) return; // kept for a save all the same
		var spec = options["3dmotion"] !== void ? (string)options["3dmotion"] : "";
		if (spec != motionSpec || motionSpec === void) setMotion(spec);
		placeCamera();
		if (vrm !== void) {
			setLip(options["3dlip"]);
