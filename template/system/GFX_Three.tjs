		}
		return false;
	}

	function stepVRM(dt, sec) {
		// the pose: the motion that goes on, or the one played once; the one before fading out
		if (motionAnim !== void) {
			var d = motionAnim.getDuration();
			motionTime += sec;
			motionTime %= d if d > 0;
		}
		var anim = oncePlaying ? onceAnim : motionAnim;
		var at = oncePlaying ? onceAnim.getDuration() - onceLeft : motionTime;
		if (fadeLeft > 0 && fromAnim !== void) {
			fromTime += sec;
			var fd = fromAnim.getDuration();
			fromTime %= fd if fd > 0 && fromAnim === motionAnim;
			vrm.applyAnimation(fromAnim, fromTime);
