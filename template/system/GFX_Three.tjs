	}

	function flipStore(dic) {
		// a motion playing once isn't kept
		if (dic === void || file == "") return;
		dic.file    = file;
		dic.width   = canvasWidth;
		dic.height  = canvasHeight;
		dic.options = %[];
		(Dictionary.assign incontextof dic.options)(options);
	}

	function flipRestore(dic) {
		if (dic === void || dic.file == "") return; // flipUpdate ends it
		var elm = %[];
		(Dictionary.assign incontextof elm)(dic.options) if (dic.options !== void);
		elm["3dwidth"]  = dic.width;
		elm["3dheight"] = dic.height;
		flipStart(dic.file, elm);
	}
}

// Registration
GenericFlip.Entry(
	%[
		"type"     => "3d",                           // Registration tag ([newlay 3d=...])
		"class"    => ThreeFlip,                      // Controller class
		"trigger"  => "3ddone",                       // Trigger sent when every 3D flip has ended
		"ext"      => [ "vrm", "glb", "gltf" ],       // Extensions
		"checker"  => function(storage) {             // scenes built in script, by name
			return storage !== void && (string)storage != "" && global.KAGThreeScenes[(string)storage] !== void;
		},
		"options"  => [ "3dwidth", "3dheight", "3dmotion", "3donce", "3dexpression", "3dblink", "3dlook",
						"3dlip", "3dangle", "3dturn", "3dspeed", "3dcamera", "3dtarget", "3dfov", "3dframe" ],
		"dtstore"  => true,                           // Restore flag (for KAGEnvLayer)
		"keepOnRedraw" => true,                       // Plays on through a World layer's redraw
		]);
