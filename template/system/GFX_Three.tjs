			delete elm["3donce"];
		}
		// no way to draw (the console said why, as the window's 3D system was made): the layer
		// shows nothing, and stays, so that a motion played once still sends 3donce, a frame
		// later, and [layopt 3donce=...][waittrig name=3donce] goes on
		if (!system.available) {
			unavailable = true;
			setStateOptions(elm);
			showFrame();
			return;
		}

		renderer = system.newRenderer();
		scene = new Threepp.Scene();
		camera = new Threepp.PerspectiveCamera(30, (real)w / h, 0.05, 200);
		holder = new Threepp.Group();
		scene.add(holder);
		system.addUser(this);
		if (kind == "vrm") {
			vrm = system.loadVRM(fn);
			if (vrm === void) {
				releaseThree();
				throw new Exception(@"VRM model ${storage} can't be read");
			}
			holder.add(vrm.getScene());
			expressions = new KAGThreeExpressions(vrm);
