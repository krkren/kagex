			else vrm.clearLookAtTarget();
		}
	}

	// the part of the model shown, bottom to top (metres): a VRM's feet to 0.3 above its head
	// bone, where a VRoid's head ends; else two metres from the ground
	function defaultFrame() {
		if (vrm !== void) {
			try {
				var head = vrm.getBoneNode("head");
				if (head !== void) {
					vrm.getScene().updateMatrixWorld(true);
					var p = head.getWorldPosition();
					return [ -0.05, p.y + 0.3 ];
				}
			} catch {}
		}
		return [ 0, 2 ];
	}

	// the SE buffer (its number) whose sound opens the mouth, or none ("")
	function setLip(v) {
		var b;
		if (v !== void && (string)v != "") {
