// KAGEnvCharacterModel.tjs - World characters played by a model that moves by itself
//
// The base of Live2D characters (KAGEnvCharacterLive2D.tjs) and VRM characters
// (KAGEnvCharacterVRM.tjs): a model drawn every few frames into a picture the size of the
// character's World level, whose poses are motions that go on, whose motions play once and go
// back to the pose, and whose faces fade into each other. It blinks and lip-syncs to its voice as
// a character drawn from layers does (KAGEnvCharacterEyeLip.tjs). An entry's settings (its
// "live2d", its "vrm") have the poses, motions and faces by name:
//
//       "poses"   => %[ standard:<motion that goes on> ],
//       "motions" => %[ tap:<motion played once> ],
//       "faces"   => %[ normal:%[], smile:%[ ... ] ],
//       "defaultPose" => "standard",
//       "defaultFace" => "normal",
//       "height"  => 1650,   // the picture's height on the screen at 100%
//       "anchor"  => [x, y], // where the World places it, from the picture's centre
//
// A subclass reads its model (prepareModel), moves it on (step) and draws it (renderModel), and
// says what a motion and a face are (startMotion, motionPlaying, faceValuesOf).

class KAGEnvCharacterModel extends KAGEnvCharacterEyeLip {

	var kind = "model";  // in messages: "Live2D", "VRM"
	var config;          // the entry's settings
	var aspect = 1.0;    // its picture's width for its height
	var failed;          // why it can't be drawn, when it can't
	var renderLayer;     // the picture drawn
	var emptyLayer;      // the picture when it can't be drawn

	var lastStep;        // when the model last moved (System.getTickCount)
	var lastDraw;        // when it was last drawn
	var poseStart;       // the pose's motion is to start again
	var oneShot;         // a motion to play once (its spec, as in "motions"), until it starts
	var oneShotPlaying;  // a motion playing once
	var motionWait;      // the command waits for that motion to end (motionwait)
	var missingMotions = %[]; // the motions the model doesn't have, logged once

	var faceFrom = %[];  // the face's values fading out
	var faceTo = %[];    // and fading in
	var faceStart;       // when the fade began

	/**
	 * Constructor
	 * @param conf the entry's settings for the model (its "live2d", its "vrm")
	 */
	function KAGEnvCharacterModel(env, name, initName, init, conf) {
		super.KAGEnvCharacterEyeLip(env, name, initName, init);
		config = conf;
		pose = config.defaultPose !== void ? config.defaultPose : firstName(config.poses);
		face = config.defaultFace;
		// it blinks, and its mouth follows its voice, unless told otherwise (eyeflipoff ...)
		eyeflipTime = void;
		lipflipTime = void;
		setEyeState(6);
		setLipState(6);
	}

	function finalize() {
		releasePlayer();
		invalidate renderLayer if renderLayer !== void;
		invalidate emptyLayer if emptyLayer !== void;
		super.finalize(...);
	}

	// a setting that's a name or a list of names, as a list
	function listOf(v, def) {
		if (v === void) return def;
		if (typeof v == "String") return v != "" ? [ v ] : [];
		var ret = [];
		ret.assign(v);
		return ret;
	}

	function firstName(dict) {
		if (dict === void) return void;
		var list = [];
		list.assign(dict);
		return list.count > 0 ? list[0] : void;
	}

	function namesOf(dict) {
		var ret = [];
		if (dict !== void) {
			var list = [];
			list.assign(dict);
			for (var i = 0; i < list.count; i += 2) ret.add(list[i]);
			ret.sort();
		}
		return ret;
	}

	// The model's poses, motions and faces by name
	function poseSpec(name)   { return config.poses   !== void && name !== void ? config.poses[name]   : void; }
	function motionSpec(name) { return config.motions !== void && name !== void ? config.motions[name] : void; }
	function faceSpec(name)   { return config.faces   !== void && name !== void ? config.faces[name]   : void; }

	// ----------------------------------------------------------------
	// What a subclass does
	// ----------------------------------------------------------------

	// whether the model has been read and can be drawn
	function modelReady() { return false; }

	// reads the model: true, or false with failed saying why
	function prepareModel() { failed = "no model"; return false; }

	// lets go of the model (its GL objects); it's read again when next drawn
	function releaseModel() {}

	/**
	 * Starts a motion: a pose's that goes on (asPose), or one played once; true when the model
	 * has it
	 */
	function startMotion(spec, asPose) { return false; }

	// whether the motion playing goes on (false when one played once has ended)
	function motionPlaying() { return true; }

	// moves the model on to tick (stepMotions starts its motions)
	function step(tick) {}

	// draws the model into layer, the size of its picture
	function renderModel(layer) {}

	// ms between the frames drawn, of a face's fade, the tallest picture drawn
	function frameTime() { return 33; }
	function faceFadeTime() { return 300; }
	function maxPictureHeight() { return 2048; }

	/**
	 * The values of a face (%[ key:value ]), which fade into the next face's
	 */
	function faceValuesOf(faceName) {
		var spec = faceSpec(faceName);
		var ret = %[];
		(Dictionary.assign incontextof ret)(spec, false) if typeof spec == "Object" && spec !== null;
		return ret;
	}

	// a value with no face
	function noFaceValue(key) { return 0.0; }

	// ----------------------------------------------------------------

	// Show a released model again on the next draw (its picture, its GL objects)
	function releasePlayer() {
		releaseModel();
		oneShotPlaying = false;
		lastStep = void;
		lastDraw = void;
	}

	// The stand-in picture cache ([env clearstandcache]): a model not shown is let go
	function flashStandLayerInfo() {
		releasePlayer() if !isShow();
	}

	// Initialize level at initial display: a character that goes lets go of its model
	property disp {
		getter() {
			return *(&global.KAGEnvCharacter.disp incontextof this);
		}
		setter(v) {
			if (disp != CLEAR && v == CLEAR) {
				releasePlayer();
			}
			*(&global.KAGEnvCharacter.disp incontextof this) = v;
		}
	}

	// ----------------------------------------------------------------
	// Poses, motions and faces
	// ----------------------------------------------------------------

	/**
	 * Sets the pose: the motions that go on while nothing else plays
	 */
	function setPose(poseName, elm) {
		if (poseSpec(poseName) === void) {
			env.errorCmd(@"${name}: no ${kind} pose ${poseName}");
			return;
		}
		if (poseName != pose || isClear()) {
			if (elm.emotion === void) {
				hideEmotion();
			}
			pose = poseName;
			poseStart = true;
			if (isClear()) {
				initFile(elm);
				disp = SHOW;
				redraw = true;
				setAutoTrans([init.poseTrans, init.charTrans, env.envinfo.poseTrans, env.envinfo.charTrans], elm);
				ypos = 0 if (elm.ypos === void);
			}
		}
	}

	/**
	 * Plays a motion once, then the pose's again
	 */
	function playOnce(motionName, elm) {
		var spec = motionSpec(motionName);
		if (spec === void) {
			env.errorCmd(@"${name}: no ${kind} motion ${motionName}");
			return;
		}
		// skipped with nothing shown, it doesn't play: the screen isn't drawn
		if (!env.skipNoDisp) {
			oneShot = spec;
			motionWait = elm.motionwait !== void && +elm.motionwait;
		}
		if (isClear()) {
			initFile(elm);
			disp = SHOW;
			redraw = true;
			setAutoTrans([init.poseTrans, init.charTrans, env.envinfo.poseTrans, env.envinfo.charTrans], elm);
		}
	}

	/**
	 * Starts the face's values fading in (at once with now), from where the face is
	 */
	function setFaceValues(now) {
		var to = faceValuesOf(face);
		var tick = System.getTickCount();
		faceFrom = now ? to : currentFaceValues(tick);
		faceTo = to;
		faceStart = now ? void : tick;
	}

	/**
	 * Sets the face
	 */
	function setFace(faceName, elm) {
		if (faceSpec(faceName) === void) {
			env.errorCmd(@"${name}: no ${kind} face ${faceName}");
			return;
		}
		if (faceName != face) {
			if (env.envinfo.hideEmotionOnFace && elm.emotion === void) {
				hideEmotion();
			}
			face = faceName;
			// before the model is read, at once. With effects off nothing moves the model on (no
			// update handler), so the face changes at once and the character is drawn again now
			setFaceValues(isClear() || !modelReady() || env.isNoeffect());
			redraw = true if env.isNoeffect();
		}
		if (isClear()) {
			disp = SHOW;
			redraw = true;
			setAutoTrans([init.faceTrans, init.charTrans, env.envinfo.faceTrans, env.envinfo.charTrans], elm);
		}
	}

	/**
	 * The face's values at tick, on their way from faceFrom to faceTo (a value one of them
	 * doesn't name from or to its value with no face)
	 */
	function currentFaceValues(tick) {
		var t = 1.0;
		var fade = faceFadeTime();
		if (faceStart !== void && fade > 0) {
			t = (tick - faceStart) / fade;
			t = 1.0 if t > 1.0;
			t = 0.0 if t < 0.0;
		}
		var ret = %[];
		var keys = [];
		keys.assign(faceFrom);
		for (var i = 0; i < keys.count; i += 2) ret[keys[i]] = true;
		keys.assign(faceTo);
		for (var i = 0; i < keys.count; i += 2) ret[keys[i]] = true;
		keys.assign(ret);
		for (var i = 0; i < keys.count; i += 2) {
			var p = keys[i];
			var none = noFaceValue(p);
			var a = faceFrom[p] !== void ? +faceFrom[p] : none;
			var b = faceTo[p] !== void ? +faceTo[p] : none;
			ret[p] = a + (b - a) * t;
		}
		return ret;
	}

	// ----------------------------------------------------------------
	// Commands
	// ----------------------------------------------------------------

	/**
	 * Prioritize pose specification processing
	 */
	function doPoseCommand(cmd, param, elm) {
		if (cmd == "pose") {
			setPose(param, elm);
			return true;
		}
		if (poseSpec(cmd) !== void) {
			setPose(cmd, elm);
			return true;
		}
		return false;
	}

	/**
	 * Execute command
	 */
	function doCommand(cmd, param, elm) {
		if (doEyeLipCommand(cmd, param, elm)) {
			return true;
		}
		if (cmd == "motion") {
			playOnce(param, elm);
			return true;
		}
		if (cmd == "motionwait") {
			return true; // with the motion
		}
		if (motionSpec(cmd) !== void) {
			playOnce(cmd, elm);
			return true;
		}
		if (faceSpec(cmd) !== void) {
			setFace(cmd, elm);
			return true;
		}
		// x<face>: a blink as the face changes (the model fades from one to the other)
		if (cmd == "xface" || (cmd.charAt(0) == "x" && faceSpec(cmd.substr(1)) !== void)) {
			setFace(cmd == "xface" ? param : cmd.substr(1), elm);
			eyeflip = 1 if !(eyeflip > 0);
			return true;
		}
		return super.doCommand(cmd, param, elm);
	}

	function initCommand() {
		super.initCommand();
		motionWait = false;
	}

	// With effects off the update handler doesn't run, so the eyes and mouth go to what their
	// commands (eyeclose, lipopen ...) set when the character is drawn again, as
	// KAGEnvCharacterEx's characters do on every redraw
	function command(elm) {
		super.command(elm);
		initEyeLip() if redraw && env.isNoeffect();
	}

	function checkSync(elm) {
		super.checkSync(elm);
		syncCommand = true if motionWait;
	}

	function sync(elm, skipMode) {
		super.sync(...);
		if (motionWait) {
			motionWait = false;
			env.addFastTag("wchanim", %[target:this]);
		}
	}

	// a motion played once can be waited for (motionwait) and is stopped by a click; not when
	// the model can't be drawn (nothing plays it), nor with effects off
	function canWaitAnim() {
		if (failed !== void || env.isNoeffect()) return false;
		return oneShot !== void || oneShotPlaying;
	}

	function stopAnim() {
		var was = canWaitAnim();
		oneShot = void;
		if (oneShotPlaying) {
			oneShotPlaying = false;
			poseStart = true;
		}
		env.trigger(name + "_anim") if was;
	}

	function waitAnim(elm, main) {
		if (!canWaitAnim()) {
			return 0;
		}
		var trigger = name + "_anim";
		var canskip = elm.canskip !== void ? elm.canskip : true;
		if (canskip && main.clickSkipEnabled) {
			if (main.skipMode) {
				stopAnim();
				return 0;
			}
			main.conductor.wait(%[
				click : function(arg) { arg(); } incontextof this,
				click_arg : stopAnim,
				trigger => function(arg) { return arg; } incontextof this,
				trigger + "_arg" => +elm.wait
				]);
		} else {
			main.conductor.wait(%[
				trigger => function(arg) { return arg; } incontextof this,
				trigger + "_arg" => +elm.wait
				]);
		}
		return -2;
	}

	// ----------------------------------------------------------------
	// Save and load
	// ----------------------------------------------------------------

	function onRestore(f) {
		super.onRestore(f);
		// the pose's motion from its start, the face as it was, no motion played once
		oneShot = void;
		oneShotPlaying = false;
		poseStart = true;
		restoreModel();
		setFaceValues(true);
		restoreEyeLip(f);
	}

	// what a load puts back in the model beyond the pose and the face
	function restoreModel() {}

	// ----------------------------------------------------------------
	// Drawing
	// ----------------------------------------------------------------

	/**
	 * Reads the model, the first time it's drawn; false (and why, logged once) when it can't be
	 * drawn
	 */
	function prepare() {
		if (modelReady()) return true;
		if (failed !== void) return false;
		if (!prepareModel()) {
			failed = "it can't be read" if failed === void;
			dm(@"${kind} character ${name} isn't drawn: ${failed}");
			releaseModel();
			return false;
		}
		poseStart = true;
		lastStep = void;
		return true;
	}

	function approach(v, target, dt, time) {
		if (time <= 0 || dt >= time) return target;
		return v + (target - v) * dt / time;
	}

	/**
	 * The motions of a step: one played once that starts, else the pose's (again, when one played
	 * once ends or the motion playing does)
	 */
	function stepMotions() {
		if (oneShot !== void) {
			var spec = oneShot;
			oneShot = void;
			if (startMotion(spec, false)) {
				oneShotPlaying = true;
				poseStart = false;
			} else {
				// it didn't start: nothing to wait for (motionwait)
				env.trigger(name + "_anim");
			}
		} else if (poseStart || !motionPlaying()) {
			if (oneShotPlaying) {
				oneShotPlaying = false;
				env.trigger(name + "_anim");
			}
			startMotion(poseSpec(pose), true);
			poseStart = false;
		}
	}

	// a motion the model doesn't have, logged once
	function noMotion(motion) {
		if (missingMotions[motion] !== void) return;
		missingMotions[motion] = true;
		dm(@"${kind} character ${name}: its model has no motion ${motion}");
	}

	/**
	 * Draws the model: into a picture the size of its height at the character's level, which
	 * the World places by the picture's centre (moved by "anchor")
	 * @param layer Target layer
	 * @param levelName Level name
	 * @param pose Pose specification
	 * @return true if successful
	 */
	function drawPose(layer, levelName, pose) {
		var levelInfo = env.levels[(int)+level];
		var zoom = 100;
		if (levelInfo !== void) {
			zoom = levelInfo.imgzoom !== void ? +levelInfo.imgzoom : levelInfo.zoom !== void ? +levelInfo.zoom : 100;
		}
		var height = config.height !== void ? +config.height : kag.scHeight;
		var h = height * zoom / 100.0;
		var maxh = maxPictureHeight();
		var r = h > maxh ? maxh / h : 1.0;
		var rh = (int)(h * r + 0.5);
		rh = 1 if rh < 1;
		var rw = (int)(rh * aspect + 0.5);
		rw = 1 if rw < 1;

		// the model read the first time, which calls into the plugin: an error there is logged
		// and the character drawn empty, as an error in drawing it is
		var ready = false;
		if (!env.skipNoDisp) {
			try {
				ready = prepare();
			} catch (e) {
				dm(@"${kind} character ${name} isn't drawn: ${e.message}");
				stopAnim();
				failed = e.message;
				releasePlayer();
			}
		}
		if (ready) {
			if (renderLayer === void) {
				var parent = env.temporaryLayer;
				renderLayer = new global.Layer(parent.window, parent);
				renderLayer.name = @"${kind} picture:${name}";
			}
			if (renderLayer.imageWidth != rw || renderLayer.imageHeight != rh) {
				renderLayer.setImageSize(rw, rh);
			}
			var tick = System.getTickCount();
			try {
				step(tick);
				renderModel(renderLayer);
			} catch (e) {
				dm(@"${kind} character ${name} stopped: ${e.message}");
				stopAnim();
				failed = e.message;
				releasePlayer();
				renderLayer.fillRect(0, 0, rw, rh, 0);
			}
			lastDraw = tick;
			layer.assignImages(renderLayer);
		} else if (env.skipNoDisp && modelReady() && renderLayer !== void) {
			// a skip that shows nothing: the picture as it was
			layer.assignImages(renderLayer);
			rw = renderLayer.imageWidth;
			rh = renderLayer.imageHeight;
			r = rh / h;
		} else {
			// nothing to draw: an empty picture, placed as the model would be
			if (emptyLayer === void) {
				var parent = env.temporaryLayer;
				emptyLayer = new global.Layer(parent.window, parent);
				emptyLayer.name = @"${kind} picture (none):${name}";
				emptyLayer.setImageSize(1, 1);
				emptyLayer.fillRect(0, 0, 1, 1, 0);
			}
			layer.assignImages(emptyLayer);
			r = 1.0;
			rw = rh = 1;
		}
		layer.type = ltAlpha;
		layer.resolution = drawResolution = 100 * r;
		var anchor = config.anchor;
		var ax = anchor !== void ? +anchor[0] * zoom / 100 : 0;
		var ay = anchor !== void ? +anchor[1] * zoom / 100 : 0;
		afx = defaultAfx = (int)(rw / r / 2 + ax);
		afy = defaultAfy = (int)(rh / r / 2 + ay);
		return true;
	}

	// drawLayer sets a level's imgzoom as the picture's resolution, for pictures drawn at 100%:
	// this one is drawn at the level's size already
	var drawResolution;
	function drawLayer(layer) {
		super.drawLayer(layer);
		if (drawResolution !== void && isShowBU()) {
			layer.resolution = drawResolution;
		}
	}

	/**
	 * No face window (facewin) for a model
	 */
	function drawFace(layer) {
		return false;
	}

	// the model moves on its own: draw it again every frameTime while it shows
	function updateExtra(tick) {
		if (!modelReady() || !isShow() || env.skipNoDisp) return 0;
		if (lastDraw !== void && tick - lastDraw < frameTime()) return 0;
		return 1;
	}

	function isAnimating() {
		return isShow() && failed === void && !env.skipNoDisp;
	}

	// ----------------------------------------------------------------
	// Names, for the debug tools
	// ----------------------------------------------------------------

	function getPoseNames() {
		return namesOf(config.poses);
	}

	function getDressNames() {
		return [];
	}

	function getFaceNames() {
		return namesOf(config.faces);
	}

	function getMotionNames() {
		return namesOf(config.motions);
	}
};
