    if (playing) kag.setBgmStop(%[ exp:'playNext();']);
}

/**
 * End Music Mode
 */
function musicEnd()
{
    voiceListStop();
    kag.bgm.setLoop(true);
    kag.clearBgmStop();
}

/**
 * Leaving Extras for the title (title.ks *backtotitle): the music room's track stops, unless it's
 * kept as the title's music
