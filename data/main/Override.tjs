}
// the next or the previous list (the favourites, the playlists)
function voiceListStep(dir)
{
    var n = KAGFavouriteVoices.playlists + 1;
    KAGFavouriteVoices.at = ((KAGFavouriteVoices.at + dir) % n + n) % n;
    tf.voicePosition = 0;
    tf.voiceFocus = void;
    voiceListStop();
}
// Play all: the list's voices one after another, the row playing focused; again: stop
var voiceListPlayer;
function voiceListPlaying() { return voiceListPlayer !== void && voiceListPlayer.playing; }
function voiceListPlay()
{
    if (voiceListPlaying()) { voiceListStop(); voicePlayLabel(); return; }
    if (tf.voiceRows === void || tf.voiceRows.count == 0) return;
    if (voiceListPlayer === void) {
        voiceListPlayer = new KAGVoiceListPlayer();
        voiceListPlayer.onEntry = voiceListAt;
        voiceListPlayer.onEnd = voicePlayLabel;
    }
    voiceListPlayer.play(tf.voiceRows, 0);
    voicePlayLabel();
}
function voiceListStop() { voiceListPlayer.stop() if voiceListPlaying(); }
function voiceListAt(i)
{
    var l = kag.current.names.voiceList;
    if (l === void || !isvalid l) return;
    l.focusIndex = i;
    l.show(i, true);
    l.redraw();
}
// Play all's label (Stop while the list plays), on the button's pictures loaded again
function voicePlayLabel(m = kag.current)
{
    var p = m.names.voice_play;
    if (p === void || !isvalid p) return;
    p.loadButtons("music_view_normal", "music_view_over");
    drawButtonLabel(p, voiceListPlaying() ? tr("Stop") : tr("Play all"), [0x5025ff, 0xffffff, 0xffffff], 26);
}
// a line's scene played from the line to the scene's end, and back to the music room (as
// Search plays a line found)
function voicePlayScene(index)
{
    var e = tf.voiceRows[index];
    if (e === void || typeof global.world_object == "undefined") return;
    voiceListStop();
    var l = kag.fore.messages[0].names.voiceList;
    if (l !== void && isvalid l) tf.voicePosition = l.position, tf.voiceFocus = index;
    stopBgm() if tf.musicplaying;
    tf.recollect = 1;
    kag.process('loadinit.ks', '', true, true);
    world_object.initPlayer();
    world_object.player.seek(e.storage, e.label, e.idx, true);
    kag.startRecollection(%[storage:e.storage, target:"", doneStorage:"musicmode.ks", doneTarget:""]);
}

/**
 * Update BGM state
 */
function updateBgm()
{
    if (tf.musicplaying) {
        kag.clearBgmStop();
        kag.bgm.exchange(%[ storage:tf.musicmodelist[tf.playbgmnum].filename, time:1000]);
        kag.bgm.setLoop(tf.musicrepeat);
        kag.setBgmStop(%[ exp:'playNext();']);
        sf.titleMusic = tf.musicmodelist[tf.playbgmnum].filename if keepTitleMusic();
    } else {
        kag.clearBgmStop();
        kag.bgm.fadeOut(%[ time:1000]);
    }
    setMusicmodePageButton();
    setPlayButton() if kag.conductor.curStorage == "musicmode.ks";
    tf.beforemusic = tf.playbgmnum;
}

function startBgm()
{
    tf.musicplaying = true;
    updateBgm();
}

function stopBgm ()
{
    tf.musicplaying = false;
    updateBgm();
}

function playBgm(work)
{
    tf.playbgmnum = work;
    startBgm();
}

/**
 * Processing when song playback ends
 */
function playNext()
{
    if (tf.musicrepeat) { stopBgm(); return; }
    // the list the track was picked from (every track, or a playlist), the tracks heard
    var rows = musicRows(tf.musicPlayingList), heard = [];
    for (var i = 0; i < rows.count; i++) heard.add(rows[i]) if tf.bgmplayflag[rows[i]];
    if (heard.count == 0) { stopBgm(); return; }
    var at = heard.find(tf.playbgmnum);
    if (tf.musicmode == "shuffle" && heard.count > 1) {
        // any other, at random
        var k = (int)(Math.random() * (heard.count - 1));
        k++ if at >= 0 && k >= at;
        tf.playbgmnum = heard[k];
    } else {
        tf.playbgmnum = heard[(at + 1) % heard.count];
    }
    updateBgm();
}

// ---- the tracks' playlists (since 0.25.0): sf.musicPlaylists, three lists of track files; the
// Music view shows every track (sf.musicListAt 0, whose rows' 1 2 3 put a track in a playlist)
// or a playlist (its handle puts its tracks in order), and a track plays on through its list
var musicPlaylistCount = 3;
function musicPlaylist(n)
{
    var p = sf.musicPlaylists;
    if (typeof p != "Object" || p === void || !(p instanceof "Array")) p = sf.musicPlaylists = [];
    while (p.count < n) p.add([]);
    return p[n - 1];
}
// the track numbers a list shows (0: every track)
function musicRows(n = void)
{
    n = +sf.musicListAt if n === void;
    var r = [];
    if (n <= 0) { for (var i = 0; i < tf.musicmodelist.count; i++) r.add(i); return r; }
    var l = musicPlaylist(n);
    for (var i = 0; i < l.count; i++) { var k = musicIndexOf(l[i]); r.add(k) if k >= 0 && r.find(k) < 0; }
    return r;
}
function musicListName(n = void)
{
    n = +sf.musicListAt if n === void;
    return n <= 0 ? tr("All tracks") : tr("Playlist %d").sprintf(n);
}
function musicListStep(dir)
{
    var n = musicPlaylistCount + 1;
    sf.musicListAt = ((+sf.musicListAt + dir) % n + n) % n;
}
function musicInPlaylist(track, n) { return musicPlaylist(n).find(tf.musicmodelist[track].filename) >= 0; }
function musicTogglePlaylist(track, n)
{
    var l = musicPlaylist(n), f = tf.musicmodelist[track].filename, i = l.find(f);
    if (i >= 0) l.erase(i); else l.add(f);
}
function musicReorder(from, to)
{
    var l = musicPlaylist(+sf.musicListAt);
    if (from < 0 || from >= l.count || to < 0 || to >= l.count) return;
    var e = l[from];
    l.erase(from);
    l.insert(to, e);
    tf.musicRows = musicRows();
}

