// --------------------------------------------------------
// Search (Extras): the lines read so far, in the compiled scenes (searchmode.ks)
// --------------------------------------------------------

var searchFound = []; // what the last search found (KAGEnvPlayer.searchTexts)
var searchRowPics = %[]; // the rows' pictures (search_row_normal, search_row_over)
var searchMax = 500;  // the most it finds
var searchTrigger;    // shows the screen again once the key or click that searched is over
var searchNames;      // what replaylist.csv calls each script (its "Start" scene's title)

// Whether there's anything to search: the World's scene player and compiled scripts
function searchAvailable()
{
    return typeof global.world_object != "undefined" && world_object.scenePlayEnabled &&
        Storages.isExistentStorage("!scnlist.txt");
}

function searchInit()
{
    sf.extramode = 4;
    tf.recollect = 0;
    tf.searchText = "" if tf.searchText === void;
    tf.searchPosition = 0 if tf.searchPosition === void; // the list's scroll and focus, kept
    tf.searchFocus = -1 if tf.searchFocus === void;      // over a line played from it
    // the scene player's script (it loads when first used)
    KAGLoadScript("KAGEnvPlayer.tjs") if typeof global.world_object != "undefined" && typeof global.scnFindCompiled == "undefined";
    // the scripts' names, from Replay's list: a row says which demo its line is in
    searchNames = %[];
    var parser = new ReplayListParser();
    var list = parser.parseStorage("replaylist.csv");
    invalidate parser;
    for (var i = 0; i < list.count; i++) {
        var info = list[i];
        if (info === void || info.title == "") continue;
        var key = (info.scene + ".ks").toLowerCase();
        if (info.target == "*" || info.target == "start" || searchNames[key] === void) searchNames[key] = info.title;
    }
    searchFound = [];
    var text = ((string)tf.searchText).trim();
    if (!searchAvailable()) {
        tf.searchStatus = tr("Search looks through compiled scenes, and this game has none");
    } else if (text == "") {
        tf.searchStatus = tr("Type a word or a name, then press Return");
    } else {
        world_object.initPlayer();
        searchFound = world_object.player.searchTexts(text, !tf.allseen, searchMax);
        var n = searchFound.count;
        tf.searchStatus = n == 0 ? tr("No line read so far has \"%s\"").sprintf(text) :
            (n == 1 ? tr("1 line") : tr("%d lines").sprintf(n)) + (n >= searchMax ? tr(" (the first %d)").sprintf(searchMax) : "") +
            tr(" with \"%s\": choose one to play from it").sprintf(text);
    }
}

// The Search button: what's typed, then searchRun
function searchFromField()
{
    kag.fore.messages[0].commit();
    searchRun();
}

// Return in the field ([edit enter=]) or the button: the screen again with what tf.searchText
// finds, from its first page
function searchRun()
{
    tf.searchPosition = 0, tf.searchFocus = -1;
    if (searchTrigger === void) searchTrigger = new AsyncTrigger(function { kag.process("searchmode.ks"); }, "");
    searchTrigger.trigger();
}

// Typing goes to the field
function searchFocus()
{
    var e = kag.fore.messages[0].names["tf.searchText"];
    e.focus() if e !== void;
}

// Fits a found line to w (font as set): a window around the match at m (when it's found in
// the line), with ellipses where it's cut. [prefix, from, to, suffix]
function searchFit(font, text, m, w)
{
    var a = 0, b = text.length, pre = "";
    if (m > 30 && font.getTextWidth(text) > w) {
        a = m - 30;
        pre = "...";
    }
    while (b > a && font.getTextWidth(pre + text.substring(a, b - a) + (b < text.length ? "..." : "")) > w) b--;
    return [pre, a, b, b < text.length ? "..." : ""];
}

// A row: the scene and who speaks above, the line below with what was looked for picked out
// (over: the row under the pointer or the keys)
function drawSearchRow(layer, info, key, over)
{
    var hold = layer.holdAlpha;
    layer.holdAlpha = true;
