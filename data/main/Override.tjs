function extrasLeave()
{
    if (!roomMusicPlaying()) return;
    kag.clearBgmStop();
    if (keepTitleMusic()) kag.bgm.setLoop(true);
    else stopBgm();
}

// ---- the title's music: a track from the music room, kept there ([Keep on Title]) ----

function keepTitleMusic()
