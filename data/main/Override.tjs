KAGLoadScript("MyHistoryLayer.tjs");
// the layer demo's 3D scene built in script (KAGThreeScene, GFX_Three.tjs)
KAGLoadScript("Scenes3D.tjs") if typeof global.KAGThreeScene != "undefined";

/**
 * Determination of whether the system menu is currently running
 */
function inSystemMenu(kag)
{
    return (kag.currentStorage == "config.ks"    ||
            kag.currentStorage == "musicmode.ks" ||
            kag.currentStorage == "cgmode.ks"    ||
            kag.currentStorage == "replay.ks" ||
            kag.currentStorage == "save.ks" ||
            kag.currentStorage == "load.ks" ||
            kag.conductor == kag.extraConductor);
};

/**
 * Enable/Disable control for message layer buttons
 * @param layer Message layer
 * @param name Button name
 * @param enabled True if enabled
 */
function setLayerButtonEnabled(layer, name, enabled)
{
    if (layer !== void && layer.buttons[name] !== void) {
        layer.buttons[name].enabled = enabled;
    }
}

/**
 * Enable/Disable control for message layer 0 buttons
 * @param kag KAG window
 * @param name Button name
 * @param enabled True if enabled
 */
function setButtonEnabled(kag, name, enabled)
{
    setLayerButtonEnabled(kag.fore.messages[0], name, enabled);
    setLayerButtonEnabled(kag.back.messages[0], name, enabled);
}

/**
 * Switch message layer button mode (ON/Normal)
 * Expects image filenames as: Normal: msg_name_normal / Over: msg_name_over / ON: msg_name_on
 * @param layer Message layer
 * @param name Button name
 * @param mode True if ON
 */
function setLayerButtonMode(layer, name, mode)
{
    if (layer !== void && layer.buttons[name] !== void) {
        if (mode) {
            layer.buttons[name].loadButtons(name + "_on", name + "_over");
        } else {
            layer.buttons[name].loadButtons(name + "_normal", name + "_over");
        }
    }
}

/**
 * Switch message layer 0 button mode (ON/Normal)
 * @param kag KAG window
 * @param name Button name
 * @param mode True if ON
 */
function setButtonMode(kag, name, mode)
{
    setLayerButtonMode(kag.fore.messages[0], name, mode);
    setLayerButtonMode(kag.back.messages[0], name, mode);
}

/**
 * EXIT, in a scene played from Extras: back where it was played from (Replay), or the title
 */
function exitScene()
{
    if (kag.isRecollection && kag.recollectionStorage != "") {
        var storage = kag.recollectionStorage, target = kag.recollectionTarget;
        kag.stopRecollection();
        kag.process(storage, target);
    } else {
        kag.process('title.ks', '*start');
    }
}

/**
 * Whether BACK can go back a message (compiled scenes: KAGEnvPlayer.rollback)
 */
function canRollBack()
{
    return typeof global.world_object != "undefined" && world_object.player !== void && world_object.player.canRollback;
}

/**
 * BACK: the message before the one on screen, as it was
 */
function rollBack()
{
    if (canRollBack()) world_object.player.rollback(true);
}

/**
 * The scene player's moves (since 0.18.0; compiled scenes only, as BACK): the start of the scene
 * (or the one before), a rewind to it or the last choice, the last choice again, the next scene
 */
function playerOf()
{
    return typeof global.world_object != "undefined" && world_object.player !== void && world_object.player.working ? world_object.player : void;
}
function canPlayerMove(move)
{
    var p = playerOf();
    if (p === void) return false;
    switch (move) {
    case "prevScene":  return p.canPrevScene;
    case "rewind":     return p.canPrevScene || p.canPrevChoice;
    case "prevChoice": return p.canPrevChoice;
    case "nextScene":  return true;
    }
    return false;
}
function playerMove(move)
{
    var p = playerOf();
    if (p === void || !canPlayerMove(move)) return;
    switch (move) {
    case "prevScene":  p.prevScene(true); break;
    case "rewind":     p.rewind(); break;
    case "prevChoice": p.prevChoice(true); break;
    case "nextScene":  p.nextScene(); break;
    }
}

/**
 * Change Mode
 * Called from MainWindow when system state changes
 * @param kag KAG window
 * @param autoMode State of auto mode
 * @param skipMode State of skip mode
 * @param canAuto Auto mode is available
 * @param canSkip Skip mode is available
 * @param selectShowing Selection window is showing
 * @param modal
 */
function onModeChange(kag, autoMode, skipMode, canAuto, canSkip, selectShowing, modal)
{
    // (the message window's buttons are the quick menu, which dims and lights them by their
    // actions: AfterInit.tjs, since 0.19.0)

    // Sync config menu
    if (typeof kag.configMenuItem != "undefined") {
        kag.configMenuItem.enabled = !inSystemMenu(kag) && !modal && kag.inStable;
        setButtonEnabled(kag, "config", kag.configMenuItem.enabled);
    }
}

/**
 * Menu hijacking
 */

// Menus.tjs - Definition of menu creation functions
// Copyright (C)2001-2009, W.Dee and contributors. Modification and distribution are free.

function KAGWindow_createMenus()
{
	// This function is executed in the context of the MainWindow class object

    // Polyfill missing window menu property for SDL3
    if (typeof this.menu == "undefined") {
        this.menu = new global.Menu(this); // (this: showing or hiding it gives the window the menu bar's strip)
        this.menuBarStandIn = true; // no real menu bar (Menus.tjs, standview.tjs)
    }
    if (typeof menu == "undefined") {
        var menu = this.menu;
    }

	// The menu bar above the game in a window (F10, R3 on a controller; MenuBar.tjs) shows
	// these, their captions in the language shown (tr: data/lang/<code>/lang.json,
	// system/kagex_<code>.json); the part after a tab is the key that does the same
	menu.add(this.systemMenu = new KAGMenuItem(this, "System(&S)", 0, "", false));

	systemMenu.add(this.storeMenu   = new KAGMenuItem(this, "Save(&S)\tF2", 0,"startSave()",false));
	systemMenu.add(this.restoreMenu = new KAGMenuItem(this, "Load(&L)\tF3", 0,"startLoad()",false));

    systemMenu.add(this.configMenuItem  = new KAGMenuItem(this, "Config(&C)\tF4", 0, "startConfig()", false));
	systemMenu.add(new MenuItem(this, "-"));
	systemMenu.add(this.rightClickMenuItem = new KAGMenuItem(this, "Hide Message(&H)\tEsc", 0,
		onRightClickMenuItemClick, false));
	systemMenu.add(new MenuItem(this, "-"));
	systemMenu.add(this.goToStartMenuItem = new KAGMenuItem(this, "Return to Title(&R)", 0,
		onGoToStartMenuItemClick, false));
	systemMenu.add(new MenuItem(this, "-"));
	systemMenu.add(this.exitMenuItem = new KAGMenuItem(this, "Exit(&X)", 0, onExitMenuItemClick, false));

	menu.add(this.displayMenu = new KAGMenuItem(this, "Display(&V)", 0, void, false));
		displayMenu.add(this.windowedMenuItem = new KAGMenuItem(this, "Window(&W)\tF5", 1,
			onWindowedMenuItemClick, false));
		displayMenu.add(this.fullScreenMenuItem = new KAGMenuItem(this, "Full Screen(&F)\tF5", 1,
			onFullScreenMenuItemClick, false));

		displayMenu.add(new MenuItem(this, "-"));

		displayMenu.add(this.resetWindowSizeMenuItem = new KAGMenuItem(this, "Default Window Size(&D)", 0,
			/**/           onResetWindowSizeMenuItemClick, false));
		displayMenu.add(this.disableWindowResizeMenuItem = new KAGMenuItem(this, "Disable Resizing(&Z)", 0,
			/**/           onDisableWinwodResizeMenuItemClick, false));
		// the window sizes that fit the screen (Display.tjs, since 0.26.0)
		KAGDisplayMenuSizes(this, displayMenu) if typeof global.KAGDisplayMenuSizes != "undefined";

		displayMenu.add(new MenuItem(this, "-"));

		displayMenu.add(this.screenshotMenuItem = new KAGMenuItem(this, "Save Screenshot(&S)\tF12", 0,
			/**/           saveScreenshot, false));

	menu.add(this.skipToNextStopMenuItem = new KAGMenuItem(this, "Skip(&K)\tF6", 0, onSkipToNextStopMenuItemClick, false));
	menu.add(this.showHistoryMenuItem = new KAGMenuItem(this, "Backlog(&B)\tF7", 0, onShowHistoryMenuItemClick, false));
	menu.add(this.autoModeMenuItem = new KAGMenuItem(this, "Auto(&A)\tF8", 0, onAutoModeMenuItemClick, false));

	menu.add(this.helpMenu = new KAGMenuItem(this, "Help(&H)", 0, void, false));

		helpMenu.add(this.helpIndexMenuItem = new KAGMenuItem(this, "Manual(&M)\tF1", 0,
			onHelpIndexMenuItemClick, false));

		helpMenu.add(this.controlsMenuItem = new KAGMenuItem(this, "Controls(&K) ...", 0,
			showControls, false));

		helpMenu.add(this.helpAboutMenuItem = new KAGMenuItem(this, "About This Software(&A) ...", 0,
		onHelpAboutMenuItemClick, false));

	menu.add(this.debugMenu = new KAGMenuItem(this, "Debug(&D)", 0, void, false));

		debugMenu.add(this.loadScenarioMenuItem = new KAGMenuItem(this, "Load Scenario(&R)", 1,
			onExecDialogMenuItemClick, false));
		debugMenu.add(this.reloadScenarioMenuItem = new KAGMenuItem(this, "Reload Scenario(&R)", 1,
			onReloadScenarioMenuItemClick, false));
		debugMenu.add(this.showConsoleMenuItem = new KAGMenuItem(this, "Console(&C)\tShift+F4", 1,
			onShowConsoleMenuItemClick, false));
		debugMenu.add(this.showControllerMenuItem = new KAGMenuItem(this, "Controller(&S)\tShift+F1", 1,
			onShowContollerMenuItemClick, false));

        debugMenu.add(new MenuItem(this, "-"));

		debugMenu.add(this.showControllerMenuItem = new KAGMenuItem(this, "System Reset", 1,
																	resetAll, false));
        debugMenu.add(new MenuItem(this, "-"));

		debugMenu.add(this.debugLevelNoneMenuItem = new KAGMenuItem(this, "Debug Level: None", 2,
			onDebugLevelNoneMenuItemClick, false));
		debugMenu.add(this.debugLevelSimpleMenuItem = new KAGMenuItem(this, "Debug Level: Simple", 2,
			onDebugLevelSimpleMenuItemClick, false));
		debugMenu.add(this.debugLevelVerboseMenuItem = new KAGMenuItem(this, "Debug Level: Verbose", 2,
			onDebugLevelVerboseMenuItemClick, false));

        debugMenu.add(new MenuItem(this, "-"));

		debugMenu.add(this.debugWinMenuItem = new KAGMenuItem(this, "Show Debug Window", 0,
			onDebugWinMenuItemClick, false));
    
        debugMenu.add(this.backToAutoLabelStoreMenuItem = new KAGMenuItem(this, "Return to Previous Trace\tShift+BS", 0,
			onBackToAutoLabelStoreMenuItemClick, false));

        debugMenu.add(new MenuItem(this, "-"));

		debugMenu.add(this.chDebugLogMenuItem = new KAGMenuItem(this, "KAGEX Log Mode", 0,
			onChDebugLogMenuItemClick, false));

        debugMenu.add(this.outputDebugLogMenuItem = new KAGMenuItem(this, "Output KAGEX Log", 0,
			onOutputDebugLogMenuItemClick, false));

		// the writer's helpers: restart, go to a line, flags, copy, a bug report (DebugTools.tjs)
		KAGDebugMenuItems(this, debugMenu) if typeof global.KAGDebugMenuItems != "undefined";

        debugMenu.add(new MenuItem(this, "-"));

		debugMenu.add(this.voiceSpeedMenu = new KAGMenuItem(this, "Voice Speed(&V)", 0, void, false));
			voiceSpeedMenu.add(this.voiceNormalSpeedMenuItem = new KAGMenuItem(this, "Normal(&N)", 1,
				onVoiceSpeedMenuItemClick, false));
			voiceNormalSpeedMenuItem.speed = 1.0;
			voiceSpeedMenu.add(this.voiceOneHalfSpeedMenuItem = new KAGMenuItem(this, "1.5x Speed(&F)", 1,
				onVoiceSpeedMenuItemClick, false));
			voiceOneHalfSpeedMenuItem.speed = 1.5;
			voiceSpeedMenu.add(this.voiceDoubleSpeedMenuItem = new KAGMenuItem(this, "2x Speed(&D)", 1,
				onVoiceSpeedMenuItemClick, false));
			voiceDoubleSpeedMenuItem.speed = 2.0;
			voiceSpeedMenu.add(this.voiceDoubleHalfSpeedMenuItem = new KAGMenuItem(this, "2.5x Speed(&E)", 1,
				onVoiceSpeedMenuItemClick, false));
			voiceDoubleHalfSpeedMenuItem.speed = 2.5;
			voiceSpeedMenu.add(this.voiceTripleSpeedMenuItem = new KAGMenuItem(this, "3x Speed(&T)", 1,
				onVoiceSpeedMenuItemClick, false));
			voiceTripleSpeedMenuItem.speed = 3.0;
}

// ---------------------------------------------------------
// Basic Function Methods
// Called from message window menu or other menus
// ---------------------------------------------------------

/**
 * Execute load
 * @param work
 */
function loadFunction(work)
{
    kag.process('loadinit.ks', '', true, true);
    kag.loadBookMark(work);
}

/**
 * Execute save processing
 * @param work
 */
function saveFunction(work)
{
    kag.saveBookMark(work);
}

/**
 * Call save screen
 */
function startSave()
{
    if (kag.storeMenu.enabled) {
        kag.lockMessageLayerSelProcess();
        kag.callExtraConductor('save.ks', '*startFromGame');
    }
}

/**
 * Call load screen
 */
function startLoad()
{
    if (kag.restoreMenu.enabled) {
        kag.lockMessageLayerSelProcess();
        if (kag.conductor.curStorage == "title.ks") {
            kag.process('load.ks', '*startFromTitle');
        } else {
            if (kag.conductor !== kag.extraConductor) {
                kag.callExtraConductor('load.ks', '*startFromGame');
            }
        }
    }
}

/**
 * Call system screen
 */
function startConfig()
{
    if (kag.configMenuItem.enabled) {
        kag.lockMessageLayerSelProcess();
        if (kag.conductor.curStorage == "title.ks") {
            kag.process('config.ks', '*startFromTitle');
        } else {
            if (kag.conductor !== kag.extraConductor) {
                kag.callExtraConductor('config.ks', '*startFromGame');
            }
        }
    }

}

/**
 * Quick load (Q.LOAD, Shift+L): the newest quick save, after asking
 */
function quickloadAction()
{
    var work = kag.newestQuickSave();
    if (work >= 0 && kag.canRestore()) {
        askYesNo("Quick Load?", "Confirmation", loadFunction, void, work);
    }
}

/**
 * Quick save (Q.SAVE, Shift+S): into the next of the quick saves, which go round
 * (Config.tjs's quickSaveSlot and quickSaveSlots; kag.quickSave shows the notice)
 */
function quicksaveAction()
{
    if (kag.quickSave() >= 0) {
        kag.setMenuAccessibleAll(); // Q.LOAD has something to load now
    }
}

/**
 * Carry on where you left off: the first time the title shows in a run, it asks whether to
 * load the place the game kept (the continue save, Config.tjs's continueSlot), with that
 * place's scene and date, unless Config turned it off
 */
function offerContinue()
{
    if (tf.continueAsked) return;
    tf.continueAsked = true;
    if (!kag.hasContinue || !kag.canRestore()) return;
    var n = kag.continueSlot;
    var date = kag.getBookMarkDate(n), name = tr(kag.getBookMarkPageName(n));
    // the save as a card above the prompt, with its picture (since 0.21.0), or its scene and
    // date in the prompt where there's no picture
    if (typeof global.showYesNoCard == "undefined") KAGLoadScript("YesNoDialog.tjs");
    var pic = new global.Layer(kag, kag.primaryLayer), card;
    try { pic.loadImages(kag.getBookMarkFileNameAtNum(n)); } catch { invalidate pic; pic = void; }
    if (pic !== void && typeof global.showYesNoCard != "undefined") {
        var lines = [ name ];
        lines.add(date) if date !== void;
        try { card = showYesNoCard(kag, pic, lines, true, "above"); } catch (e) { dm("continue card: " + e.message); }
    }
    invalidate pic if pic !== void;
    tf.continueCard = card;
    askYesNo(tr("Carry on where you left off?") + (card !== void ? "" : "\n" + name + (date !== void ? "  " + date : "")),
        "Confirmation", loadFunction, void, n, offerContinueDone);
}
function offerContinueDone()
{
    if (tf.continueCard !== void && isvalid tf.continueCard) invalidate tf.continueCard;
    tf.continueCard = void;
}

// The name is centred in the message window's name box (namebox.png, [initscene] in
// macro.ks), so it isn't bracketed or padded here any more; MyHistoryLayer.storeName brackets
// it in the history. A dispNameFilter(dispName) function here can still change it.


/**
 * Set current message layer button state (normal/over)
 * @param name Button name
 * @param mode True for over state
 */
function setButtonOver(name, mode)
{
    var button = kag.current.names[name];
    if (button !== void) {
        button.loadButtons(name + (mode ? "_over" : "_normal"), name + "_over");
    }
}

// ---------------------------------------------------------
// Save Processing Related
// ---------------------------------------------------------

/**
 * Button drawing process
 * @param name "save" or "load"
 * @param work Button number
 */
function fileDataButton(name, work) 
{
    drawSaveSlot(kag.current.names[name + work], (sf.loadpage - 1) * 10 + work, name);
}

// a slot's button drawn for bookmark savedatanum ("save" or "load" picks its hovered look):
// the old page buttons' and the slot lists' (since 0.21.0)
function drawSaveSlot(target, savedatanum, name)
{
    var savefilename = kag.getBookMarkFileNameAtNum(savedatanum);

    // Button redraw: the slot frame for the normal state, <name>_win_over for the over and
    // pressed states (the button image holds the three side by side)
    target.holdAlpha = false;
    target.loadButtons("sl_win_base", name + "_win_over");
    var w = target.width;

    if (Storages.isExistentStorage(savefilename)) {

        // Text drawing
        var savedatadate = kag.getBookMarkDate(savedatanum);
        var savedatatitle = tr(kag.getBookMarkPageName(savedatanum)); // the scene's title, in the language shown (a compiled scene's own, or the strings')

        var thum = new global.Layer(kag, kag.fore.base);
        thum.loadImages(savefilename);
        // "New!" badge in the thumbnail's bottom-right corner
        var thum2 = new global.Layer(kag, kag.fore.base);
        thum2.loadImages("newdata");

        // The thumbnail goes in the frame's well at 9,9, then the title and date rows of the
        // text area, in each of the three states; holdAlpha keeps the frame's rounded corners
        target.holdAlpha = true;
        var tx = 260, ty1 = 23, ty2 = 89;
        for (var s = 0; s < 3; s++) {
            var x = w * s;
            target.operateRect(x + 9, 9, thum, 0, 0, thum.imageWidth, thum.imageHeight, omPsNormal);
            if (savedatanum == sf.newsavedata) {
                target.operateRect(x + 9 + thum.imageWidth - 6 - thum2.imageWidth, 9 + thum.imageHeight - 6 - thum2.imageHeight,
                                   thum2, 0, 0, thum2.imageWidth, thum2.imageHeight, omPsNormal);
            }
            // the styles (textstyles.tjs) shrink a long title to fit, then cut it (since 0.22.0)
            KAGDrawStyledText(target, "slot.title", savedatatitle, x + tx, ty1, w - tx - 12, 44);
            KAGDrawStyledText(target, "slot.date", savedatadate, x + tx, ty2, w - tx - 12, 40);
        }

        invalidate thum;
        invalidate thum2;
    }
}

// ---- the save and load screens' slots as one scrolling list (since 0.21.0; ScrollList.tjs):
// all of them two across, scrolled with the wheel, by dragging and flicks, the bar, the keys
// or the D-pad; a page button scrolls to its ten (a page's five rows) ----

var slotListRows = 5; // a page's rows in view
function slotItem(prefix, layer, index, w, h, state) { listTile(layer, w, h, state, "sl_win_base", drawSlotTile, [ index, prefix ]); }
function drawSlotTile(button, data) { drawSaveSlot(button, data[0], data[1]); }
function saveSlotItem(layer, index, w, h, state) { slotItem("save", layer, index, w, h, state); }
function loadSlotItem(layer, index, w, h, state) { slotItem("load", layer, index, w, h, state); }
function slotItemName(index)
{
    var slot = tr("Slot %d").sprintf(index + 1);
    if (!kag.isExistentBookMark(index)) return slot + ": " + tr("Empty");
    var date = kag.getBookMarkDate(index);
    return slot + ": " + tr(kag.getBookMarkPageName(index)) + (date !== void ? " " + date : "");
}
// the list on the screen's message layer: prefix "save" or "load" (save.ks, load.ks)
function slotList(prefix)
{
    var l = screenList(prefix + "List", prefix == "save" ? "Save slots" : "Saves", 290, 190, 1337, 168 * slotListRows - 19, 149, 2, 19,
        kag.numBookMarks, prefix == "save" ? saveSlotItem : loadSlotItem, prefix == "save" ? saveActionAt : loadActionAt, slotItemName);
    l.scrollTo(((sf.loadpage !== void ? +sf.loadpage : 1) - 1) * slotListRows * l.rowStride);
}
// the page buttons lit, and the list (or the old slot buttons) at the page's ten
function setSlotPage(prefix, work)
{
    sf.loadpage = work if work !== void;
    sf.loadpage = 1 if sf.loadpage === void;
    for (var i = 1; i < 10; i++) setButtonOver("page" + i, i == sf.loadpage);
    var l = kag.current.names[prefix + "List"];
    if (l !== void && isvalid l) l.scrollTo((sf.loadpage - 1) * slotListRows * l.rowStride, work !== void);
    else for (var i = 0; i < 10; i++) fileDataButton(prefix, i);
}
function refreshSlotList(prefix)
{
    for (var i = 0; i < kag.fore.messages.count; i++) {
        var l = kag.fore.messages[i].names[prefix + "List"];
        l.refresh() if l !== void && isvalid l;
    }
}

/**
 * Page button drawing process
 */
function setSavePageButton(work=void)
{
    setSlotPage("save", work);
}

/**
 * For save processing
 */
function saveFunction2(work)
{
    saveAtSlot((sf.loadpage - 1) * 10 + work);
}
function saveAtSlot(savedatanum)
{
    sf.newsavedata = savedatanum;
    saveFunction(savedatanum);
    refreshSlotList("save");
    setSavePageButton();
}

/**
 * Execute save
 */
function saveAction(work)
{
    saveActionAt((sf.loadpage - 1) * 10 + work);
}
// a slot picked: saved over after asking, or at once into an empty one
function saveActionAt(savedatanum)
{
    if (Storages.isExistentStorage(kag.getBookMarkFileNameAtNum(savedatanum))) {
        askYesNo("Overwrite?", "Confirmation", saveAtSlot, void, savedatanum);
    } else {
        saveAtSlot(savedatanum);
    }
}

// ---------------------------------------------------------
// Load Processing Related
// ---------------------------------------------------------

/**
 * Page button drawing process
 */
function setLoadPageButton(work=void)
{
    setSlotPage("load", work);
}

/**
 * Execute load
 */
function loadAction(work)
{
    loadActionAt((sf.loadpage - 1) * 10 + work);
}
function loadActionAt(loaddatanum)
{
    if (Storages.isExistentStorage(kag.getBookMarkFileNameAtNum(loaddatanum))) {
        askYesNo("Load?", "Confirmation", loadFunction, void, loaddatanum);
    }
}

// ---------------------------------------------------------
// Config Processing Related
// ---------------------------------------------------------

/**
 * Set Window/Fullscreen button state
 */
function setScreenButton(work=void) 
{
    if (work !== void) {
        if (work) {
            kag.onWindowedMenuItemClick();
        } else {
            kag.onFullScreenMenuItemClick();
		}
	}
    setButtonOver("config_window",    !kag.fullScreened);
    setButtonOver("config_fullscreen", kag.fullScreened);
}

/**
 * Set Effect ON/Effect OFF button state
 */
function setNoEffectButton(work=void) 
{
    KAGOptionSet("noEffect", work) if work !== void; // an option: Undo takes it back
    configUndoButtons();
    setButtonOver("config_effecton", !kag.noeffect);
    setButtonOver("config_effectoff", kag.noeffect);
}

/**
 * Set Skip All/Skip Read button state
 */
function setSkipButton(work=void)
{
    KAGOptionSet("allSkip", work) if work !== void;
    configUndoButtons();
    setButtonOver("config_skipall",    kag.allskip);
    setButtonOver("config_skipalrdy", !kag.allskip);
}

/**
 * Character specific voice volume setting
 * @paran name Character name
 * @param init True for initialization
 */
function setVoiceOnButton(name, init=void)
{
    if (!init) {
        // an option (KAGDefineVoiceOptions, AfterInit.tjs), so Undo takes it back
        if (KAGOptions["voiceOn:" + name] !== void) KAGOptionSet("voiceOn:" + name, !kag.getVoiceOn(name));
        else kag.setVoiceOn(name, !kag.getVoiceOn(name));
        configUndoButtons();
    }
    var btnname = "config_" + name;
    var button = kag.current.names[btnname];
    if (button !== void) {
        button.loadButtons(btnname + (kag.getVoiceOn(name) ? "_on" : "_off"));
    }
}

// --------------------------------------------------------
// Languages (Language.tjs; F9, the controller's L2, Config's Language buttons)
// --------------------------------------------------------

// The screens are drawn by their scripts, with images that have words on them (data/lang/ja/
// has the Japanese ones), so a screen on show is drawn again in another language from the
// label that draws it (kag.languageChangeHook, AfterInit.tjs). The game's own message window,
// choices and buttons the framework draws again itself.
var screenRedrawLabels = %[
    "title.ks" => "*titleloop", "config.ks" => "*buttons", "save.ks" => "*buttons", "load.ks" => "*buttons",
    "cgmode.ks" => "*loop", "replay.ks" => "*loop", "musicmode.ks" => "*loop", "searchmode.ks" => ""
    ];

function redisplayScreen(code, previous)
{
    var storage = kag.conductor.curStorage;
    var label = screenRedrawLabels[storage];
    if (label === void) return;
    if (storage == "cgmode.ks" && isCgView()) return; // a CG shown full screen has no words
    kag.process(storage, label);
}

/**
 * Set the language buttons' state; with a language, show the game in it (KAGLanguage, which
 * draws this screen again through redisplayScreen)
 */
function setLanguageButton(work=void)
{
    if (work !== void && global.KAGLanguage !== void) kag.setLanguage(work);
    var cur = global.KAGLanguage !== void ? KAGLanguage.current : "en";
    setButtonOver("config_lang_en", cur == "en");
    setButtonOver("config_lang_ja", cur == "ja");
}

/**
 * Initialize variables
 */
function initial()
{
    askYesNo('Initialize', 'Confirmation', function() {
        KAGOptionUndo.mark(); // one step for Undo
        initialEnvironment();
        KAGOptionUndo.groupEnd();
        kag.process("", "*buttons");
    });
}

/**
 * Undo and Revert (KAGOptionUndo, Options.tjs; begun as Config opens): the page drawn again as
 * the settings are after it
 */
function configUndo()
{
    if (KAGOptionUndo.undo()) kag.process("", "*buttons");
}

function configRevert()
{
    if (KAGOptionUndo.revert()) kag.process("", "*buttons");
}

// Undo and Revert lit when there's something to take back
function configUndoButtons()
{
    if (kag.current === void || !isvalid kag.current) return;
    var names = kag.current.names;
    if (names === void || names.config_undo === void) return;
    var b = names.config_undo, r = names.config_revert;
    b.enabled = KAGOptionUndo.canUndo, b.opacity = b.enabled ? 255 : 110;
    if (r !== void) r.enabled = KAGOptionUndo.changed, r.opacity = r.enabled ? 255 : 110;
}
KAGOptionHook.add(function(name, v) { configUndoButtons(); } incontextof global);

// Config closing: no more steps, and the music sample stops
function configLeave()
{
    KAGTextPreviewClose();
    KAGOptionUndo.end();
    KAGVolumeSamples.stop(300);
}

/**
 * Config's pages: the settings on show (1 or 2), drawn again
 */
function setConfigPage(page)
{
    if (tf.configPage == page) return;
    KAGTextPreviewClose();
    tf.configPage = page;
    kag.process("", "*buttons");
}

/**
 * Config's pages after the first: the options of each column, a row each (an option with
 * rows:2 takes two), laid out from the options table (template/system/Options.tjs)
 */
var configPages = [
    void, void,
    [ [ "voiceCut", "voiceFadeTime", "voicePlacement", "voiceSpeed", "autoVoiceWait", "dramaticMode" ],
      [ "continueOn", "quickSaves", "askAgain", "screenshotWindow", "screenshotFormat" ] ],
    [ [ "readSpeed", "autoSpeed", "autoCharWait", "textFade", "readColor", "readMark" ],
      [ "windowOpacity", "afterauto", "afterskip", "enterSkip", "msgStyleTint:normal", "msgStyleTint:memory" ] ],
    [ [ "chapterTitles", "nowPlaying", "modeMark", "voiceBar", "faceWindow", "titleGreeter" ],
      [ "heroName", "subtitles", "movieSkipping", "movieRightClick", "movieQuality", "reduceMotion" ] ],
    // the characters' voices (configVoiceOptions, AfterInit.tjs), filled in by configOptionsPage
    [ [], [ "volumeSamples", "voiceNote", "movieVolume" ] ],
    // the interface: the quick menu and its panels, tips; the screen and the controller (Display.tjs)
    [ [ "quickMenu", "quickMenuSize", "quickMenuOpacity", "quickMenuPanels", "tooltips", "fullScreenFill" ],
      [ "windowSize", "fullScreenFit", "smoothScaling", "vsync", "padEnabled", "padTest" ] ],
    // the text's look (TextSettings.tjs, since 0.22.0), with its preview in the right column
    [ [ "textFont", "textOutline", "textOutlineColor", "textShadow", "textShadowColor", "readColor" ],
      [ void, void, void, void, "glossaryMarks", "glossaryColor" ] ],
    // the languages (Language.tjs, since 0.26.0): the menus' own, and a second under the story's;
    // the mouse pointer (GameCursor.tjs, since 0.27.0): the game's own, where questions put it
    [ [ "menuLanguage", "secondLanguage", "languageNote" ], [ "gameCursor", "promptPointer", "hideCursorIdle" ] ]
    ];

KAGDefineOption(%[ name:"languageNote", label:"Languages", kind:"note", rows:2,
    lines:[ "A second language shows, smaller,", "under each line of the story.", "Shift+F9 swaps the two." ] ]);

KAGDefineOption(%[ name:"voiceNote", label:"Each Character's Voice", kind:"note", rows:2,
    lines:[ "A slider sets a character's volume;", "Test plays one of their lines.",
            "The volumes on page 1 play a sample", "as you point at them and move them." ] ]);

// The message window's left margin ([initscene] in macro.ks): room for the face window
// (envinit's faceCrop), unless Config turned it off
function faceWindowMargin()
{
    var on = KAGOptionGet("faceWindow");
    return on !== void && !on ? 48 : 320;
}

// ---------------------------------------------------------
// The hero's name (namescreen.ks; the framework's kag.setHeroName). The player's choice is kept
// in sf (heroName, heroFamily, heroNamed) and put into f at each new game (heroFromSf)
// ---------------------------------------------------------
var nameTrigger;

// the fields' values as the screen opens: the name now (the default's in the language shown)
function nameStart()
{
    tf.heroGiven  = sf.heroNamed ? kag.heroName()   : tr(kag.defaultName);
    tf.heroFamily = sf.heroNamed ? kag.heroFamily() : tr(kag.defaultFamily);
    tf.heroGiven  = sf.heroName   if sf.heroNamed && sf.heroName   !== void && sf.heroName   != kag.defaultName;
    tf.heroFamily = sf.heroFamily if sf.heroNamed && sf.heroFamily !== void && sf.heroFamily != kag.defaultFamily;
    tf.nameError = "";
}

// the rows' titles, the fields' backgrounds and a refused name's reason, on the screen's layer
function nameInit()
{
    var lay = kag.current;
    if (typeof global.setYesNoFont == "undefined") KAGLoadScript("YesNoDialog.tjs");
    var f = lay.font, face = f.face, height = f.height, bold = f.bold;
    setYesNoFont(lay, 33);
    drawYesNoString(lay, 322, 214, tr("Given Name"), 0xffffff, yesnoTextBase);
    drawYesNoString(lay, 1022, 214, tr("Family Name"), 0xffffff, yesnoTextBase);
    lay.fillRect(322, 266, 616, 60, 0xffffffff);
    lay.fillRect(1022, 266, 576, 60, 0xffffffff);
    setYesNoFont(lay, 26);
    drawYesNoString(lay, 322, 360, tr("Leave a name empty to use the default."), 0xffffff, yesnoTextBase);
    if (tf.nameError != "") drawYesNoString(lay, 322, 460, tf.nameError, 0xffe060, yesnoTextBase);
    f.face = face, f.height = height, f.bold = bold;
}

function nameButtons()
{
    var names = kag.current.names;
    drawButtonLabel(names.name_default, tr("Default"), [ 0x5025ff, 0xffffff, 0xffffff ], 28);
    drawButtonLabel(names.name_ok, tr("OK"), [ 0x5025ff, 0xffffff, 0xffffff ], 28);
}

function nameFocus()
{
    var e = kag.current.names["tf.heroGiven"];
    e.focus() if e !== void;
}

function nameAgain(label)
{
    tf.nameLabel = label;
    if (nameTrigger === void) nameTrigger = new AsyncTrigger(function { kag.process("namescreen.ks", tf.nameLabel); }, "");
    nameTrigger.trigger();
}

function nameDefault()
{
    kag.current.commit();
    tf.heroGiven = tr(kag.defaultName), tf.heroFamily = tr(kag.defaultFamily), tf.nameError = "";
    nameAgain("*screen");
}

// OK (or Return in a field): the name, or why it can't be used
function nameOK()
{
    kag.current.commit();
    var g = tf.heroGiven !== void ? ((string)tf.heroGiven).trim() : "", fa = tf.heroFamily !== void ? ((string)tf.heroFamily).trim() : "";
    g  = "" if g  == tr(kag.defaultName);   // the default as shown is the default
    fa = "" if fa == tr(kag.defaultFamily);
    var why = kag.setHeroName(g, fa);
    if (why != "") {
        tf.nameError = why;
        nameAgain("*screen");
        return;
    }
    sf.heroName = kag.flags.name, sf.heroFamily = kag.flags.family, sf.heroNamed = true;
    tf.nameError = "";
    nameAgain("*done");
}

// a new game: the player's name for the hero
function heroFromSf()
{
    if (sf.heroNamed) kag.flags.name = sf.heroName, kag.flags.family = sf.heroFamily;
}

// Config: the name screen, and back to this page
function nameFromConfig()
{
    nameStart();
    kag.process("namescreen.ks", "*fromConfig");
}

KAGDefineOption(%[ name:"heroName", label:"Your Name", kind:"button", button:"Change", action:function { nameFromConfig(); } ]);

function configOptionsPage()
{
    var page = configPages[tf.configPage];
    if (tf.configPage == 5) page[0] = configVoiceOptions;
    KAGOptionPage(kag.current, [ [ 290, 206, page[0] ], [ 990, 206, page[1] ] ]);
    KAGTextPreviewClose();
    if (tf.configPage == 7) {
        // the text's look as you change it: a small message window typing sample lines
        var lay = kag.current, f = lay.font, face = f.face, height = f.height, bold = f.bold;
        setYesNoFont(lay, KAGOptionStyle.label.size);
        drawYesNoString(lay, 990 + KAGOptionStyle.label.x, 206 + KAGOptionStyle.label.y, tr("Preview"), 0xffffff, yesnoTextBase);
        f.face = face, f.height = height, f.bold = bold;
        KAGTextPreviewOpen(lay, 1010, 266, 600, 380);
    }
}

/**
 * Return to title
 */
function gotoTitle()
{
    // The same prompt as the system's own return to title (YesNoDialogLayer.tjs shortens it)
    askYesNo("Returning to title. Are you sure?", "Confirmation", kag.goToStart);
}

/**
 * Config screen initialization process
 */
function configInit()
{
    for (var i = 1; i < configPages.count; i++) setButtonOver("page" + i, i == (tf.configPage > 1 ? tf.configPage : 1));
    configUndoButtons();
    if (tf.configPage > 1) return; // the options draw themselves (Options.tjs)
    setScreenButton();
    setNoEffectButton();
    setSkipButton();
    setVoiceOnButton("voice0", true);
    setVoiceOnButton("voice1", true);
    setVoiceOnButton("voice2", true);
    setVoiceOnButton("voice3", true);
    setLanguageButton();
}

// --------------------------------------------------------
// CG Mode Processing
// --------------------------------------------------------

class CgListParser extends CSVParser {

    // For holding results
    var result;

    /**
     * Called for each line
     * @param columns Column data (Array)
     * @param lineNo Logical line number (1~)
     */
    function doLine(columns, lineNo) {
        if (columns[0].charAt(0) != '#') {
            var info = %[];
            info.page = columns[0];
            info.cglist = [];
            for (var i=1;i<columns.count;i++) {
                info.cglist.add(columns[i]);
            }
            result.add(info);
        }
    }

    function parseStorage(filename,utf8=false) {
        result = [];
        super.parseStorage(...);
        return result;
    } 

    function CgListParser() {
        super.CSVParser();
    }
};

/**
 * CG Mode initialization process
 */
function cgInit()
{
    var cgParser = new CgListParser();
    tf.cgmodelist = cgParser.parseStorage("cglist.csv");
    invalidate cgParser;

    sf.extramode = 1;
    tf.cgpagenum = 6;
    tf.cgbtnnum  = 16;
    tf.cgmodepage = 0 if tf.cgmodepage === void;
}

/**
 * Has the CG been seen?
 * @param num CG number
 * @param i Difference number
 */
function isCgSeenOne(num, i)
{
    if (num < tf.cgmodelist.count) {
        var list = tf.cgmodelist[num].cglist;
        if (i < list.count) {
            var base = list[i];
            if (tf.allseen || base !== void && sf["cg_" + base.toUpperCase()]) {
                return true;
            }
        }
    }
    return false;
}

/**
 * Has the CG been seen?
 * @param num CG number
 */
function isCgSeen(num)
{
    if (num < tf.cgmodelist.count) {
        var list = tf.cgmodelist[num].cglist;
        for (var i=0; i<list.count; i++) {
            if (isCgSeenOne(num, i)) {
                return true;
            }
        }
    }
    return false;
}

// Replace button images
function setCGImage(target, filename)
{
    var layer = new global.Layer(kag, kag.fore.base);
    var layer2 = new global.Layer(kag, kag.fore.base);
    // Picture area inside the thumbnail frame's 3px border; the whole source image is fitted into it
    var b = 3, pw = target.width - b*2, ph = target.height - b*2;

    // A prepared thumbnail (data/thum/thum_<name>, the picture area's size, in any image format:
    // kagex-release converts it) avoids decoding the full CG on every page; without one the CG is
    // shrunk here
    // (a CG variation too, put together from its layered file: KAGLoadPicture, CGVariations.tjs)
    KAGLoadPicture(layer, getExistImageName("thum_"+filename) !== void ? "thum_"+filename : filename);
    layer2.loadImages("cgmode_thum_normal");
    layer2.imageWidth=pw;
    layer2.imageHeight=ph;
    var sw = layer.imageWidth, sh = layer.imageHeight;
    if (typeof layer2.shrinkCopy == "Object" && pw <= sw\2 && ph <= sh\2) {
        // Averages the pixels it shrinks (a 1920x1080 CG is about 9x the picture area);
        // a nearest-neighbour stretch made jagged thumbnails
        KAGShrinkCopy(layer2,0,0,pw,ph,layer,0,0,sw,sh,stLinear); // with a margin (Utils.tjs)
    } else {
        layer2.operateStretch(0,0,pw,ph,layer,0,0,sw,sh,omAuto,255,stLinear);
    }

    // holdAlpha keeps the frame's alpha, as in fileDataButton: without it the browser build
    // (whose omPs* blends write alpha 0) left the picture transparent, so the tile looked empty
    var hold = target.holdAlpha;
    target.holdAlpha = true;
    target.operateRect(               b,  b,layer2,0,0,layer2.imageWidth,layer2.imageHeight,omPsNormal);
    target.operateRect(target.width  +b,  b,layer2,0,0,layer2.imageWidth,layer2.imageHeight,omPsNormal);
    target.operateRect(target.width*2+b,  b,layer2,0,0,layer2.imageWidth,layer2.imageHeight,omPsNormal);
    target.holdAlpha = hold;

    if (tf.viewcgfilename) {
	    target.font.face = KAGFontFace("interface");
	    target.font.height = 14;
	    target.drawText(2,2,filename,0x000000,255,true,255,0x000000,2,2);
    }
    invalidate layer;
    invalidate layer2;
}

/**
 * Update CG mode page
 */
function setCgmodePageButton(work=void)
{
    tf.cgmodepage = work if work !== void;

    // Change display of page buttons
    for (var i=0; i<tf.cgpagenum; i++) {
        var pagename = "cgmode_page" + i;
        var button = kag.current.names[pagename];
        if (button !== void) {
            button.loadButtons(pagename + (i == tf.cgmodepage ? "_over" : "_normal"), pagename + "_over");
        }
    }

    // the tab's pictures, each a tile of the grid (cgList: tf.cgviewlist[tile] is its CG's
    // number, void while it hasn't been seen)
    tf.cgtiles = [];
    tf.cgviewlist = [];
    var pagename = "page" + tf.cgmodepage;
    for (var i=0;i<tf.cgmodelist.count;i++) {
        if (tf.cgmodelist[i].page != pagename) continue;
        tf.cgviewlist[tf.cgtiles.count] = isCgSeen(i) ? i : void;
        tf.cgtiles.add(i);
    }

    // how many of each page's pictures were found, on its button, and of all of them under the
    // thumbnails
    var counts = cgCounts();
    for (var i=0; i<tf.cgpagenum; i++) {
        var button = kag.current.names["cgmode_page" + i], c = counts["page" + i];
        if (button !== void && c !== void) {
            var text = "%d/%d".sprintf(c[0], c[1]);
            button.holdAlpha = true;
            for (var st = 0; st < 3; st++) {
                var color = st == 0 && i != tf.cgmodepage ? 0x8a74ff : 0xffffff;
                KAGDrawStyledText(button, "count", text, button.width * st + 10, 0, button.width - 28, button.height, %[ color:color ]);
            }
            button.holdAlpha = false;
        }
    }
    drawScreenText(1654, 966, tr("Found: %d/%d").sprintf(counts.all[0], counts.all[1]), "right");
}

// ---- the tiles of CG and Replay, and the music room's tracks, as scrolling lists (since
// 0.20.0; ScrollList.tjs): drawn as their buttons were, one at a time while in view, and
// scrolled with the wheel, by dragging, with the bar, the keys or a controller's D-pad ----

// A tile's picture for a list: a hidden button of the tile's look (normal: its picture's name),
// drawn as a [button] of it would be by draw(button, data), then the state's third copied out
var tileDraw, tileData; // (no closures in TJS: what listTile's caller draws with)
function listTile(layer, w, h, state, normal, draw = void, data = void, opacity = 255)
{
    var b = new ButtonLayer(kag, kag.fore.base);
    b.visible = false;
    try {
        b.loadButtons(normal, getExistImageName(normal.replace(/_normal$/, "_over")) != "" ? normal.replace(/_normal$/, "_over") : normal);
        if (draw !== void) draw(b, data);
        var st = state == "normal" ? 0 : 1; // pointed at or focused: the hovered look
        layer.operateRect(0, 0, b, b.width * st, 0, b.width, b.height, omAlpha, opacity);
    } catch (e) { dm("list tile " + normal + ": " + e.message); }
    invalidate b;
}

// a list on the screen's message layer (one of its links, so the keys reach it from the buttons)
function screenList(name, a11y, x, y, w, h, itemHeight, columns, gap, count, drawItem, onPick, itemName)
{
    var m = kag.current;
    var l = new KAGScrollList(kag, m);
    l.name = name;
    l.a11yName = a11y;
    l.itemHeight = itemHeight;
    l.columns = columns;
    l.gap = gap;
    l.drawItem = drawItem;
    l.onPick = onPick;
    l.itemName = itemName;
    l.setPos(x, y);
    l.itemCount = count;
    l.setSize(w, h);
    m.addLinkLayer(l);
    return l;
}

function drawCgTile(button, i) { setCGImage(button, tf.cgmodelist[i].cglist[0]); }
function drawCgItem(layer, index, w, h, state)
{
    var i = tf.cgviewlist[index];
    if (i !== void) listTile(layer, w, h, state, "cgmode_thum_normal", drawCgTile, i);
    else listTile(layer, w, h, "normal", "cgmode_thum_normal");
}
function cgItemName(index)
{
    return tf.cgviewlist[index] !== void ? tr("Picture %d").sprintf(index + 1) : tr("Not seen yet");
}
function cgPick(index)
{
    if (tf.cgviewlist[index] === void) return;
    var l = kag.fore.messages[0].names.cgList;
    tf.cgPosition = l.position if l !== void && isvalid l;
    tf.cgnum = index;
    kag.process("cgmode.ks", "*cgview");
}
// the grid of the tab's pictures (cgmode.ks): four across, as the buttons were
function cgList()
{
    var l = screenList("cgList", "Pictures", 681, 322, 967, 585, 123, 4, 31, tf.cgtiles.count, drawCgItem, cgPick, cgItemName);
    l.scrollTo(tf.cgPosition !== void && tf.cgPositionTab == tf.cgmodepage ? +tf.cgPosition : 0);
    tf.cgPositionTab = tf.cgmodepage;
}

/**
 * The CG pictures found: %[ page: [ found, all ] ..., all: [ found, all ] ], each difference
 * counting as a picture
 */
function cgCounts()
{
    var counts = %[], all = [ 0, 0 ];
    for (var i = 0; i < tf.cgmodelist.count; i++) {
        var info = tf.cgmodelist[i], c = counts[info.page];
        if (c === void) c = counts[info.page] = [ 0, 0 ];
        for (var j = 0; j < info.cglist.count; j++) {
            if (info.cglist[j] === void || info.cglist[j] == "") continue;
            c[1]++, all[1]++;
            if (isCgSeenOne(i, j)) c[0]++, all[0]++;
        }
    }
    counts.all = all;
    return counts;
}

/**
 * Text drawn on the screen (the current message layer, whose frame is the screen), in the
 * dialogs' look: white with a navy outline; align "right" puts its end at x
 */
function drawScreenText(x, y, text, align = "left", size = 28)
{
    if (typeof global.setYesNoFont == "undefined") KAGLoadScript("YesNoDialog.tjs");
    var layer = kag.current, f = layer.font, face = f.face, height = f.height, bold = f.bold;
    setYesNoFont(layer, size);
    if (align == "right") x -= measureYesNoText(layer, text);
    drawYesNoString(layer, x, y, text, 0xffffff, yesnoTextBase);
    f.face = face, f.height = height, f.bold = bold;
}

/**
 * Initialize list for viewing
 * Set CG number in tf.cgnum
 */
function cgViewInit()
{
    var num = tf.cgviewlist[tf.cgnum];
    tf.cgcnt = 0;
    tf.cgviewlist2 = [];
    var list = tf.cgmodelist[num].cglist;
    for (var i=0;i<list.count;i++) {
        if (isCgSeenOne(num, i)) {
            tf.cgviewlist2.add(list[i]);
        }
    }
}

/**
 * Are there still images in the viewing list?
 */
function isCgView()
{
    return tf.cgcnt < tf.cgviewlist2.count;
}

/**
 * Display CG
 * Should use dedicated parts ideally
 */
function cgView()
{
    kag.current.loadImages(tf.cgviewlist2[tf.cgcnt++]);
}

// --------------------------------------------------------
// The CG viewer (since 0.18.0): a CG and its variations full screen, zoomed with the wheel, the
// bar's - and + buttons, the + and - keys or a pinch (about the point under the pointer), moved
// by dragging, the arrow keys or the stick, stepped through with the bar's arrows, Page Up and
// Down or a click (the last one closes it), closed with x, Esc or the right button. The bar
// fades away when the pointer rests. cgmode.ks waits for the trigger cgviewer
// --------------------------------------------------------
var cgViewer;
function cgViewerOpen()
{
    invalidate cgViewer if cgViewer !== void && isvalid cgViewer;
    cgViewer = new CGViewer(kag, tf.cgviewlist2);
}

class CGViewer extends Layer
{
    var list, index = 0, pic;
    var z = 1.0, cx = 0, cy = 0, fit = 1.0, maxZoom = 4.0;
    var bar, buttons = [], hover = -1, barTimer, lastMove = 0, barAlpha = 255;
    var down = false, downX, downY, downCx, downCy, dragged = false;
    var pinchZ = void;
    var closeTrigger, closed = false;
    var wheelHook, pinchHook;
    var fontFace = KAGFontFace("interface");

    function CGViewer(win, list)
    {
        super.Layer(win, win.primaryLayer);
        this.list = [];
        this.list.assign(list);
        var prim = win.primaryLayer;
        setImageSize(prim.width, prim.height);
        setSizeToImageSize();
        absolute = 1999000000; // over the screens, under the Yes/No prompts
        hitType = htMask;
        hitThreshold = 0;      // every click is the viewer's
        focusable = true;
        pic = new global.Layer(win, this);
        bar = new global.Layer(win, this);
        bar.setImageSize(744, 84);
        bar.setSizeToImageSize();
        bar.setPos((width - bar.width) \ 2, height - bar.height - 40);
        bar.hitType = htMask;
        bar.hitThreshold = 256; // the viewer works out the buttons itself
        bar.visible = true;
        // [ x, width, what it does ] along the bar
        buttons = [ [12, 84, "zoomout"], [104, 84, "zoomin"], [236, 84, "prev"], [328, 180, "count"], [516, 84, "next"], [648, 84, "close"] ];
        barTimer = new Timer(onBarTimer, "");
        barTimer.interval = 100;
        barTimer.enabled = true;
        lastMove = System.getTickCount();
        closeTrigger = new AsyncTrigger(onCloseLater, "");
        wheelHook = onWheel;
        pinchHook = onPinch;
        win.addHook("onMouseWheelHook", wheelHook);
        win.addHook("onTouchScalingHook", pinchHook);
        visible = true;
        focus();
        if (this.list.count == 0) { close(); return; } // nothing seen yet
        load();
    }

    function finalize()
    {
        window.removeHook("onMouseWheelHook", wheelHook);
        window.removeHook("onTouchScalingHook", pinchHook);
        invalidate barTimer;
        invalidate closeTrigger;
        invalidate pic;
        invalidate bar;
        super.finalize(...);
    }

    function load()
    {
        KAGLoadPicture(pic, list[index]); // (a CG variation too)
        var fx = width / pic.imageWidth, fy = height / pic.imageHeight;
        fit = fx < fy ? fx : fy;
        z = 1.0;
        cx = pic.imageWidth / 2, cy = pic.imageHeight / 2;
        draw();
        drawBar();
    }

    property scale { getter() { return fit * z; } }

    // keeps the view on the picture (centred where it's smaller than the screen)
    function clampView()
    {
        var s = scale, vw = width / s, vh = height / s, iw = pic.imageWidth, ih = pic.imageHeight;
        if (vw >= iw) cx = iw / 2;
        else cx = cx < vw / 2 ? vw / 2 : cx > iw - vw / 2 ? iw - vw / 2 : cx;
        if (vh >= ih) cy = ih / 2;
        else cy = cy < vh / 2 ? vh / 2 : cy > ih - vh / 2 ? ih - vh / 2 : cy;
    }

    function draw()
    {
        clampView();
        fillRect(0, 0, width, height, 0xff000000);
        var s = scale, vw = width / s, vh = height / s;
        var sx = cx - vw / 2, sy = cy - vh / 2;
        var x0 = sx < 0 ? 0 : sx, y0 = sy < 0 ? 0 : sy;
        var x1 = sx + vw > pic.imageWidth ? pic.imageWidth : sx + vw, y1 = sy + vh > pic.imageHeight ? pic.imageHeight : sy + vh;
        if (x1 > x0 && y1 > y0)
            stretchCopy((int)((x0 - sx) * s), (int)((y0 - sy) * s), (int)((x1 - x0) * s + 0.5), (int)((y1 - y0) * s + 0.5),
                pic, x0, y0, x1 - x0, y1 - y0, stLinear);
        update();
    }

    function zoomTo(nz, px = width / 2, py = height / 2)
    {
        nz = nz < 1.0 ? 1.0 : nz > maxZoom ? maxZoom : nz;
        var s0 = scale;
        var ix = cx + (px - width / 2) / s0, iy = cy + (py - height / 2) / s0;
        z = nz;
        var s1 = scale;
        cx = ix - (px - width / 2) / s1, cy = iy - (py - height / 2) / s1;
        draw();
        drawBar();
    }

    function pan(dx, dy) { cx -= dx / scale; cy -= dy / scale; draw(); }

    function step(d)
    {
        var n = index + d;
        if (n < 0) return;
        if (n >= list.count) { close(); return; }
        index = n;
        load();
    }

    function close()
    {
        if (closed) return;
        closed = true;
        visible = false;
        closeTrigger.trigger();
    }
    function onCloseLater()
    {
        window.trigger("cgviewer");
        cgViewer = void if cgViewer === this;
        invalidate this;
    }

    // ---- the bar ----
    function drawBar()
    {
        var b = bar;
        b.fillRect(0, 0, b.width, b.height, 0);
        b.fillRect(0, 0, b.width, b.height, 0xff5025ff);
        b.fillRect(4, 4, b.width - 8, b.height - 8, 0xe6a690ff);
        b.font.face = fontFace;
        b.font.bold = true;
        b.font.height = 34;
        var labels = %[ zoomout:"−", zoomin:"+", prev:"◀", next:"▶", close:"×", count:"%d / %d".sprintf(index + 1, list.count) ];
        for (var i = 0; i < buttons.count; i++) {
            var bt = buttons[i], name = bt[2], on = i == hover;
            var dim = (name == "zoomout" && z <= 1.0) || (name == "zoomin" && z >= maxZoom) || (name == "prev" && index == 0);
            if (name != "count") {
                b.fillRect(bt[0], 10, bt[1], 64, on && !dim ? 0xffffffff : 0xff5025ff);
            }
            var text = labels[name], tw = b.font.getTextWidth(text);
            var col = name == "count" ? 0xffffff : dim ? 0x9a86e8 : on ? 0x5025ff : 0xffffff;
            b.drawText(bt[0] + (bt[1] - tw) \ 2, 10 + (64 - b.font.getTextHeight(text)) \ 2, text, col, 255, true);
        }
        b.opacity = barAlpha;
    }
    function buttonAt(x, y)
    {
        if (!bar.visible || barAlpha < 64) return -1;
        x -= bar.left, y -= bar.top;
        if (y < 10 || y >= 74) return -1;
        for (var i = 0; i < buttons.count; i++)
            if (buttons[i][2] != "count" && x >= buttons[i][0] && x < buttons[i][0] + buttons[i][1]) return i;
        return -1;
    }
    function act(name)
    {
        KAGInterfaceSound("cgview." + name + ".click"); // uisounds.csv
        switch (name) {
        case "zoomout": zoomTo(z / 1.25); break;
        case "zoomin":  zoomTo(z * 1.25); break;
        case "prev":    step(-1); break;
        case "next":    step(1); break;
        case "close":   close(); break;
        }
    }
    function wake()
    {
        lastMove = System.getTickCount();
        if (barAlpha != 255) { barAlpha = 255; bar.opacity = 255; }
    }
    function onBarTimer()
    {
        if (closed || barAlpha == 0) return;
        var idle = System.getTickCount() - lastMove;
        if (idle < 2500) return;
        barAlpha = idle > 3000 ? 0 : (int)(255 * (3000 - idle) / 500);
        bar.opacity = barAlpha;
    }

    // ---- the pointer, the wheel, a pinch, the keys ----
    function onMouseDown(x, y, button, shift)
    {
        wake();
        if (button == mbRight) { close(); return; }
        var i = buttonAt(x, y);
        if (i >= 0) { act(buttons[i][2]); return; }
        down = true, dragged = false, downX = x, downY = y, downCx = cx, downCy = cy;
    }
    function onMouseMove(x, y, shift)
    {
        wake();
        if (down) {
            if (!dragged && (Math.abs(x - downX) > 8 || Math.abs(y - downY) > 8)) dragged = true;
            if (dragged) { cx = downCx - (x - downX) / scale; cy = downCy - (y - downY) / scale; draw(); }
            return;
        }
        var i = buttonAt(x, y);
        if (i != hover) { hover = i; drawBar(); }
    }
    function onMouseUp(x, y, button, shift)
    {
        if (!down) return;
        down = false;
        if (!dragged) step(1); // a click goes to the next variation; after the last, back to the CGs
    }
    function onWheel(shift, delta, x, y)
    {
        if (closed || !visible) return false;
        wake();
        zoomTo(z * Math.pow(1.15, delta / 120), x, y);
        return true;
    }
    function onPinch(start, current, px, py, flag)
    {
        if (closed || !visible || start <= 0) return false;
        pinchZ = z if pinchZ === void || (flag & 1);
        zoomTo(pinchZ * current / start, px, py);
        pinchZ = void if (flag & 2);
        return true;
    }
    function onKeyDown(key, shift)
    {
        wake();
        var d = 160;
        switch (key) {
        case VK_ESCAPE: case VK_BACK: close(); return;
        case VK_PRIOR: step(-1); return;
        case VK_NEXT: case VK_RETURN: case VK_SPACE: step(1); return;
        case VK_ADD: case 0xBB: zoomTo(z * 1.25); return;  // + (and = beside it)
        case VK_SUBTRACT: case 0xBD: zoomTo(z / 1.25); return;
        case VK_LEFT:  if (z > 1.0) pan(d, 0); else step(-1); return;
        case VK_RIGHT: if (z > 1.0) pan(-d, 0); else step(1); return;
        case VK_UP:    pan(0, d); return;
        case VK_DOWN:  pan(0, -d); return;
        }
    }
}

// --------------------------------------------------------
// Replay Mode
// --------------------------------------------------------

class ReplayListParser extends CSVParser {

    // For holding results
    var result;

    /**
     * Called for each line
     * @param columns Column data (Array)
     * @param lineNo Logical line number (1~)
     */
    function doLine(columns, lineNo) {
        if (columns[0].charAt(0) != '#') {
            var info = %[];
            info.page   = columns[0];
            info.scene  = columns[1];
            info.target = columns[2];
            info.thum   = columns[3];
            info.title  = columns[4];
            result.add(info);
        }
    }

    function parseStorage(filename,utf8=false) {
        result = [];
        super.parseStorage(...);
        return result;
    } 

    function ReplayListParser() {
        super.CSVParser();
    }
};

// Replay's tabs (their labels) and the tiles on each: %[storage, label (no *), thum, title,
// compiled, scene (storage + *label, lower case)]
var replayTabs, replayTiles;
// Thumbnails drawn from compiled scenes, by scene (Layers): drawing the World takes a moment
var replayThumbs = %[];

function replayInit()
{
    var replayParser = new ReplayListParser();
    var list = replayParser.parseStorage("replaylist.csv");
    invalidate replayParser;

    sf.extramode = 2;
    tf.recollect = 0;
    tf.cgbtnnum  = 16;
    tf.replayTab = 0 if tf.replayTab === void;
    tf.replayPage = 0 if tf.replayPage === void;

    // the scene player's script, for the compiled scenes (it loads when first used)
    KAGLoadScript("KAGEnvPlayer.tjs") if typeof global.world_object != "undefined" && typeof global.scnFindCompiled == "undefined";

    replayTabs = [];
    replayTiles = [];
    for (var i = 0; i < list.count; i++) {
        var info = list[i];
        if (info === void || info.page == "") continue;
        var tab = replayTabs.find(info.page);
        if (tab < 0) {
            if (replayTabs.count >= 6) continue;
            tab = replayTabs.count;
            replayTabs.add(info.page);
            replayTiles.add([]);
        }
        if (info.scene.substring(0, 6) == "movie:") {
            // a movie, playable once seen ([movie], Movies.tjs)
            replayTiles[tab].add(%[movie:info.scene.substring(6), alpha:info.target != "" ? info.target : "0", thum:info.thum, title:info.title]);
            continue;
        }
        var storage = info.scene + ".ks";
        var compiled = typeof global.scnFindCompiled != "undefined" && scnFindCompiled(storage) !== void &&
            typeof global.world_object != "undefined" && world_object.scenePlayEnabled;
        if (info.target == "*") {
            // every scene of the compiled script that has a title
            if (!compiled) {
                replayTiles[tab].add(%[storage:storage, label:"", thum:info.thum, title:info.title, compiled:false]);
                continue;
            }
            var data = new StorageData(storage);
            var scenes = data.root !== void ? data.root.scenes : void;
            for (var j = 0; scenes !== void && j < scenes.count; j++) {
                var sc = scenes[j];
                if (sc.title == "" || sc.label == "") continue;
                var fromList = sc.title == "Start" && info.title != "";
                replayTiles[tab].add(%[storage:storage, label:sc.label.substr(1), thum:info.thum,
                    title:fromList ? info.title : sc.title, titles:fromList ? void : scnTitles(sc),
                    compiled:true, scene:(storage + sc.label).toLowerCase()]);
            }
            invalidate data;
        } else {
            var title = info.title, titles;
            if (title == "" && compiled) {
                var data = new StorageData(storage);
                var sc = data.findScene(info.target != "" ? "*" + info.target : "");
                title = sc !== void ? sc.title : "";
                titles = scnTitles(sc);
                invalidate data;
            }
            replayTiles[tab].add(%[storage:storage, label:info.target, thum:info.thum, title:title, titles:titles,
                compiled:compiled, scene:(storage + "*" + (info.target != "" ? info.target : "start")).toLowerCase()]);
        }
    }
    tf.replayTab = 0 if tf.replayTab >= replayTabs.count;
}

// Whether a tile can be played: its scene has been read (compiled scenes: the scene player's
// read marks), or its label passed (setRecordLabel: sf["trail_<storage>_<label>"])
function replayUnlocked(info)
{
    if (tf.allseen) return true;
    if (info.movie !== void) return KAGMovieSeen(info.movie);
    if (info.compiled) {
        var r = kag.sflags.envPlayerSceneReaded;
        return r !== void && r[info.scene] !== void && +r[info.scene] > 0;
    }
    var flagname = "trail_" + Storages.chopStorageExt(info.storage).toLowerCase() + "_" + (info.label != "" ? info.label : "start");
    return sf[flagname] !== void && +sf[flagname] > 0;
}

// what screen readers call the sample's screens (Accessibility.tjs)
KAGA11yScreenNames = %[ "config" => "Config", "save" => "Save", "load" => "Load", "cgmode" => "CG", "replay" => "Replay",
    "musicmode" => "Music", "searchmode" => "Search", "glossary" => "Glossary", "chart" => "Chart",
    "spritemode" => "Characters", "title" => "Title", "namescreen" => "Your Name" ];

// A label drawn on each state of a button: the replay tabs' labels
function drawButtonLabel(button, text, colors, size = 30)
{
    button.a11yLabel = text; // (what a screen reader calls it: Accessibility.tjs)
    var hold = button.holdAlpha;
    button.holdAlpha = true;
    for (var st = 0; st < 3; st++)
        KAGDrawStyledText(button, "tab", text, button.width * st + 6, 0, button.width - 12, button.height, %[ color:colors[st], size:size ]);
    button.holdAlpha = hold;
}

// The picture of a compiled scene at its first line (the World only, as compiled), fitted to
// w x h; void where the World shows nothing there
function replaySnapshot(info, w, h)
{
    if (replayThumbs[info.scene] !== void) return replayThumbs[info.scene] ? replayThumbs[info.scene] : void;
    var thumb;
    try {
        world_object.initPlayer();
        var data = new StorageData(info.storage);
        var text = data.getText(info.label != "" ? "*" + info.label : "", 1);
        invalidate data;
        if (text !== void && text.state !== void) {
            var shot = new global.Layer(kag, kag.fore.base);
            world_object.player.getSnapshot(shot, text.state);
            // shows anything: some of it isn't transparent
            var seen = false;
            for (var y = 0; y < 8 && !seen; y++)
                for (var x = 0; x < 8 && !seen; x++)
                    seen = shot.getMaskPixel(shot.imageWidth * (x * 2 + 1) \ 16, shot.imageHeight * (y * 2 + 1) \ 16) > 0;
            if (seen) {
                thumb = new global.Layer(kag, kag.fore.base);
                thumb.setImageSize(w, h);
                thumb.fillRect(0, 0, w, h, 0xff000000);
                if (typeof thumb.shrinkCopy == "Object") KAGShrinkCopy(thumb, 0, 0, w, h, shot, 0, 0, shot.imageWidth, shot.imageHeight, stLinear);
                else thumb.operateStretch(0, 0, w, h, shot, 0, 0, shot.imageWidth, shot.imageHeight, omAuto, 255, stLinear);
            }
            invalidate shot;
        }
    } catch (e) {
        dm("Replay: no thumbnail for " + info.scene + ": " + e.message);
    }
    replayThumbs[info.scene] = thumb !== void ? thumb : false;
    return thumb;
}

// A title in the language shown: a compiled scene's own (titles, by code: the scene's
// translations, doc/scn.txt "Languages"), or replaylist.csv's through the language's strings
function shownTitle(info)
{
    var t = info.titles;
    if (t !== void && typeof global.KAGLanguage != "undefined" && KAGLanguage !== void && typeof t[KAGLanguage.current] == "String")
        return t[KAGLanguage.current];
    return info.shownTitle !== void ? info.shownTitle : tr(info.title);
}

// A tile: its picture, and its title on a band along the bottom (violet when hovered)
function drawReplayTile(button, info)
{
    var b = 3, pw = button.width - b*2, ph = button.height - b*2;
    if (info.thum != "") {
        setCGImage(button, info.thum);
    } else {
        var thumb = info.compiled && info.movie === void ? replaySnapshot(info, pw, ph) : void;
        if (thumb !== void) {
            var hold = button.holdAlpha;
            button.holdAlpha = true;
            for (var st = 0; st < 3; st++) button.operateRect(button.width * st + b, b, thumb, 0, 0, pw, ph, omOpaque);
            button.holdAlpha = hold;
        } else {
            button.loadButtons("replay_thum_normal", "replay_thum_over");
        }
    }
    if (info.title == "") return;
    var title = shownTitle(info);
    var hold = button.holdAlpha;
    button.holdAlpha = true;
    // the title on a band, smaller where it doesn't fit ("tile", textstyles.tjs)
    var band = 30;
    for (var st = 0; st < 3; st++) {
        var x = button.width * st + b;
        button.fillRect(x, b + ph - band, pw, band, st == 0 ? 0xc8010062 : 0xe85025ff);
        KAGDrawStyledText(button, "tile", title, x + 6, b + ph - band, pw - 12, band);
    }
    button.holdAlpha = hold;
}

/**
 * Lays out Replay's tabs and the tiles of the tab shown (tf.replayTab; page is kept for scripts
 * that pass it, since the tiles scroll)
 */
function setReplayPage(tab = void, page = void)
{
    tf.replayTab = tab if tab !== void;
    var tiles = replayTiles[tf.replayTab] !== void ? replayTiles[tf.replayTab] : [];

    for (var i = 0; i < 6; i++) {
        var button = kag.current.names["replay_tab" + i];
        if (button === void) continue;
        if (i >= replayTabs.count) {
