KAGDefineOption(%[ name:"titleGreeter", label:"Title Greeting", kind:"choice", save:true, initial:"ai",
    values:[ ["Ai", "ai"], ["Pip", "pip"], ["Off", "off"] ],
    // (the line is picked again for the new greeter as the title draws it, once the option has
