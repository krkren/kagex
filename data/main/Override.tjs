    if (tf.greetingRepick) { tf.greetingRepick = false; KAGGreetingAgain() if KAGGreetingPicked !== void; }
    var g = KAGGreeting(), text = KAGGreetingText(g);
    if (text == "") return;
    var m = kag.current, hold = m.holdAlpha, pip = KAGOptionGet("titleGreeter") == "pip";
    m.holdAlpha = true;
