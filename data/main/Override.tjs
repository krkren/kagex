}

/**
 * The title starts (title.ks *dispstart): its kept music, carrying on if it's playing, or none
 */
function titleMusicStart()
{
    var i = keepTitleMusic() ? musicIndexOf(sf.titleMusic) : -1;
    if (i < 0 || !(tf.allseen || sf["bgm_" + musicList()[i].filename.toUpperCase()])) {
        tf.musicplaying = false;
        kag.tagHandlers.stopbgm(%[]);
        return;
    }
    kag.clearBgmStop();
    if (!kag.bgm.inPlaying || musicIndexOf(kag.bgm.playingStorage) != i)
        kag.bgm.play(%[ storage:musicList()[i].filename, loop:true ]);
    kag.bgm.setLoop(true);
    tf.musicplaying = true;
    tf.playbgmnum = i;
}

/**
