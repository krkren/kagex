            button.enabled = false;
            continue;
        }
        var current = i == tf.replayTab;
        button.loadButtons(current ? "replay_tab_over" : "replay_tab_normal", "replay_tab_over");
        drawButtonLabel(button, tr(replayTabs[i]), current ? [0xffffff, 0xffffff, 0xffffff] : [0x5025ff, 0xffffff, 0xffffff]);
    }
    // the tab's tiles, in a scrolling grid (replayList; since 0.20.0, pages of 16 before):
    // tf.replaylist[tile] is a tile that can be played, void while it's locked
