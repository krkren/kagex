    for (var i = 0; i < list.count; i++) if (list[i].filename.toLowerCase() == name) return i;
    return -1;
}

/**
 * Whether a track the music room started is playing (it plays on through the CG and Replay
 * screens, and on the title when it's kept there)
 */
function roomMusicPlaying()
{
    return tf.musicplaying && tf.playbgmnum !== void && kag.bgm.inPlaying &&
        musicIndexOf(kag.bgm.playingStorage) == tf.playbgmnum;
}

/**
 * Music Mode Initialization
 */
function musicInit()
{
    var playing = roomMusicPlaying();
    musicList();

    sf.extramode = 3;
    tf.musicbtnnum  = 12;
    tf.beforemusic  = void;
    tf.musicrepeat  = true if tf.musicrepeat === void;
    if (!playing) {
        tf.playbgmnum   = void;
        tf.musicplaying = false;
    }

    // Check flag for already played
    tf.bgmplayflag = [];
    for (var i=0;i<tf.musicmodelist.count;i++) {
        var name = tf.musicmodelist[i].filename.toUpperCase();
        var cond = tf.allseen || sf["bgm_" + name];
