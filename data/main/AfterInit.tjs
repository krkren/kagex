/**
 * Key bindings: F1-F8 open the sample's screens and do what its message window's buttons do.
 * kag.bindKey(key, shift, action, label) adds one to the window's bindings
 * (KAGWindow.keyBindings), which the controls list reads (Help > Controls, Config's Controls
 * button), so it lists these with what they do. The framework's own (F9 the next language,
 * F10 the menu, F12 a screenshot, A, B, F, R, Esc...) are in createKeyBindings.
 */

// F5: full screen or a window, while the Screen menu can be used
function toggleFullScreenByKey()
{
    if (kag.fullScreened) {
        kag.onWindowedMenuItemClick();
    } else {
        kag.onFullScreenMenuItemClick();
    }
}

kag.bindKey(VK_F1, 0, showAbout, "About"); // in the game window (YesNoDialogLayer.tjs)
kag.bindKey(VK_F2, 0, startSave, "Save");
kag.bindKey(VK_F3, 0, startLoad, "Load");
kag.bindKey(VK_F4, 0, startConfig, "Config");
kag.bindKey(VK_F5, 0, toggleFullScreenByKey, "Full screen or window", true, false,
    function { return kag.displayMenu.enabled; });
// F6 to F8 name actions (Actions.tjs): the controls list says what they do, and a player who
// moves an action to another key in Change Controls finds these keys go with it
kag.bindKey(VK_F6, 0, "@skip");
kag.bindKey(VK_F7, 0, "@backlog");
kag.bindKey(VK_F8, 0, "@auto");
// Quick save and quick load are the sample's own (Override.tjs), which load through loadinit.ks:
// the framework's actions do them, so Shift+S and Shift+L, the message window's Q.SAVE and Q.LOAD
// and any key or gesture the player gives them all do the same
KAGActions.quickSave.func = KAGBindToGlobal(quicksaveAction);
KAGActions.quickLoad.func = KAGBindToGlobal(quickloadAction);
// The sample's own screens behind the framework's actions, and two of its own: Config, and leaving
// a replay. BACK is a message back in compiled scenes (rollBack, Override.tjs)
KAGActions.save.func = KAGBindToGlobal(startSave);
KAGActions.save.available = void;
KAGActions.load.func = KAGBindToGlobal(startLoad);
KAGActions.load.available = void;
KAGActions.back.func = KAGBindToGlobal(rollBack);
KAGActions.back.enabled = KAGBindToGlobal(function { return kag.inStable && canRollBack(); });
KAGDefineAction(%[ name:"config", label:"Config", func:startConfig,
    enabled:function { return typeof kag.configMenuItem == "Object" ? kag.configMenuItem.enabled : true; } ]);
KAGDefineAction(%[ name:"exitScene", label:"Leave the replay", func:exitScene,
    available:function { return !!tf.recollect; } ]);

// The message window's buttons are the quick menu (QuickMenu.tjs): along the window's bottom
// edge, at its right, with their pictures (msg_*: icons, but for the saves); dimmed while they
// can't be used, auto and skip lit while on; Config's Quick Menu lets them fade out until the
// pointer comes near (a tap on the handle on a phone). In three groups: moving through the story
// (the scene before, the last choice, rewind, back a line, auto, skip, the next scene), saving
// and loading, then the history, a screenshot and Config. Five have panels (QuickPanels.tjs)
// that a right-click or a long press opens: Auto the text's settings, Q.LOAD the latest quick
// saves, SAVE a new save and the latest saves to save over, LOAD the latest saves, Config the
// volumes. A replay has fewer
var quickMenuStory = [
    %[ action:"prevScene",  image:"msg_prevscene",  x:0 ],
    %[ action:"prevChoice", image:"msg_prevchoice", x:50 ],
    %[ action:"rewind",     image:"msg_rewind",     x:100 ],
    %[ action:"back",       image:"msg_back",       x:150 ],
    %[ action:"auto",       image:"msg_auto",       x:200, on:function { return kag.autoMode; }, panel:"text" ],
    %[ action:"skip",       image:"msg_skip",       x:250, on:function { return kag.skipMode != SKIP_NONE; } ],
    %[ action:"nextScene",  image:"msg_nextscene",  x:300 ],
    %[ action:"quickSave",  image:"msg_qsave",      x:366 ],
    %[ action:"quickLoad",  image:"msg_qload",      x:474, panel:"quickSaves" ],
    %[ action:"save",       image:"msg_save",       x:582, panel:"saves" ],
    %[ action:"load",       image:"msg_load",       x:690, panel:"loads" ],
    %[ action:"backlog",    image:"msg_log",        x:814 ],
    %[ action:"screenshot", image:"msg_screenshot", x:864 ],
    %[ action:"config",     image:"msg_config",     x:914, panel:"volume" ] ];
var quickMenuReplay = [
    %[ action:"back",       image:"msg_back",       x:0 ],
    %[ action:"auto",       image:"msg_auto",       x:50, on:function { return kag.autoMode; }, panel:"text" ],
    %[ action:"skip",       image:"msg_skip",       x:100, on:function { return kag.skipMode != SKIP_NONE; } ],
    %[ action:"exitScene",  image:"msg_exit",       x:166 ],
    %[ action:"backlog",    image:"msg_log",        x:290 ],
    %[ action:"screenshot", image:"msg_screenshot", x:340 ],
    %[ action:"config",     image:"msg_config",     x:390, panel:"volume" ] ];
// the bottom right of the window's panel (1788x318 of its 1800x330; [initscene]'s marginB keeps
// the text above the strip at its larger size)
function quickMenuPlace(w, h) { var m = kag.fore.messages[0]; return [ m.left + m.width - 33 - w, m.top + m.height - 23 - h ]; }
with (KAGQuickMenuOf(kag)) {
    .items = function { return tf.recollect ? quickMenuReplay : quickMenuStory; };
    .place = quickMenuPlace;
    // in the story: after [initscene] (macro.ks), which sets f.quickMenu, until the title clears
    // it (f is the game's, so a save loaded brings it back); not over Config and the like
    .when = function { return !!f.quickMenu && !inSystemMenu(kag); };
}

// The message window's styles (MessageStyles.tjs, since 0.22.0): the window as [initscene] makes
// it, and sepia for memories ([env msgstyle=memory], the [memory] macro); each gets a colour row
// on Config's third page
KAGDefineMessageStyle("normal", %[ frame:"messagewindow", nameframe:"namebox", label:"Message Window" ]);
KAGDefineMessageStyle("memory", %[ frame:"messagewindow_memory", nameframe:"namebox_memory", label:"Memories' Window" ]);
var configStyleOptions = KAGDefineMessageStyleOptions();

// Movies have a volume of their own (Config's fifth page), not the music's
kag.independentMovieAudioProperty = true;

// Gestures in the story: a swipe on a phone, or a drag with the right mouse button, left rewinds
// (compiled scenes), right skips, up shows the message history and down hides the window; a long
// press turns auto mode on or off
kag.gestureActions.left  = "rewind";
kag.gestureActions.right = "skip";
kag.gestureActions.hold  = "auto"; // a long press on the story (since 0.20.0): auto mode on or off
// the story only, as the quick menu (Search's list is dragged on the title's conductor)
kag.gestures.when = function { return !!f.quickMenu && !inSystemMenu(kag); };

// Help lines (Tooltips.tjs, since 0.20.0): at the bottom of Config, the save and load screens and
// Extras, what the pointer or the focus is on (helptexts.csv), or what the screen is for
function helpLineArea()
{
    var s = kag.conductor.curStorage;
    if (s == "config.ks") return [ 290, 1008, 760, 54 ];
    if (s == "save.ks" || s == "load.ks") return [ 290, 1014, 1340, 50 ];
    if (s == "cgmode.ks" || s == "replay.ks" || s == "musicmode.ks" || s == "searchmode.ks") return [ 290, 1000, 1000, 54 ];
}
kag.tooltips.helpArea = helpLineArea;

// Controller: START opens the config screen, BACK (Select) the save screen and L1 the load
// screen, the same as F4, F2 and F3 above. The framework maps the D-pad, A/B/X/Y, R1, R2, L2
// and R3 (the menu bar's first menu, in a window) (initialPadKeyMap in MainWindow.tjs); the
// framework's START opens that menu too, which the sample leaves to R3.
kag.padKeyMap[VK_PAD10] = VK_F4;
kag.padKeyMap[VK_PAD9]  = VK_F2;
kag.padKeyMap[VK_PAD5]  = VK_F3;
kag.recreatePadKeyMap();

// Config's page 5: each character's voice volume, with a Test button (Options.tjs; their test
// lines are envinit.tjs's testVoices), and the samples page 1's volumes play as they're set
var configVoiceOptions = KAGDefineVoiceOptions([ "ai", "pip", "hiyori", "vee" ]);
KAGVolumeSamples.musicStorage = "bgm01"; // the opening's song, heard as the game starts
KAGVolumeSamples.soundStorage = "se_chime";
KAGVolumeSamples.movieStorage = "bgm01"; // the opening's sound is the start of its song

// Languages: F9 and the controller's L2 show the game in its next language (KAGLanguageList in
// Config.tjs), as Config's Language buttons choose one. The framework draws the message window
// and the choices again; the screen on show is drawn again here (redisplayScreen, Override.tjs)
kag.languageChangeHook.add(redisplayScreen);

// Restrict save and load
kag.origCanStore   = kag.canStore;
kag.origCanRestore = kag.canRestore;

kag.canStore = function()
{
    return origCanStore() && !inSystemMenu(this);
} incontextof kag;

kag.canRestore = function()
{
    return origCanRestore() && !inSystemMenu(this);
} incontextof kag;

// On-screen indicators (Indicators.tjs): each compiled scene's title shows in a corner as it
// starts, and the music's title (musiclist.csv) when it changes
kag.indicators.chapterFromScenes = true;

// The hero's name (namescreen.ks): words a name may not hold
kag.heroNameRefused = [ "idiot", "stupid", "dummy" ];
