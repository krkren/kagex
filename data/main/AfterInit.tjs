/**
 * Key Function
 * Register this in AfterInit.tjs to KAG to intercept functions
 */
function keyFunc(key, shift)
{
    if (key == VK_F1 && shift < 1) {
        showAbout(); // in the game window (YesNoDialogLayer.tjs)
        return true;
    } else if (key == VK_F2 && shift == 0 ) {
        startSave();
        return true;
    } else if (key == VK_F3 && shift == 0) {
        startLoad();
        return true;
    } else if (key == VK_F5 && kag.displayMenu.enabled && shift == 0) {
        if (kag.fullScreened) {
            kag.onWindowedMenuItemClick();
        } else {
            kag.onFullScreenMenuItemClick();
        }
        return true;
    } else if (key == VK_F6 && shift == 0) {
        kag.skipToNextStopByKey();
        return true;
    } else if (key == VK_F7 && shift == 0) {
        kag.showHistoryByKey();
        return true;
    } else if (key == VK_F8 && shift == 0) {
        kag.switchAutoModeByKey();
        return true;
    } else if (key == VK_F4 && shift == 0) {
        startConfig();
        return true;
    }
    return false;
}

// Register key binds
kag.keyDownHook.add(keyFunc);

// Controller: START opens the config screen, BACK (Select) the save screen and L1 the load
// screen, the same as F4, F2 and F3 above. The framework maps the D-pad, A/B/X/Y, R1 and R2
// (initialPadKeyMap in MainWindow.tjs).
kag.padKeyMap[VK_PAD10] = VK_F4;
kag.padKeyMap[VK_PAD9]  = VK_F2;
kag.padKeyMap[VK_PAD5]  = VK_F3;
kag.recreatePadKeyMap();

// Languages: F9 and the controller's L2 show the game in its next language (KAGLanguageList in
// Config.tjs), as Config's Language buttons choose one. The framework draws the message window
// and the choices again; the screen on show is drawn again here (redisplayScreen, Override.tjs)
kag.languageChangeHook.add(redisplayScreen);

// Restrict save and load
kag.origCanStore   = kag.canStore;
kag.origCanRestore = kag.canRestore;

kag.canStore = function()
{
    return origCanStore() && !inSystemMenu(this);
} incontextof kag;

kag.canRestore = function()
{
    return origCanRestore() && !inSystemMenu(this);
} incontextof kag;