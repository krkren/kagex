/**
 * Key bindings: F1-F8 open the sample's screens and do what its message window's buttons do.
 * kag.bindKey(key, shift, action, label) adds one to the window's bindings
 * (KAGWindow.keyBindings), which the controls list reads (Help > Controls, Config's Controls
 * button), so it lists these with what they do. The framework's own (F9 the next language,
 * F10 the menu, F12 a screenshot, A, B, F, R, Esc...) are in createKeyBindings.
 */

// F5: full screen or a window, while the Screen menu can be used
function toggleFullScreenByKey()
{
    if (kag.fullScreened) {
        kag.onWindowedMenuItemClick();
    } else {
        kag.onFullScreenMenuItemClick();
    }
}

kag.bindKey(VK_F1, 0, showAbout, "About"); // in the game window (YesNoDialogLayer.tjs)
kag.bindKey(VK_F2, 0, startSave, "Save");
kag.bindKey(VK_F3, 0, startLoad, "Load");
kag.bindKey(VK_F4, 0, startConfig, "Config");
kag.bindKey(VK_F5, 0, toggleFullScreenByKey, "Full screen or window", true, false,
    function { return kag.displayMenu.enabled; });
// F6 to F8 name actions (Actions.tjs): the controls list says what they do, and a player who
// moves an action to another key in Change Controls finds these keys go with it
kag.bindKey(VK_F6, 0, "@skip");
kag.bindKey(VK_F7, 0, "@backlog");
kag.bindKey(VK_F8, 0, "@auto");
// Quick save and quick load are the sample's own (Override.tjs), which load through loadinit.ks:
// the framework's actions do them, so Shift+S and Shift+L, the message window's Q.SAVE and Q.LOAD
// and any key or gesture the player gives them all do the same
KAGActions.quickSave.func = KAGBindToGlobal(quicksaveAction);
KAGActions.quickLoad.func = KAGBindToGlobal(quickloadAction);
// Gestures in the story: a swipe on a phone, or a drag with the right mouse button, left rewinds
// (compiled scenes), right skips, up shows the message history and down hides the window
kag.gestureActions.left  = "rewind";
kag.gestureActions.right = "skip";

// Controller: START opens the config screen, BACK (Select) the save screen and L1 the load
// screen, the same as F4, F2 and F3 above. The framework maps the D-pad, A/B/X/Y, R1, R2, L2
// and R3 (the menu bar's first menu, in a window) (initialPadKeyMap in MainWindow.tjs); the
// framework's START opens that menu too, which the sample leaves to R3.
kag.padKeyMap[VK_PAD10] = VK_F4;
kag.padKeyMap[VK_PAD9]  = VK_F2;
kag.padKeyMap[VK_PAD5]  = VK_F3;
kag.recreatePadKeyMap();

// Config's page 5: each character's voice volume, with a Test button (Options.tjs; their test
// lines are envinit.tjs's testVoices), and the samples page 1's volumes play as they're set
var configVoiceOptions = KAGDefineVoiceOptions([ "ai", "pip", "hiyori", "vee" ]);
KAGVolumeSamples.musicStorage = "bgm01"; // the opening's song, heard as the game starts
KAGVolumeSamples.soundStorage = "se_chime";

// Languages: F9 and the controller's L2 show the game in its next language (KAGLanguageList in
// Config.tjs), as Config's Language buttons choose one. The framework draws the message window
// and the choices again; the screen on show is drawn again here (redisplayScreen, Override.tjs)
kag.languageChangeHook.add(redisplayScreen);

// Restrict save and load
kag.origCanStore   = kag.canStore;
kag.origCanRestore = kag.canRestore;

kag.canStore = function()
{
    return origCanStore() && !inSystemMenu(this);
} incontextof kag;

kag.canRestore = function()
{
    return origCanRestore() && !inSystemMenu(this);
} incontextof kag;

// On-screen indicators (Indicators.tjs): each compiled scene's title shows in a corner as it
// starts, and the music's title (musiclist.csv) when it changes
kag.indicators.chapterFromScenes = true;

// The hero's name (namescreen.ks): words a name may not hold
kag.heroNameRefused = [ "idiot", "stupid", "dummy" ];
