%[

	"autoLabelSync" => true, // Save point at sync position
	// Writers' shorthands (since 0.17.0): [ai 102] is pose 1 and face 02, through each
	// character's "poseCodes" and "faceCodes" (KAGEnvCharacter.doShorthand)
	"shorthands" => [ %[ "pattern" => "^([0-9])([0-9][0-9][a-z]?)$", "pose" => "$1", "face" => "$2" ] ],
	// Voices from where the speakers stand (since 0.16.0): a character on the left is heard a
	// little from the left, one further back further away, through the engine's 3D sound as
	// sounds placed with [se char=] are; the player can centre them again (Config)
	"voice3d" => true,



	// Time information

	"times" => %[

		"day" => %[

			"prefix" => "01",

			],

		"evening" => %[

			"prefix" => "02",

			"lightColor" => 0xc0ff6010,    // Background correction light color

			"lightType" => ltPsHardLight,  // Background correction light blend type

			"brightness" => 0,             // Background brightness correction

			"contrast" => 0,               // Background contrast correction

			"charLightColor" => 0xffff0000,   // Character correction light blend color

			"charLightType" => ltPsSoftLight, // Character correction light blend type

			"charBrightness" => 0,            // Character brightness correction

			"charContrast" => 0,              // Character contrast correction

			],

		"night" => %[

			"prefix" => "03",

			"lightColor" => 0xc0000040,   // Character correction light blend color

			"lightType" => ltPsHardLight, // Character correction light blend type

			"brightness" => -20,          // Character brightness correction

			"contrast" => -30,            // Character contrast correction

			"charLightColor" => 0xff400080,   // Character correction light blend color

			"charLightType" => ltPsSoftLight, // Character correction light blend type

			"charBrightness" => -50,          // Character brightness correction

			"charContrast" => -30,            // Character contrast correction

			]

		],



	// Location information

	"stages" => %[

		"road" => %[

			"image" => "bg01_TIME",

			],

		],



	"defaultTime" => "day",



	// Overall character placement offset (origin at screen center)

	"yoffset" => 1260,



	// Character placement information definition

	"positions" => %[

		// *type definition is no longer necessary. If any of disp/xpos/ypos/level are defined, they will be used.



		// Display definition (face display has no meaning if the face window function is not present)

		"both" => %[ "disp" => KAGEnvImage.BOTH      ], // Display both standing image and face

		"body" => %[ "disp" => KAGEnvImage.BU        ], // Display standing image only

		"face" => %[ "disp" => KAGEnvImage.FACE      ], // Display face only

		"hide" => %[ "disp" => KAGEnvImage.CLEAR     ], // Temporarily hide (auto-display upon state change is active) *This is generally used

		"none" => %[ "disp" => KAGEnvImage.INVISIBLE ], // Completely hide (auto-display upon state change is also disabled)



		// Position definition

		"farleft" => %[ "xpos" => int -1056 ],

		"farright" => %[ "xpos" => int  1056 ],

		"posleft"   => %[ "xpos" => int -480 ],

		"posright"   => %[ "xpos" => int  480 ],

		"midleft" => %[ "xpos" => int -240 ],

		"midright" => %[ "xpos" => int  240 ],

		"outleft" => %[ "xpos" => int -1440 ],

		"outright" => %[ "xpos" => int  1440 ],

		"center"   => %[ "xpos" => int    0 ],

		// Sprite Mode's (spritemode.ks): the middle of the screen right of its panel
		"spriteview" => %[ "xpos" => int  340 ],



		// ypos is often specified individually directly

//		"vDefault" => %[ "ypos" => int    0 ],

//		"vCrouch"   => %[ "ypos" => int   50 ],

//		"vStretch"     => %[ "ypos" => int  -20 ],



		"backlevel"   => %[ "level" => int 0 ],

		"centerlevel"   => %[ "level" => int 1 ],

		"frontlevel" => %[ "level" => int 2 ],

		// Presets that do more at once (since 0.17.0): further back and behind the others, or

		// nearer and in front of them

		"far"  => %[ "level" => int 0, "back"  => true ],

		"near" => %[ "level" => int 2, "front" => true ],

		],



    // Information for display levels

	"levels" => [

		%[

			// Zoom ratio specification

			"zoom" => 60, // Position reduction ratio (camera

//			"imgzoom" => 100, // Image reduction ratio

			"name" => "1", // Level name

			],

		%[

			"zoom" => 100,

			"name" => "0"

			],

		%[

			"zoom" => 150,

			"name" => "2"

			],

		],

    

    "defaultLevel" => 1,



	// BG depth specification (equivalent to level zoom specification) *Individual levelz changes for each BG are not implemented

	"bglevelz" => 30,





    // Level specification for face window. If not using face window, use void.
    // (since 0.18.0 the sample's speakers show their faces by the message window: [initscene]'s
    // face box, each character's faceCrop below, crossfading; the faces keep their own colours,
    // whatever lighting or colour effects their sprites have)

    "faceLevelName" => "0",

    "faceFadeTime" => 200,

    "faceApplyColor" => false,

    // Layouts (since 0.18.0): where one to four characters stand ([name join], [name leave],
    // [env layout], [env makeroom=]), and how long the others take to slide over

    "layouts" => %[ "places" => [ [0], [-420, 420], [-660, 0, 660], [-780, -260, 260, 780] ], "time" => 400 ],

//	"faceArea" => %[ name:"Face area layer", center:true/*Center flag*/, xoffset:0, yoffset:0, width:200, height:160 ],

//	"faceZoom" => 100,





    "actions" => %[

		"bow" => %[

			"module" => "LayerJumpOnceActionModule",

			"vibration" => 36,

			"cycle" => 2000,

			],

		"shock" => %[

			"module" => "LayerHeartBeatZoomModule",

			"time" => 200,

			"zoom" => 110,

			],

		"hop" => %[

			"module" => "LayerJumpActionModule",

			"vibration" => -54,

			"cycle" => 1000,

			],

		"hopNoWait" => %[

			"module" => "LayerJumpActionModule",

			"vibration" => -54,

			"cycle" => 1000,

			"nowait" => true,

			],

		"shiver" => %[

			"module" => "LayerVibrateActionModule",

			"vibration" => 5,

			"waitTime" => 40

			],



		// The staging kit's gestures (since 0.18.0): a word each, [ai nod]; relative actions, so a
		// character ends where it was. The screen shakes go to the camera: [quake], [thud],
		// [rumble] (macro.ks, [env actioncamera=quake])
		"nod" => %[ "time" => 420, "top" => %[ handler:"TriangleAction", vibration:28, ontime:160, offtime:260 ] ], // a nod
		"nods" => %[ "time" => 840, "top" => %[ handler:"TriangleAction", vibration:24, ontime:160, offtime:260 ] ], // two nods
		"headshake" => %[ "time" => 900, "left" => %[ handler:"SinAction", vibration:20, cycle:300 ] ], // shaking the head
		"sigh" => %[ "time" => 1400, "top" => %[ handler:"TriangleAction", vibration:22, ontime:500, offtime:900 ], "zoomy" => %[ handler:"TriangleAction", vibration:-2, ontime:500, offtime:900 ] ], // shoulders falling with a sigh
		"laugh" => %[ "time" => 1000, "top" => %[ handler:"SinAction", vibration:9, cycle:180 ] ], // shaking with laughter
		"shrug" => %[ "time" => 520, "top" => %[ handler:"TriangleAction", vibration:-18, ontime:200, offtime:320 ], "zoomx" => %[ handler:"TriangleAction", vibration:3, ontime:200, offtime:320 ] ], // a shrug
		"lookaround" => %[ "time" => 1800, "left" => %[ handler:"SinAction", vibration:36, cycle:1800 ], "rotate" => %[ handler:"SinAction", vibration:2, cycle:1800 ] ], // looking around
		"wobble" => %[ "time" => 1500, "rotate" => %[ handler:"SinAction", vibration:4, cycle:500 ] ], // wobbling
		"slump" => %[ "time" => 1600, "top" => %[ handler:"TriangleAction", vibration:60, ontime:600, offtime:1000 ], "zoomy" => %[ handler:"TriangleAction", vibration:-3, ontime:600, offtime:1000 ] ], // slumping
		"startle" => %[ "time" => 320, "top" => %[ handler:"TriangleAction", vibration:-70, ontime:110, offtime:210 ] ], // a start
		"tremble" => %[ "time" => 1500, "left" => %[ handler:"RandomAction", vibration:5, waittime:30 ] ], // trembling
		"bounce" => %[ "time" => 1200, "top" => %[ handler:"TriangleAction", vibration:-26, ontime:150, offtime:150 ] ], // bouncing
		"leanin" => %[ "time" => 900, "zoom" => %[ handler:"TriangleAction", vibration:7, ontime:300, offtime:600 ] ], // leaning in
		"stepback" => %[ "time" => 900, "zoom" => %[ handler:"TriangleAction", vibration:-7, ontime:300, offtime:600 ] ], // stepping back
		"sway" => %[ "time" => 3000, "rotate" => %[ handler:"SinAction", vibration:3, cycle:1500 ] ], // swaying
		"stomp" => %[ "time" => 520, "top" => %[ handler:"TriangleAction", vibration:16, ontime:60, offtime:200 ] ], // a stomp
		"pop" => %[ "time" => 300, "zoom" => %[ handler:"TriangleAction", vibration:12, ontime:100, offtime:200 ] ], // popping up
		"tilt" => %[ "time" => 1200, "rotate" => %[ handler:"TriangleAction", vibration:8, ontime:300, offtime:900 ] ], // tilting the head
		"giggle" => %[ "time" => 800, "rotate" => %[ handler:"SinAction", vibration:2, cycle:200 ], "top" => %[ handler:"SinAction", vibration:4, cycle:200 ] ], // a giggle
		"faint" => %[ "time" => 1200, "top" => %[ handler:"TriangleAction", vibration:90, ontime:400, offtime:800 ], "opacity" => %[ handler:"TriangleAction", vibration:-120, ontime:400, offtime:800 ] ], // nearly fainting
		"quake" => %[ "time" => 700, "camerax" => %[ handler:"RandomAction", vibration:24, waittime:30 ], "cameray" => %[ handler:"RandomAction", vibration:18, waittime:30 ] ], // the screen shakes hard
		"thud" => %[ "time" => 360, "cameray" => %[ handler:"TriangleAction", vibration:30, ontime:60, offtime:300 ] ], // the screen drops once
		"rumble" => %[ "time" => 2000, "camerax" => %[ handler:"RandomAction", vibration:6, waittime:40 ], "cameray" => %[ handler:"RandomAction", vibration:4, waittime:40 ] ], // the screen rumbles

		// New style action definition example



		"move_test" => %[ // Move to current position +300 over 500ms

						   "time" => 500,

						   "left" => %[ handler:"MoveAction", value:"@+720" ],

						   ],



		"path_test" => %[ // Batch specification of multiple movements

						   "time" => 1000,

						   "left" => %[ handler:"PathAction", value:"@+720,@-720,@+240" ],

						   ],



		"path_test2" => %[ // KAG move compatible notation

								"time" => 3000,

								"path" => "(-960,720,128)(-960,-720,100)(0,0,256)",

								"spline" => true,

						   ],

		

		"rotate_test" => %[ // Rotate for 1000ms

						   "time" => 1000,

						   "rotate" => %[ handler:"TriangleAction", vibration:360,  ontime:1000, offtime:0 ]

						   ],



		// Sequential actions



		"sequence_test" => [

			// Note that the initial coordinate for movement is the position before all actions are executed

			%[ // Move to current position +300 over 500ms

			   "time" => 500,

			   "left" => %[ handler:"MoveAction", value:"@+720" ],

				],

			%[ // Move to current position -300 over 1000ms

				"time" => 1000,

				"left" => %[ handler:"MoveAction", value:"@-720" ],

				],

			%[ // Move to current position +300 over 1000ms

				"time" => 1000,

				"left" => %[ handler:"MoveAction", value:"@+720" ],

			   ],

			%[ // Move to current position over 1000ms

			   "time" => 1000,

			   "left" => %[ handler:"MoveAction", value:"@" ]

			   ]

			],



		"sequence_test2" => [ // Sequential specification via action names is also possible

							"move_test", "rotate_test" ],



		"title_slide" => %[

			"tilex" => %[ handler:"LoopMoveAction", max:1920, loop:2000 ],

			"tiley" => %[ handler:"LoopMoveAction", max:1080, loop:2000 ]

			],



		"side_slide" => %[

			"tilex"  => %[ handler:"LoopMoveAction", max:2700, loop:2700 ],

			"nowait" => true,

			],



		"motion_action" => %[

			"motion"  => %[ handler:"MotionAction", storage:"action.psb", chara:"action", motion:"motion1", layer:"layer1" ],

			],



		"motion_action2" => %[

			"motion"  => %[ handler:"MotionAction", storage:"action.psb", chara:"action", motion:"motion2", layer:"layer1" ],

			],



		"motion_action3" => %[

			"motion"  => %[ handler:"MotionAction", storage:"action.psb", chara:"action", motion:"motion3", layer:"layer1" ],

			],



		"motion_action4" => %[

			"motion"  => %[ handler:"MotionAction", storage:"action.psb", chara:"action", motion:"motion4", layer:"layer1" ],

			],



		

		],



    // Screen update parameters

	"transitions" => %[

		"normal" => %[

			"time" => 1000,

			"method" => "crossfade",

			],



		"notrans" => %[

			"time" => 0,

			"method" => void,

			],



		"showfade" => %[

		time: 200,

		showaction: %[],

		hideaction: %[]

			],

		

		"showslide" => %[

		time: 200,

		showaction: %[ left : %[ handler:"MoveAction", start:"@+120", value:"@" ]	],

		hideaction: %[ left : %[ handler:"MoveAction", start:"@", value:"@-120" ]	]

			],



		"showzoom" => %[

		time: 200,

		showaction: %[ zoom : %[ handler:"MoveAction", start:200, value:100, accel:1 ]],

		hideaction: %[ zoom : %[ handler:"MoveAction", start:"@", value:150, accel:1 ]]

			],



		// extNagano's morphing (transition.ks): the old picture winds up into a swirl while the
		// new one unwinds out of it. before and after list the same triangles, six numbers each
		// (x1, y1, x2, y2, x3, y3), on a 12 x 7 grid over the screen: before as it is, after with
		// its inner points turned around the centre, the middle most. The edges stay put, so the
		// triangles cover the screen all the way through.

		"swirl" => (function() {

			var w = kag.scWidth, h = kag.scHeight, nx = 12, ny = 7, flat = [], turned = [];

			for (var j = 0; j <= ny; j++) for (var i = 0; i <= nx; i++) {

				var x = w * i / nx, y = h * j / ny, tx = x, ty = y;

				if (i > 0 && i < nx && j > 0 && j < ny) {

					var dx = x - w / 2, dy = y - h / 2;

					var r = Math.sqrt(dx * dx + dy * dy) * 2 / Math.sqrt(w * w + h * h);

					var a = Math.PI * 0.6 * (1 - r) * (1 - r);

					tx = w / 2 + dx * Math.cos(a) - dy * Math.sin(a);

					ty = h / 2 + dx * Math.sin(a) + dy * Math.cos(a);

				}

				flat.add((int)x); flat.add((int)y); turned.add((int)tx); turned.add((int)ty);

			}

			var before = [], after = [];

			for (var j = 0; j < ny; j++) for (var i = 0; i < nx; i++) {

				var a = j * (nx + 1) + i, b = a + 1, c = a + nx + 1, d = c + 1;

				var corners = [a, b, c, b, d, c];

				for (var k = 0; k < corners.count; k++) {

					before.add(flat[corners[k] * 2]); before.add(flat[corners[k] * 2 + 1]);

					after.add(turned[corners[k] * 2]); after.add(turned[corners[k] * 2 + 1]);

				}

			}

			return %[ method: "morphing", time: 2000, before: before, after: after ];

		})(),



		],



// Default Transition Definitions Start Here



	// Defines transitions used when transition specification is omitted for character, background, or event image changes

	// "*Trans" => Transition name string (defined in "transitions") or transition definition dictionary

	// *Note: For character-related items, the *Trans definition within the character definition takes precedence.



	"charDispTrans" => %[ "time" =>  300, "method"  => "crossfade" ],                   // Character display/hide specification

	"positionTrans" => %[ "time" =>  300, "method"  => "crossfade" ],                   // Character position change



//	"poseTrans"     => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // Character pose change

//	"dressTrans"    => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // Character clothing change

//	"diffTrans"     => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // Character variation change (only when using exstand)

//	"faceTrans"     => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // Character expression change

	"charTrans"     => %[ "time" =>  300, "method"  => "crossfade", "nosync" => true ], // Default for pose, clothing, variation, and expression (used when the above are undefined)



//	"layerDispTrans"=> %[ "time" =>  500, "method"  => "crossfade" ],                   // Display/hide specification for layers (created with newlay)



//	"timeTrans"     => %[ "time" => 1500, "method"  => "crossfade" ],                   // Time change

//	"stageTrans"    => %[ "time" => 1500, "method"  => "crossfade" ],                   // Stage change

//	"eventTrans"    => %[ "time" => 1500, "method"  => "crossfade" ],                   // Event change

	"envTrans"      => "normal",                                                        // Environment default (used when the above are undefined)



// Default Transition Definitions End Here



	// Default value for fade command: Global (default 500 if undefined)

	"fadeValue" => 1000,

	// Default value for fade command: For characters (refers to fadeValue if undefined)

	"charFadeValue" => 300,



	// Initial voice number value for automatic incremental method

	//"voiceInit" => 0,



	// Character definition information

	"characters" => %[

		// *Note: Detailed definitions here are unnecessary if using exstand (standing images converted from psd materials).

		// Only definitions like voiceName are required

		//"ai" => %[ "voiceName" => "voice0", 〜 ];



		// Definition

		"ai" => %[

			// displayed name for 【ai】 lines, in each of the game's languages (KAGLanguageList)
			"nameAlias" => %[ "en" => "Ai", "ja" => "あい" ],

			// Pose registration (range where expression files are not used separately)

			"poses" => %[

				// Pose specification

				"standard" => %[

					// Image name, pre-composed pattern

					"image"     => "ch_LEVEL_DRESS_FACE",

//					"image"     => "ch_0_DRESS_0",

//					"faceImage" => "ch_0_0_FACE",

					

					// Clothing variations

					"dresses" => %[

						"uniform"     => "0",

						],

					// Default clothing

					"defaultDress" => "0",

					// Expression variations

					"faces" => %[

						"happy"    => "1",

						"angry"    => "2",

						"sad"    => "3",

						],

					// Default expression

					"defaultFace" => "1",

					],

				],

			"defaultPose" => "standard",

			// the shorthands' numbers ("shorthands" above): pose 1, faces 01 to 03

			"poseCodes" => %[ "1" => "standard" ],

			// the face window (since 0.18.0): this part of her level 0 sprite (540x1620)
			"faceCrop" => %[ "level" => "0", "left" => 90, "top" => 70, "width" => 360, "height" => 360 ],

			"faceCodes" => %[ "01" => "happy", "02" => "angry", "03" => "sad" ],

			"voiceFile" => "ai%s%06d.ogg",

			"voiceName" => "voice0",

			// Config's Test button and the volume sliders play one of these (Options.tjs, KAGVoiceTest)

			"testVoices" => [ "ai000001" ]

			],



		// A character drawn from layers (exstand): its pose, outfits, arm poses and faces come from

		// charinit.csv and fgimage/pip (tools/assets/make_pip.py), so it has no "poses" here.

		// Its eyes blink, and its mouth follows its voice.

		// the hero, whom the player names (namescreen.ks): only a name, shown by an expression
		// ("&" first: KAGEnvironment.nameAliasOf), the given name the player chose

		"hero" => %[

			"nameAlias" => "&kag.heroName()"

			],

		"pip" => %[

			"nameAlias" => %[ "en" => "Pip", "ja" => "ピップ" ],

			"yoffset" => 0, // the centre of its canvas goes to the centre of the screen

			// the face window: this part of its level 0 canvas (640x1168)
			"faceCrop" => %[ "level" => "0", "left" => 70, "top" => 140, "width" => 500, "height" => 500 ],

			"voiceFile" => "pip%s%06d",

			"voiceName" => "voice1",

			// Config's Test button and the volume sliders play one of these (Options.tjs, KAGVoiceTest)

			"testVoices" => [ "pip000001", "pip000003", "pip000005", "pip000009" ]

			],



		// A Live2D character (KAGEnvCharacterLive2D.tjs): Hiyori, Live2D Inc.'s sample model, which

		// tools/assets/make_hiyori.py fetches from Live2D's GitHub into fgimage/hiyori.l2d (it isn't

		// in this repository: Live2D's licence for its sample models doesn't let others put copies of

		// them online, only works that use them). The krkrlive2d

		// plugin draws her; a build without it, or without her file, says so in anim.ks.

		"hiyori" => %[

			"nameAlias" => %[ "en" => "Hiyori", "ja" => "ひより" ],

			"yoffset" => 300, // the centre of her canvas, below the centre of the screen

			"voiceFile" => "hiyori%s%06d",

			"voiceName" => "voice2",

			// Config's Test button and the volume sliders play one of these (Options.tjs, KAGVoiceTest)

			"testVoices" => [ "hiyori000001" ],

			// the face window (since 0.22.0): this part of her picture, in fractions of it (the

			// model's canvas, 2976x4175), cut from the picture as it's drawn

			"faceCrop" => %[ "left" => 0.30, "top" => 0.05, "width" => 0.40, "height" => 0.285 ],

			"live2d" => %[

				"model" => "hiyori",

				"canvas" => [2976, 4175], // her canvas in Cubism Editor, for its shape

				"height" => 1650,         // its height on the screen at 100%

				// a pose is motions that go on: one of the model3.json group after another, or one
				// motion of its own (":<name>"), which loops on its own

				"poses" => %[ "standard" => "Idle", "still" => ":Hiyori_m03" ],

				"defaultPose" => "standard",

				// motions played once, then the pose's again; a spec is a model3.json group ("Idle",
				// one of its motions at random), "<group>:<n>" its n-th and ":<name>" the file
				// motions/<name>.motion3.json, whatever group it is in

				"motions" => %[ "tap" => "TapBody", "idle5" => "Idle:4", "m03" => ":Hiyori_m03" ],

				// faces: values for her parameters (an eye's is how open it is: 1 open, 0 shut), which
				// hold whatever her motions do; a parameter a face doesn't name is at its default

				"faces" => %[

					"normal"    => %[],

					"smile"     => %[ "ParamEyeLSmile" => 1, "ParamEyeRSmile" => 1, "ParamMouthForm" => 1 ],

					"laugh"     => %[ "ParamEyeLOpen" => 0, "ParamEyeROpen" => 0, "ParamEyeLSmile" => 1, "ParamEyeRSmile" => 1, "ParamMouthForm" => 1, "ParamMouthOpenY" => 0.5, "ParamCheek" => 1 ],

					"sad"       => %[ "ParamEyeLOpen" => 0.75, "ParamEyeROpen" => 0.75, "ParamBrowLY" => -0.3, "ParamBrowRY" => -0.3, "ParamBrowLForm" => -1, "ParamBrowRForm" => -1, "ParamBrowLAngle" => -0.5, "ParamBrowRAngle" => -0.5, "ParamMouthForm" => -2 ],

					"surprised" => %[ "ParamEyeLOpen" => 1.2, "ParamEyeROpen" => 1.2, "ParamBrowLY" => 0.8, "ParamBrowRY" => 0.8, "ParamMouthForm" => -2, "ParamMouthOpenY" => 0.6 ],

					"blush"     => %[ "ParamEyeLOpen" => 0.85, "ParamEyeROpen" => 0.85, "ParamEyeLSmile" => 0.6, "ParamEyeRSmile" => 0.6, "ParamBrowLY" => -0.3, "ParamBrowRY" => -0.3, "ParamCheek" => 1 ],

					// thinking: her eyes look away and half shut, as if she is reading the script

					"thinking"  => %[ "ParamEyeLOpen" => 0.7, "ParamEyeROpen" => 0.7, "ParamEyeBallX" => -0.7, "ParamEyeBallY" => -0.5, "ParamBrowLY" => 0.4, "ParamBrowRY" => 0.4, "ParamBrowLAngle" => 0.5, "ParamBrowRAngle" => 0.5, "ParamMouthForm" => -0.5 ],

					// wink: one eye shut, the other open and smiling, which goes on blinking

					"wink"      => %[ "ParamEyeLOpen" => 0, "ParamEyeROpen" => 1, "ParamEyeRSmile" => 1, "ParamMouthForm" => 1, "ParamCheek" => 0.4 ],

					],

				"defaultFace" => "normal",

				],

			],

		// A VRM character (KAGEnvCharacterVRM.tjs): Vee, the sample's own avatar, built from shapes by
		// tools/assets/make_vrm.py (fgimage/vee.vrm, her VRM animations fgimage/vee_*.vrma). The
		// krkrthreepp plugin draws her; a build without it says so in anim.ks.

		"vee" => %[

			"nameAlias" => %[ "en" => "Vee", "ja" => "ヴィー" ],

			"yoffset" => 190, // the centre of her picture, below the centre of the screen

			"voiceFile" => "vee%s%06d",

			"voiceName" => "voice3",

			// Config's Test button and the volume sliders play one of these (Options.tjs, KAGVoiceTest)

			"testVoices" => [ "vee000001" ],

			// the face window (since 0.22.0): this part of her picture at 100% (832x1340), cut from

			// the picture as it's drawn, so it blinks and talks there too

			"faceCrop" => %[ "left" => 246, "top" => 70, "width" => 340, "height" => 340 ],

			"vrm" => %[

				"model" => "vee",

				"height" => 1340,          // the picture's height on the screen at 100%

				"aspect" => 0.62,          // its width for its height

				"frame" => [-0.03, 1.47],  // what the picture shows of her (metres, from the ground)

				// a pose is a VRM animation that goes on (looping)

				"poses" => %[ "standard" => "vee_idle", "think" => "vee_think" ],

				"defaultPose" => "standard",

				// motions: VRM animations played once, then the pose's again

				"motions" => %[ "wave" => "vee_wave", "nod" => "vee_nod", "bow" => "vee_bow", "cheer" => "vee_cheer" ],

				// faces: weights for her expressions (VRM's presets, and blush of her own); her
				// eyes blink and her mouth follows her voice over them

				"faces" => %[

					"normal"    => %[],

					"smile"     => %[ "happy" => 0.45 ],

					"laugh"     => %[ "happy" => 1 ],

					"relaxed"   => %[ "relaxed" => 1 ],

					"blush"     => %[ "relaxed" => 0.5, "blush" => 1 ],

					"sad"       => %[ "sad" => 1 ],

					"angry"     => %[ "angry" => 1 ],

					"surprised" => %[ "surprised" => 1 ],

					],

				"defaultFace" => "normal",

				],

			],

		],



	// Named layers

	// If a layer with the specified name does not exist, it is automatically created and initialized with defaults

	// *Note: Names will be normalized to lowercase

	// You can register images for effects etc. by specifying file names or level names

	"layers" => %[

		"border" => %[

		init: %[level:5, file:"border"], // Initialization parameters. Any parameters can be placed here

		trans: "normal", // Default transition specification,

		dispTrans: "normal",  // Default display transition specification

			],

		]

	];