{
  "comment": "krkrz_ios: the sample for the iOS Simulator (a device build needs an Apple Developer team). PROJECT_DIR is this repository; data/ (with the framework copied in as data/system) goes into the app bundle",
  "bundleId": "io.github.krkren.kagex",
  "displayName": "KAGEX",
  "version": "0.2.0",
  "build": 200,
  "deploymentTarget": "16.0",
  "devices": ["iphone", "ipad"],
  "orientations": ["landscapeLeft", "landscapeRight"],
  "graphics": "gles",
  "repl": true,
  "a11y": true,
  "icon": "platform/icon-1024.png",
  "ipa": { "baseName": "kagex" },
  "cmake": {
    "pluginFolders": [
      "${BUILD_SYSTEM_DIR}/plugins",
      "${KRKRZ_BASE}/krkrz_dev/src/plugins"
    ],
    "plugins": [
      "json", "KAGParserEx", "csvParser",
      "getSample", "layerExBTOA", "layerExImage", "layerExRaster", "saveStruct",
      "scriptsEx", "shrinkCopy", "krkr_richtext", "extrans", "virtualpad", "iosconfig"
    ]
  },
  "assetPack": {
    "baseFolder": "${PROJECT_DIR}",
    "sources": [
      { "type": "mirror", "from": "data", "to": "data", "exclude": ["**/*.bak", "**/*.psd"] },
      { "type": "mirror", "from": "template/system", "to": "data/system" }
    ]
  }
}
