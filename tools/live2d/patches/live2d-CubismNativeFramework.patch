+void CubismShader_OpenGLES2::SetPendingShader(const csmInt32 index, const csmChar* vertShaderPath, const csmChar* fragShaderPath, const csmInt32 colorBlendMode, const csmInt32 alphaBlendMode, const MaskType maskType)
+{
+    // kagex: GenerateShaders compiled all 79 blend-mode combinations' six sets up front, 474
+    // programs: seconds under ANGLE, over 30 on a Mac, though a model draws with a few
+    CubismShaderSet* shaderSet = _shaderSets[index];
+    shaderSet->PendingVertShaderPath = vertShaderPath;
+    shaderSet->PendingFragShaderPath = fragShaderPath;
+    shaderSet->PendingColorBlendMode = colorBlendMode;
+    shaderSet->PendingAlphaBlendMode = alphaBlendMode;
+    shaderSet->PendingMaskType = maskType;
+}
+
+CubismShader_OpenGLES2::CubismShaderSet* CubismShader_OpenGLES2::GetShaderSet(const csmInt32 index)
+{
+    CubismShaderSet* shaderSet = _shaderSets[index];
+    if (shaderSet->PendingFragShaderPath != NULL)
+    {
+        // compiled once, even when it fails (it draws nothing then, as before)
+        const csmChar* vert = shaderSet->PendingVertShaderPath;
+        const csmChar* frag = shaderSet->PendingFragShaderPath;
+        shaderSet->PendingVertShaderPath = NULL;
+        shaderSet->PendingFragShaderPath = NULL;
+        shaderSet->ShaderProgram = LoadShaderProgramFromFile(vert, frag, shaderSet->PendingColorBlendMode, shaderSet->PendingAlphaBlendMode);
+        SetShaderSet(*shaderSet, static_cast<MaskType>(shaderSet->PendingMaskType), true);
+    }
+    return shaderSet;
+}
