<?xml version="1.0" encoding="utf-8"?>
<!-- krkrz_android's Theme.Krkrz with a black window and navigation bar (since 0.21.0): the game's
     window stops above the navigation bar, and the strip there showed the theme's background, the
     white of Material's light theme. kagex-release writes the same for every game -->
<resources>
    <style name="Theme.Krkrz" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
