//
// The part World characters that draw their own picture share: those drawn from layers
// (KAGEnvCharacterEx.tjs, charinit.csv) and Live2D characters (KAGEnvCharacterLive2D.tjs). It
// holds the eyes' and the mouth's states and their commands (eyeopen, eyeflip, lipflip ...),
// reads the voice for lip-sync (its lip track or its level) and runs the update handler that
// moves them; a subclass draws the picture with eyeLevel, lipLevel and lipVowel (drawPose), and
// can add work of its own to each frame (updateExtra, isAnimating). world.tjs loads it before
// either, so Override.tjs can change the settings below.

// Switching time for stand-alone animation patterns (shortest case)
var eyeFlipTime = 60;

// Eye blink frequency *Note that this increases as eyeFlipTime decreases, so correction is included below.
var eyeFlipFreq = 0.025 * eyeFlipTime / 100;

// Switching time for lip-sync animation patterns (shortest case)
// Better for update timing if kept as an integer multiple of the eye timing
var lipFlipTime = 120;

// Voice levels (RMS, 0 to 1) at which the mouth is half open and open
