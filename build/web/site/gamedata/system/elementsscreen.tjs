// ElementsScreen.tjs - Screens drawn with the engine's Elements UI in a game layer
//
// KAGElementsScreen is a full-screen layer that an ElementsPanel (the engine's Elements UI
// drawn into a layer, engine reference: ElementsPanel) draws one screen into: buttons that
// a mouse, the keyboard and a controller work (the arrows or the D-pad move between them,
// Return or A presses one, Esc, B or a right-click goes back), that a screen reader reads (the
// engine exposes a panel's buttons with ElementsDialog.a11yLayers), and that take part in the
// layers' order like any other layer. It opens as KAG's current dialog
// (KAGWindow.openDialog), so the game waits while it's open, and KAGWindow.closeDialog takes
// it away (and invalidates it).
//
// The pictures come from the game, not from Elements' own look: a subclass draws each piece
// (a button in each of its states, a title, a line of text) into a hidden atlas layer in the
// dialogs' look (YesNoDialogLayer.tjs: the dialog_* images, the game's face list), which is
// handed to Elements as mem://<name> (ElementsDialog.registerLayerImage) and shown with
// atlas_button / atlas_image / atlas_nine. Text drawn there is the game's, in the language
// shown, so the screen is built again when it changes.
//
// The menu bar's drop-down menus (MenuBar.tjs) and the controls list (Controls.tjs) are made
// this way.

var KAGElementsScreenSerial = 0; // numbers the atlases' names

// Whether this engine can show such screens: it has ElementsPanel, and takes a layer's pixels
function KAGElementsScreenAvailable()
{
	return typeof global.ElementsPanel != "undefined" && typeof global.ElementsDialog != "undefined" &&
		typeof global.ElementsDialog.registerLayerImage != "undefined";
}

class KAGElementsScreen extends Layer
{
	var window;
	var panel;                // the ElementsPanel drawing into this layer
	var atlas;                // the pictures the screen shows, a hidden layer
	var atlasName;            // its name in ElementsDialog's image store (mem://<name>)
	var pieces = [];          // the atlas's pieces: %[ w, h, x, y, ... ] for drawPiece
	var hiddenLayers = [];    // [ layer, a11yHidden before ] kept from screen readers
	var a11yLayersBefore;     // ElementsDialog.a11yLayers before this opened
	var opened = false;
	var oldAtlasNames = [];   // the atlases of screens shown before, dropped once the next shows
	var deferred = [];        // [ function, arguments ] to run after the panel's event (defer)
	var deferTrigger;
	var a11yRole = "group";   // what a screen reader calls this layer: the screen's title
	var a11yName = "";

	function KAGElementsScreen(win, name = "Elements screen")
	{
		super.Layer(win, win.primaryLayer);
		window = win;
		this.name = name;
		var w = win.primaryLayer.width, h = win.primaryLayer.height;
		setImageSize(w, h);
		setSizeToImageSize();
		type = ltAlpha;
		face = dfAlpha;
		fillRect(0, 0, w, h, 0);
		hitType = htMask;
		hitThreshold = 0; // every click is the screen's
		focusable = true;
		cursor = win.cursorDefault if typeof win.cursorDefault != "undefined";
		atlas = new global.Layer(win, win.primaryLayer);
		atlas.name = name + " atlas";
		atlas.type = ltAlpha;
		atlas.face = dfAlpha;
		atlas.visible = false;
		atlasName = "kagex_screen_" + (++global.KAGElementsScreenSerial);
		panel = new global.ElementsPanel(this);
		panel.onAction = onPanelAction;
		panel.onClose = onPanelClose;
		if (typeof global.drawYesNoPanel == "undefined") KAGLoadScript("YesNoDialog.tjs");
	}

	function finalize()
	{
		showToScreenReaders(false);
		invalidate deferTrigger if deferTrigger !== void;
		if (panel !== void) { try { panel.close(); } catch {} invalidate panel; panel = void; }
		dropOldAtlases();
		try { ElementsDialog.unregisterImage(atlasName); } catch {}
		try { ElementsDialog.trimAtlasCache(0); } catch {}
		invalidate atlas if atlas !== void;
		super.finalize(...);
	}

	// ------------------------------------------------------------------ the atlas --

	/**
	 * Adds a piece of w x h to the atlas, to be drawn by drawPiece(piece, layer, x, y);
	 * returns the piece, whose x and y buildAtlas sets (rect gives them as [x, y, w, h])
	 */
	function addPiece(w, h, info)
	{
		var p = %[];
		(Dictionary.assign incontextof p)(info, true) if info !== void;
		p.w = w, p.h = h;
		pieces.add(p);
		return p;
	}

	function rect(p) { return [ p.x, p.y, p.w, p.h ]; }

	/**
	 * Packs the pieces in rows, draws them and gives the atlas to Elements: returns
	 * "mem://<name>" for the screen's "atlases"
	 */
	function buildAtlas()
	{
		// 8 pixels apart: text's outline reaching past its piece doesn't land in the next
		var maxW = 2048, gap = 8, x = 0, y = 0, rowH = 0, width = 0;
		for (var i = 0; i < pieces.count; i++) {
			var p = pieces[i];
			if (x > 0 && x + p.w > maxW) x = 0, y += rowH + gap, rowH = 0;
			p.x = x, p.y = y;
			x += p.w + gap;
			rowH = p.h if p.h > rowH;
			width = x if x > width;
		}
		var height = y + rowH;
		atlas.setImageSize(width > 0 ? width : 1, height > 0 ? height : 1);
		atlas.fillRect(0, 0, atlas.imageWidth, atlas.imageHeight, 0);
		for (var i = 0; i < pieces.count; i++) drawPiece(pieces[i], atlas, pieces[i].x, pieces[i].y);
		ElementsDialog.registerLayerImage(atlasName, atlas);
		return "mem://" + atlasName;
	}

	/**
	 * Starts a new set of pieces (the next page). The screen on show keeps its atlas, under its
	 * own name, until the next one has replaced it (show)
	 */
	function newAtlas()
	{
		oldAtlasNames.add(atlasName);
		atlasName = "kagex_screen_" + (++global.KAGElementsScreenSerial);
		pieces.clear();
	}

	function dropOldAtlases()
	{
		for (var i = 0; i < oldAtlasNames.count; i++) try { ElementsDialog.unregisterImage(oldAtlasNames[i]); } catch {}
		oldAtlasNames.clear();
	}

	function drawPiece(p, layer, x, y) {}

	// ------------------------------------------------------------- drawing helpers --

	/**
	 * Text in the dialogs' face at size, its top-left at x, y (color 0xRRGGBB); returns its width
	 */
	function drawText(layer, x, y, text, size, color, bold = true)
	{
		setYesNoFont(layer, size);
		layer.font.bold = bold;
		drawYesNoString(layer, x, y, text, color, yesnoLabelBase);
		return measureYesNoText(layer, text);
	}

	function textWidth(text, size, bold = true)
	{
		setYesNoFont(atlas, size);
		atlas.font.bold = bold;
		return measureYesNoText(atlas, text);
	}

	function textHeight(size)
	{
		setYesNoFont(atlas, size);
		return atlas.font.getTextHeight("Ag");
	}

	/**
	 * The size of font (from size down, by 2) that fits text in width
	 */
	function fitSize(text, size, width, bold = true, smallest = 18)
	{
		while (size > smallest && textWidth(text, size, bold) > width) size -= 2;
		return size;
	}

	// A triangle pointing right, its left edge at x, centred on cy (h high)
	function drawArrow(layer, x, cy, h, color)
	{
		var half = h >> 1;
		for (var i = 0; i <= half; i++) {
			var w = (half - i) * 2 \ 3 + 1;
			layer.fillRect(x, cy - i, w, 1, 0xff000000 | color);
			layer.fillRect(x, cy + i, w, 1, 0xff000000 | color) if i > 0;
		}
	}

	// A box (a check box: filled inside when on), size x size at x, y
	function drawBox(layer, x, y, size, color, on)
	{
		var c = 0xff000000 | color;
		layer.fillRect(x, y, size, 3, c);
		layer.fillRect(x, y + size - 3, size, 3, c);
		layer.fillRect(x, y, 3, size, c);
		layer.fillRect(x + size - 3, y, 3, size, c);
		layer.fillRect(x + 7, y + 7, size - 14, size - 14, c) if on;
	}

	// ------------------------------------------------------------------ showing --

	/**
	 * Shows a screen (an Elements layout as a dictionary, ElementsPanel.showDict)
	 */
	function show(layout)
	{
		fillRect(0, 0, imageWidth, imageHeight, 0);
		a11yName = layout["a11y"] !== void && layout["a11y"].title !== void ? layout["a11y"].title : "";
		var ok = panel.showDict(layout);
		dropOldAtlases();
		try { ElementsDialog.trimAtlasCache(0); } catch {} // the previous page's atlas
		dm("Elements screen not shown: " + name) if !ok;
		return ok;
	}

	/**
	 * Runs func(args) once the panel's event is over: a new screen can't be shown, nor the
	 * screen closed, from inside the panel's own onAction or onClose (showDict there crashed)
	 */
	function defer(func, args = [])
	{
		deferred.add([ func, args ]);
		if (deferTrigger === void) {
			deferTrigger = new AsyncTrigger(runDeferred, "");
			deferTrigger.cached = true;
		}
		deferTrigger.trigger();
	}

	function runDeferred()
	{
		while (deferred.count > 0) {
			var d = deferred[0];
			deferred.erase(0);
			d[0](d[1]*);
			if (!(this isvalid)) return;
		}
	}

	function onPanelAction(id, payload) {}
	function onPanelClose(action) { defer(close); }

	// --------------------------------------------- KAGWindow.openDialog's contract --

	function open()
	{
		window.openDialog(this);
	}

	function onOpen()
	{
		opened = true;
		focus();
		showToScreenReaders(true);
	}

	function close()
	{
		if (!opened) return;
		opened = false;
		showToScreenReaders(false);
		window.closeDialog(this);
	}

	function setMode()    { super.setMode(...); }
	function removeMode() { super.removeMode(...); }
	function hasWheel()   { return false; } // the wheel comes to the layer itself (onMouseWheel)
	function processWheel(shift, delta, x, y) {}

	/**
	 * While the screen is open, a screen reader sees it and nothing behind it: the engine
	 * exposes the panel's buttons with a11yLayers on, and every other layer is hidden from it
	 * (a11yHidden) as are the nodes Accessibility.tjs shows (this is in front, with none)
	 */
	function showToScreenReaders(on)
	{
		if (!KAGA11y.available) return;
		if (on) {
			a11yLayersBefore = ElementsDialog.a11yLayers;
			var kids = window.primaryLayer.children;
			for (var i = 0; i < kids.count; i++) {
				var l = kids[i];
				if (l === this) continue;
				hiddenLayers.add([ l, typeof l.a11yHidden != "undefined" ? l.a11yHidden : void ]);
				l.a11yHidden = true;
			}
			KAGA11y.setNodes(this, [], void);
			ElementsDialog.a11yLayers = true;
		} else {
			if (a11yLayersBefore === void) return;
			for (var i = 0; i < hiddenLayers.count; i++) {
				var l = hiddenLayers[i][0];
				if (isvalid l) l.a11yHidden = hiddenLayers[i][1] !== void ? hiddenLayers[i][1] : false;
			}
			hiddenLayers.clear();
			ElementsDialog.a11yLayers = a11yLayersBefore;
			a11yLayersBefore = void;
			KAGA11y.removeNodes(this);
		}
	}

	// ------------------------------------------------------------------- input --

	function panelButton(button)
	{
		return button == mbRight ? 1 : button == mbMiddle ? 2 : 0;
	}

	// A right-click goes back, as Esc does (a panel leaves that to its host)
	function onMouseDown(x, y, button, shift)
	{
		if (button == mbRight) return;
		panel.mouseDown(x, y, panelButton(button), shift);
	}

	function onMouseUp(x, y, button, shift)
	{
		if (button == mbRight) return cancel();
		panel.mouseUp(x, y, panelButton(button), shift);
	}

	function onMouseMove(x, y, shift)
	{
		panel.mouseMove(x, y, shift);
	}

	function onMouseLeave()
	{
		panel.mouseLeave();
		super.onMouseLeave(...);
	}

	function onMouseWheel(shift, delta, x, y)
	{
		panel.mouseWheel(delta, x, y, shift);
	}

	/**
	 * Keys go to the panel (the controller's buttons arrive as the keys KAGWindow.padKeyMap
	 * turns them into: A as Return, B as Esc). Esc goes back (a panel leaves that to its host),
	 * and keyOutside gets the other keys the panel didn't use
	 */
	function onKeyDown(key, shift, process)
	{
		// not to the panel: its own Esc ends the screen for good (the session finishes)
		if (key == VK_ESCAPE) { cancel() if !(shift & ssRepeat); return; }
		if (panel.keyDown(key, shift & ~ssRepeat)) return;
		keyOutside(key, shift);
	}

	// Esc, B or a right-click
	function cancel()
	{
		onPanelClose("");
	}

	function onKeyUp(key, shift, process)
	{
		panel.keyUp(key, shift) if key != VK_ESCAPE;
	}

	function keyOutside(key, shift)
	{
		// the screenshot key works here too
		if (key == VK_F12 && shift == 0 && window.screenshotEnabled) window.saveScreenshot();
	}
}
