     "language": "en"
    },
    {
     "character": "pip",
     "script": "char.ks",
     "text": "ぼくは舞台にもいないよ。よそから電話してるんだ！",
     "reading": "ぼくは舞台にもいないよ。よそから電話してるんだ！",
     "language": "ja"
    },
    {
     "character": "pip",
     "script": "char.ks",
     "text": "我都不在舞台上哦。我是从别的地方打电话过来的！",
     "reading": "我都不在舞台上哦。我是从别的地方打电话过来的！",
     "language": "zh-cn"
    },
    {
     "character": "pip",
