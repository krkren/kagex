  {
   "name": "pip000009.ogg",
   "file": "D:/a/kagex/kagex/kagex/data/voice/pip000009.ogg",
   "status": "current",
   "lip": "D:/a/kagex/kagex/kagex/data/voice/pip000009.lip",
   "lines": [
    {
     "character": "pip",
     "script": "anim.ks",
     "text": "Hi again! Listen closely. When I speak with a real voice, my mouth makes the shape of every vowel I say. Ah, ee, ooh, eh, oh. Isn't that so much better than mumbling?",
     "reading": "Hi again! Listen closely. When I speak with a real voice, my mouth makes the shape of every vowel I say. Ah, ee, ooh, eh, oh. Isn't that so much better than mumbling?",
     "language": "en"
    },
    {
     "character": "pip",
     "script": "anim.ks",
     "text": "もう一回こんにちは！ よく聞いてね。本物の声でしゃべると、ぼくの口は言った母音ひとつひとつの形になるんだ。あー、いー、うー、えー、おー。もごもご言うより、ずっといいでしょ？",
     "reading": "もう一回こんにちは！ よく聞いてね。本物の声でしゃべると、ぼくの口は言った母音ひとつひとつの形になるんだ。あー、いー、うー、えー、おー。もごもご言うより、ずっといいでしょ？",
     "language": "ja"
    },
    {
     "character": "pip",
     "script": "anim.ks",
     "text": "又见面啦！仔细听哦。我用真实的声音说话时，嘴巴会做出每个元音的口型。啊、咿、呜、诶、喔。是不是比含含糊糊地动嘴好多了？",
     "reading": "又见面啦！仔细听哦。我用真实的声音说话时，嘴巴会做出每个元音的口型。啊、咿、呜、诶、喔。是不是比含含糊糊地动嘴好多了？",
     "language": "zh-cn"
    },
    {
     "character": "pip",
     "script": "anim.ks",
     "text": "又見面啦！仔細聽哦。我用真實的聲音說話時，嘴巴會做出每個母音的口型。啊、咿、嗚、誒、喔。是不是比含含糊糊地動嘴好多了？",
     "reading": "又見面啦！仔細聽哦。我用真實的聲音說話時，嘴巴會做出每個母音的口型。啊、咿、嗚、誒、喔。是不是比含含糊糊地動嘴好多了？",
     "language": "zh-tw"
    }
   ],
   "track": {
    "text": "Hi again! Listen closely. When I speak with a real voice, my mouth makes the shape of every vowel I say. Ah, ee, ooh, eh, oh. Isn't that so much better than mumbling?",
    "language": "en",
    "marks": 111
   }
