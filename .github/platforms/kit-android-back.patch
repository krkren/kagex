+    /** kagex: Back closes the side menu, or goes to the game as Esc. */
+    private void onBackForGame() {
+        if (drawerLayout != null && drawerLayout.isDrawerOpen(GravityCompat.START)) {
+            drawerLayout.closeDrawer(GravityCompat.START);
+            return;
+        }
+        SDLActivity.onNativeKeyDown(KeyEvent.KEYCODE_ESCAPE);
+        SDLActivity.onNativeKeyUp(KeyEvent.KEYCODE_ESCAPE);
+    }
+
+    /**
+     * kagex: before Android 13 Back comes as KEYCODE_BACK, which SDL hands the engine as a key
+     * it has no name for: it goes as Escape instead, held as long as Back is.
